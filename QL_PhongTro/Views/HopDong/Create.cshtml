@model QL_PhongTro.ViewModels.HopDongCreateViewModel
@{ ViewData["Title"] = "Lập hợp đồng thuê"; var y = Model.DaChon; }
@section Styles { <link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/contract-create.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/contract-create-bootstrap.css" asp-append-version="true" /> }
<div class="contract-page lease-create create-reference">
<div class="contract-heading d-flex flex-wrap"><div><h1>Lập hợp đồng thuê</h1><p>Tạo hợp đồng từ yêu cầu thuê đã được duyệt.</p></div><button class="btn btn-outline-primary" type="button" id="preview-contract" disabled="@(y is null)">▤ &nbsp; Xem trước hợp đồng</button></div>

<div class="create-workspace"><div class="create-main"><section class="contract-card contract-request">
<div class="contract-card-title"><span class="contract-icon" aria-hidden="true">▤</span><h2>Yêu cầu thuê đã duyệt</h2></div>
<form method="get"><label for="request" class="visually-hidden">Yêu cầu thuê đã duyệt</label><select class="form-select" id="request" name="yeuCauId" onchange="this.form.submit()"><option value="">Chọn yêu cầu thuê đã duyệt…</option>@foreach(var item in Model.YeuCaus) { <option value="@item.Id" selected="@(item.Id == Model.YeuCauId)">@item.Ma — @item.Khach — Phòng @item.Phong</option> }</select><noscript><button type="submit" class="btn btn-outline-primary">Chọn yêu cầu</button></noscript></form>
@if(y is not null){<div class="lease-request-strip"><span class="lease-avatar" aria-hidden="true">@y.Khach.FirstOrDefault()</span><div><strong>@y.Khach</strong><small>@y.DienThoai</small></div><div><strong>@y.Phong</strong><small>@y.ToaNha</small></div><strong>@y.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ/tháng</strong><span class="lease-approved">✓ Đã duyệt</span><a asp-controller="LichHen" asp-action="ChiTiet" asp-route-id="@y.Id">Xem yêu cầu →</a></div>}else{<p class="contract-note">Chọn yêu cầu để xem thông tin phòng và người thuê.</p>}
</section>
<form asp-action="Create" method="post" enctype="multipart/form-data" id="contract-form">
<input asp-for="YeuCauId" type="hidden" />
<input asp-for="PhienBanPhong" type="hidden" />
<div asp-validation-summary="All" class="text-danger"></div>
<div class="contract-columns"><section class="contract-card create-terms">
<div class="contract-card-title"><span class="contract-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4M16 3v4M4 10h16M8 14h2M14 14h2M8 17h2M14 17h2"/></svg></span><div><h2>Thông tin hợp đồng</h2><small>Thiết lập kỳ thuê, tiền cọc và lịch hóa đơn.</small></div></div>
<div class="lease-tenant-fields"><div class="contract-field"><label for="customer-name">Khách thuê <em>*</em></label><input class="form-control" id="customer-name" value="@y?.Khach" readonly /></div><div class="contract-field"><label for="customer-phone">Số điện thoại</label><input class="form-control" id="customer-phone" value="@y?.DienThoai" readonly /></div><div class="contract-field"><label for="room-name">Phòng thuê <em>*</em></label><input class="form-control" id="room-name" value="@y?.Phong" readonly /></div></div>
<div class="create-terms-row create-terms-dates">
<div class="contract-field"><label asp-for="NgayBatDau">Ngày bắt đầu <em>*</em></label><input class="form-control" asp-for="NgayBatDau" type="date" asp-format="{0:yyyy-MM-dd}" min="@Model.HomNay.ToString("yyyy-MM-dd")" required /><span asp-validation-for="NgayBatDau" class="text-danger"></span></div>
<div class="contract-field"><label asp-for="SoThang">Kỳ hạn (tháng) <em>*</em></label><select class="form-select" asp-for="SoThang" required>@for(var month=1;month<=120;month++){<option value="@month">@month tháng</option>}</select><span asp-validation-for="SoThang" class="text-danger"></span></div>
<div class="contract-field"><label for="end-date">Ngày kết thúc <em>*</em></label><input class="form-control" id="end-date" type="date" value="@Model.NgayKetThuc?.ToString("yyyy-MM-dd")" readonly aria-describedby="contract-term-note" /></div>
<div class="contract-field"><label asp-for="NgayChot">Ngày chốt hóa đơn <em>*</em></label><select class="form-select" asp-for="NgayChot" required><option value="">Chọn ngày</option>@for(var day=1;day<=31;day++){<option value="@day">@day.ToString("00") hằng tháng</option>}</select><span asp-validation-for="NgayChot" class="text-danger"></span></div>
</div>
<div class="create-terms-row create-terms-money"><div class="contract-field"><label for="deposit-months">Tiền cọc (tháng)</label><select class="form-select" id="deposit-months"><option value="">Tùy chỉnh</option>@for(var m=0;m<=3;m++){<option value="@m" selected="@(Model.GiaThue > 0 && (decimal)(Model.TienCoc ?? -1) == (decimal)Model.GiaThue.Value * m)">@m tháng</option>}</select></div>
<div class="contract-field"><label asp-for="GiaThue">Giá thuê phòng <em>*</em></label><div class="create-money-input"><input class="form-control" asp-for="GiaThue" type="number" inputmode="numeric" min="500000" step="1" required /><span>VND</span></div><span asp-validation-for="GiaThue" class="text-danger"></span></div>
<div class="contract-field"><label asp-for="TienCoc">Tiền cọc quy đổi (đ) <em>*</em></label><div class="create-money-input"><input class="form-control" asp-for="TienCoc" type="number" inputmode="numeric" min="0" step="1" required /><span>VND</span></div><span asp-validation-for="TienCoc" class="text-danger"></span></div>
</div>
<p id="contract-term-note" class="contract-note">Ngày kết thúc tự tính theo kỳ hạn. Cọc thỏa thuận mặc định bằng một tháng tiền thuê, tối đa ba tháng; tiền thực thu được ghi nhận riêng.</p>
</section>
<section class="contract-card create-meters-card">
<div class="contract-card-title"><span class="contract-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M7 13a5 5 0 0 1 10 0M12 13l3-3M8 17h8"/><circle cx="12" cy="13" r="1"/></svg></span><div><h2>Chỉ số điện nước đầu kỳ</h2><small>Ghi nhận chỉ số công tơ tại thời điểm bàn giao phòng.</small></div></div>
<div class="contract-meters">
<div><label asp-for="ChiSoDien">Chỉ số điện đầu kỳ <em>*</em></label><div class="create-meter-input"><input class="form-control" asp-for="ChiSoDien" type="number" inputmode="decimal" min="0" step="0.001" placeholder="Ví dụ: 1250" required aria-describedby="meter-handover-note" /><span aria-hidden="true">kWh</span></div><span asp-validation-for="ChiSoDien" class="text-danger"></span></div>
<div><label asp-for="ChiSoNuoc">Chỉ số nước đầu kỳ <em>*</em></label><div class="create-meter-input"><input class="form-control" asp-for="ChiSoNuoc" type="number" inputmode="decimal" min="0" step="0.001" placeholder="Ví dụ: 120" required aria-describedby="meter-handover-note" /><span aria-hidden="true">m³</span></div><span asp-validation-for="ChiSoNuoc" class="text-danger"></span></div>
</div>
<p id="meter-handover-note" class="create-meter-note"><span aria-hidden="true">ⓘ</span><span>Nhập chỉ số thực tế tại ngày bắt đầu thuê, không âm. Đây là chỉ số bàn giao, không phải mức tiêu thụ.</span></p>
</section>


<section class="contract-card create-services">
<div class="contract-card-title"><span class="contract-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 7 2 2 3-4M12 7h8M4 14l2 2 3-4M12 14h8M12 20h8"/></svg></span><div><h2>Dịch vụ áp dụng</h2><small>Các khoản phí đang áp dụng cho phòng tại @Model.HomNay.ToString("dd/MM/yyyy").</small></div></div>
@if(Model.PhiDichVus.Count > 0){
<div class="create-services-table table-responsive"><table class="table align-middle mb-0"><thead><tr><th scope="col">Dịch vụ</th><th scope="col">Cách tính</th><th scope="col">Đơn vị</th><th scope="col">Đơn giá</th></tr></thead><tbody>
@foreach(var service in Model.PhiDichVus){<tr><td><span class="create-service-check" aria-label="Đang áp dụng">✓</span>@service.TenDichVu</td><td>@(service.CachTinh switch { "THEO_CHI_SO" => "Theo đồng hồ", "THEO_NGUOI" => "Theo đầu người", _ => "Cố định hằng tháng" })</td><td>@service.DonViTinh</td><td>@service.DonGia.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</td></tr>}
</tbody></table></div>
}else{<p class="contract-note">@(y is null ? "Chọn phòng để xem phí dịch vụ." : "Phòng chưa có dịch vụ đang áp dụng.")</p>}
<div class="create-services-footer">@if(y is not null){<a asp-controller="PhongTro" asp-action="Edit" asp-route-id="@y.PhongId" asp-fragment="room-services">Xem cấu hình dịch vụ</a>}<span>Điện, nước tính theo cách tính được cấu hình.</span></div>
</section><section class="contract-card create-documents">
<div class="contract-card-title"><span class="contract-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H5v18h14v-7M14 3v5h5M10 15l1-4 7-7 3 3-7 7-4 1Z"/></svg></span><div><h2>Điều khoản &amp; tài liệu</h2><small>Chọn mẫu hợp đồng và đính kèm tài liệu liên quan.</small></div></div>
<div class="contract-field"><label for="contract-template">Mẫu hợp đồng</label><select class="form-select" id="contract-template"><option>Mẫu hợp đồng tiêu chuẩn của hệ thống</option></select></div>
<div class="contract-field"><label for="contract-extra-terms">Điều khoản bổ sung</label><textarea class="form-control" asp-for="DieuKhoanBoSung" id="contract-extra-terms" rows="3" maxlength="5000" placeholder="Nhập thỏa thuận bổ sung giữa chủ nhà và người thuê."></textarea><span asp-validation-for="DieuKhoanBoSung" class="text-danger"></span></div>
<div class="create-document-divider"></div>
<div class="create-document-label"><label for="contract-documents">Tài liệu đính kèm</label><span>PDF, JPG, PNG · Tối đa 10 MB / tệp · Tối đa 5 tệp</span></div>
<div id="contract-documents" class="create-document-dropzone"><input asp-for="TaiLieus" type="file" multiple accept=".pdf,.jpg,.jpeg,.png" aria-label="Chọn tài liệu hợp đồng" /><small>Chọn hoặc kéo thả tài liệu vào ô này.</small></div><span asp-validation-for="TaiLieus" class="text-danger"></span><ul id="contract-file-list" aria-live="polite"></ul>
@if(User.IsInRole("CHU_NHA")){<label class="create-document-invoice"><input asp-for="TaoHoaDonKyDau" /> Tạo hóa đơn nháp kỳ đầu khi đủ dữ liệu.</label><span asp-validation-for="TaoHoaDonKyDau" class="text-danger"></span>}
<p class="contract-note">Điều khoản và tài liệu được lưu cùng hợp đồng. Hóa đơn nháp cần đủ chỉ số cuối kỳ và cấu hình giá; bạn kiểm tra trước khi phát hành.</p>
</section></div>

</form></div>@{ var fixedFees = Model.PhiDichVus.Where(x => x.CachTinh == "CO_DINH").Sum(x => (decimal)x.DonGia); var moneyCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<aside class="create-summary"><section class="contract-card lease-create-summary" data-fixed-fees="@fixedFees.ToString("0", System.Globalization.CultureInfo.InvariantCulture)">
<div class="contract-card-title"><h2>Tóm tắt hợp đồng</h2></div>
<div class="contract-generated"><span>Mã hợp đồng</span><strong>Tạo tự động khi lưu</strong></div><div class="create-room"><span class="contract-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4h9v16H8M8 4l5-1v18l-5-1V4ZM4 21h16M11 12h.01"/></svg></span><div><strong>@(y?.Phong ?? "Chưa chọn phòng")</strong><small>@(y is null ? "Chọn phòng để tiếp tục" : $"{y.ToaNha}{(string.IsNullOrWhiteSpace(y.LoaiPhong) ? "" : $" · {y.LoaiPhong}")}")</small></div></div>
<div class="contract-generated"><span>Người thuê</span><strong>@(y?.Khach ?? "Chưa chọn")</strong></div>
<div class="contract-generated"><span>Thời hạn</span><strong><span id="summary-start">@(Model.NgayBatDau?.ToString("dd/MM/yyyy") ?? "—")</span> đến <span id="summary-end">@(Model.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "—")</span></strong></div><span id="term-preview" hidden>@Model.SoThang tháng</span>
<div class="create-summary-divider"></div>
<div class="contract-generated"><span>Tiền thuê / tháng</span><strong id="rent-preview">@(Model.GiaThue?.ToString("N0", moneyCulture) ?? "—") đ</strong></div>
<div class="contract-generated" hidden><span>Phí dịch vụ cố định</span><strong>@fixedFees.ToString("N0", moneyCulture) đ</strong></div>
<div class="create-summary-total" hidden><span>Tổng cố định hằng tháng</span><strong id="monthly-total-preview">@((fixedFees + (Model.GiaThue ?? 0)).ToString("N0", moneyCulture)) đ</strong><small>Chưa bao gồm dịch vụ theo chỉ số và theo người.</small></div>
<div class="contract-generated"><span>Tiền đặt cọc</span><strong id="deposit-preview">@(Model.TienCoc?.ToString("N0", moneyCulture) ?? "—") đ</strong></div>
<div class="contract-generated"><span>Chốt hóa đơn</span><strong id="billing-day-preview">Ngày @Model.NgayChot?.ToString("00") · Hằng tháng</strong></div>
<div class="create-summary-divider"></div>
<div class="contract-generated" hidden><span>Dự kiến thu kỳ đầu</span><strong id="first-total-preview">@((fixedFees + (Model.GiaThue ?? 0) + (Model.TienCoc ?? 0)).ToString("N0", moneyCulture)) đ</strong></div>
<p class="create-summary-footnote" hidden>Gồm tiền cọc, một tháng tiền thuê và dịch vụ cố định. Kỳ lẻ và phí theo sử dụng được tính khi lập hóa đơn.</p>
</section><section class="contract-card lease-validity"><div class="contract-card-title"><span class="contract-icon" aria-hidden="true">▤</span><h2>Kiểm tra hiệu lực</h2></div><div class="lease-timeline"><span id="start-preview">—</span><strong id="validity-term">—</strong><span id="end-preview">—</span></div><div class="lease-timeline-line" aria-hidden="true"></div><div id="overlap-status" class="contract-overlap @(Model.ChongLans.Count > 0 ? "has-conflict" : "")" role="status" aria-live="polite">
@if(Model.ChongLans.Count > 0){<strong>Không thể lưu — có hợp đồng chồng lấn:</strong><ul>@foreach(var conflict in Model.ChongLans){<li>@conflict.Ma: @conflict.NgayBatDau.ToString("dd/MM/yyyy") – @conflict.NgayKetThuc.ToString("dd/MM/yyyy")</li>}</ul>}
</div>
<div class="lease-check @(y is null ? "is-pending" : "")">@(y is null ? "○ Chưa chọn phòng" : y.TrangThaiPhong == "DA_DAT_COC" ? "✓ Phòng đã được giữ chỗ" : y.TrangThaiPhong == "TRONG" ? "✓ Phòng đang trống" : "Cần kiểm tra trạng thái phòng")</div><div class="lease-check @(y is null ? "is-pending" : "")">@(y is null ? "○ Chưa chọn yêu cầu" : "✓ Yêu cầu đã được duyệt")</div><p class="lease-warning">⚠ Vui lòng kiểm tra chỉ số điện nước trước khi lưu.</p></section><section class="contract-card lease-after"><div class="contract-card-title"><span class="contract-icon" aria-hidden="true">▤</span><h2>Sau khi tạo hợp đồng</h2></div><ul><li>Sinh mã hợp đồng tự động</li><li>Chuyển phòng sang Đang thuê</li><li>Ẩn tin đăng của phòng</li><li>Lưu chỉ số điện nước bàn giao</li></ul><small>Lưu bản nháp chưa chuyển trạng thái phòng.</small></section></aside></div><div class="lease-actionbar d-flex flex-wrap"><span id="completion-status" role="status" aria-live="polite">Hoàn tất các trường bắt buộc để lưu.</span><div><a class="btn btn-outline-secondary" asp-action="Index">Hủy</a><button class="btn btn-outline-primary" type="submit" form="contract-form" name="intent" value="NHAP" disabled="@(y is null)">Lưu bản nháp</button><button id="save-contract" class="btn btn-primary" type="submit" form="contract-form" disabled="@(y is null)">Kiểm tra &amp; tạo hợp đồng</button></div></div></div>
<dialog id="contract-preview-dialog" class="create-preview-dialog"><div><h2>Xem trước thông tin hợp đồng</h2><button type="button" id="close-contract-preview" aria-label="Đóng bản xem trước">×</button></div><p>Thông tin dự kiến từ biểu mẫu; hợp đồng chưa được tạo.</p><div id="contract-preview-content"></div></dialog>
@section Scripts { <script src="~/js/contracts.js" asp-append-version="true"></script> }
