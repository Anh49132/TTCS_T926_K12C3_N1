@model QL_PhongTro.ViewModels.LichSuNguoiOViewModel
@{ ViewData["Title"] = "Lịch sử"; var current=Model.Nguois.Count(x=>x.DangO); }
<div class="occupancy-history occupancy-bootstrap">
<header class="oh-heading"><div><h1>Lịch sử</h1><p>Tra cứu quá trình cư trú tại phòng @Model.Phong · @Model.ToaNha.</p></div><button type="button" data-history-export class="btn btn-outline-secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m-4-4 4 4 4-4M5 15v5h14v-5"/></svg>Xuất danh sách</button></header>
<div class="oh-stats"><section><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8a8 8 0 1 1-1 7M4 3v5h5M12 7v5l3 2"/></svg></span><div><strong>@Model.Nguois.Count</strong> Tổng lượt cư trú<small>Trong khoảng thời gian đã chọn</small></div></section><section><span aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v2"/></svg></span><div><strong>@current</strong> Đang ở<small>Lượt cư trú đang tiếp diễn</small></div></section><section><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4h9v16H8M8 4l5-1v18l-5-1V4ZM4 21h16M11 12h.01"/></svg></span><div><strong>@Model.Nguois.Count(x=>!x.DangO && !x.KetThucTheoHanHopDong)</strong> Đã chuyển đi<small>Đã ghi nhận ngày chuyển đi</small></div></section></div>
<section class="oh-card"><div class="oh-search"><div class="oh-search-field"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input class="form-control" type="search" data-history-search placeholder="Tìm theo tên hoặc mã hợp đồng" aria-label="Tìm người ở"/></div><small>Thời gian lọc theo khoảng cư trú giao nhau</small></div><form method="get" asp-action="LichSuNguoiO"><input asp-for="PhongId" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="oh-filters"><div><label>Tòa nhà</label><div class="oh-fixed">@Model.ToaNha</div></div><div><label>Phòng</label><div class="oh-fixed">@Model.Phong</div></div><div><label for="oh-state">Trạng thái</label><select class="form-select" id="oh-state" data-history-state><option value="all">Tất cả trạng thái</option><option value="current">Đang ở</option><option value="left">Đã chuyển đi</option><option value="unknown">Chưa xác nhận</option></select></div><div><label asp-for="TuNgay">Từ ngày</label><input class="form-control" asp-for="TuNgay" type="date" required/></div><div><label asp-for="DenNgay">Đến ngày</label><input class="form-control" asp-for="DenNgay" type="date" required/></div><button type="submit" class="btn btn-dark">Áp dụng</button></div></form></section>
@if(Model.HopDongThieuDuLieu>0){<p class="oh-warning">Có @Model.HopDongThieuDuLieu hợp đồng cũ thiếu dữ liệu. Kết quả chỉ phản ánh thông tin đã ghi nhận.</p>}
@if(Model.DaLoc){<section class="oh-card"><div class="oh-list-heading"><div><h2>Danh sách lịch sử cư trú</h2><p>Mỗi dòng là một lượt cư trú tại phòng.</p></div><small>@Model.TuNgay?.ToString("dd/MM/yyyy") – @Model.DenNgay?.ToString("dd/MM/yyyy")</small></div><div class="oh-tabs"><span>Tất cả · @Model.Nguois.Count</span><span>Đang ở · @current</span><span>Đã chuyển đi · @Model.Nguois.Count(x=>!x.DangO && !x.KetThucTheoHanHopDong)</span><small>Ngày vào mới nhất ↓</small></div><div class="oh-table-scroll"><table class="table align-middle mb-0"><thead><tr><th>Người ở</th><th>Phòng / tòa nhà</th><th>Ngày vào</th><th>Ngày ra</th><th>Thời gian cư trú</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var person in Model.Nguois.OrderByDescending(x=>x.NgayBatDau)){
var state=person.DangO?"current":person.KetThucTheoHanHopDong?"unknown":"left";
<tr data-history-row data-state="@state"><td><div class="oh-person"><span class="oh-avatar">@(string.Concat(person.HoTen.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])))</span><div><strong>@person.HoTen</strong><small>@person.VaiTro · @person.MaHopDong</small></div></div></td><td>@Model.Phong<small>@Model.ToaNha</small></td><td>@person.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@(person.DangO?"—":person.NgayKetThuc.ToString("dd/MM/yyyy"))@if(person.KetThucTheoHanHopDong){<small>Theo hạn hợp đồng</small>}</td><td>@(person.NgayKetThuc.DayNumber-person.NgayBatDau.DayNumber+1) ngày<small>Khoảng cư trú đã ghi nhận</small></td><td><span class="oh-badge @state">● @(person.DangO?"Đang ở":person.KetThucTheoHanHopDong?"Chưa xác nhận":"Đã chuyển đi")</span></td><td><a asp-action="Details" asp-route-id="@person.HopDongId">Chi tiết ›</a></td></tr>
}
</tbody></table></div><p data-history-empty hidden>Không có lượt cư trú phù hợp.</p><footer class="oh-table-footer">Hiển thị <b data-history-count>@Model.Nguois.Count</b> lượt cư trú</footer></section>}
<p class="oh-note">ⓘ Một người có thể có nhiều lượt cư trú. Ngày chuyển đi vẫn là ngày ở. Ngày kết thúc theo hạn hợp đồng không xác nhận người ở đã chuyển đi.</p></div>
@section Styles {<link rel="stylesheet" href="~/css/occupancy-history.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/occupancy-bootstrap.css" asp-append-version="true"/>}
@section Scripts {<script src="~/js/occupancy-history.js" asp-append-version="true"></script>}
