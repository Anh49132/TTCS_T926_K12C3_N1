@model QL_PhongTro.ViewModels.HopDongDetailsViewModel
@{
    var k = Model.Ky;
    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var total = Model.Nguois.Count + (Model.DungTen is null ? 0 : 1);
    var remaining = k is null ? 0 : Math.Max(0, k.NgayKetThuc.DayNumber - Model.HomNay.DayNumber + 1);
    var nextMonth = Model.HomNay.Day < Math.Min(Model.HopDong.NgayChot, DateTime.DaysInMonth(Model.HomNay.Year, Model.HomNay.Month)) ? new DateOnly(Model.HomNay.Year, Model.HomNay.Month, 1) : new DateOnly(Model.HomNay.Year, Model.HomNay.Month, 1).AddMonths(1);
    var nextClosing = nextMonth.AddDays(Math.Min(Model.HopDong.NgayChot, DateTime.DaysInMonth(nextMonth.Year, nextMonth.Month)) - 1);
}
<div class="ref-workspace"><div class="ref-main">
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/></svg></span><h2>Thông tin hợp đồng</h2></div>
        <div class="ref-fact-columns"><dl class="ref-facts"><div><dt>Khách thuê</dt><dd>@(Model.DungTen?.HoTen ?? "Chưa cập nhật")</dd></div><div><dt>Số điện thoại</dt><dd>@(Model.DungTen?.SoDienThoai ?? "Chưa cập nhật")</dd></div><div><dt>CCCD</dt><dd>@(Model.DungTen?.SoGiayTo ?? "Chưa cập nhật")</dd></div><div><dt>Phòng thuê</dt><dd>@Model.Phong</dd></div></dl><dl class="ref-facts"><div><dt>Ngày bắt đầu</dt><dd>@(k?.NgayBatDau.ToString("dd/MM/yyyy") ?? "—")</dd></div><div><dt>Ngày kết thúc</dt><dd>@(k?.NgayKetThuc.ToString("dd/MM/yyyy") ?? "—")</dd></div><div><dt>Kỳ hạn</dt><dd>@k?.SoThang tháng</dd></div><div><dt>Ngày chốt hóa đơn</dt><dd>Ngày @Model.HopDong.NgayChot.ToString("00")</dd></div></dl></div>
        <p class="ref-notice">◷ &nbsp; @(remaining > 0 ? $"Thời hạn còn lại: {remaining} ngày" : "Kỳ hợp đồng đã hết hạn") · Hợp đồng kết thúc ngày @(k?.NgayKetThuc.ToString("dd/MM/yyyy") ?? "—").</p>
    </section>
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="14" height="16" rx="2"/><path d="M9 5V3h6v2M8 12a4 4 0 0 1 8 0M12 12l2-2M9 17h6"/></svg></span><h2>Tài chính hợp đồng</h2>@if (Model.XemTaiChinh) { <a href="#contract-bills">Xem hóa đơn</a> }</div>
        <div class="ref-metrics"><div><small>Giá thuê</small><strong>@(k?.GiaThue.ToString("N0", vi) ?? "—") đ / tháng</strong></div><div><small>Tiền cọc thỏa thuận</small><strong>@Model.HopDong.TienCoc.ToString("N0", vi) đ</strong></div><div><small>Dư nợ</small><span>Chưa tổng hợp tại đây</span></div><div><small>Ngày chốt tiếp theo</small><strong>@(Model.HopDong.TrangThai is "DANG_HIEU_LUC" or "CHO_HIEU_LUC" && remaining > 0 && nextClosing <= k!.NgayKetThuc ? nextClosing.ToString("dd/MM/yyyy") : "—")</strong></div></div>
    </section>
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="5" width="14" height="16" rx="2"/><path d="M9 5V3h6v2M8 12a4 4 0 0 1 8 0M12 12l2-2M9 17h6"/></svg></span><h2>Chỉ số bàn giao đầu kỳ</h2></div>@if (Model.ChiSo is {} meter) { <div class="ref-metrics ref-metrics-three"><div><small>Điện</small><strong>@meter.ChiSoDien.ToString("#,##0.###", vi) kWh</strong></div><div><small>Nước</small><strong>@meter.ChiSoNuoc.ToString("#,##0.###", vi) m³</strong></div><div><small>Ngày ghi nhận</small><strong>@meter.NgayBanGiao.ToString("dd/MM/yyyy")</strong></div></div> } else { <p class="contract-note">Chưa ghi nhận chỉ số bàn giao.</p> }</section>
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/></svg></span><h2>Dịch vụ và đơn giá áp dụng</h2></div>@if (Model.DichVus.Count > 0) { <div class="ref-table-frame"><table class="ref-table"><thead><tr><th>Dịch vụ</th><th>Cách tính</th><th>Đơn vị</th><th>Đơn giá</th></tr></thead><tbody>@foreach (var s in Model.DichVus) { <tr><td>@s.TenDichVu</td><td>@(s.CachTinh switch { "THEO_CHI_SO" => "Theo chỉ số", "THEO_NGUOI" => "Theo người", _ => "Cố định theo phòng" })</td><td>@s.DonViTinh</td><td>@s.DonGia.ToString("N0", vi) đ</td></tr> }</tbody></table></div><p class="contract-note">Đơn giá được lưu cùng hợp đồng. Hóa đơn đã phát hành giữ nguyên đơn giá.</p> } else { <p class="contract-note">Chưa có bản ghi dịch vụ trong hợp đồng này.</p> }</section>
    @if (Model.XemTaiChinh) {
        <section class="contract-card ref-card" id="contract-bills"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/></svg></span><h2>Hóa đơn liên quan</h2><a asp-controller="HoaDonDichVu" asp-action="Index">Xem danh sách hóa đơn</a></div>@if (Model.HoaDons.Count == 0) { <p class="contract-note">Chưa có hóa đơn cho hợp đồng này.</p> }@foreach (var bill in Model.HoaDons) { <div class="ref-bill"><strong>@bill.MaHoaDon</strong><span>Tháng @bill.Thang/@bill.Nam · @(bill.TrangThai == "NHAP" ? "Nháp" : "Đã phát hành")</span><strong>@bill.TongTien.ToString("N0", vi) đ</strong><small>Hạn thanh toán @bill.HanThanhToan.ToString("dd/MM/yyyy")</small></div> }</section>
    }
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><h2>Lịch sử gia hạn</h2></div>@if (Model.LichSuGiaHan.Count == 0) { <p class="contract-note">Hợp đồng chưa có lần gia hạn nào.</p> }@foreach (var renewal in Model.LichSuGiaHan) { <div class="cd-history"><strong>Lần @renewal.SoThuTu · @renewal.GiaThue.ToString("N0", vi) đ/tháng</strong><span>@renewal.NgayBatDau.ToString("dd/MM/yyyy") — @renewal.NgayKetThuc.ToString("dd/MM/yyyy")</span><small>@renewal.ThoiDiemVietNam.ToString("dd/MM/yyyy HH:mm") · @(renewal.NguoiThucHien ?? "Chưa ghi nhận tên")</small></div> }</section>
    <details class="contract-card ref-card"><summary>Thông tin bên cho thuê và tài liệu</summary><dl class="ref-facts"><div><dt>Chủ nhà</dt><dd>@Model.ChuNha</dd></div><div><dt>Số điện thoại</dt><dd>@(Model.ChuNhaDienThoai ?? "Chưa cập nhật")</dd></div><div><dt>Email</dt><dd>@(Model.ChuNhaEmail ?? "Chưa cập nhật")</dd></div><div><dt>Email người thuê</dt><dd>@(Model.NguoiThueEmail ?? "Chưa cập nhật")</dd></div><div><dt>Quê quán người thuê</dt><dd>@(Model.DungTen?.QueQuan ?? "Chưa cập nhật")</dd></div></dl><p class="contract-note">Chưa ghi nhận mẫu hợp đồng, điều khoản bổ sung, ngày ký và tài liệu đính kèm.</p></details>
</div><aside class="ref-side">
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 5v3"/></svg></span><h2>Người đứng tên hợp đồng</h2></div>@if (Model.DungTen is {} signer) { <div class="ref-person"><span class="ref-avatar">@signer.HoTen.FirstOrDefault()</span><div><strong>@signer.HoTen</strong><span class="ref-person-badge">Người đứng tên</span><small>☎ @signer.SoDienThoai &nbsp; ▣ @signer.SoGiayTo</small></div></div> } else { <p class="contract-note">Chưa có người đứng tên.</p> }</section>
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 5v3"/></svg></span><h2>Người đang ở</h2></div><div class="ref-capacity"><strong>@total / @Model.GioiHan <small>người</small></strong><span>Còn @Math.Max(0, Model.GioiHan - total) vị trí</span></div>@if (Model.DungTen is {} tenant) { <div class="ref-person compact"><span class="ref-avatar">@tenant.HoTen.FirstOrDefault()</span><strong>@tenant.HoTen</strong><span class="ref-person-badge">Người đứng tên</span></div> }@foreach (var person in Model.Nguois) { <div class="ref-person compact"><span class="ref-avatar">@person.HoTen.FirstOrDefault()</span><strong>@person.HoTen</strong><span class="ref-person-badge">Ở ghép</span></div> }<a class="btn btn-primary ref-full" asp-action="Details" asp-route-id="@Model.HopDong.Id" asp-route-tab="people">Quản lý người ở ghép</a></section>
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/></svg></span><h2>Việc cần chú ý</h2></div><dl class="ref-facts"><div><dt>Hợp đồng còn</dt><dd>@remaining ngày</dd></div><div><dt>Người ở ghép</dt><dd>@Model.Nguois.Count người</dd></div><div><dt>Người sắp vào</dt><dd>@Model.SapVao.Count người</dd></div></dl><p class="ref-notice">Tiền cọc thỏa thuận chưa đồng nghĩa với tiền cọc đã thu.</p></section>
    <section class="contract-card ref-card"><div class="ref-card-title"><span class="ref-icon neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 3-1 3-3 1v4l-2 1 2 4 3-1 2 3h4l2-3 3 1 2-4-2-1V7l-3-1-1-3Z"/><circle cx="12" cy="11" r="3"/></svg></span><h2>Thao tác hợp đồng</h2></div>@if (Model.ChoGiaHan) { <a class="ref-action" asp-action="GiaHan" asp-route-id="@Model.HopDong.Id">◷ &nbsp; Gia hạn hợp đồng <span>›</span></a> }<button class="ref-action" type="button" onclick="window.print()">▤ &nbsp; In hợp đồng <span>›</span></button><button class="ref-action" type="button" disabled title="Chưa hỗ trợ cập nhật tài khoản nhận tiền">Cập nhật tài khoản nhận tiền</button><button class="ref-action danger" type="button" disabled title="Chưa hỗ trợ chấm dứt hợp đồng tại trang này">Kết thúc hợp đồng</button></section>
</aside></div>
