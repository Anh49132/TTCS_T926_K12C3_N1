@model QL_PhongTro.ViewModels.HopDongDetailsViewModel
@{ var k=Model.Ky; var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); var fixedFees=Model.DichVus.Where(x=>x.CachTinh=="CO_DINH").Sum(x=>(decimal)x.DonGia); var state=Model.HopDong.TrangThai switch {"DANG_HIEU_LUC"=>"Đang hiệu lực","CHO_HIEU_LUC"=>"Chờ hiệu lực","NHAP"=>"Nháp","DA_KET_THUC"=>"Đã kết thúc",_=>"Đã hủy"}; }
<section class="cd-overview"><div><small>Phòng / căn hộ</small><strong>@Model.Phong</strong><span>@Model.ToaNha · @Model.LoaiPhong</span></div><div><small>Thời hạn hợp đồng</small><strong>@k?.SoThang tháng</strong><span>@k?.NgayBatDau.ToString("dd/MM/yyyy") — @k?.NgayKetThuc.ToString("dd/MM/yyyy")</span></div><div><small>Tiền thuê / tháng</small><strong>@(k?.GiaThue.ToString("N0",vi) ?? "—") đ</strong><span>Chưa bao gồm phí dịch vụ</span></div><div><small>Tiền đặt cọc</small><strong>@Model.HopDong.TienCoc.ToString("N0",vi) đ</strong><span>Tiền cọc thỏa thuận</span></div><footer><span>◷ Trạng thái hợp đồng: @state</span><span>@Model.HopDong.MaHopDong</span></footer></section>
<div class="cd-workspace"><div class="cd-main">
<section class="contract-card cd-room-card">
    <div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 21V7h9v14M14 11h5v10M8 10h3M8 13h3M8 16h3M8 21v-2h3v2M3 21h18M8 7V3h6v4"/></svg></span><h2>Thông tin phòng / căn hộ</h2></div>
    <dl class="cd-facts cd-three"><div><dt>Tòa nhà</dt><dd>@Model.ToaNha</dd></div><div><dt>Phòng / căn hộ</dt><dd>@Model.Phong@if(!string.IsNullOrWhiteSpace(Model.LoaiPhong)){<text> — @Model.LoaiPhong</text>}</dd></div><div><dt>Diện tích • Tầng</dt><dd>@Model.DienTich.ToString("0.##",vi) m² • Tầng @Model.Tang</dd></div></dl>
    <div class="cd-room-address"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>@Model.DiaChiPhong</span><small>@(Model.Nguois.Count+(Model.DungTen is null?0:1)) người ở</small></div>
</section>
<section class="contract-card cd-parties-card">
    <div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 13a5 5 0 0 1 3 5v3"/></svg></span><div><h2>Các bên trong hợp đồng</h2><small>Thông tin đại diện bên cho thuê và bên thuê.</small></div></div>
    <div class="cd-parties">
        <section><small>BÊN CHO THUÊ</small><h3><span class="cd-party-avatar">@(string.Concat(Model.ChuNha.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant())</span>@Model.ChuNha</h3><dl class="cd-facts"><div><dt>Số điện thoại</dt><dd>@(Model.ChuNhaDienThoai ?? "Chưa cập nhật")</dd></div><div><dt>Email</dt><dd>@(Model.ChuNhaEmail ?? "Chưa cập nhật")</dd></div><div><dt>Số CCCD</dt><dd>Chưa cập nhật</dd></div><div><dt>Địa chỉ thường trú</dt><dd>Chưa cập nhật</dd></div></dl></section>
        <section><small>BÊN THUÊ • NGƯỜI ĐẠI DIỆN</small><h3><span class="cd-party-avatar">@(string.Concat((Model.DungTen?.HoTen ?? "").Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant())</span>@(Model.DungTen?.HoTen ?? "Chưa cập nhật")</h3><dl class="cd-facts"><div><dt>Số điện thoại</dt><dd>@(Model.DungTen?.SoDienThoai ?? "Chưa cập nhật")</dd></div><div><dt>Email</dt><dd>@(Model.NguoiThueEmail ?? "Chưa cập nhật")</dd></div><div><dt>Số CCCD / Hộ chiếu</dt><dd>@(Model.DungTen?.SoGiayTo ?? "Chưa cập nhật")</dd></div><div><dt>Địa chỉ thường trú</dt><dd>@(Model.DungTen?.QueQuan ?? "Chưa cập nhật")</dd></div></dl></section>
    </div>
</section>
<section class="contract-card cd-payment-card">
    <div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4M16 3v4M4 10h16M8 13h2M14 13h2M8 17h2M14 17h2"/></svg></span><h2>Thời hạn &amp; thanh toán</h2></div>
    <dl class="cd-facts cd-three cd-payment-dates"><div><dt>Ngày bắt đầu</dt><dd>@k?.NgayBatDau.ToString("dd/MM/yyyy")</dd></div><div><dt>Ngày kết thúc</dt><dd>@k?.NgayKetThuc.ToString("dd/MM/yyyy")</dd></div><div><dt>Thời hạn hợp đồng</dt><dd>@k?.SoThang tháng</dd></div></dl>
    <dl class="cd-facts cd-three cd-payment-terms"><div><dt>Tiền thuê mỗi tháng</dt><dd>@(k?.GiaThue.ToString("N0",vi) ?? "—") đ</dd></div><div><dt>Tiền đặt cọc</dt><dd>@Model.HopDong.TienCoc.ToString("N0",vi) đ</dd></div><div><dt>Ngày ký hợp đồng</dt><dd>Chưa cập nhật</dd></div><div><dt>Chu kỳ thanh toán</dt><dd>Hằng tháng</dd></div><div><dt>Ngày chốt hóa đơn</dt><dd>Ngày @Model.HopDong.NgayChot.ToString("00") hằng tháng</dd></div><div><dt>Hình thức thanh toán</dt><dd>Chọn khi ghi nhận thu</dd></div></dl>
    <p class="contract-note">Tiền cọc là mức thỏa thuận, chưa đồng nghĩa với tiền thực nhận.</p>
</section>
<section class="contract-card cd-services-card">
    <div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 2 2 3-4M12 6h8m-16 7 2 2 3-4M12 13h8m-16 7 2 2 3-4M12 20h8"/></svg></span><div><h2>Phí dịch vụ</h2><small>Các khoản phí áp dụng trong suốt thời gian thuê.</small></div></div>
    @if(Model.DichVus.Count>0){
        <div class="cd-services-frame"><table class="cd-services"><thead><tr><th>Dịch vụ</th><th>Cách tính</th><th>Đơn giá</th></tr></thead><tbody>@foreach(var service in Model.DichVus){<tr><td>@service.TenDichVu</td><td>@(service.CachTinh switch{"THEO_CHI_SO"=>"Theo đồng hồ","THEO_NGUOI"=>"Theo đầu người",_=>"Cố định hằng tháng"})</td><td>@service.DonGia.ToString("N0",vi) đ / @service.DonViTinh</td></tr>}</tbody></table></div>
        <p class="contract-note">Điện, nước tính theo chỉ số thực tế khi áp dụng cách tính theo đồng hồ. Tổng phí cố định: @fixedFees.ToString("N0",vi) đ / tháng.</p>
    }else{<p class="contract-note">Chưa có bản ghi dịch vụ trong hợp đồng này.</p>}
</section>
<section class="contract-card cd-clauses-card">
    <div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M13 3H5v18h14v-9M13 3v6h6M13 3l6 6M8 12h3M8 16h2m3 0 5-5 2 2-5 5-3 1Z"/></svg></span><h2>Điều khoản hợp đồng</h2></div>
    <dl class="cd-facts cd-contract-template"><div><dt>Mẫu hợp đồng</dt><dd>Chưa ghi nhận mẫu hợp đồng</dd></div></dl>
    <div class="cd-extra-clauses"><h3>Điều khoản bổ sung</h3><p>Chưa có điều khoản bổ sung được ghi nhận cho hợp đồng này.</p></div>
    <div class="cd-signing-status"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg><span>Chưa ghi nhận xác nhận nội dung và ngày ký hợp đồng.</span></div>
</section>
<section class="contract-card cd-documents-card">
    <div class="cd-documents-heading"><div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7V5h7l2 2h9v13H3ZM3 11h18"/></svg></span><h2>Tài liệu hợp đồng</h2></div><small>0 tài liệu</small></div>
    <div class="cd-documents-empty"><span class="cd-document-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h8l4 4v14H6ZM14 3v5h4M9 12h6M9 16h6"/></svg></span><div><strong>Chưa có tài liệu đính kèm</strong><small>Tài liệu sẽ được hiển thị tại đây khi có dữ liệu.</small></div></div>
    <button class="cd-document-upload" type="button" disabled title="Chức năng đính kèm tài liệu hợp đồng chưa được hỗ trợ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M4 16v5h16v-5"/></svg>Thêm tài liệu đính kèm</button>
</section>
<section class="contract-card"><div class="cd-card-heading"><span>◷</span><h2>Lịch sử gia hạn</h2></div>@if(Model.LichSuGiaHan.Count==0){<p class="contract-note">Hợp đồng chưa có lần gia hạn nào.</p>}@foreach(var renewal in Model.LichSuGiaHan){<div class="cd-history"><strong>Lần @renewal.SoThuTu · @renewal.GiaThue.ToString("N0",vi) đ/tháng</strong><span>@renewal.NgayBatDau.ToString("dd/MM/yyyy") — @renewal.NgayKetThuc.ToString("dd/MM/yyyy")</span><small>@renewal.ThoiDiemVietNam.ToString("dd/MM/yyyy HH:mm") · @(renewal.NguoiThucHien ?? "Chưa ghi nhận tên")</small></div>}</section>
<section class="contract-card"><div class="cd-card-heading"><span>⚡</span><h2>Chỉ số bàn giao đầu kỳ</h2></div>@if(Model.ChiSo is {} meter){<dl class="cd-facts cd-three"><div><dt>Điện</dt><dd>@meter.ChiSoDien.ToString("N3",vi) kWh</dd></div><div><dt>Nước</dt><dd>@meter.ChiSoNuoc.ToString("N3",vi) m³</dd></div><div><dt>Ngày bàn giao</dt><dd>@meter.NgayBanGiao.ToString("dd/MM/yyyy")</dd></div></dl>}else{<p class="contract-note">Chưa ghi nhận chỉ số bàn giao.</p>}</section>
</div><aside class="cd-side">
<section class="contract-card cd-finance">
    <h2>Tóm tắt tài chính</h2>
    <dl class="cd-summary"><div><dt>Tiền thuê / tháng</dt><dd>@(k?.GiaThue.ToString("N0",vi) ?? "—") đ</dd></div><div><dt>Phí dịch vụ cố định</dt><dd>@fixedFees.ToString("N0",vi) đ</dd></div></dl>
    <div class="cd-total"><small>Tổng cố định hằng tháng</small><strong>@((fixedFees+(k?.GiaThue ?? 0)).ToString("N0",vi)) đ</strong><small>Chưa bao gồm dịch vụ theo chỉ số và theo người.</small></div>
    <dl class="cd-summary"><div><dt>Tiền đặt cọc thỏa thuận</dt><dd>@Model.HopDong.TienCoc.ToString("N0",vi) đ</dd></div><div><dt>Chu kỳ thanh toán</dt><dd>Hằng tháng</dd></div><div><dt>Ngày chốt hóa đơn</dt><dd>Ngày @Model.HopDong.NgayChot.ToString("00")</dd></div></dl>
    <div class="cd-bank-details"><small>Tài khoản nhận thanh toán</small><p>Chưa cập nhật thông tin tài khoản</p><span>@Model.ChuNha</span><small>Mã hợp đồng: @Model.HopDong.MaHopDong</small></div>
</section>
@if(Model.XemTaiChinh){
<section class="contract-card cd-related-payments">
    <h2>Thanh toán liên quan</h2>
    <div class="cd-related-item"><div class="cd-related-title"><strong>Tiền đặt cọc</strong><span class="cd-payment-badge">Cọc thỏa thuận</span></div><div class="cd-related-meta"><small>@Model.HopDong.MaHopDong</small><strong>@Model.HopDong.TienCoc.ToString("N0",vi) đ</strong></div><p>Chưa có dữ liệu xác nhận thu cọc tại đây.</p></div>
    @if(Model.HoaDons.Count==0){<p class="contract-note">Chưa có hóa đơn cho hợp đồng này.</p>}
    @foreach(var bill in Model.HoaDons){
        <div class="cd-related-item"><div class="cd-related-title"><strong>Tháng @bill.Thang/@bill.Nam</strong><span class="cd-payment-badge">@(bill.TrangThai=="NHAP"?"Nháp":"Đã phát hành")</span></div><div class="cd-related-meta"><small>@bill.MaHoaDon</small><strong>@bill.TongTien.ToString("N0",vi) đ</strong></div><div class="cd-related-meta"><small>Hạn thanh toán</small><strong>@bill.HanThanhToan.ToString("dd/MM/yyyy")</strong></div><p>Chi tiết khoản thu và dịch vụ được ghi nhận trong hóa đơn.</p></div>
    }
    <a class="btn btn-outline-primary lease-full" asp-controller="HoaDonDichVu" asp-action="Index"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h12v18H6ZM9 7h6M9 11h6M9 15h4"/></svg> Xem hóa đơn liên quan</a>
</section>
}
<section class="contract-card cd-activity-card">
    <h2>Hoạt động gần đây</h2>
    <div class="cd-activity-list">
        @foreach(var renewal in Model.LichSuGiaHan.OrderByDescending(x=>x.ThoiDiemVietNam).Take(2)){
            <div class="cd-activity-item"><span class="cd-activity-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 12 4 4L19 6M12 17l3 3 6-7"/></svg></span><div><strong>Đã gia hạn hợp đồng lần @renewal.SoThuTu</strong><p>@(renewal.NguoiThucHien ?? "Chưa ghi nhận người thực hiện") · @renewal.GiaThue.ToString("N0",vi) đ / tháng</p><small>@renewal.ThoiDiemVietNam.ToString("dd/MM/yyyy • HH:mm")</small></div></div>
        }
        <div class="cd-activity-item"><span class="cd-activity-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h8l4 4v14H6ZM14 3v5h4M9 12h6M9 16h4"/></svg></span><div><strong>Đã tạo hợp đồng</strong><p>@Model.HopDong.MaHopDong</p><small>@Model.HopDong.NgayTao.AddHours(7).ToString("dd/MM/yyyy • HH:mm")</small></div></div>
    </div>
</section>
<section class="contract-card cd-management-card">
    <h2>Quản lý hợp đồng</h2>
    <div class="cd-management-buttons">
        <button type="button" class="btn btn-outline-primary" disabled title="Chức năng gửi bản sao hợp đồng chưa được hỗ trợ"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m3 10 18-7-7 18-4-7ZM10 14 21 3"/></svg>Gửi bản sao cho người thuê</button>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 8V3h10v5M7 17H4V9h16v8h-3M7 14h10v7H7ZM16 11h1"/></svg>In hợp đồng</button>
    </div>
    <div class="cd-management-end"><button type="button" disabled title="Chức năng chấm dứt hợp đồng chưa được hỗ trợ tại trang này"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="m6 18 12-12"/></svg>Chấm dứt hợp đồng</button></div>
    <p class="contract-note">Mọi thay đổi sau khi ký cần được hai bên xác nhận bằng phụ lục hợp đồng.</p>
</section>
</aside></div>