@model QL_PhongTro.ViewModels.HopDongDetailsViewModel
@{ViewData["Title"]="Hợp đồng & người ở ghép";var people=Context.Request.Query["tab"]=="people"||!ViewData.ModelState.IsValid;var k=Model.Ky;var signer=Model.DungTen;var count=Model.Nguois.Count+(signer==null?0:1);var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");var simulateError=Context.Request.Query["simulateError"].ToString();}
<div class="contract-page contract-details-reference">
<div class="contract-heading"><div><h1>@(people?"Người ở ghép":"Chi tiết hợp đồng thuê")</h1><p>@Model.HopDong.MaHopDong · Phòng @Model.Phong · @Model.ToaNha</p></div>@if(Model.ChoKichHoat){<form method="post" asp-action="KichHoat" asp-route-id="@Model.HopDong.Id" class="contract-activate">@Html.AntiForgeryToken()@if(!string.IsNullOrEmpty(simulateError)){<input type="hidden" name="simulateError" value="@simulateError" />}<button type="submit" class="btn btn-primary">⚡ Kích hoạt hợp đồng</button></form>}<div class="contract-heading-actions"><a class="btn btn-outline-primary" asp-action="LichSuNguoiO" asp-route-phongId="@Model.HopDong.PhongId">◷ Lịch sử người ở</a>@if (User.IsInRole("CHU_NHA") || User.IsInRole("ADMIN"))
{<a class="btn btn-outline-secondary" asp-controller="PhongTro" asp-action="NhatKyPhong" asp-route-phongId="@Model.HopDong.PhongId">◷ Nhật ký phòng</a>@if(!people){<div class="contract-download-renew"><button type="button" class="btn btn-outline-primary" disabled title="Chức năng tải hợp đồng chưa hỗ trợ trên trang này"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4"/></svg> Tải hợp đồng</button>@if(Model.ChoGiaHan){<a class="btn btn-primary" asp-action="GiaHan" asp-route-id="@Model.HopDong.Id">Gia hạn hợp đồng</a>}</div>}}</div></div>
@if(TempData["ContractSuccess"] is {} message){<div class="alert alert-success">@message</div>}
@if(TempData["ContractWarning"] is {} warning){<div class="alert alert-warning">@warning</div>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<nav class="lease-detail-tabs"><a class="@(!people?"is-active":"")" asp-action="Details" asp-route-id="@Model.HopDong.Id">Tổng quan</a><a class="@(people?"is-active":"")" asp-action="Details" asp-route-id="@Model.HopDong.Id" asp-route-tab="people">Người ở cùng (@Model.Nguois.Count)</a><span>Lịch sử thanh toán · Chưa có</span></nav>
@if(people){<partial name="_Residents" model="Model"/>}else{
<partial name="_ContractOverview" model="Model"/>}
</div>
@section Styles{<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/contract-details.css" asp-append-version="true"/>}
