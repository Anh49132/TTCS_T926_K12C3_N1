@model List<QL_PhongTro.ViewModels.HopDongDanhSach>
@inject QL_PhongTro.Authorization.PermissionService Permissions
@using QL_PhongTro.ViewModels
@{
 ViewData["Title"]="Hợp đồng & người ở ghép";
 var today=(DateOnly)ViewData["HomNay"]!;
 var active=Model.Count(x=>x.HopDong.TrangThai=="DANG_HIEU_LUC");
 var ending=Model.Count(x=>x.HopDong.TrangThai=="DANG_HIEU_LUC"&&x.Ky is {} k&&k.NgayKetThuc>=today&&k.NgayKetThuc<=today.AddDays(30));
 var ended=Model.Count(x=>x.HopDong.TrangThai=="DA_KET_THUC");
 var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
 var occupants=ViewData["Occupants"] as Dictionary<int,int> ?? new();
 string Label(string state)=>state switch{"DANG_HIEU_LUC"=>"Hiệu lực","NHAP"=>"Nháp","CHO_HIEU_LUC"=>"Chờ hiệu lực","DA_KET_THUC"=>"Đã kết thúc","DA_HUY"=>"Đã hủy",_=>state};
}
<div class="contract-page contract-list lease-overview">
@if(User.IsInRole("CHU_NHA") && await Permissions.AllowsAsync("HOP_DONG")){<p><a class="btn btn-outline-secondary" asp-controller="YeuCauTraPhong" asp-action="Index">Yêu cầu trả phòng của khách</a></p>}
@if(User.IsInRole("CHU_NHA") && await Permissions.AllowsAsync("HOP_DONG",true) && await Permissions.AllowsAsync("TAI_CHINH",true)){<div class="lease-header-actions"><a class="btn btn-outline-primary" asp-controller="TraPhong" asp-action="Index">Ghi nhận trả phòng</a><a class="btn btn-outline-primary" asp-controller="TatToan" asp-action="Index">Bảng tất toán</a></div>}
<div class="contract-heading"><div><h1>Hợp đồng &amp; người ở ghép</h1><p>Quản lý hợp đồng thuê và các thành viên cư trú trong từng phòng.</p></div><div class="lease-header-actions"><button type="button" class="btn btn-outline-primary" id="lease-export"><svg class="lease-download-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg> Xuất danh sách</button>@if(await Permissions.AllowsAsync("HOP_DONG",true)){<a class="btn btn-primary" asp-action="Create">＋ Tạo hợp đồng</a>}</div></div>
@if(TempData["ContractSuccess"] is {} message){<div class="alert alert-success">@message</div>}
<div class="lease-stats">
<section class="contract-card"><span class="contract-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4h7l3 3v10H9zM16 4v4h3M6 8H4v12h10v-2"/></svg></span><div><strong>@Model.Count</strong> Tổng hợp đồng<small>@active còn hiệu lực · @ended đã kết thúc</small></div></section>
<section class="contract-card"><span class="contract-icon gold"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4m8-4v4M4 10h16"/><circle cx="12" cy="15" r="3"/><path d="M12 13v2l1 1"/></svg></span><div><strong>@ending</strong> Sắp hết hạn<small>Trong 30 ngày tới</small></div></section>
<section class="contract-card"><span class="contract-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="8" r="3"/><path d="M4 20v-3a6 6 0 0 1 12 0v3m0-15a3 3 0 0 1 0 6m3 9v-3a5 5 0 0 0-2-4"/></svg></span><div><strong>@occupants.Values.Sum()</strong> Người ở ghép<small>@occupants.Count(x=>x.Value>0) phòng có người ở ghép</small></div></section></div>
<section class="contract-card lease-filter-card"><div class="lease-search-line"><div class="lease-search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="lease-search" aria-label="Tìm hợp đồng" placeholder="Tìm mã hợp đồng, phòng, người đứng tên hoặc người ở ghép"/></div><small>Dữ liệu tính đến @today.ToString("dd/MM/yyyy")</small></div><div class="lease-filter-row">
<label>Tòa nhà<select id="lease-building"><option value="">Tất cả tòa nhà</option>@foreach(var b in Model.Select(x=>x.ToaNha).Distinct()){<option>@b</option>}</select></label>
<label>Phòng / căn hộ<select id="lease-room"><option value="">Tất cả phòng</option>@foreach(var r in Model.Select(x=>x.Phong).Distinct()){<option>@r</option>}</select></label>
<label>Người ở ghép<select id="lease-people"><option value="">Tất cả hợp đồng</option><option value="yes">Có người ở ghép</option><option value="no">Không có người ở ghép</option></select></label>
<label>Ngày hết hạn<select id="lease-expiry"><option value="">Tất cả thời gian</option><option value="ending">Trong 30 ngày tới</option><option value="past">Đã qua ngày hết hạn</option></select></label><button type="button" class="btn btn-primary" id="lease-apply">Áp dụng</button></div></section>
<section class="contract-card lease-list-card"><div class="contract-card-title"><div><h2>Danh sách hợp đồng</h2><small>Mỗi hợp đồng gắn với một phòng và một nhóm người cư trú.</small></div><small>@occupants.Values.Sum() người ở ghép</small></div>
<div class="lease-list-tools"><div class="lease-tabs" id="lease-filters"><button type="button" data-status="" class="is-active">Tất cả <span>@Model.Count</span></button><button type="button" data-status="DANG_HIEU_LUC">Hiệu lực <span>@active</span></button><button type="button" data-status="ending">Sắp hết hạn <span>@ending</span></button><button type="button" data-status="DA_KET_THUC">Đã kết thúc <span>@ended</span></button></div><small>Mới nhất trước</small></div>
<div class="table-responsive"><table class="table lease-table"><thead><tr><th>Mã hợp đồng</th><th>Phòng / Tòa nhà</th><th>Người đứng tên</th><th>Ở ghép</th><th>Thời hạn</th><th>Tiền thuê</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var r in Model){var h=r.HopDong;var k=r.Ky;var n=occupants.GetValueOrDefault(h.Id);var soon=h.TrangThai=="DANG_HIEU_LUC"&&k!=null&&k.NgayKetThuc>=today&&k.NgayKetThuc<=today.AddDays(30);
<tr data-lease-row data-building="@r.ToaNha" data-room="@r.Phong" data-people="@(n>0?"yes":"no")" data-status="@h.TrangThai" data-ending="@(soon?"yes":"no")" data-past="@(k!=null&&k.NgayKetThuc<today?"yes":"no")"><td><strong>@h.MaHopDong</strong><small>@h.NgayTao.AddHours(7).ToString("dd/MM/yyyy")</small></td><td><strong>@r.Phong</strong><small>@r.ToaNha</small></td><td><strong>@(r.Khach??"Chưa cập nhật")</strong></td><td>@n người<small>@(n+(h.KhachDungTenId.HasValue?1:0)) người cư trú</small></td><td>@if(k!=null){<span>@k.NgayBatDau.ToString("dd/MM/yyyy") – @k.NgayKetThuc.ToString("dd/MM/yyyy")</span><small>@(k.NgayKetThuc>=today?$"Còn {k.NgayKetThuc.DayNumber-today.DayNumber+1} ngày":"Đã qua ngày hết hạn")</small>}else{<span>Chưa có kỳ thuê</span>}</td><td><strong>@(k?.GiaThue.ToString("N0",vi)??"—") đ</strong><small>/ tháng</small></td><td><span class="contract-badge @(soon?"badge-warning":h.TrangThai=="DANG_HIEU_LUC"?"badge-success":"")">• @(soon?"Sắp hết hạn":Label(h.TrangThai))</span></td><td>@if(User.IsInRole("CHU_NHA")){<a class="lease-row-menu-trigger" asp-action="Details" asp-route-id="@h.Id" aria-label="Chi tiết hợp đồng @h.MaHopDong" title="Chi tiết hợp đồng">⋯</a>}</td></tr>}
</tbody></table></div><p id="lease-empty" hidden>Không có hợp đồng phù hợp.</p><footer class="lease-table-footer"><small id="lease-count">Hiển thị @Model.Count hợp đồng</small><label>Số dòng / trang <select id="lease-page-size"><option>10</option><option>20</option><option>50</option></select></label><button id="lease-prev" type="button" aria-label="Trang trước">‹</button><span id="lease-page">1</span><button id="lease-next" type="button" aria-label="Trang sau">›</button></footer></section>
<p class="lease-footnote">Người đứng tên chịu trách nhiệm hợp đồng; người ở ghép được quản lý theo ngày vào ở và ngày chuyển đi.</p></div>
@section Styles{<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/contract-overview.css" asp-append-version="true"/>}
@section Scripts{<script src="~/js/lease-list.js" asp-append-version="true"></script>}
