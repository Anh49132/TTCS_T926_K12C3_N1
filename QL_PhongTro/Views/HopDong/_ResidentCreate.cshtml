@model QL_PhongTro.ViewModels.HopDongDetailsViewModel
@{var total=Model.Nguois.Count+(Model.DungTen is null?0:1);}
<div class="resident-create-layout">
<form asp-action="ThemNguoi" asp-route-id="@Model.HopDong.Id" method="post" class="resident-create-form">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Input.PhienBanPhong" type="hidden" />
<section class="contract-card resident-room-card"><div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 21V7h9v14M14 11h5v10M8 10h3M8 13h3M8 16h3M3 21h18M8 7V3h6v4"/></svg></span><div><h2>Phòng / căn hộ &amp; hợp đồng liên quan</h2><small>Người ở ghép được thêm vào hợp đồng này, không tạo hợp đồng mới.</small></div></div>
<div class="resident-fields"><div><label>Phòng / căn hộ</label><div class="resident-locked-field"><input value="@Model.Phong — @Model.ToaNha" readonly aria-label="Phòng / căn hộ" /><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4M12 14v3"/></svg></div></div><div><label>Hợp đồng liên quan</label><div class="resident-locked-field"><input value="@Model.HopDong.MaHopDong" readonly aria-label="Hợp đồng liên quan" /><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4M12 14v3"/></svg></div></div></div>
<div class="resident-room-info"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>@Model.DiaChiPhong · @Model.LoaiPhong · @Model.DienTich m² · Tầng @Model.Tang</span><div><small>Thời hạn thuê: @Model.Ky?.NgayBatDau.ToString("dd/MM/yyyy") — @Model.Ky?.NgayKetThuc.ToString("dd/MM/yyyy")</small><strong>@(Model.HopDong.TrangThai switch { "DANG_HIEU_LUC"=>"Đang hiệu lực", "CHO_HIEU_LUC"=>"Chờ hiệu lực", "NHAP"=>"Nháp", "DA_KET_THUC"=>"Đã kết thúc", _=>"Đã hủy" })</strong></div></div>
<div class="resident-signer"><span class="cd-party-avatar">@(string.Concat((Model.DungTen?.HoTen ?? "").Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant())</span><div><small>NGƯỜI THUÊ CHÍNH • ĐỨNG TÊN HỢP ĐỒNG</small><strong>@Model.DungTen?.HoTen</strong><small>@Model.DungTen?.SoDienThoai@if(!string.IsNullOrWhiteSpace(Model.NguoiThueEmail)){<text> · @Model.NguoiThueEmail</text>}</small></div><span class="resident-count">@total người ở hiện tại</span></div>
</section>
<section class="contract-card resident-person-card"><div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M19 8v6M16 11h6"/></svg></span><div><h2>Thông tin người ở ghép</h2><small>Người cư trú bổ sung, không thay thế người thuê chính trên hợp đồng.</small></div></div>
<div class="resident-fields">
<div><label asp-for="Input.HoTen">Họ và tên <em>*</em></label><input asp-for="Input.HoTen" maxlength="100" required autocomplete="name" placeholder="Nhập họ và tên" /><span asp-validation-for="Input.HoTen" class="text-danger"></span></div>
<div><label asp-for="Input.SoDienThoai">Số điện thoại <em>*</em></label><input asp-for="Input.SoDienThoai" type="tel" inputmode="numeric" maxlength="10" required autocomplete="tel" placeholder="10 chữ số, bắt đầu bằng 0" /><span asp-validation-for="Input.SoDienThoai" class="text-danger"></span></div>
</div>
<div class="resident-fields resident-fields-three resident-extra-fields"><div><label>Ngày sinh</label><input type="date" disabled title="Chưa hỗ trợ lưu ngày sinh trong luồng này" /></div><div><label>Giới tính</label><select disabled><option>Chưa cập nhật</option></select></div><div><label>Quốc tịch</label><select disabled><option>Chưa cập nhật</option></select></div></div>
<div class="resident-fields resident-extra-fields"><div><label>Email</label><input type="email" disabled placeholder="Chưa hỗ trợ lưu" /></div><div><label>Quan hệ với người thuê chính</label><select disabled><option>Chưa cập nhật</option></select></div></div>
<div class="resident-subheading">Giấy tờ định danh</div>
<div class="resident-fields"><div><label>Loại giấy tờ</label><select disabled><option>Căn cước công dân</option></select></div><div><label asp-for="Input.SoGiayTo">Số giấy tờ <em>*</em></label><input asp-for="Input.SoGiayTo" inputmode="numeric" maxlength="12" required placeholder="9 hoặc 12 chữ số" /><span asp-validation-for="Input.SoGiayTo" class="text-danger"></span></div></div>
<div class="resident-fields resident-extra-fields"><div><label>Ngày cấp</label><input type="date" disabled /></div><div><label>Nơi cấp</label><input disabled placeholder="Chưa hỗ trợ lưu" /></div></div>
<p class="contract-note resident-extra-note">Ngày sinh, giới tính, quốc tịch, email, quan hệ và thông tin cấp giấy tờ chưa hỗ trợ lưu trong luồng này.</p>
</section>
<section class="contract-card resident-living-card">
<div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 10 8-7 8 7v11H4ZM9 21v-8h6v8"/></svg></span><div><h2>Thông tin cư trú</h2><small>Ghi nhận thời điểm bắt đầu ở và tình trạng đăng ký tạm trú.</small></div></div>
<div class="resident-fields"><div><label asp-for="Input.NgayVao">Ngày bắt đầu ở <em>*</em></label><input asp-for="Input.NgayVao" type="date" required /><span asp-validation-for="Input.NgayVao" class="text-danger"></span></div><div><label>Tình trạng tạm trú</label><select disabled title="Chưa hỗ trợ lưu tình trạng tạm trú"><option>Chưa ghi nhận</option></select></div></div>
<p class="contract-note">Ngày bắt đầu ở nằm trong thời hạn hợp đồng: @Model.Ky?.NgayBatDau.ToString("dd/MM/yyyy") — @Model.Ky?.NgayKetThuc.ToString("dd/MM/yyyy").</p>
<div class="resident-fields resident-extra-fields"><div class="resident-field-full"><label>Địa chỉ thường trú</label><input disabled placeholder="Chưa hỗ trợ lưu" /></div><div><label>Người liên hệ khẩn cấp</label><input disabled placeholder="Chưa hỗ trợ lưu" /></div><div><label>Số điện thoại liên hệ</label><input type="tel" disabled placeholder="Chưa hỗ trợ lưu" /></div></div>
</section>
<section class="contract-card resident-documents-card">
<div class="cd-card-heading"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 7V5h7l2 2h9v13H3ZM3 11h18"/></svg></span><div><h2>Tài liệu &amp; ghi chú</h2><small>Đính kèm giấy tờ định danh và hồ sơ cư trú của người ở ghép.</small></div></div>
<div class="resident-document-label"><label>Tài liệu đính kèm</label><small>PDF, JPG, PNG • Tối đa 10 MB / tệp</small></div>
<div class="resident-document-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h8l4 4v14H6ZM14 3v5h4M9 12h6M9 16h4"/></svg><span>Chưa có tài liệu đính kèm</span></div>
<button class="cd-document-upload" type="button" disabled title="Chưa hỗ trợ lưu tài liệu người ở ghép"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M4 16v5h16v-5"/></svg>Kéo thả tài liệu vào đây hoặc chọn tệp</button>
<div class="resident-document-notes"><label for="resident-note">Ghi chú</label><textarea id="resident-note" rows="3" disabled placeholder="Chưa hỗ trợ lưu ghi chú"></textarea></div>
<p class="contract-note">Tài liệu đính kèm và ghi chú chưa hỗ trợ lưu trong luồng này.</p>
</section>
<footer class="resident-create-footer"><small>Dấu * là thông tin bắt buộc.</small><a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.HopDong.Id">Hủy</a><button type="submit" class="btn btn-primary resident-save-button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M19 8v6M16 11h6"/></svg>Lưu thêm người ở ghép</button></footer>
</form>
<aside class="resident-create-summary"><section class="contract-card cd-finance resident-summary-card">
<header><h2>Tóm tắt bổ sung</h2><span>Chưa lưu</span></header>
<div class="resident-summary-room"><span class="resident-summary-room-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 21V5h10v16M15 10h4v11M8 8h4M8 12h4M8 16h4M3 21h18"/></svg></span><div><strong>@Model.Phong</strong><small>@Model.ToaNha · @Model.LoaiPhong</small></div></div>
<dl class="cd-summary"><div><dt>Hợp đồng</dt><dd>@Model.HopDong.MaHopDong</dd></div><div><dt>Người thuê chính</dt><dd>@Model.DungTen?.HoTen</dd></div></dl>
<div class="resident-summary-person"><small>NGƯỜI Ở GHÉP BỔ SUNG</small><div><span class="cd-party-avatar" data-resident-avatar>…</span><div><strong data-resident-name>Chưa nhập họ tên</strong><small data-resident-phone>Chưa nhập số điện thoại</small></div></div></div>
<dl class="cd-summary"><div><dt>Ngày bắt đầu ở</dt><dd data-resident-date>Chưa chọn</dd></div><div><dt>Tạm trú</dt><dd>Chưa ghi nhận</dd></div><div><dt>Tài liệu đính kèm</dt><dd>0 tệp</dd></div></dl>
<div class="cd-total resident-count-total"><small>Số người ở sau khi thêm</small><div><span>@total <b>→</b></span><strong>@(total+1) người</strong></div><small>@total người hiện tại + 1 người ở ghép</small></div>
<p class="contract-note">Sau khi lưu, người ở ghép sẽ được thêm vào phòng @Model.Phong và hợp đồng @Model.HopDong.MaHopDong. Hệ thống kiểm tra sức chứa tại ngày bắt đầu ở.</p>
</section><section class="contract-card"><h2>Quy định người ở ghép</h2><p class="contract-note">Người đứng tên tiếp tục chịu trách nhiệm thanh toán. Người chuyển đi trong ngày vẫn được tính đến hết ngày.</p></section></aside>
</div>
<script>
(() => {
    const form = document.querySelector('.resident-create-form');
    const summary = document.querySelector('.resident-summary-card');
    if (!form || !summary) return;
    const name = form.querySelector('[name="Input.HoTen"]');
    const phone = form.querySelector('[name="Input.SoDienThoai"]');
    const date = form.querySelector('[name="Input.NgayVao"]');
    function update() {
        const fullName = name.value.trim();
        summary.querySelector('[data-resident-name]').textContent = fullName || 'Chưa nhập họ tên';
        summary.querySelector('[data-resident-phone]').textContent = phone.value.trim() || 'Chưa nhập số điện thoại';
        summary.querySelector('[data-resident-avatar]').textContent = fullName ? fullName.split(/\s+/).slice(-2).map(part => part[0]).join('').toUpperCase() : '…';
        const parts = date.value.split('-');
        summary.querySelector('[data-resident-date]').textContent = parts.length === 3 ? parts.reverse().join('/') : 'Chưa chọn';
    }
    [name, phone, date].forEach(field => field.addEventListener('input', update));
    update();
})();
</script>