@model QL_PhongTro.ViewModels.HopDongDetailsViewModel
@{ var accountMode = Model.Input.CachThem == "CO_TAI_KHOAN"; var total = Model.Nguois.Count + (Model.DungTen is null ? 0 : 1); }
<section class="contract-card ref-card ref-add-resident" id="add-resident">
    <div class="ref-card-title"><span class="ref-icon neutral" aria-hidden="true">＋</span><div><h2>Thêm người ở ghép</h2><small>Người mới được thêm vào hợp đồng hiện tại, không thay đổi người đứng tên.</small></div></div>
    <nav class="ref-add-tabs nav nav-pills" aria-label="Cách thêm người ở ghép"><a class="@(accountMode ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.HopDong.Id" asp-route-tab="people" asp-route-mode="account" asp-fragment="add-resident" aria-current="@(accountMode ? "page" : null)">Có tài khoản</a><a class="@(!accountMode ? "is-active" : "")" asp-action="Details" asp-route-id="@Model.HopDong.Id" asp-route-tab="people" asp-route-mode="manual" asp-fragment="add-resident" aria-current="@(!accountMode ? "page" : null)">Chưa có tài khoản</a></nav>
    <p class="ref-date-notice">ⓘ &nbsp; Ngày bắt đầu ở được ghi tự động theo ngày Việt Nam khi lưu. Hôm nay: @Model.HomNay.ToString("dd/MM/yyyy").</p>
    @if (accountMode) {
        <form asp-action="TimNguoiOGhep" asp-route-id="@Model.HopDong.Id" method="post" class="ref-account-search">
            <label for="resident-account-id">ID người dùng <em>*</em></label><div><input class="form-control" id="resident-account-id" name="taiKhoanId" type="number" inputmode="numeric" min="1" step="1" value="@Model.Input.TaiKhoanId" required placeholder="Nhập chính xác ID người dùng" /><button class="btn btn-outline-secondary" type="submit">Kiểm tra tài khoản</button></div><span asp-validation-for="Input.TaiKhoanId" class="text-danger"></span><small>Chỉ tra cứu theo ID chính xác. Không hiển thị danh sách gợi ý người dùng.</small>
        </form>
        @if (Model.TaiKhoanXacNhan is {} found) {
            <div class="ref-account-confirm"><div class="ref-person"><span class="ref-avatar">@found.HoTen.FirstOrDefault()</span><div><strong>@found.HoTen</strong><small>ID người dùng: @found.Id</small></div></div><dl class="ref-facts"><div><dt>Số điện thoại</dt><dd>@(string.IsNullOrEmpty(found.DienThoaiDaChe) ? "Chưa cập nhật" : found.DienThoaiDaChe)</dd></div><div><dt>CCCD</dt><dd>@(string.IsNullOrEmpty(found.CanCuocDaChe) ? "Chưa cập nhật" : found.CanCuocDaChe)</dd></div><div><dt>Xác thực email</dt><dd>@(found.EmailDaXacThuc ? "Đã xác thực" : "Chưa xác thực")</dd></div></dl><p class="contract-note">Thông tin chỉ để xác nhận. Khách thuê tự cập nhật hồ sơ trong tài khoản của mình.</p></div>
            <form asp-action="ThemNguoi" asp-route-id="@Model.HopDong.Id" method="post" class="resident-create-form" aria-label="Thêm tài khoản vào hợp đồng">
                <input type="hidden" name="Input.CachThem" value="CO_TAI_KHOAN" /><input type="hidden" name="Input.TaiKhoanId" value="@found.Id" /><input asp-for="Input.PhienBanPhong" type="hidden" />
                <footer class="ref-resident-footer"><p>Hiện tại: @total/@Model.GioiHan người. Hệ thống kiểm tra lại trước khi thêm.</p><button type="submit" class="btn btn-primary" disabled="@(!found.DuThongTin)">Thêm vào hợp đồng</button></footer>
            </form>
        }
    } else {
        <form asp-action="ThemNguoi" asp-route-id="@Model.HopDong.Id" method="post" class="resident-create-form" aria-label="Thông tin người ở ghép">
            <input type="hidden" name="Input.CachThem" value="CHUA_CO_TAI_KHOAN" /><input asp-for="Input.PhienBanPhong" type="hidden" />
            <div class="ref-resident-fields"><div class="ref-field-full"><label asp-for="Input.HoTen">Họ và tên <em>*</em></label><input class="form-control" asp-for="Input.HoTen" maxlength="100" minlength="2" required autocomplete="name" placeholder="Nhập họ và tên" /><span asp-validation-for="Input.HoTen" class="text-danger"></span></div><div><label asp-for="Input.SoDienThoai">Số điện thoại <em>*</em></label><input class="form-control" asp-for="Input.SoDienThoai" type="tel" inputmode="numeric" maxlength="10" pattern="0[0-9]{9}" required autocomplete="tel" placeholder="10 chữ số, bắt đầu bằng 0" /><small>Nếu đã có tài khoản, chuyển sang Có tài khoản.</small><span asp-validation-for="Input.SoDienThoai" class="text-danger"></span></div><div><label asp-for="Input.SoGiayTo">CCCD <em>*</em></label><input class="form-control" asp-for="Input.SoGiayTo" inputmode="numeric" maxlength="12" pattern="([0-9]{9}|[0-9]{12})" required placeholder="9 hoặc 12 chữ số" /><span asp-validation-for="Input.SoGiayTo" class="text-danger"></span></div></div>
            <p class="contract-note">Hồ sơ người ở ghép chưa liên kết tài khoản. Chưa hỗ trợ gửi lời mời qua số điện thoại hoặc tự liên kết sau đăng ký.</p>
            <footer class="ref-resident-footer"><p>Hiện tại: @total/@Model.GioiHan người. Hệ thống kiểm tra lại sức chứa khi lưu.</p><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.HopDong.Id">Hủy</a><button type="submit" class="btn btn-primary">Thêm người ở ghép</button></footer>
        </form>
    }
</section>
