@model QL_PhongTro.ViewModels.DanhSachYeuCauViewModel
@using QL_PhongTro.Models
@using QL_PhongTro.Services
@{
    var all = Model.TongHop;
    var today = DateOnly.FromDateTime(Model.NowUtc.AddHours(7));
    var pending = all.Count(x => TrangThaiYeuCau.ChuaXuLy(x.TrangThai));
    var overdue = all.Count(x => x.QuaHanChuaXuLy);
    var approved = all.Count(x => x.TrangThai == "DA_DUYET" && !x.DaLapHopDong);
    var appointments = all.Where(x => x.TrangThai == "DA_HEN_LICH" && x.LichHen.HasValue && DateOnly.FromDateTime(x.LichHen.Value.AddHours(7)) == today).OrderBy(x => x.LichHen).ToList();
    var monthCount = all.Count(x => x.NgayTao.AddHours(7).Year == today.Year && x.NgayTao.AddHours(7).Month == today.Month);
}
<div class="owner-requests or-reference requests-bootstrap">
@if(TempData["YeuCauOk"] is string message){<p class="text-success" role="status">@message</p>}
@if(TempData["YeuCauError"] is string error){<p class="text-danger" role="alert">@error</p>}
<header class="or-heading"><div><h1>Yêu cầu thuê &amp; lịch xem</h1><p>Theo dõi nhu cầu thuê và kết nối với người thuê phù hợp.</p></div><button type="button" class="or-button btn btn-dark" id="or-export"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 15v5h14v-5" /></svg><span>Xuất danh sách</span></button></header>
<section class="or-stats">
<article><span class="or-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2"/><path d="M4 13h5l2 3h2l2-3h5M8 6V4h8v2"/></svg></span><div><span>Tổng yêu cầu tháng này</span><strong>@monthCount.ToString("D2")</strong><small>Từ đầu tháng đến hôm nay</small></div></article>
<article><span class="or-icon amber"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span><div><span>Chờ xử lý</span><strong>@pending.ToString("D2")</strong><small>@overdue yêu cầu quá 24 giờ</small></div></article>
<article><span class="or-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 10h16"/></svg></span><div><span>Đã hẹn xem</span><strong>@all.Count(x => x.TrangThai == "DA_HEN_LICH").ToString("D2")</strong><small>@appointments.Count lịch hẹn hôm nay</small></div></article>
<article><span class="or-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="m8 12 3 3 5-6"/></svg></span><div><span>Đã duyệt</span><strong>@approved.ToString("D2")</strong><small>Sẵn sàng tạo hợp đồng</small></div></article>
</section>
<div class="or-layout"><section class="or-card or-list">
<nav class="or-tabs nav" aria-label="Lọc nhanh yêu cầu"><a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" class="@(Model.TrangThai == null ? "active" : "")">Tất cả <span>@all.Count</span></a>@foreach (var state in TrangThaiYeuCau.Labels) { <a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-trangThai="@state.Key" class="@(Model.TrangThai == state.Key ? "active" : "")">@state.Value <span>@all.Count(x => x.TrangThai == state.Key)</span></a> }</nav>
<form method="get" asp-action="Index" class="or-filters"><div class="or-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="or-search" type="search" placeholder="Tìm tên, số điện thoại..." aria-label="Tìm yêu cầu" /></div><select name="toaNhaId" aria-label="Tòa nhà" onchange="this.form.requestSubmit()"><option value="">Tất cả tòa nhà</option>@foreach(var building in Model.ToaNhaOptions){<option value="@building.Value" selected="@(Model.ToaNhaId?.ToString()==building.Value)">@building.Text</option>}</select><label class="or-month-field"><span class="visually-hidden">Tháng gửi yêu cầu</span><input id="or-month" type="month" aria-label="Tháng gửi yêu cầu" /></label><input type="hidden" name="trangThai" value="@Model.TrangThai"/></form>
<div class="or-scroll"><table id="or-table"><thead><tr><th>Người thuê</th><th>Phòng / Căn hộ</th><th>Ngày gửi ↓</th><th>Trạng thái</th><th><span class="visually-hidden">Thao tác</span></th></tr></thead><tbody>
@foreach(var item in Model.YeuCaus.OrderByDescending(x=>x.NgayTao)){
<tr data-request-id="@item.Id" data-month="@item.NgayTao.AddHours(7).ToString("yyyy-MM")" data-type="@item.LoaiYeuCau" tabindex="0" aria-label="Xem yêu cầu của @item.TenKhach">
<td><div class="or-table-person"><span class="or-avatar">@(string.IsNullOrWhiteSpace(item.TenKhach)?"KT":string.Concat(item.TenKhach.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])))</span><div><strong>@item.TenKhach</strong><small>@item.SoDienThoai</small></div></div></td>
<td><strong>Phòng @item.MaPhong</strong><small>@item.TenToaNha</small></td><td>@item.NgayTao.AddHours(7).ToString("dd/MM/yyyy")<small>@item.NgayTao.AddHours(7).ToString("HH:mm")</small></td>
<td>@if(item.QuaHanChuaXuLy){<small class="or-tag amber">Quá 24 giờ, chưa xử lý</small>}<span class="or-tag @(item.TrangThai=="MOI"?"amber":"")">• @(item.TrangThai=="MOI"?"Chờ xử lý":TrangThaiYeuCau.Labels.GetValueOrDefault(item.TrangThai,item.TrangThai))</span></td><td><a class="or-button" asp-controller="LichHen" asp-action="ChiTiet" asp-route-id="@item.Id" aria-label="Chi tiết yêu cầu @item.MaYeuCau">Chi tiết</a></td></tr>
}
</tbody></table></div><p id="or-empty" class="or-empty" hidden="@(Model.YeuCaus.Count > 0)">Không có yêu cầu phù hợp. Thử bỏ bộ lọc.</p><footer class="or-pagination"><span id="or-count">@Model.YeuCaus.Count yêu cầu</span><nav id="or-pages" aria-label="Phân trang yêu cầu"></nav></footer>
</section><aside class="or-detail-panel">
<div class="or-panel-header"><h2>Chi tiết yêu cầu</h2><a id="or-open-detail" class="or-open-detail" hidden aria-label="Mở trang chi tiết yêu cầu" title="Chi tiết yêu cầu"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg></a></div>
<div id="or-selected-detail"><p class="or-muted">Chọn một yêu cầu để xem chi tiết.</p></div>
@foreach(var item in Model.YeuCaus){
<template id="or-detail-@item.Id">
<div class="or-panel-body"><div class="or-panel-status"><small>@item.MaYeuCau</small><span class="or-tag @(item.TrangThai=="MOI"?"amber":"")">• @(item.TrangThai=="MOI"?"Chờ xử lý":TrangThaiYeuCau.Labels.GetValueOrDefault(item.TrangThai,item.TrangThai))</span></div>
<div class="or-person"><span class="or-avatar">@(string.IsNullOrWhiteSpace(item.TenKhach)?"KT":string.Concat(item.TenKhach.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])))</span><div><strong>@item.TenKhach</strong><small>Khách quan tâm thuê phòng</small></div></div><div class="or-contact-lines"><p><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-3 2a15 15 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>@item.SoDienThoai</p>@if(!string.IsNullOrWhiteSpace(item.Email)){<p><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg>@item.Email</p>}</div>
<section class="or-panel-room"><h3>Phòng / căn hộ quan tâm</h3><div class="or-room-summary"><img src="@(item.AnhPhong??Url.Content("~/room-placeholder.svg"))" alt="Phòng @item.MaPhong"/><div><strong>Phòng @item.MaPhong</strong><small>@item.TenToaNha · @item.DienTich.ToString("0.#") m²</small><b>@item.GiaThue.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ / tháng</b></div></div></section>
<div class="or-detail-fields"><div><small>Ngày dọn vào</small><strong>@(item.NgayMongMuon?.ToString("dd/MM/yyyy")??"Chưa cung cấp")</strong></div><div><small>Thời hạn thuê</small><strong>Chưa cung cấp</strong></div><div><small>Số người ở</small><strong>@item.SoNguoiDuKien người</strong></div><div><small>Nghề nghiệp</small><strong>@(string.IsNullOrWhiteSpace(item.NgheNghiep)?"Chưa cung cấp":item.NgheNghiep)</strong></div>@if(item.LichHen.HasValue){<div><small>Lịch xem phòng</small><strong>@item.LichHen.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")</strong></div>}</div>
<div class="or-message"><strong>Lời nhắn từ người thuê</strong><p>@(string.IsNullOrWhiteSpace(item.LoiNhan)?"Khách chưa để lại lời nhắn.":item.LoiNhan)</p></div><p class="or-sent">Đã gửi yêu cầu · @item.NgayTao.AddHours(7).ToString("HH:mm, dd/MM/yyyy")</p></div>
<footer class="or-panel-actions">
@if(User.IsInRole("CHU_NHA") && TrangThaiYeuCau.ChuaXuLy(item.TrangThai)){
<form method="post" asp-action="XuLyNhanh" asp-controller="YeuCau"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="thaoTac" value="DUYET"/><input type="hidden" name="sauKhiXem" value="@(item.LoaiYeuCau=="XEM_PHONG"?"true":"false")"/>
@if(item.LoaiYeuCau=="XEM_PHONG"){<input type="hidden" name="daDongYThue" value="true"/>}
<button class="or-button primary or-approve-open" type="button" disabled="@(item.LoaiYeuCau=="XEM_PHONG" && item.TrangThai!="DA_HEN_LICH")">✓ Duyệt yêu cầu</button>
<dialog class="or-reject-dialog or-approve-dialog" aria-labelledby="or-approve-title-@item.Id"><div class="or-reject-dialog-header"><h3 id="or-approve-title-@item.Id">Duyệt yêu cầu</h3><button type="button" class="or-approve-cancel" aria-label="Đóng thông báo">×</button></div><p class="or-approve-message">Bạn có muốn duyệt yêu cầu của <strong>@item.TenKhach</strong> cho phòng <strong>@item.MaPhong</strong>?</p><div class="or-reject-dialog-actions"><button type="button" class="or-button or-approve-cancel">Hủy</button><button type="submit" class="or-button primary">Xác nhận duyệt</button></div></dialog></form>
<div class="or-action-pair"><a class="or-button or-schedule-button" asp-controller="LichHen" asp-action="ChiTiet" asp-route-id="@item.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M8 3v4m8-4v4M4 10h16m5 4h6m-3-3v6"/></svg>Hẹn xem phòng</a><button type="button" class="or-button or-reject-open">Từ chối</button><dialog class="or-reject-dialog"><div class="or-reject-dialog-header"><h3>Từ chối yêu cầu</h3><button type="button" class="or-reject-cancel" aria-label="Đóng thông báo">×</button></div><div class="or-reject-form"><form method="post" asp-action="XuLyNhanh" asp-controller="YeuCau"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="thaoTac" value="TU_CHOI"/><label>Lý do từ chối<select name="lyDo" required><option value="">Chọn lý do</option>@foreach(var reason in LyDoTuChoi.All){<option value="@reason">@LichHenService.LyDoLabel(reason)</option>}</select></label><label>Ghi chú (bắt buộc khi chọn lý do khác)<textarea name="ghiChu" maxlength="1000" rows="3"></textarea></label><div class="or-reject-dialog-actions"><button type="button" class="or-button or-reject-cancel">Hủy</button><button class="or-button primary" type="submit">Xác nhận từ chối</button></div></form></div></dialog></div>
}else{<p class="or-muted">Yêu cầu này không còn chờ xử lý hoặc bạn không có quyền xử lý.</p>}
</footer>
</template>}
</aside></div><p class="or-bottom-note">ⓘ Phản hồi sớm giúp tăng khả năng kết nối với người thuê phù hợp.</p></div>
