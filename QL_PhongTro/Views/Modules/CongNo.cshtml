@model QL_PhongTro.ViewModels.CongNoIndexViewModel
@{
    ViewData["Title"] = "Công nợ";
    var overdueRooms = Model.Rows.Count(x => x.SoNgayQuaHanDaiNhat > 0);
    var exportUrl = Url.Action("ExportCsv", "Modules", new { toaNhaId = Model.ToaNhaId, quaHanTu = Model.QuaHanTu, quaHanDen = Model.QuaHanDen, tienTu = Model.TienTu, tienDen = Model.TienDen });
}
@section Styles { <link rel="stylesheet" href="~/css/debt-list.css" asp-append-version="true" /> }
<div class="debt-page">
    <div class="debt-heading">
        <div><h1>Công nợ theo phòng</h1><p>Theo dõi số tiền còn thiếu và mức độ quá hạn theo từng phòng.</p></div>
        <a class="debt-export" href="@exportUrl"><span aria-hidden="true">⇩</span> Xuất CSV</a>
    </div>

    <section class="debt-stats" aria-label="Tổng quan công nợ">
        <article class="debt-stat debt-stat-money"><span class="debt-stat-icon">₫</span><div><small>Tổng còn thiếu</small><strong>@Model.TotalOutstanding.ToString("N0") đ</strong></div></article>
        <article class="debt-stat"><span class="debt-stat-icon">▦</span><div><small>Phòng còn nợ</small><strong>@Model.Rows.Count</strong></div></article>
        <article class="debt-stat debt-stat-invoice"><span class="debt-stat-icon">▤</span><div><small>Hóa đơn chưa trả hết</small><strong>@Model.TotalInvoices</strong></div></article>
        <article class="debt-stat debt-stat-overdue"><span class="debt-stat-icon">◷</span><div><small>Phòng đang quá hạn</small><strong>@overdueRooms</strong></div></article>
    </section>

    <section class="debt-panel debt-filter-panel">
        <h2><span aria-hidden="true">▽</span> Bộ lọc công nợ</h2>
        <form method="get" action="/CongNo" class="debt-filter-form">
            <label class="debt-field debt-field-building"><span>Tòa nhà</span><select name="toaNhaId"><option value="">Tất cả tòa nhà</option>@foreach (var b in Model.Buildings) { <option value="@b.Id" selected="@(Model.ToaNhaId == b.Id)">@b.Name</option> }</select></label>
            <label class="debt-field"><span>Số ngày quá hạn</span><span class="debt-range"><span>Từ</span><input type="number" min="0" name="quaHanTu" value="@Model.QuaHanTu" placeholder="0 ngày" /><span>Đến</span><input type="number" min="0" name="quaHanDen" value="@Model.QuaHanDen" placeholder="90 ngày" /></span></label>
            <label class="debt-field"><span>Số tiền còn thiếu</span><span class="debt-range"><span>Từ</span><input type="number" min="0" step="1" name="tienTu" value="@Model.TienTu" placeholder="0 đ" aria-label="Số tiền còn thiếu từ" /><span>Đến</span><input type="number" min="0" step="1" name="tienDen" value="@Model.TienDen" placeholder="Không giới hạn" aria-label="Số tiền còn thiếu đến" /><span>đ</span></span></label>
            <div class="debt-filter-actions"><button type="submit" class="debt-apply">Áp dụng bộ lọc</button><a class="debt-reset" href="/CongNo">Bỏ bộ lọc</a></div>
        </form>
        <div class="debt-filter-note"><span aria-hidden="true">ⓘ</span> Số liệu cập nhật đến @DateTime.Today.ToString("dd/MM/yyyy"). Các khoảng lọc tính theo VND và ngày nguyên.</div>
    </section>

    <section class="debt-panel debt-table-panel">
        <div class="debt-table-heading"><h2><span aria-hidden="true">▤</span> Danh sách công nợ</h2><label class="debt-search"><span aria-hidden="true">⌕</span><input id="debt-search" type="search" placeholder="Tìm phòng, người đứng tên..." aria-label="Tìm phòng hoặc người đứng tên" /></label></div>
        <div class="debt-table-wrap"><table class="debt-table"><thead><tr><th>Phòng</th><th>Tòa nhà</th><th>Người đứng tên</th><th>HĐ chưa trả hết</th><th>Tổng còn thiếu</th><th>Quá hạn dài nhất</th></tr></thead>
            <tbody id="debt-rows">
            @foreach (var row in Model.Rows) { <tr data-search="@($"{row.MaPhong} {row.TenToaNha} {row.NguoiDungTen}".ToLowerInvariant())"><td>@row.MaPhong</td><td>@row.TenToaNha</td><td>@row.NguoiDungTen</td><td class="debt-center">@row.SoHoaDonChuaTraHet</td><td class="debt-amount">@row.TongConThieu.ToString("N0") đ</td><td><span class="debt-overdue-badge @(row.SoNgayQuaHanDaiNhat > 30 ? "is-danger" : row.SoNgayQuaHanDaiNhat > 0 ? "is-warning" : "is-normal")">@row.SoNgayQuaHanDaiNhat ngày</span></td></tr> }
            @if (Model.Rows.Count == 0) { <tr class="debt-empty"><td colspan="6">Không có phòng đang nợ theo bộ lọc này.</td></tr> }
            </tbody><tfoot><tr><th colspan="3">TỔNG KẾT KẾT QUẢ ĐANG LỌC</th><th>@Model.TotalInvoices hóa đơn</th><th>@Model.TotalOutstanding.ToString("N0") đ</th><th>—</th></tr></tfoot>
        </table></div>
    </section>
</div>
@section Scripts {
<script>
(() => { const search = document.getElementById('debt-search'); if (!search) return; search.addEventListener('input', () => { const q = search.value.trim().toLocaleLowerCase('vi'); document.querySelectorAll('#debt-rows tr[data-search]').forEach(row => row.hidden = !row.dataset.search.includes(q)); }); })();
</script>
}
