@model QL_PhongTro.ViewModels.CongNoIndexViewModel
@{ ViewData["Title"] = "Công nợ theo phòng"; }
<div class="container-fluid py-4">
<div class="d-flex justify-content-end mb-3"><a class="btn btn-outline-dark" href="@Url.Action("ExportCsv", "Modules", new { toaNhaId = Model.ToaNhaId, quaHanTu = Model.QuaHanTu, quaHanDen = Model.QuaHanDen, tienTu = Model.TienTu, tienDen = Model.TienDen })">Xuất CSV</a></div>
<h1 class="h2 mb-1">Công nợ theo phòng</h1><p class="text-muted">Theo dõi số tiền còn thiếu và mức độ quá hạn theo từng phòng.</p>
<form method="get" action="/CongNo" class="card card-body mb-4"><div class="row align-items-end g-3"><div class="col-md-3"><label class="form-label">Tòa nhà</label><select class="form-select" name="toaNhaId"><option value="">Tất cả tòa nhà</option>@foreach(var b in Model.Buildings){<option value="@b.Id" selected="@(Model.ToaNhaId == b.Id)">@b.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Quá hạn từ</label><input class="form-control" type="number" min="0" name="quaHanTu" value="@Model.QuaHanTu" /></div><div class="col-md-2"><label class="form-label">Quá hạn đến</label><input class="form-control" type="number" min="0" name="quaHanDen" value="@Model.QuaHanDen" /></div><div class="col-md-2"><label class="form-label">Tiền thiếu từ</label><input class="form-control" type="number" min="0" name="tienTu" value="@Model.TienTu" /></div><div class="col-md-2"><label class="form-label">Tiền thiếu đến</label><input class="form-control" type="number" min="0" name="tienDen" value="@Model.TienDen" /></div><div class="col-md-auto"><button class="btn btn-dark">Áp dụng bộ lọc</button></div></div><div class="small text-muted mt-2">Ngày là số nguyên không âm; tiền tính theo VND. Để trống nghĩa là không giới hạn.</div></form>
<div class="card"><div class="card-header bg-white"><h2 class="h5 mb-0">Danh sách công nợ</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Phòng</th><th>Tòa nhà</th><th>Người đứng tên</th><th>HĐ chưa trả hết</th><th>Tổng còn thiếu</th><th>Quá hạn dài nhất</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><strong>@row.MaPhong</strong></td><td>@row.TenToaNha</td><td>@row.NguoiDungTen</td><td>@row.SoHoaDonChuaTraHet</td><td>@row.TongConThieu.ToString("N0") đ</td><td>@row.SoNgayQuaHanDaiNhat ngày</td></tr>}@if(Model.Rows.Count == 0){<tr><td colspan="6" class="text-center text-muted py-4">Không có phòng đang nợ.</td></tr>}</tbody><tfoot><tr class="table-warning"><th colspan="3">TỔNG KẾT QUẢ ĐANG LỌC</th><th>@Model.TotalInvoices hóa đơn</th><th>@Model.TotalOutstanding.ToString("N0") đ</th><th>-</th></tr></table></div></div>
</div>
