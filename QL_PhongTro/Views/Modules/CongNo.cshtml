@model QL_PhongTro.ViewModels.CongNoIndexViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Công nợ";
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    string Money(long n) => n.ToString("N0", vn) + " đ";
    string Link(int page) => Url.Action("CongNo", new { Model.ToaNhaId, Model.QuaHanTu, Model.QuaHanDen, Model.TienTu, Model.TienDen, Model.TimKiem, Model.SapXep, Model.TinhTrang, Model.PageSize, page })!;
    var export = Url.Action("ExportCsv", new { Model.ToaNhaId, Model.QuaHanTu, Model.QuaHanDen, Model.TienTu, Model.TienDen, Model.TimKiem, Model.SapXep, Model.TinhTrang });
    var longest = Model.Rows.Select(x => x.SoNgayQuaHanDaiNhat).DefaultIfEmpty().Max();
}
@section Styles { <link rel="stylesheet" href="~/css/debt-dashboard.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/debt-dashboard.js" asp-append-version="true"></script> }
<div class="debt-page">
<header class="debt-heading"><div><h1>Công nợ theo phòng và tòa nhà</h1><p>Theo dõi số tiền còn thiếu và ưu tiên các phòng cần thu hôm nay.</p></div><div><button type="button" class="btn btn-outline-dark" data-debt-export="@export" disabled="@Model.LocLoi">↓ Xuất CSV</button><small>UTF-8 · Giữ nguyên bộ lọc đang áp dụng</small></div></header>
<p data-debt-status role="status" aria-live="polite" hidden></p>
<form method="get" action="/CongNo" class="debt-card debt-filters" data-debt-filter>
<h2>Bộ lọc công nợ</h2><div asp-validation-summary="All" class="debt-errors" role="alert"></div>
<div class="debt-filter-grid">
<label>Tòa nhà<select class="form-select" name="toaNhaId"><option value="">Tất cả tòa nhà</option>@foreach(var b in Model.Buildings){<option value="@b.Id" selected="@(Model.ToaNhaId == b.Id)">@b.Name</option>}</select></label>
<label>Quá hạn từ @Html.TextBox("quaHanTu", Model.QuaHanTu, new { @class="form-control", inputmode="numeric", pattern="[0-9]+", placeholder="0 ngày", maxlength="10" })</label>
<label>Quá hạn đến @Html.TextBox("quaHanDen", Model.QuaHanDen, new { @class="form-control", inputmode="numeric", pattern="[0-9]+", placeholder="Không giới hạn", maxlength="10" })</label>
<label>Tiền thiếu từ @Html.TextBox("tienTu", Model.TienTu, new { @class="form-control", inputmode="numeric", pattern="[0-9]+", placeholder="0 đ", maxlength="19" })</label>
<label>Tiền thiếu đến @Html.TextBox("tienDen", Model.TienDen, new { @class="form-control", inputmode="numeric", pattern="[0-9]+", placeholder="Không giới hạn", maxlength="19" })</label>
<div class="debt-filter-buttons"><button class="btn btn-dark">Áp dụng</button><a class="btn btn-outline-secondary" href="/CongNo">Đặt lại</a></div>
</div>
<div class="debt-search-grid"><label>Tìm phòng hoặc người đứng tên<input class="form-control" type="search" name="timKiem" value="@Model.TimKiem" maxlength="100" placeholder="Nhập mã phòng hoặc tên khách..." /></label><label>Trạng thái<select class="form-select" name="tinhTrang">@foreach(var state in new[]{("TAT_CA","Tất cả"),("QUA_HAN","Quá hạn"),("CHUA_QUA_HAN","Chưa quá hạn")}){<option value="@state.Item1" selected="@(Model.TinhTrang == state.Item1)">@state.Item2</option>}</select></label><label>Sắp xếp<select class="form-select" name="sapXep">@foreach(var sort in new[]{("PHONG","Theo tòa / phòng"),("TIEN_GIAM","Còn thiếu nhiều nhất"),("TIEN_TANG","Còn thiếu ít nhất"),("QUAHAN_GIAM","Quá hạn dài nhất"),("QUAHAN_TANG","Quá hạn ít nhất")}){<option value="@sort.Item1" selected="@(Model.SapXep == sort.Item1)">@sort.Item2</option>}</select></label><label>Hiển thị<select class="form-select" name="pageSize">@foreach(var size in new[]{10,20,50}){<option value="@size" selected="@(Model.PageSize == size)">@size phòng / trang</option>}</select></label></div>
<p class="debt-help">Ngày và tiền là số nguyên không âm. Nhập tiền bằng đồng, không có dấu phân cách. Để trống nghĩa là không giới hạn.</p>
</form>
@if(Model.LocLoi){<section class="debt-card debt-empty"><h2>Chưa thể áp dụng bộ lọc</h2><p>Sửa các giá trị được báo lỗi rồi áp dụng lại. Chưa hiển thị hoặc xuất kết quả với bộ lọc sai.</p></section>}
else {
<section class="debt-stats" aria-label="Tổng quan kết quả đang lọc"><div><span>Phòng còn nợ</span><strong>@Model.Rows.Count</strong><small>@Model.TotalInvoices hóa đơn chưa trả hết</small></div><div><span>Tổng còn thiếu</span><strong>@Money(Model.TotalOutstanding)</strong><small>Theo kết quả đang lọc</small></div><div><span>Phòng quá hạn</span><strong>@Model.Rows.Count(x => x.SoNgayQuaHanDaiNhat > 0)</strong><small>Cần ưu tiên xử lý</small></div><div><span>Quá hạn lâu nhất</span><strong>@longest ngày</strong><small>@(longest > 0 ? string.Join(", ", Model.Rows.Where(x => x.SoNgayQuaHanDaiNhat == longest).Take(3).Select(x => x.MaPhong)) : "Không có phòng quá hạn")</small></div></section>
<p class="debt-rule">ⓘ Báo thanh toán đang chờ xác nhận không được tính vào đã thu. Tiền cọc đã cấn trừ được tính riêng.</p>
<div class="debt-overview"><section class="debt-card"><h2>Tổng hợp theo tòa nhà</h2><div class="debt-table-wrap"><table><thead><tr><th>Tòa nhà</th><th>Phòng còn nợ</th><th>HĐ chưa trả hết</th><th>Tổng còn thiếu</th><th>Quá hạn dài nhất</th></tr></thead><tbody>@foreach(var b in Model.Buildings.Where(x => !Model.ToaNhaId.HasValue || x.Id == Model.ToaNhaId)){var rooms=Model.Rows.Where(x=>x.ToaNhaId==b.Id).ToList();<tr><td>@b.Name</td><td>@rooms.Count</td><td>@rooms.Sum(x=>x.SoHoaDonChuaTraHet)</td><td class="debt-money">@Money(rooms.Sum(x=>x.TongConThieu))</td><td>@(rooms.Count>0 ? rooms.Max(x=>x.SoNgayQuaHanDaiNhat)+" ngày" : "—")</td></tr>}</tbody><tfoot><tr><th>TỔNG CỘNG</th><td>@Model.Rows.Count</td><td>@Model.TotalInvoices</td><th>@Money(Model.TotalOutstanding)</th><td>—</td></tr></tfoot></table></div></section>
<section class="debt-card"><h2>Ưu tiên thu hôm nay</h2><p class="debt-help">Các phòng quá hạn lâu nhất trong kết quả đang lọc.</p>@foreach(var r in Model.Rows.Where(x=>x.SoNgayQuaHanDaiNhat>0).OrderByDescending(x=>x.SoNgayQuaHanDaiNhat).ThenByDescending(x=>x.TongConThieu).Take(3)){<div class="debt-priority"><div><b>@r.MaPhong · @r.TenToaNha</b><small>@r.NguoiDungTen</small></div><div><b>@Money(r.TongConThieu)</b><small class="debt-danger">Quá hạn @r.SoNgayQuaHanDaiNhat ngày</small></div><button type="button" class="btn btn-outline-secondary btn-sm" data-debt-room="@r.PhongId">Xem công nợ</button></div>}@if(!Model.Rows.Any(x=>x.SoNgayQuaHanDaiNhat>0)){<p class="debt-empty">Không có phòng quá hạn trong kết quả đang lọc.</p>}</section></div>
<section class="debt-card"><h2>Danh sách công nợ theo phòng <span class="debt-count">@Model.Rows.Count phòng</span></h2>
@if(Model.Rows.Count==0){<div class="debt-empty" role="status"><b>Không có kết quả phù hợp</b><p>Không tìm thấy phòng còn nợ với bộ lọc này. Thử nới khoảng tiền, số ngày hoặc bỏ từ khóa.</p><a class="btn btn-outline-secondary" href="/CongNo">Bỏ bộ lọc</a></div>}
else {<div class="debt-table-wrap"><table><thead><tr><th>Phòng</th><th>Tòa nhà</th><th>Người đứng tên</th><th>HĐ chưa trả hết</th><th>Tổng còn thiếu</th><th>Quá hạn dài nhất</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var r in Model.PageRows){<tr><td><b>@r.MaPhong</b></td><td>@r.TenToaNha</td><td>@r.NguoiDungTen</td><td>@r.SoHoaDonChuaTraHet</td><td class="debt-money">@Money(r.TongConThieu)</td><td>@r.SoNgayQuaHanDaiNhat ngày</td><td><span class="debt-badge @(r.SoNgayQuaHanDaiNhat>0 ? "overdue" : "")">@(r.QuaHanNhieuKy ? "Quá hạn nhiều kỳ" : r.SoNgayQuaHanDaiNhat>0 ? "Quá hạn" : "Chưa quá hạn")</span></td><td><button type="button" class="btn btn-outline-secondary btn-sm" data-debt-room="@r.PhongId">Chi tiết</button></td></tr>}</tbody><tfoot><tr><th colspan="3">TỔNG KẾT QUẢ ĐANG LỌC</th><th>@Model.TotalInvoices hóa đơn</th><th>@Money(Model.TotalOutstanding)</th><td colspan="3">—</td></tr></tfoot></table></div>
<footer class="debt-pagination"><span>Hiển thị @((Model.Page-1)*Model.PageSize+1)–@(Math.Min(Model.Page*Model.PageSize,Model.Rows.Count)) trong @Model.Rows.Count phòng</span><nav aria-label="Phân trang công nợ">@if(Model.Page>1){<a href="@Link(Model.Page-1)" aria-label="Trang trước">‹</a>}@{var last=0;}@foreach(var p in new[]{1,Model.Page-1,Model.Page,Model.Page+1,Model.TotalPages}.Where(x=>x>=1&&x<=Model.TotalPages).Distinct().OrderBy(x=>x)){if(p-last>1){<span>…</span>}<a href="@Link(p)" aria-current="@(p==Model.Page ? "page" : null)">@p</a>last=p;}@if(Model.Page<Model.TotalPages){<a href="@Link(Model.Page+1)" aria-label="Trang sau">›</a>}</nav></footer>}
</section>}
<dialog class="debt-dialog" data-debt-dialog aria-labelledby="debt-dialog-title"><header><h2 id="debt-dialog-title">Chi tiết công nợ phòng</h2><button type="button" class="btn btn-outline-secondary" data-debt-close aria-label="Đóng chi tiết công nợ">✕</button></header><div data-debt-content></div></dialog>
</div>
