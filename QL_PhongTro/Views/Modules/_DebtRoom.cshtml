@model QL_PhongTro.ViewModels.CongNoRowViewModel
@using System.Globalization
@{var vn=CultureInfo.GetCultureInfo("vi-VN");string Money(long n)=>n.ToString("N0",vn)+" đ";}
<div class="debt-room-title"><h3>Phòng @Model.MaPhong · @Model.TenToaNha</h3><p>@Model.NguoiDungTen</p><strong>Tổng còn thiếu: @Money(Model.TongConThieu)</strong></div>
<p class="debt-rule">Chỉ liệt kê hóa đơn đã phát hành còn dư nợ. Khoản chờ xác nhận chưa tính vào đã thu.</p>
@if(Model.Invoices.Count==0){<p class="debt-empty">Phòng không còn hóa đơn phải trả.</p>}
else {<div class="debt-table-wrap"><table><thead><tr><th>Hóa đơn / Kỳ</th><th>Tổng tiền</th><th>Đã thu</th><th>Cấn cọc</th><th>Còn thiếu</th><th>Hạn thanh toán</th><th>Quá hạn</th><th>Chờ xác nhận</th></tr></thead><tbody>@foreach(var b in Model.Invoices){<tr><td><a asp-controller="HoaDonDichVu" asp-action="Details" asp-route-id="@b.Id">@b.MaHoaDon</a><small>@b.Thang.ToString("00")/@b.Nam · @b.NguoiDungTen</small></td><td class="debt-money">@Money(b.TongTien)</td><td class="debt-money">@Money(b.DaThu)</td><td class="debt-money">@Money(b.CanCoc)</td><td class="debt-money"><b>@Money(b.ConThieu)</b></td><td>@b.HanThanhToan.ToString("dd/MM/yyyy")</td><td class="@(b.SoNgayQuaHan>0 ? "debt-danger" : "")">@b.SoNgayQuaHan ngày</td><td class="debt-money">@(b.ChoXacNhan>0 ? Money(b.ChoXacNhan) : "—")</td></tr>}</tbody><tfoot><tr><th>Tổng @Model.Invoices.Count hóa đơn</th><td>@Money(Model.Invoices.Sum(x=>x.TongTien))</td><td>@Money(Model.Invoices.Sum(x=>x.DaThu))</td><td>@Money(Model.Invoices.Sum(x=>x.CanCoc))</td><th>@Money(Model.TongConThieu)</th><td colspan="2">Quá hạn lâu nhất: @Model.SoNgayQuaHanDaiNhat ngày</td><td>@Money(Model.Invoices.Sum(x=>x.ChoXacNhan))</td></tr></tfoot></table></div>}
