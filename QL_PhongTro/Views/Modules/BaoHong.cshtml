@model QL_PhongTro.Models.AppModule
@{ ViewData["Title"] = "Báo hỏng & bảo trì";
var issues = new[] { ("A.302","An Nhiên","Rò nước dưới bồn rửa","Hoàng Nam","Cao","09:10","Đang xử lý","Trần Văn Hải"), ("B.205","Mộc Mộc","Ổ cắm phát tia lửa","Thu Hà","Cao","09:00","Chờ tiếp nhận","Chưa phân công"), ("A.401","An Nhiên","Điều hòa không lạnh","Minh Khang","Vừa","08:00","Đang xử lý","Lê Quốc Huy"), ("B.103","Mộc Mộc","Khóa cửa bị kẹt","Ngọc Linh","Vừa","08:00","Chờ tiếp nhận","Chưa phân công"), ("A.201","An Nhiên","Đèn phòng nhấp nháy","Anh Thư","Thấp","07:30","Mới báo","Trần Văn Hải"), ("B.304","Mộc Mộc","Vòi sen chảy yếu","Bảo Long","Vừa","07:00","Mới báo","Nguyễn Đức An") };
}
@section Styles { <link rel="stylesheet" href="~/css/bao-hong.css" asp-append-version="true"/> }
<div class="maintenance-page">
<header class="mt-heading"><div><h1>Báo hỏng &amp; bảo trì</h1><p>Theo dõi sự cố, phối hợp xử lý và chủ động chăm sóc không gian sống.</p></div><div><button disabled>▣ Lập kế hoạch bảo trì</button><button class="mt-primary" disabled>＋ Tạo báo hỏng</button></div></header>
<div class="mt-stats">
@foreach(var stat in new[]{("Chờ tiếp nhận","05","2 báo hỏng mới hôm nay","M5 7h14v13H5zM8 7V4h8v3M9 13h6"),("Đang xử lý","07","2 sự cố cần ưu tiên cao","M14 4a6 6 0 0 0-7 7L3 17l4 4 6-4a6 6 0 0 0 7-7l-4 3-3-3 1-6Z"),("Đã hoàn tất tháng này","12","Thời gian xử lý TB: 18 ngày","M8 12l3 3 5-6M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18"),("Bảo trì sắp tới","04","Trong 10 ngày tới","M5 5h14v16H5zM8 3v4M16 3v4M5 10h14M8 14h3M8 17h6")}){<section><span class="mt-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@stat.Item4"/></svg></span><div><small>@stat.Item1</small><strong>@stat.Item2</strong><p>@stat.Item3</p></div></section>}
</div>
<div class="mt-layout"><div class="mt-main"><nav class="mt-tabs"><span>Tất cả (24)</span><span>Chờ tiếp nhận (5)</span><span>Đang xử lý (7)</span><span>Hoàn tất (12)</span></nav>
<div class="mt-filters"><input disabled placeholder="⌕ Tìm mã báo hỏng, phòng, người báo..."/><select disabled><option>Tất cả tòa nhà</option></select><select disabled><option>Mọi mức ưu tiên</option></select><select disabled><option>Tháng 10, 2026</option></select></div>
<div class="mt-warning">ⓘ 3 sự cố cần ưu tiên cao xử lý · 1 bảo hỏng đã quá hạn <span>Xem ưu tiên ›</span></div>
<section class="mt-card mt-list"><div class="mt-scroll"><table><thead><tr><th>Phòng / căn hộ</th><th>Sự cố</th><th>Người báo</th><th>Ưu tiên</th><th>Ngày gửi ↓</th><th>Trạng thái</th><th>Phụ trách</th><th></th></tr></thead><tbody>
@foreach(var issue in issues){<tr><td><strong>@issue.Item1</strong><small>@issue.Item2</small></td><td><strong>@issue.Item3</strong><small>BH-1026 · Điện nước</small></td><td>@issue.Item4<small>Người thuê</small></td><td><span class="@(issue.Item5=="Cao"?"mt-high":"")">⚑ @issue.Item5</span></td><td>@issue.Item6<small>09/10</small></td><td><span class="mt-badge @(issue.Item7=="Chờ tiếp nhận"?"gold":issue.Item7=="Mới báo"?"green":"")">• @issue.Item7</span></td><td>@issue.Item8</td><td><button disabled aria-label="Xem chi tiết">›</button></td></tr>}
</tbody></table></div><footer>Hiển thị 1–6 trong 24 báo hỏng <span>‹ <b>1</b> 2　3　4　›</span></footer></section>
<section class="mt-card mt-schedule"><header><div><h2>Bảo trì sắp tới</h2><small>4 công việc · 09–15 tháng 10, 2026</small></div><span>Xem toàn bộ lịch ›</span></header><div class="mt-events">
@foreach(var item in new[]{("09","Sửa đường nước bồn rửa","A.302 · An Nhiên · Trần Văn Hải"),("10","Vệ sinh điều hòa định kỳ","Tầng 4 · An Nhiên · Lê Quốc Huy"),("12","Kiểm tra hệ thống PCCC","Khu chung · Mộc Mộc · Đội An Phú"),("15","Bảo dưỡng máy bơm nước","Khu kỹ thuật · An Nhiên · Nguyễn Đức An")}){<article><strong>@item.Item1<small>TH.10</small></strong><div><small>HÔM NAY · 08:00–11:00</small><h3>@item.Item2</h3><p>@item.Item3</p><span class="mt-badge">• Đã xác nhận</span></div></article>}
</div></section></div>
<aside class="mt-card mt-detail"><header><h2>Chi tiết báo hỏng</h2><button disabled aria-label="Đóng chi tiết">×</button></header><div class="mt-detail-body"><small>BH-1026-168 <span class="mt-badge">• Đang xử lý</span></small><h2>Rò nước dưới bồn rửa</h2><p><span class="mt-high">• Ưu tiên cao</span>　Điện nước · Khu bếp</p><div class="mt-room">▥ <strong>Căn hộ A.302 · An Nhiên</strong><small>12 Nguyễn Du · Tầng 3</small></div><h3>Mô tả từ người thuê</h3><p>Nước rỉ liên tục ở ống thoát dưới bồn rửa bếp, làm ướt sàn và tủ. Đã khóa van tạm thời, mong được kiểm tra trong hôm nay.</p><div class="mt-photos"><span>Ảnh hiện trường</span><span>Ảnh khu bếp</span></div><div class="mt-contact"><span class="mt-avatar">HN</span><div><strong>Nguyễn Hoàng Nam</strong><small>Người thuê · 0903 *** 4567</small></div></div><div class="mt-contact-actions"><button disabled>♧ Gọi điện</button><button disabled>▢ Nhắn tin</button></div><h3>Người phụ trách</h3><select disabled><option>Trần Văn Hải · Điện nước</option></select><div class="mt-appointment"><small>HÔM NAY · 09/10/2026</small><strong>14:00 – 15:00</strong><p>Đã hẹn với người thuê, chuẩn bị vật tư sửa chữa.</p></div><h3>Lịch sử xử lý</h3><ol class="mt-timeline"><li><small>09:10</small><strong>Đã xác minh lịch sửa chữa</strong><p>Người thuê có mặt lúc 14:00.</p></li><li><small>08:45</small><strong>Phân công Trần Văn Hải</strong><p>Đang xử lý sự cố điện nước.</p></li><li><small>08:20</small><strong>Tiếp nhận báo hỏng</strong><p>Nguyễn Hoàng Nam gửi yêu cầu.</p></li></ol><button class="mt-primary mt-wide" disabled>✓ Cập nhật trạng thái</button><div class="mt-contact-actions"><button disabled>▣ Lên lịch bảo trì</button><button disabled>▧ Ghi chú</button></div></div></aside></div>
<p class="mt-demo-note">Dữ liệu minh họa giao diện · Chức năng báo hỏng và bảo trì chưa triển khai.</p></div>
