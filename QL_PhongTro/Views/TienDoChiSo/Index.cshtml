@model QL_PhongTro.ViewModels.TienDoChiSoViewModel
@using System.Globalization
@{ViewData["Title"]="Tiến độ chốt chỉ số";var total=Model.ToaNhas.Sum(x=>x.TongPhongDangThue);var done=Model.ToaNhas.Sum(x=>x.SoPhongDaChot);var missing=Model.ToaNhas.Sum(x=>x.SoPhongConThieu);var rate=total==0?0m:100m*done/total;var locked=Model.ToaNhas.Count(x=>x.KyDaKhoa);}
<article class="mp-page mp-bootstrap" data-meter-progress>
<header class="mp-heading"><div><p class="mp-eyebrow">TÀI CHÍNH</p><h1>Tiến độ chốt chỉ số</h1><p>Theo dõi việc ghi điện, nước theo từng tòa trước khi phát hành hóa đơn.</p></div><div class="mp-heading-actions"><form asp-action="Index" method="get" class="mp-period"><label><span class="visually-hidden">Tháng</span><select class="form-select" name="thang" id="thang">@for(var month=1;month<=12;month++){<option value="@month" selected="@(Model.Thang==month)">Kỳ @month.ToString("00")</option>}</select></label><label><span class="visually-hidden">Năm</span><input class="form-control" name="nam" id="nam" type="number" min="1900" max="9998" value="@Model.Nam" required /></label><button type="submit" class="mp-button btn btn-outline-secondary">Xem</button></form><button type="button" class="mp-button btn btn-outline-secondary" data-export-progress>↥ Xuất báo cáo</button></div></header>
@if(Model.CanhBaos.Count>0){<section class="mp-alert" role="status"><span class="mp-symbol">!</span><strong>Đã đến ngày chốt kỳ · Còn @Model.CanhBaos.Sum(x=>x.SoPhongConThieu) phòng chưa hoàn tất tại @Model.CanhBaos.Count tòa nhà.</strong><button type="button" class="mp-button btn btn-outline-secondary" data-show-missing>Xem phòng còn thiếu →</button></section>}
<div class="mp-stats">@foreach(var stat in new[]{("▤","neutral","Phòng đang thuê",total.ToString(),""),("✓","green","Đã chốt đủ",done.ToString(),rate.ToString("0.#",CultureInfo.GetCultureInfo("vi-VN"))+"% toàn bộ tòa hiển thị"),("!","amber","Còn thiếu",missing.ToString(),Model.ToaNhas.Count(x=>x.SoPhongConThieu>0)+" tòa cần xử lý"),("♙","neutral","Tòa đã khóa kỳ",locked+" / "+Model.ToaNhas.Count,"")}){<section class="mp-stat @stat.Item2"><span class="mp-stat-icon">@stat.Item1</span><div><p>@stat.Item3</p><strong>@stat.Item4</strong><small>@stat.Item5</small></div></section>}</div>
<section class="mp-card card"><header class="mp-table-heading"><div><h2>Tiến độ theo tòa nhà</h2><p>Kỳ @Model.Thang.ToString("00")/@Model.Nam · Ghi chỉ số theo tháng</p></div><div class="mp-filters"><label><span class="visually-hidden">Tìm theo tên tòa nhà</span><input class="form-control" type="search" data-building-search placeholder="Tìm theo tên tòa nhà" /></label><label><span class="visually-hidden">Trạng thái kỳ</span><select class="form-select" data-building-status><option value="">Tất cả trạng thái</option><option value="missing">Đang chốt</option><option value="ready">Đã đủ chỉ số</option><option value="locked">Đã khóa</option></select></label></div><small>Cập nhật lúc: @Model.CapNhatLuc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small></header>
<div class="mp-table-wrap table-responsive"><table class="mp-table table table-hover align-middle mb-0"><thead><tr><th>Tòa nhà</th><th>Người phụ trách</th><th>Phòng đang thuê</th><th>Đã chốt chỉ số</th><th>Tiến độ</th><th>Còn thiếu</th><th>Trạng thái kỳ</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var b in Model.ToaNhas){var percent=b.TongPhongDangThue==0?0m:100m*b.SoPhongDaChot/b.TongPhongDangThue;var state=b.KyDaKhoa?"locked":b.SoPhongConThieu>0?"missing":"ready";
<tr data-building-name="@b.TenToaNha" data-state="@state" data-export-row><th scope="row"><div class="mp-building"><span aria-hidden="true">▤</span>@b.TenToaNha</div></th><td>@(b.TenQuanLy??"Chưa phân công")</td><td>@b.TongPhongDangThue</td><td>@b.SoPhongDaChot</td><td><strong>@percent.ToString("0.#",CultureInfo.GetCultureInfo("vi-VN"))%</strong><progress max="100" value="@percent.ToString(CultureInfo.InvariantCulture)" aria-label="Tiến độ @b.TenToaNha"></progress></td><td>@if(b.SoPhongConThieu>0){<a class="mp-badge amber" asp-action="PhongConThieu" asp-route-toaNhaId="@b.ToaNhaId" asp-route-nam="@Model.Nam" asp-route-thang="@Model.Thang" data-open-missing aria-label="Xem @b.SoPhongConThieu phòng còn thiếu tại @b.TenToaNha">@b.SoPhongConThieu phòng</a>}else{<span class="mp-badge green">0 · Không còn phòng thiếu</span>}</td><td><span class="mp-state @state">@(b.KyDaKhoa?"Đã khóa":b.TongPhongDangThue==0?"Không có phòng thuê":b.SoPhongConThieu>0?"Đang chốt":"Đã đủ chỉ số")</span>@if(!b.KyDaKhoa){<small class="mp-unlocked">Chưa khóa</small>}</td><td><a class="mp-button small btn btn-outline-secondary" asp-action="PhongConThieu" asp-route-toaNhaId="@b.ToaNhaId" asp-route-nam="@Model.Nam" asp-route-thang="@Model.Thang" data-open-missing>@(b.KyDaKhoa?"Chỉ xem":"Xem chi tiết")</a></td></tr>}
</tbody></table></div><p class="mp-empty" data-progress-empty hidden="@(Model.ToaNhas.Count>0)">@(Model.ToaNhas.Count==0?"Bạn chưa có tòa nhà đang hoạt động.":"Không có tòa nhà phù hợp với bộ lọc.")</p><p class="mp-note">ⓘ Kỳ chỉ được khóa khi hóa đơn của tòa đã phát hành. Kỳ đã khóa không thể sửa chỉ số. Đủ chỉ số chưa đồng nghĩa đã đủ các điều kiện phát hành hóa đơn.</p></section>
<p class="mp-export-status" data-export-status role="status"></p>
<dialog class="mp-drawer" id="meter-missing-drawer" aria-labelledby="missing-rooms-title"><button type="button" class="mp-close" data-close-drawer aria-label="Đóng danh sách phòng thiếu">×</button><div data-missing-content></div><footer><button type="button" class="mp-button btn btn-outline-secondary" data-close-drawer>Đóng</button></footer></dialog>
</article>
@section Styles {<link rel="stylesheet" href="~/css/meter-progress.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/meter-missing-bootstrap.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/meter-progress-bootstrap.css" asp-append-version="true" />}
@section Scripts {<script src="~/js/meter-progress.js" asp-append-version="true"></script>}
