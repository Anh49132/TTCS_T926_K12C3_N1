@model QL_PhongTro.ViewModels.ChiTietHoaDonViewModel
@using System.Globalization
@using QL_PhongTro.Services
@using QL_PhongTro.Models
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    var bill = Model.HoaDon;
    var summary = Model.ThanhToan!;
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    var write = User.IsInRole("CHU_NHA") && await Permissions.AllowsAsync("TAI_CHINH", true);
    var issue = bill.NgayPhatHanhNghiepVu ?? DateOnly.FromDateTime((bill.NgayPhatHanh ?? bill.NgayLap).AddHours(7));
    var progress = summary.TongHoaDon > 0 ? Math.Clamp((decimal)summary.TongDaThu / summary.TongHoaDon * 100, 0, 100) : 0;
    var statusClass = summary.TrangThai == "DA_THANH_TOAN" ? "paid" : summary.TrangThai == "THANH_TOAN_MOT_PHAN" ? "partial" : summary.TrangThai == "DA_HUY" ? "canceled" : "unpaid";
}
<div class="ic-page" id="invoice-collection" data-summary-url="@Url.Action("CollectionDetails", new { id = bill.Id })" data-can-cancel="@(write && summary.HuySanSang ? "true" : "false")" data-paid="@summary.TongDaThu" data-remaining="@summary.ConPhaiTra">
@if (TempData["DraftSuccess"] is string saved) { <p class="alert alert-success" role="status">@saved</p> }
@if (TempData["DraftError"] is string failure) { <p class="alert alert-danger" role="alert">@failure</p> }
<svg class="ic-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
<symbol id="ic-document" viewBox="0 0 24 24"><path d="M6 3h9l3 3v15H6zM14 3v5h4M9 11h6M9 15h6M9 18h3"/></symbol>
<symbol id="ic-coins" viewBox="0 0 24 24"><ellipse cx="10" cy="7" rx="7" ry="3"/><path d="M3 7v4c0 4 14 4 14 0V7M3 11v4c0 4 14 4 14 0v-4M7 19c5 3 14 1 14-2V9M18 6c2 0 3 1 3 3s-2 3-4 3"/></symbol>
<symbol id="ic-wallet" viewBox="0 0 24 24"><path d="M19 7H4V5l13-2 2 4ZM4 7v13h16V7M20 11h-6v5h6M16 13.5h1"/></symbol>
<symbol id="ic-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 3"/></symbol>
<symbol id="ic-download" viewBox="0 0 24 24"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></symbol>
<symbol id="ic-receipt" viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3ZM9 7h6M9 11l2 2 4-4"/></symbol>
</defs></svg>
<a class="ic-back" asp-action="Management" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-nam="@bill.Nam" asp-route-thang="@bill.Thang">← Quay lại quản lý hóa đơn</a>
<div class="ic-notice" id="ic-success" role="status" hidden><span id="ic-success-text"></span><button type="button" aria-label="Đóng thông báo">×</button></div>
<header class="ic-heading"><div><div class="ic-title"><h1>Hóa đơn @bill.MaHoaDon</h1><span class="ic-status @statusClass" data-ic-status>@summary.TenTrangThai</span></div><p>Phòng @Model.MaPhong <span>·</span> @Model.TenKhach <span>·</span> Kỳ @bill.Thang.ToString("00")/@bill.Nam</p></div><div class="ic-actions"><button type="button" class="ic-button secondary" onclick="window.print()"><svg><use href="#ic-download"/></svg>In / lưu PDF</button>@if(write){<button type="button" class="ic-button primary" id="ic-open" hidden="@(!summary.ChoPhepGhiThu || Model.BaoCaoChoXacNhan is not null)"><svg><use href="#ic-wallet"/></svg>Ghi thu tiền</button>}</div></header>
@if(!summary.SanSang){<p class="alert alert-warning">Chức năng ghi thu chưa được cài trên CSDL này. Cần nâng cấp bằng bước v26 sau khi kiểm tra trên bản sao.</p>}
<div class="ic-stats">
<section class="ic-stat"><span class="ic-icon blue"><svg><use href="#ic-document"/></svg></span><div><span>Tổng hóa đơn</span><strong data-ic-total>@summary.TongHoaDon.ToString("N0",vn) đ</strong></div></section>
<section class="ic-stat"><span class="ic-icon green"><svg><use href="#ic-coins"/></svg></span><div><span>Tổng đã thu</span><strong data-ic-paid>@summary.TongDaThu.ToString("N0",vn) đ</strong></div></section>
<section class="ic-stat remaining"><span class="ic-icon amber"><svg><use href="#ic-wallet"/></svg></span><div><span>Còn phải trả</span><strong data-ic-remaining>@summary.ConPhaiTra.ToString("N0",vn) đ</strong></div></section>
<section class="ic-stat"><span class="ic-icon neutral"><svg><use href="#ic-clock"/></svg></span><div><span>Hạn thanh toán</span><strong>@bill.HanThanhToan.ToString("dd/MM/yyyy")</strong></div></section>
</div>
@if (Model.BaoCaoChoXacNhan is not null) { <partial name="_OwnerPaymentReview" model="Model" /> }
<div class="ic-columns"><div class="ic-main">
<section class="ic-card"><h2>Chi tiết hóa đơn</h2><div class="ic-table-wrap"><table class="ic-table"><thead><tr><th>STT</th><th>Khoản mục</th><th class="money">Đơn giá</th><th>Số lượng</th><th class="money">Thành tiền</th></tr></thead><tbody>
@foreach(var line in bill.ChiTiet.OrderBy(x=>x.SoThuTu)){
<tr><td>@line.SoThuTu</td><td>@line.TenKhoan
@if(!string.IsNullOrEmpty(line.GhiChu)){<small>@line.GhiChu</small>}
@if(line.LoaiKhoan == "DICH_VU" && line.CachTinhApDung == CachTinhDichVu.CoDinh){<small>Cố định theo phòng</small>}
else if(line.LoaiKhoan == "DICH_VU" && line.CachTinhApDung == CachTinhDichVu.TheoNguoi){<small>Khoán theo đầu người</small>}
@if(line.ChiSoDau.HasValue){<small>Chỉ số: @line.ChiSoDau?.ToString("0.###",vn) → @line.ChiSoCuoi?.ToString("0.###",vn) @line.DonViTinh</small>}
@if(line.SoNgayTinhTien.HasValue){<small>@line.SoNgayTinhTien/@line.SoNgayTrongThang ngày</small>}
</td><td class="money">@line.DonGia.ToString("N0",vn) đ</td>
<td>@(line.SoNgayTinhTien.HasValue ? $"{line.SoNgayTinhTien}/{line.SoNgayTrongThang} ngày" : $"{line.SoLuong.ToString("0.###",vn)} {(line.CachTinhApDung == CachTinhDichVu.TheoNguoi ? "người" : line.LoaiKhoan == "TIEN_PHONG" ? "tháng" : line.CachTinhApDung == CachTinhDichVu.CoDinh ? "phòng" : line.DonViTinh)}")</td>
<td class="money">@(line.LoaiKhoan=="GIAM_TRU" ? "−" : "")@line.ThanhTien.ToString("N0",vn) đ</td></tr>}
</tbody><tfoot><tr><th colspan="4">Tổng cộng</th><td class="money">@summary.TongHoaDon.ToString("N0",vn) đ</td></tr></tfoot></table></div></section>
<section class="ic-card"><h2>Lịch sử thu tiền <span id="ic-count">(@summary.LanThus.Count)</span></h2>
<div id="ic-empty" class="ic-empty" hidden="@(summary.LanThus.Count != 0)"><span class="ic-icon neutral"><svg><use href="#ic-receipt"/></svg></span><strong>Chưa có lần thu nào được ghi nhận.</strong><p>Các lần thu sẽ hiển thị tại đây sau khi xác nhận.</p></div>
<div id="ic-history" class="ic-table-wrap" hidden="@(summary.LanThus.Count == 0)"><table class="ic-table ic-history-table"><thead><tr><th>STT</th><th class="money">Số tiền</th><th>Ngày thu</th><th>Hình thức</th><th>Ghi chú</th><th>Người xác nhận</th><th>Thời điểm ghi</th><th>Thao tác</th></tr></thead><tbody id="ic-history-body">
@foreach(var receipt in summary.LanThus){<tr class="@(receipt.DaHuy ? "ic-canceled-row" : "")"><td>@(summary.LanThus.ToList().IndexOf(receipt)+1)</td><td class="money">@if(receipt.DaHuy){<del>@receipt.SoTien.ToString("N0",vn) đ</del><span class="ic-canceled-badge">Đã hủy</span>}else{<span>@receipt.SoTien.ToString("N0",vn) đ</span>}</td><td>@receipt.NgayThu.ToString("dd/MM/yyyy")</td><td><span class="ic-method">@GhiThuHoaDonService.TenHinhThuc(receipt.HinhThuc)</span></td><td>@(receipt.GhiChu ?? "—")</td><td>@receipt.NguoiXacNhan</td><td>@(receipt.ThoiDiemGhi?.AddHours(7).ToString("dd/MM/yyyy HH:mm") ?? "Chưa có thông tin")</td><td>@if(write && receipt.ChoPhepHuy){<button type="button" class="ic-cancel-button" data-cancel-id="@receipt.Id" data-cancel-version="@receipt.PhienBan" data-cancel-amount="@receipt.SoTien" data-cancel-date="@receipt.NgayThu.ToString("yyyy-MM-dd")" data-cancel-method="@receipt.HinhThuc" data-cancel-recorder="@receipt.NguoiXacNhan">Hủy lần thu</button>}else{<span>—</span>}</td></tr>
@if(receipt.DaHuy){<tr class="ic-cancel-reason"><td colspan="8"><strong>Lý do hủy:</strong> @(receipt.LyDoHuy ?? "Chưa có thông tin (dữ liệu cũ)") <span>·</span> Người hủy: @(receipt.NguoiHuy ?? "Chưa có thông tin") <span>·</span> @(receipt.ThoiDiemHuy?.AddHours(7).ToString("dd/MM/yyyy HH:mm") ?? "Chưa có thông tin")</td></tr>}}
</tbody></table></div><p class="ic-hint">ⓘ Các lần thu đã hủy không được tính vào tổng đã thu và không thể khôi phục.</p></section>
<partial name="_Cancellation" model="Model" />
<partial name="_DraftHistory" model="Model.LichSuNhap" />
<partial name="_PaymentReportHistory" model="Model" />

</div><aside>
<section class="ic-card"><h2>Tiến độ thanh toán</h2><div class="ic-progress" role="progressbar" aria-label="Tỉ lệ đã thu" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress.ToString("0",CultureInfo.InvariantCulture)"><div id="ic-progress-fill" style="width:@progress.ToString("0.##",CultureInfo.InvariantCulture)%">@progress.ToString("0",vn)%</div></div><div class="ic-progress-labels"><div><span>Đã thu</span><strong><span data-ic-paid>@summary.TongDaThu.ToString("N0",vn) đ</span> / <span data-ic-total>@summary.TongHoaDon.ToString("N0",vn) đ</span></strong></div><div><span>Còn</span><strong class="ic-debt" data-ic-remaining>@summary.ConPhaiTra.ToString("N0",vn) đ</strong></div></div></section>
<section class="ic-card"><h2>Thông tin hóa đơn</h2><dl class="ic-info"><div><dt>Khách thuê</dt><dd>@Model.TenKhach</dd></div><div><dt>Phòng</dt><dd>@Model.MaPhong</dd></div><div><dt>Tòa nhà</dt><dd>@Model.TenToaNha</dd></div><div><dt>Ngày phát hành</dt><dd>@issue.ToString("dd/MM/yyyy")</dd></div><div><dt>Hạn thanh toán</dt><dd>@bill.HanThanhToan.ToString("dd/MM/yyyy")</dd></div></dl></section>
<p class="ic-permission">▣ Chỉ chủ nhà sở hữu hóa đơn có quyền tài chính mới được ghi thu.</p>
</aside></div>
@if(write && summary.SanSang){
<dialog class="ic-dialog" id="ic-dialog" aria-labelledby="ic-dialog-title"><div class="ic-dialog-header"><div><h2 id="ic-dialog-title">Ghi thu tiền</h2><p>Hóa đơn @bill.MaHoaDon <span>·</span> Phòng @Model.MaPhong</p></div><button type="button" class="ic-close" data-ic-close aria-label="Đóng biểu mẫu">×</button></div>
<div class="ic-modal-stats"><div><span>Tổng hóa đơn</span><strong data-ic-total>@summary.TongHoaDon.ToString("N0",vn) đ</strong></div><div><span>Đã thu</span><strong data-ic-paid>@summary.TongDaThu.ToString("N0",vn) đ</strong></div><div><span>Còn phải trả</span><strong data-ic-remaining>@summary.ConPhaiTra.ToString("N0",vn) đ</strong></div></div>
<form id="ic-form" asp-action="Collect" method="post" novalidate data-today="@Model.HomNay.ToString("yyyy-MM-dd")" data-remaining="@summary.ConPhaiTra">
<input type="hidden" name="HoaDonId" value="@bill.Id"/><input type="hidden" name="KhoaChongTrung" value="@Guid.NewGuid().ToString("N")"/>
<div id="ic-form-error" class="ic-form-error" role="alert" hidden></div>
<div class="ic-field"><label for="ic-amount">Số tiền thu <em>*</em></label><div><div class="ic-amount"><input id="ic-amount" name="SoTien" inputmode="numeric" autocomplete="off" value="@summary.ConPhaiTra.ToString("N0",vn)" aria-describedby="ic-error-SoTien ic-amount-hint" required/><span>đ</span></div><p class="ic-error" id="ic-error-SoTien"></p><small id="ic-amount-hint">Tối đa <span data-ic-remaining>@summary.ConPhaiTra.ToString("N0",vn) đ</span>, chỉ nhập số nguyên.</small></div></div>
<div class="ic-field"><label for="ic-date">Ngày thu <em>*</em></label><div><input id="ic-date" type="date" name="NgayThu" value="@Model.HomNay.ToString("yyyy-MM-dd")" min="@Model.HomNay.AddDays(-30).ToString("yyyy-MM-dd")" max="@Model.HomNay.ToString("yyyy-MM-dd")" aria-describedby="ic-error-NgayThu" required/><p class="ic-error" id="ic-error-NgayThu"></p><small>Từ @Model.HomNay.AddDays(-30).ToString("dd/MM/yyyy") đến @Model.HomNay.ToString("dd/MM/yyyy").</small></div></div>
<div class="ic-field"><label for="ic-method">Hình thức thu <em>*</em></label><div><select id="ic-method" name="HinhThuc" aria-describedby="ic-error-HinhThuc" required><option value="">Chọn hình thức thu</option><option value="TIEN_MAT">Tiền mặt</option><option value="CHUYEN_KHOAN" selected>Chuyển khoản</option><option value="KHAC">Khác</option></select><p class="ic-error" id="ic-error-HinhThuc"></p></div></div>
<div class="ic-field"><label for="ic-note">Ghi chú</label><div><textarea id="ic-note" name="GhiChu" maxlength="255" rows="3" placeholder="Nhập nội dung đối chiếu, mã giao dịch…" aria-describedby="ic-error-GhiChu"></textarea><small class="ic-note-count"><span id="ic-note-length">0</span>/255</small><p class="ic-error" id="ic-error-GhiChu"></p></div></div>
<div class="ic-actor">▣ Người xác nhận <span>|</span> <strong>@Model.TenNguoiGhiThu</strong></div>
<footer class="ic-dialog-footer"><small>ⓘ Mỗi lần xác nhận chỉ được ghi một lần.</small><button type="button" class="ic-button secondary" data-ic-close>Quay lại</button><button type="submit" class="ic-button primary" id="ic-submit">Xác nhận ghi thu</button></footer>
</form></dialog>}
@if(write && summary.HuySanSang){<partial name="_CancelCollection" model="Model"/>}
</div>
