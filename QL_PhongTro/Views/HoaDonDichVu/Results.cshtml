@model QL_PhongTro.ViewModels.KetQuaPhatHanhThang
@using System.Globalization
@{
    ViewData["Title"] = Model.LaPhatHanh ? "Phát hành hóa đơn hoàn tất" : "Tạo hóa đơn Nháp hoàn tất";
    if(Model.LaPhatHanh && Model.SoThatBai>0) ViewData["Title"]="Kết quả phát hành hóa đơn";
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    string Status(QL_PhongTro.ViewModels.KetQuaPhongHoaDon row) => row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? "Đã lưu" : row.TrangThai == "DA_CO_HOA_DON" ? "Đã có hóa đơn" : row.ThieuChiSo ? "Thiếu chỉ số" : row.TrangThai == "KHONG_CHON" ? "Không chọn" : row.TrangThai=="THAT_BAI" ? "Thất bại" : "Bị bỏ qua";
    string Group(QL_PhongTro.ViewModels.KetQuaPhongHoaDon row) => row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? "issued" : row.TrangThai == "DA_CO_HOA_DON" ? "existing" : row.ThieuChiSo ? "missing" : "other";
}
@section Styles { <link rel="stylesheet" href="~/css/invoice-flow.css" asp-append-version="true" /> <link rel="stylesheet" href="~/css/monthly-invoices.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/invoice-review.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/invoice-results.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/invoice-results.js" asp-append-version="true"></script> }
<div class="monthly-invoices invoice-results">
<nav class="mi-breadcrumb" aria-label="Đường dẫn"><a asp-controller="Home" asp-action="Index">Tổng quan</a> / Hóa đơn, thanh toán / Tạo hóa đơn Nháp</nav>
<header class="mi-heading"><div><h1>@ViewData["Title"]</h1><p>Kỳ tháng @Model.Thang.ToString("00")/@Model.Nam · @Model.TenToaNha</p></div></header>
<section class="ir-banner @(Model.SoThatBai>0 ? "ir-failed" : "")" role="status"><span class="ir-success-icon">@(Model.SoThatBai>0 ? "!" : "✓")</span><div><h2>@(Model.SoDaTao > 0 ? $"{(Model.LaPhatHanh ? "Đã phát hành" : "Đã tạo nháp")} {Model.SoDaTao} hóa đơn" : "Đã kiểm tra lại kỳ hóa đơn")</h2><p>Hoàn tất trong <strong id="run-duration">@Model.SoGiay.ToString("N2",vn)</strong> giây · @Model.SoDaCoHoaDon phòng đã có hóa đơn được giữ nguyên.</p></div><div class="ir-actions"><a href="#issue-results" class="btn btn-dark">▤ Xem danh sách hóa đơn</a><a asp-action="ExportResults" asp-route-runId="@Model.MaLanChay" class="btn btn-outline-secondary">↓ Tải báo cáo kết quả</a></div></section>
@if(Model.LaPhatHanh){<div class="alert alert-info">@(Model.SoThatBai>0 ? "Đợt phát hành chưa thành công; các bản nháp được giữ nguyên. Xem lý do ở bảng kết quả." : "Đã tạo thông báo trong ứng dụng cho khách. Email được xử lý theo cấu hình gửi thư.")</div><div class="flow-metrics"><div class="mi-card"><span>Thành công</span><strong>@Model.SoDaPhatHanh</strong></div><div class="mi-card"><span>Bị bỏ qua</span><strong>@(Model.Phongs.Count-Model.SoDaPhatHanh-Model.SoThatBai)</strong></div><div class="mi-card"><span>Thất bại</span><strong>@Model.SoThatBai</strong></div><div class="mi-card"><span>Thời gian xử lý</span><strong>@Model.SoGiay.ToString("N2",vn) giây</strong></div></div>}
<div class="mr-summary ir-summary">
<div class="mr-metric"><span>@(Model.LaPhatHanh ? "✓ Phát hành thành công" : "▤ Tạo nháp thành công")</span><strong id="issued-count">@Model.SoDaTao</strong><small>Hóa đơn mới của lần chạy này</small></div>
<div class="mr-metric"><span>⚠ Thiếu chỉ số</span><strong id="missing-count">@Model.SoThieuChiSo</strong><small>Không tạo hóa đơn thiếu dữ liệu</small></div>
<div class="mr-metric"><span>▤ Đã có hóa đơn</span><strong id="existing-count">@Model.SoDaCoHoaDon</strong><small>Không tạo thêm khi chạy lại</small></div>
<div class="mr-metric mr-highlight"><span>◎ Tổng tiền mới cần thu</span><strong>@Model.TongTien.ToString("N0",vn) đ</strong><small>@(Model.LaPhatHanh ? "Chỉ cộng hóa đơn phát hành thành công" : "Chỉ cộng hóa đơn mới tạo nháp")</small></div>
<div class="mr-metric"><span>▦ Hạn thanh toán</span><strong>@Model.HanThanhToan.ToString("dd/MM/yyyy")</strong><small>Áp dụng cho hóa đơn mới</small></div>
</div>
<div class="mr-columns"><section class="mi-card" id="issue-results"><h2>Kết quả từng phòng</h2>
<nav class="mr-tabs ir-tabs" aria-label="Kết quả tạo nháp"><button type="button" data-result-tab="issued" aria-selected="true">@(Model.LaPhatHanh ? "Đã phát hành" : "Đã tạo nháp") (@Model.SoDaTao)</button><button type="button" data-result-tab="missing" aria-selected="false">Thiếu chỉ số (@Model.SoThieuChiSo)</button><button type="button" data-result-tab="existing" aria-selected="false">Đã có hóa đơn (@Model.SoDaCoHoaDon)</button><button type="button" data-result-tab="other" aria-selected="false">@(Model.LaPhatHanh ? "Kết quả khác / Thất bại" : "Bỏ qua khác") (@Model.SoBoQuaKhac)</button></nav>
<div class="mr-filters ir-filters"><input id="result-search" class="form-control" placeholder="Tìm phòng, khách thuê..." aria-label="Tìm phòng, khách thuê" /><select id="result-floor" class="form-select" aria-label="Lọc tầng"><option value="">Tất cả tầng</option>@foreach(var floor in Model.Phongs.Where(x=>x.TrangThai is "DA_PHAT_HANH" or "NHAP").Select(x=>x.Tang).Distinct().OrderBy(x=>x)){<option value="@floor">Tầng @floor</option>}</select></div>
<div class="table-responsive"><table class="table mr-table ir-table" id="result-table"><thead><tr><th>Hóa đơn</th><th>Phòng / Khách thuê</th><th>Ngày phát hành dự kiến</th><th>Hạn thanh toán</th><th>Tổng tiền mới</th><th>Kết quả / Lý do</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var row in Model.Phongs){<tr data-group="@Group(row)" data-room="@row.MaPhong" data-tenant="@row.TenKhach" data-floor="@(row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? row.Tang.ToString() : "")"><td class="ir-invoice-code">@(string.IsNullOrEmpty(row.MaHoaDon) ? "—" : row.MaHoaDon)</td><th scope="row">@row.MaPhong<small>@row.TenKhach</small></th><td>@(row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? Model.NgayPhatHanh.ToString("dd/MM/yyyy") : "—")</td><td>@(row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? Model.HanThanhToan.ToString("dd/MM/yyyy") : "—")</td><td><strong>@(row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? row.TongTien.ToString("N0",vn)+" đ" : "—")</strong></td><td><span class="@(row.TrangThai is "DA_PHAT_HANH" or "NHAP" ? "mr-status" : row.TrangThai=="DA_CO_HOA_DON" ? "ir-existing" : "mr-reason")">@Status(row)</span><small class="ir-reason">@row.LyDo</small></td><td>@if(row.HoaDonId.HasValue){<a asp-action="Details" asp-route-id="@row.HoaDonId">Xem</a>}</td></tr>}
</tbody></table></div><p id="result-empty" hidden>Không có phòng trong nhóm kết quả này.</p><div class="mr-pagination"><span id="result-page-info"></span><div id="result-pages"></div></div></section>
<aside><section class="mi-card"><h2>Phòng bị bỏ qua</h2><dl class="mr-skipped-list">@foreach(var row in Model.Phongs.Where(x=>x.TrangThai is not ("DA_PHAT_HANH" or "NHAP")).Take(6)){<dt>@row.MaPhong</dt><dd>@row.LyDo @if(row.HoaDonId.HasValue){<a asp-action="Details" asp-route-id="@row.HoaDonId">Xem hóa đơn</a>}</dd>}</dl><p class="mi-muted">@Model.SoThieuChiSo thiếu chỉ số · @Model.SoDaCoHoaDon đã có hóa đơn · @Model.SoBoQuaKhac bỏ qua khác.</p><a asp-action="Monthly" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-nam="@Model.Nam" asp-route-thang="@Model.Thang" class="btn btn-outline-secondary ir-full">Kiểm tra lại dữ liệu</a></section>
<section class="mi-card"><h2>Thông tin lần chạy</h2><dl class="mr-period-info"><dt>Mã lần chạy</dt><dd class="ir-run-id">BR-@Model.Nam@Model.Thang.ToString("00")-@Model.MaLanChay[..8]</dd><dt>Bắt đầu</dt><dd>@Model.BatDauUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")</dd><dt>Hoàn tất</dt><dd>@Model.HoanTatUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")</dd><dt>Thời gian</dt><dd>@Model.SoGiay.ToString("N2",vn) giây</dd><dt>Người thực hiện</dt><dd>@Model.NguoiThucHien</dd><dt>Ngày phát hành dự kiến</dt><dd>@Model.NgayPhatHanh.ToString("dd/MM/yyyy")</dd></dl><div class="ir-protection"><strong>✓ Chống tạo trùng</strong><p>Chạy lại kỳ tháng @Model.Thang.ToString("00")/@Model.Nam giữ nguyên hóa đơn hiện có và chỉ tạo nháp cho phòng mới đủ dữ liệu.</p></div><p class="mi-muted">Báo cáo lần chạy có thể tải trong 24 giờ khi máy chủ đang hoạt động. Hóa đơn được lưu lâu dài.</p></section></aside></div>
<a asp-action="Management" class="btn btn-dark">← Về quản lý hóa đơn</a><footer class="mi-footer"><span>Đã tạo nháp @Model.SoDaTao · Thiếu chỉ số @Model.SoThieuChiSo · Đã có hóa đơn @Model.SoDaCoHoaDon</span><div class="ir-actions"><a asp-action="Monthly" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-nam="@Model.Nam" asp-route-thang="@Model.Thang" asp-route-ngayPhatHanh="@Model.NgayPhatHanh.ToString("yyyy-MM-dd")" asp-route-hanThanhToan="@Model.HanThanhToan.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary" id="retry-period">Kiểm tra và chạy lại kỳ này</a><a asp-action="Monthly" asp-route-toaNhaId="@Model.ToaNhaId" class="btn btn-dark">Tạo nháp kỳ khác</a></div></footer>
</div>
