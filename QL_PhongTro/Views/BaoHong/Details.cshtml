@model QL_PhongTro.ViewModels.BaoHongChiTiet
@{
    ViewData["Title"] = Model.BaoHong.MaBaoHong;
    var controller = Model.LaQuanLy ? "QuanLyBaoHong" : Model.LaChuNha ? "ChuNhaBaoHong" : "BaoHong";
    if (TempData["BaoHongSuccess"] is string message)
    {
        ViewData["ToastSuccess"] = message;
        ViewData["ToastPersistent"] = true;
    }
}
@section Styles { <link rel="stylesheet" href="~/css/tenant-repairs.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/repair-cost.js" asp-append-version="true" defer></script> }
<div class="repairs-page">
<a asp-controller="@controller" asp-action="Index" asp-all-route-data="@((ViewData["BaoHongBoLoc"] as QL_PhongTro.ViewModels.BaoHongBoLoc)?.RouteValues())">← @(Model.LaQuanLy ? "Báo hỏng được phân công" : Model.LaChuNha ? "Báo hỏng tại tòa nhà của tôi" : "Báo hỏng của tôi")</a>
<header><h1>@Model.BaoHong.MaBaoHong</h1><p>Chi tiết báo hỏng</p></header>
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
@if (Model.LaQuanLy && Model.CanhBaoQuaHan is { } warning) {
    <partial name="~/Views/BaoHong/_CanhBaoQuaHan.cshtml" model="warning" />
}
<section class="repairs-card">
<span class="repairs-status">@QL_PhongTro.Services.BaoHongService.TenTrangThai(Model.BaoHong.TrangThai)</span>
<dl><dt>Phòng</dt><dd>@Model.MaPhong · @Model.TenToaNha</dd>
<dt>Hợp đồng</dt><dd>@Model.MaHopDong</dd>
<dt>Người gửi</dt><dd>@Model.TenNguoiBao</dd>
<dt>Loại thiết bị</dt><dd>@Model.BaoHong.LoaiThietBi</dd>
<dt>Mức độ</dt><dd>@(Model.BaoHong.MucDo == "GAP" ? "Gấp" : "Thường")</dd>
<dt>Thời điểm gửi</dt><dd>@Model.BaoHong.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</dd>
<dt>Mô tả sự cố</dt><dd class="repairs-description">@Model.BaoHong.MoTa</dd></dl>
@if (Model.Images.Count > 0) {
<h2>Ảnh thiết bị</h2><div class="repair-photos">
@foreach (var photo in Model.Images) {
<a asp-controller="@controller" asp-action="Image" asp-route-id="@Model.BaoHong.Id" asp-route-order="@photo.ThuTu" target="_blank" rel="noopener"><img src="@Url.Action("Image", controller, new { id = Model.BaoHong.Id, order = photo.ThuTu })" alt="Ảnh thiết bị @photo.ThuTu" loading="lazy" /><span>Mở ảnh @photo.ThuTu</span></a>
}
</div> }
</section>
<partial name="~/Views/BaoHong/_TraoDoi.cshtml" model="Model" />
<partial name="~/Views/BaoHong/_ChiPhi.cshtml" model="Model" />
@if (Model.LaQuanLy) { <partial name="~/Views/BaoHong/_QuanLyXuLy.cshtml" model="Model" /> }
</div>
