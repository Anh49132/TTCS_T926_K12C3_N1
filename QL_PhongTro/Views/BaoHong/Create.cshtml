@model QL_PhongTro.ViewModels.TaoBaoHongViewModel
@{ViewData["Title"]="Gửi báo hỏng";}
@section Styles {<link rel="stylesheet" href="~/css/tenant-repairs.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/repair-upgrade.css" asp-append-version="true"/>}
@section Scripts {<script src="~/js/repair-images.js" asp-append-version="true"></script><script src="~/js/repair-create.js" asp-append-version="true"></script>}
<div class="repairs-page repair-create"><nav class="ru-breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-action="Index">Báo hỏng của tôi</a><span>›</span><span>Gửi báo hỏng</span></nav><a asp-action="Index" class="ru-back">← Quay lại danh sách</a><header><h1>Gửi báo hỏng</h1><p>Báo sự cố cho phòng bạn đang thuê để quản lý xử lý và phản hồi.</p></header>
@if(Model.Phongs.Count==0){<section class="repairs-card"><h2>Chưa có phòng đủ điều kiện</h2><p>Bạn cần là người đứng tên hoặc người ở ghép đang ở theo hợp đồng còn hiệu lực để gửi báo hỏng.</p><a asp-controller="HopDongCuaToi" asp-action="Index">Xem hợp đồng của tôi</a></section>}
else {<div class="ru-create-grid"><form asp-action="Create" method="post" enctype="multipart/form-data" class="repairs-card ru-create-form" data-repair-create><h2>Thông tin sự cố</h2><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input asp-for="Input.KhoaChongTrung" type="hidden"/>
<label asp-for="Input.HopDongId">Phòng đang thuê <span>*</span></label><select asp-for="Input.HopDongId" required><option value="">Chọn phòng và hợp đồng</option>@foreach(var r in Model.Phongs){<option value="@r.HopDongId" data-room="@r.MaPhong" data-building="@r.TenToaNha">@r.MaPhong · @r.TenToaNha · @r.MaHopDong · Đang hiệu lực</option>}</select><span asp-validation-for="Input.HopDongId" class="text-danger"></span>
<div class="ru-create-fields"><div><label asp-for="Input.LoaiThietBi">Loại thiết bị <span>*</span></label><input asp-for="Input.LoaiThietBi" list="repair-devices" maxlength="100" required placeholder="Chọn hoặc nhập loại thiết bị"/><datalist id="repair-devices"><option value="Vòi nước"/><option value="Điều hòa"/><option value="Ổ điện"/><option value="Đèn"/><option value="Bồn cầu"/><option value="Cửa / khóa cửa"/></datalist><span asp-validation-for="Input.LoaiThietBi" class="text-danger"></span></div><fieldset class="ru-severity"><legend>Mức độ khẩn <span>*</span></legend><div><label><input asp-for="Input.MucDo" id="repair-normal" type="radio" value="THUONG" required/><span><b>Thường</b><small>Có thể chờ sắp xếp</small></span></label><label><input asp-for="Input.MucDo" id="repair-urgent" type="radio" value="GAP"/><span><b>Gấp</b><small>Ảnh hưởng sinh hoạt hoặc có nguy cơ mất an toàn</small></span></label></div><span asp-validation-for="Input.MucDo" class="text-danger"></span></fieldset></div>
<label asp-for="Input.MoTa">Mô tả sự cố <span>*</span></label><textarea asp-for="Input.MoTa" rows="5" maxlength="5000" required placeholder="Nêu rõ vị trí, biểu hiện và thời điểm phát hiện."></textarea><div class="ru-field-help"><span>Nêu rõ vị trí, biểu hiện và thời điểm phát hiện.</span><span data-description-count>0/5000</span></div><span asp-validation-for="Input.MoTa" class="text-danger"></span>
<label for="repair-images">Ảnh thiết bị (không bắt buộc)</label><div class="ru-field-help"><span id="repair-image-help">Tối đa 3 ảnh JPG/JPEG hoặc PNG; mỗi ảnh ≤ 5 MiB (5.242.880 byte).</span><span data-repair-image-count>0/3 ảnh</span></div><label class="ru-upload-zone" data-repair-drop for="repair-images"><span aria-hidden="true">▧</span>Kéo thả ảnh hoặc chọn từ thiết bị<input id="repair-images" type="file" name="Input.Images" accept=".jpg,.jpeg,.png" multiple aria-describedby="repair-image-help repair-image-error"/></label><span asp-validation-for="Input.Images" class="text-danger"></span><p id="repair-image-error" class="text-danger" role="alert"></p><div id="repair-image-preview" class="repair-photos"></div>
<div class="repairs-actions ru-submit"><small>Hệ thống tạo mã BH-yyyyMM-xxxx và đặt trạng thái Mới.</small><a asp-action="Index">Hủy</a><button type="submit">Gửi báo hỏng</button></div></form>
<aside><section class="repairs-card ru-summary"><h2>Tóm tắt báo hỏng</h2><dl><div><dt>Phòng</dt><dd data-summary-room>Chưa chọn</dd></div><div><dt>Tòa nhà</dt><dd data-summary-building>Chưa chọn</dd></div><div><dt>Thiết bị</dt><dd data-summary-device>Chưa nhập</dd></div><div><dt>Mức độ</dt><dd data-summary-priority>Thường</dd></div><div><dt>Ảnh đính kèm</dt><dd data-summary-images>0/3</dd></div><div><dt>Trạng thái dự kiến</dt><dd><span class="ru-badge">Mới</span></dd></div></dl><p class="ru-note">Sau khi gửi, theo dõi trạng thái và phản hồi của quản lý trong Chi tiết báo hỏng.</p></section><section class="repairs-card"><h2>Khi nào chọn Gấp?</h2><ul class="ru-help-list"><li>Rò nước lớn hoặc nguy cơ ngập.</li><li>Sự cố điện, mùi khét hoặc nguy cơ mất an toàn.</li><li>Thiết bị thiết yếu ngừng hoạt động.</li></ul></section><section class="repairs-card"><h2>Quyền riêng tư</h2><p class="ru-muted">Ảnh chỉ được truy cập qua kiểm tra quyền để xử lý sự cố của phòng. Không gửi giấy tờ hoặc thông tin tài khoản trong ảnh.</p></section></aside></div>}
</div>
