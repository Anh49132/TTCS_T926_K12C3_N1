@model List<QL_PhongTro.ViewModels.BaoHongChiTiet>
@{
    var owner = ViewData["LaChuNha"] is true;
    ViewData["Title"] = owner ? "Báo hỏng tại tòa nhà của tôi" : "Báo hỏng của tôi";
    var page = (int)(ViewData["Page"] ?? 1);
    var reports = Model.Take(20).ToList();
    var paged = page > 1 || Model.Count > 20;
    var states = new[] { (Code: "MOI", Name: "Mới", Class: "new"), (Code: "DANG_XU_LY", Name: "Đang xử lý", Class: "progress"),
        (Code: "HOAN_THANH", Name: "Hoàn thành", Class: "done"), (Code: "TU_CHOI", Name: "Từ chối", Class: "rejected") };
}
<div class="tenant-repair-list @(owner ? "owner-repair-list" : "")" data-tenant-repairs>
    <svg class="trl-symbols" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
        <symbol id="trl-clipboard" viewBox="0 0 24 24"><rect x="6" y="5" width="12" height="16" rx="2"/><path d="M9 5V3h6v2M9 10h6M9 14h6M9 18h4"/></symbol>
        <symbol id="trl-tool" viewBox="0 0 24 24"><path d="M14 4a5 5 0 0 0-6 6l-5 5a2 2 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3 3-3Z"/></symbol>
        <symbol id="trl-search-icon" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></symbol>
    </defs></svg>
    @if (!owner) { <nav class="trl-breadcrumb" aria-label="Đường dẫn điều hướng"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span aria-hidden="true">›</span><span aria-current="page">@(owner ? "Báo hỏng tại tòa nhà của tôi" : "Báo hỏng của tôi")</span></nav> }
    <header class="trl-heading"><div><h1>@ViewData["Title"]</h1><p>@(owner ? "Theo dõi tiến độ tại các tòa nhà bạn hiện sở hữu." : "Xem lại các sự cố bạn đã gửi.")</p></div>@if (!owner) { <a class="trl-create" asp-action="Create"><span aria-hidden="true">＋</span> Gửi báo hỏng</a> }</header>
    <section class="trl-stats" aria-label="@(paged ? "Thống kê báo hỏng trên trang hiện tại" : "Thống kê báo hỏng")">
        <div class="trl-total"><span class="trl-icon" aria-hidden="true"><svg><use href="#trl-clipboard"/></svg></span><strong>@reports.Count</strong><span>báo hỏng@(paged ? " trên trang" : "")</span></div>
        @foreach (var state in states) {
            <div><span class="trl-state-icon @state.Class" aria-hidden="true"></span><span>@state.Name</span><strong>@reports.Count(x => x.BaoHong.TrangThai == state.Code)</strong></div>
        }
    </section>
    <section class="trl-panel" aria-labelledby="trl-list-title">
        <div class="trl-toolbar">
            <h2 id="trl-list-title">@(paged ? "Báo hỏng trên trang " + page : "Tất cả báo hỏng") <span>@reports.Count</span></h2>
            <form class="trl-filters" data-repair-filters hidden role="search" aria-label="Bộ lọc báo hỏng">
                <div class="trl-search"><svg aria-hidden="true"><use href="#trl-search-icon"/></svg><label class="trl-sr" for="trl-search">Tìm báo hỏng trên trang hiện tại</label><input class="form-control" id="trl-search" type="search" placeholder="Tìm mã báo hỏng, thiết bị, phòng" maxlength="200" autocomplete="off" /></div>
                <label class="trl-sr" for="trl-status">Lọc trạng thái</label><select class="form-select" id="trl-status"><option value="">Tất cả trạng thái</option>@foreach (var state in states) { <option value="@state.Code">@state.Name</option> }</select>
                <label class="trl-sr" for="trl-priority">Lọc mức độ</label><select class="form-select" id="trl-priority"><option value="">Tất cả mức độ</option><option value="GAP">Gấp</option><option value="THUONG">Thường</option></select>
                <button type="submit" class="trl-apply btn btn-dark">Áp dụng</button>
            </form>
        </div>
        @if (paged) { <p class="trl-page-note">Thống kê, tìm kiếm và bộ lọc áp dụng cho tối đa 20 báo hỏng trên trang @(page).</p> }
        <div class="trl-table-wrap">
            <table class="trl-table table table-hover align-middle mb-0"><caption class="trl-sr">Danh sách báo hỏng, trang @(page)</caption>
                <thead><tr><th scope="col">Thiết bị / Mã báo hỏng</th><th scope="col">Phòng / Tòa nhà</th><th scope="col">Trạng thái</th><th scope="col">Mức độ</th><th scope="col">Thời điểm gửi</th><th scope="col">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var row in reports) {
                    var report = row.BaoHong;
                    var stateClass = report.TrangThai switch { "MOI" => "new", "DANG_XU_LY" => "progress", "HOAN_THANH" => "done", "TU_CHOI" => "rejected", _ => "new" };
                    <tr data-repair-row data-status="@report.TrangThai" data-priority="@report.MucDo">
                        <td data-label="Thiết bị / Mã báo hỏng"><div class="trl-equipment"><span class="trl-icon" aria-hidden="true"><svg><use href="#trl-tool"/></svg></span><div><a asp-action="Details" asp-route-id="@report.Id">@report.LoaiThietBi</a><small>@report.MaBaoHong</small></div></div></td>
                        <td data-label="Phòng / Tòa nhà">@row.MaPhong · @row.TenToaNha</td>
                        <td data-label="Trạng thái"><span class="trl-badge @stateClass"><span class="trl-state-icon @stateClass" aria-hidden="true"></span>@QL_PhongTro.Services.BaoHongService.TenTrangThai(report.TrangThai)</span></td>
                        <td data-label="Mức độ"><span class="trl-priority @(report.MucDo == "GAP" ? "urgent" : "")">@(report.MucDo == "GAP" ? "Gấp" : "Thường")</span></td>
                        <td data-label="Thời điểm gửi"><time datetime="@report.NgayTao.ToString("O")">@report.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time></td>
                        <td data-label="Thao tác"><a class="trl-detail" asp-action="Details" asp-route-id="@report.Id" aria-label="Xem chi tiết @report.MaBaoHong">Xem chi tiết <span aria-hidden="true">→</span></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="trl-empty" data-repair-empty hidden="@(reports.Count > 0)"><svg aria-hidden="true"><use href="#trl-clipboard"/></svg><h3 data-empty-title>@(page == 1 ? owner ? "Chưa có báo hỏng tại tòa nhà của bạn." : "Bạn chưa gửi báo hỏng nào." : "Không có báo hỏng trên trang này.")</h3><p data-empty-help>@(page == 1 ? owner ? "Các báo hỏng của khách thuê sẽ xuất hiện tại đây." : "Khi có sự cố tại phòng đang thuê, hãy chọn Gửi báo hỏng để được hỗ trợ." : "Hãy quay lại trang trước để xem các báo hỏng đã gửi.")</p><button type="button" data-reset-filters hidden>Xóa bộ lọc</button></div>
        <footer class="trl-footer"><span role="status" aria-live="polite" data-repair-count>Hiển thị @reports.Count / @reports.Count báo hỏng@(paged ? " trên trang" : "")</span><span class="trl-filter-state" data-filter-state>Đang hiển thị tất cả@(paged ? " trên trang" : "")</span></footer>
    </section>
    @if (paged) { <nav class="trl-pagination" aria-label="Phân trang báo hỏng">@if (page > 1) { <a asp-route-page="@(page - 1)">← Trang trước</a> }<span>Trang @(page)</span>@if (Model.Count > 20) { <a asp-route-page="@(page + 1)">Trang sau →</a> }</nav> }
    <footer class="trl-brand-footer"><span>NhàTốt · Sống đúng nơi</span><span>@(owner ? "Không gian dành cho chủ nhà" : "Không gian dành cho khách thuê")</span></footer>
</div>
