@model QL_PhongTro.ViewModels.BaoHongChiTiet
@using QL_PhongTro.Services
@{
    var b=Model.BaoHong;var vn=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var latest=Model.TraoDois.LastOrDefault()?.ThoiDiem??b.NgayTao;
    var accepted=Model.TraoDois.FirstOrDefault(x=>x.Loai=="TRANG_THAI"&&x.TrangThaiSau=="DANG_XU_LY");
    var completed=Model.TraoDois.FirstOrDefault(x=>x.Loai=="TRANG_THAI"&&x.TrangThaiSau=="HOAN_THANH");
    var rejected=Model.TraoDois.FirstOrDefault(x=>x.Loai=="TRANG_THAI"&&x.TrangThaiSau=="TU_CHOI");
    var state=b.TrangThai switch{"HOAN_THANH"=>"done","TU_CHOI"=>"rejected","DANG_XU_LY"=>"progress",_=>"new"};
}
<div class="repairs-page repair-tenant-detail"><nav class="ru-breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><a asp-action="Index">Báo hỏng của tôi</a><span>›</span><span>@b.MaBaoHong</span></nav><a asp-action="Index" class="ru-back">← Quay lại danh sách báo hỏng</a><header class="ru-detail-heading"><div><h1>@b.MaBaoHong · @b.LoaiThietBi <span class="ru-badge @state">@BaoHongService.TenTrangThai(b.TrangThai)</span> <span class="ru-badge @(b.MucDo=="GAP" ? "urgent" : "")">@(b.MucDo=="GAP" ? "Gấp" : "Thường")</span></h1><p>Phòng @Model.MaPhong · @Model.TenToaNha</p></div><button type="button" class="btn btn-outline-secondary" onclick="window.print()">▤ In thông tin</button></header>
<div class="ru-note state-@state"><b>@(b.TrangThai=="MOI" ? "Báo hỏng đang chờ quản lý tiếp nhận" : b.TrangThai=="DANG_XU_LY" ? "Quản lý đang xử lý sự cố" : b.TrangThai=="HOAN_THANH" ? "Sự cố đã được ghi nhận hoàn thành" : "Báo hỏng đã bị từ chối")</b><br/>Cập nhật gần nhất lúc @latest.AddHours(7).ToString("HH:mm 'ngày' dd/MM/yyyy").</div>
<section class="ru-stats ru-detail-stats"><div class="ru-stat"><span class="ru-stat-icon">▤</span><div><span>Thời điểm gửi</span><strong>@b.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</strong></div></div><div class="ru-stat"><span class="ru-stat-icon">☏</span><div><span>Phản hồi quản lý</span><strong>@Model.TraoDois.Count(x=>x.Loai=="PHAN_HOI")</strong></div></div><div class="ru-stat"><span class="ru-stat-icon">₫</span><div><span>Chi phí ghi nhận</span><strong>@(Model.ChiPhi is {} c ? c.SoTien.ToString("N0",vn)+" đ" : "Chưa có")</strong></div></div></section>
<div class="ru-detail-grid"><div><section class="repairs-card"><h2>Thông tin sự cố</h2><div class="ru-contract-strip"><b>Phòng @Model.MaPhong · @Model.TenToaNha</b><span>Hợp đồng @Model.MaHopDong</span></div><dl class="ru-facts"><div><dt>Loại thiết bị</dt><dd>@b.LoaiThietBi</dd></div><div><dt>Mức độ</dt><dd>@(b.MucDo=="GAP" ? "Gấp" : "Thường")</dd></div><div><dt>Người gửi</dt><dd>@Model.TenNguoiBao</dd></div></dl><h3>Mô tả sự cố</h3><p class="repairs-description">@b.MoTa</p><h3>Ảnh thiết bị · @Model.Images.Count ảnh</h3><div class="mrd-photos">@foreach(var p in Model.Images){var path=Url.Action("Image","BaoHong",new{id=b.Id,order=p.ThuTu});<div class="mrd-photo"><a href="@path" target="_blank" rel="noopener"><img src="@path" alt="Ảnh thiết bị @p.ThuTu" loading="lazy"/></a><div class="ru-photo-caption"><span>Ảnh @p.ThuTu · @((p.SoByte/1024m/1024m).ToString("0.##",vn)) MiB</span><a href="@path" target="_blank" rel="noopener">Xem ảnh</a></div></div>}@if(Model.Images.Count==0){<p class="ru-muted">Không có ảnh đính kèm.</p>}</div></section><partial name="~/Views/BaoHong/_TraoDoi.cshtml" model="Model"/></div>
<aside><section class="repairs-card"><h2>Trạng thái xử lý</h2><ol class="ru-status-timeline"><li class="complete"><b>Đã gửi báo hỏng</b><time>@b.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time></li><li class="@(accepted is not null ? "complete" : "")"><b>Quản lý tiếp nhận / đang xử lý</b><time>@(accepted?.ThoiDiem.AddHours(7).ToString("dd/MM/yyyy HH:mm")??"Chưa có thời điểm ghi nhận")</time></li><li class="@(completed is not null ? "complete" : rejected is not null ? "rejected" : "")"><b>@(rejected is not null ? "Từ chối" : "Hoàn thành")</b><time>@((completed??rejected)?.ThoiDiem.AddHours(7).ToString("dd/MM/yyyy HH:mm")??"Chưa có")</time></li></ol><p class="ru-note">Mọi thay đổi trạng thái và phản hồi được lưu trong lịch sử xử lý.</p></section><partial name="~/Views/BaoHong/_ChiPhi.cshtml" model="Model"/><section class="repairs-card"><h2>Thông tin xử lý gần nhất</h2>@if(Model.TraoDois.LastOrDefault() is {} last){<p><b>@last.TenNguoiGui · Quản lý</b></p><p class="repairs-description">@last.NoiDung</p><small>@last.ThoiDiem.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small>}else{<p class="ru-muted">Chưa có phản hồi từ quản lý.</p>}<p class="ru-note">Lịch kiểm tra và công việc dự kiến, nếu có, được quản lý trao đổi trong nội dung phản hồi.</p></section></aside></div></div>
