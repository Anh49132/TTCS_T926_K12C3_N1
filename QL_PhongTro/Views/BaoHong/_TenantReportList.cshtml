@model List<QL_PhongTro.ViewModels.BaoHongChiTiet>
@using QL_PhongTro.ViewModels
@using QL_PhongTro.Services
@{
    var filter = (BaoHongBoLoc)ViewData["BaoHongBoLoc"]!;
    var summary = (BaoHongTongQuan)ViewData["BaoHongTongQuan"]!;
    var pages = Math.Max(1, (summary.KetQua + 19) / 20);
    var states = new[]{("","Tất cả"),("MOI","Mới"),("DANG_XU_LY","Đang xử lý"),("HOAN_THANH","Hoàn thành"),("TU_CHOI","Từ chối")};
    Dictionary<string,string> Tab(string state){var r=filter.RouteValues(1);r.Remove("trangThai");if(state!="")r["trangThai"]=state;return r;}
}
<div class="tenant-repair-list repair-tenant-list">
<nav class="trl-breadcrumb" aria-label="Đường dẫn"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>›</span><span>Báo hỏng của tôi</span></nav>
<header class="trl-heading"><div><h1>Báo hỏng của tôi</h1><p>Theo dõi sự cố và phản hồi từ quản lý.</p></div><a class="trl-create" asp-action="Create">＋ Gửi báo hỏng</a></header>
<section class="ru-stats" aria-label="Tổng quan toàn bộ báo hỏng của bạn">@foreach(var card in new[]{("Tổng báo hỏng",summary.Tong,"total"),("Mới",summary.Moi,"new"),("Đang xử lý",summary.DangXuLy,"progress"),("Đã hoàn thành",summary.HoanThanh,"done")}){<div class="ru-stat @card.Item3"><span class="ru-stat-icon" aria-hidden="true">@(card.Item3=="done" ? "✓" : card.Item3=="progress" ? "◷" : "▤")</span><div><span>@card.Item1</span><strong>@card.Item2</strong><small>@(card.Item3=="total" ? "Các báo hỏng bạn đã gửi" : "")</small></div></div>}</section>
<section class="trl-panel"><nav class="ru-tabs" aria-label="Lọc trạng thái">@foreach(var s in states){<a asp-action="Index" asp-all-route-data="@Tab(s.Item1)" class="@((filter.TrangThai??"")==s.Item1 ? "active" : "")" aria-current="@((filter.TrangThai??"")==s.Item1 ? "page" : null)">@s.Item2 <span>@(s.Item1=="" ? summary.Tong : summary.TheoTrangThai.GetValueOrDefault(s.Item1))</span></a>}</nav>
<form method="get" asp-action="Index" class="ru-list-filters"><label class="ru-search"><span class="trl-sr">Tìm mã báo hỏng hoặc thiết bị</span><input type="search" name="timKiem" value="@filter.TimKiem" maxlength="200" placeholder="Tìm mã báo hỏng hoặc thiết bị..." /></label><label><span class="trl-sr">Trạng thái</span><select name="trangThai">@foreach(var s in states){<option value="@s.Item1" selected="@((filter.TrangThai??"")==s.Item1)">@(s.Item1=="" ? "Tất cả trạng thái" : s.Item2)</option>}</select></label><label><span class="trl-sr">Mức độ</span><select name="mucDo"><option value="">Tất cả mức độ</option><option value="THUONG" selected="@(filter.MucDo=="THUONG")">Thường</option><option value="GAP" selected="@(filter.MucDo=="GAP")">Gấp</option></select></label><button class="btn btn-dark">Lọc</button><a asp-action="Index">Đặt lại</a></form>
<div class="trl-table-wrap"><table class="trl-table ru-tenant-table"><thead><tr><th>Thiết bị / Mã báo hỏng</th><th>Phòng</th><th>Mô tả</th><th>Trạng thái</th><th>Mức độ</th><th>Cập nhật gần nhất</th><th>Phản hồi</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var row in Model){var b=row.BaoHong;var state=b.TrangThai switch{"DANG_XU_LY"=>"progress","HOAN_THANH"=>"done","TU_CHOI"=>"rejected",_=>"new"};
<tr data-repair-row data-status="@b.TrangThai" data-priority="@b.MucDo"><td data-label="Thiết bị / Mã báo hỏng"><div class="ru-equipment"><span aria-hidden="true">⚒</span><div><b>@b.LoaiThietBi</b><small>@b.MaBaoHong</small></div></div></td><td data-label="Phòng">@row.MaPhong · @row.TenToaNha</td><td data-label="Mô tả"><span class="ru-description-short">@b.MoTa</span></td><td data-label="Trạng thái"><span class="trl-badge @state">@BaoHongService.TenTrangThai(b.TrangThai)</span></td><td data-label="Mức độ"><span class="trl-priority @(b.MucDo=="GAP" ? "urgent" : "")">@(b.MucDo=="GAP" ? "Gấp" : "Thường")</span></td><td data-label="Cập nhật gần nhất">@row.CapNhatGanNhat.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td data-label="Phản hồi">@if(row.SoPhanHoi>0){<a asp-action="Details" asp-route-id="@b.Id" asp-fragment="repair-history-title">@row.SoPhanHoi phản hồi</a>}else{<span class="ru-muted">Chưa có phản hồi</span>}</td><td data-label="Thao tác"><a class="trl-detail" asp-action="Details" asp-route-id="@b.Id">Xem chi tiết</a></td></tr>}
</tbody></table></div>
@if(Model.Count==0){<div class="trl-empty" role="status"><h3>@(filter.DangLoc ? "Không có báo hỏng phù hợp với bộ lọc." : "Bạn chưa gửi báo hỏng nào.")</h3><p>Thử bỏ bộ lọc hoặc gửi báo hỏng khi có sự cố tại phòng đang thuê.</p><a asp-action="Index">Bỏ bộ lọc</a></div>}
<footer class="ru-pagination"><span>Hiển thị @(Model.Count==0 ? 0 : (filter.Page-1)*20+1)–@((filter.Page-1)*20+Model.Count) trong @summary.KetQua báo hỏng</span><nav aria-label="Phân trang báo hỏng">@if(filter.Page>1){<a asp-action="Index" asp-all-route-data="@filter.RouteValues(filter.Page-1)">‹ Trước</a>}<span>Trang @filter.Page / @pages</span>@if(filter.Page<pages){<a asp-action="Index" asp-all-route-data="@filter.RouteValues(filter.Page+1)">Sau ›</a>}</nav></footer></section>
<p class="ru-note">ⓘ Bạn chỉ có thể báo hỏng cho phòng đang thuê theo hợp đồng còn hiệu lực. Lịch sử đã gửi vẫn được giữ để tra cứu.</p>
</div>
