@model QL_PhongTro.ViewModels.PermissionMatrixViewModel
@{
    ViewData["Title"] = "Bảng phân quyền";
}
<section class="management-page" aria-labelledby="permissions-title">
<header class="management-heading"><div><p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p><h1 id="permissions-title">Bảng phân quyền theo vai trò</h1>
<p class="text-secondary">Cấu hình quyền hiện tại được lưu trong cơ sở dữ liệu.</p>
<p class="mb-0">F: toàn quyền · W: ghi trong phạm vi được giao · R: chỉ xem · —: không truy cập · *: chỉ dữ liệu của mình.</p></div></header>
<div class="table-responsive management-table" tabindex="0" role="region" aria-label="Bảng phân quyền, cuộn ngang để xem thêm">
    <table class="table table-bordered align-middle" id="permission-matrix">
        <thead><tr><th scope="col">Chức năng</th>
        @foreach (var role in Model.Roles)
        {
            <th scope="col" data-role="@role.Code">@role.Name</th>
        }
        </tr></thead>
        <tbody>
        @foreach (var module in Model.Modules)
        {
            <tr data-module="@module.Code"><th scope="row">@module.Name</th>
            @foreach (var role in Model.Roles)
            {
                var p = Model.Permissions.SingleOrDefault(p => p.RoleCode == role.Code && p.ModuleCode == module.Code);
                var label = p?.AccessLevel switch { "FULL" => "F", "WRITE" => "W", "READ" => "R", _ => "—" };
                <td data-role="@role.Code" data-access="@(p?.AccessLevel ?? "NONE")">@(label + (p?.OwnDataOnly == true ? "*" : ""))</td>
            }
            </tr>
        }
        </tbody>
    </table>
</div>
</section>

