@model QL_PhongTro.ViewModels.ChiTietToaNhaViewModel
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    ViewData["Title"] = "Chi tiết tòa nhà";
    var b = Model.ToaNha; var vn = CultureInfo.GetCultureInfo("vi-VN");
    var write = await Permissions.AllowsAsync("PHONG_TRO", true) && (User.IsInRole("CHU_NHA") || User.IsInRole("ADMIN"));
    var occupancy = Model.TongPhong == 0 ? 0 : 100m * Model.DangThue / Model.TongPhong;
    var finance = Model.XemTaiChinh;
}
<div class="building-detail building-detail-bootstrap">

<header class="bd-heading"><div><div class="bd-title"><h1>@b.TenToaNha</h1><span class="bd-status">@(b.DangHoatDong ? "Đang vận hành" : "Ngừng hoạt động")</span></div></div>
@if (write) { <div class="bd-actions"><a asp-action="SuaToaNha" asp-route-id="@b.Id" class="bd-button btn btn-outline-secondary">✎ Chỉnh sửa tòa nhà</a>@if (b.DangHoatDong) { <a asp-action="Create" asp-route-toaNhaId="@b.Id" class="bd-button bd-primary btn btn-dark">＋ Thêm phòng</a> }</div> }
</header>
<section class="bd-overview"><img src="@(Model.Anh ?? Url.Content("~/room-placeholder.svg"))" alt="Ảnh phòng trong @b.TenToaNha" />
<div class="bd-overview-main"><p class="bd-address">⌖ @string.Join(", ", new[] { b.DiaChi, b.PhuongXa, b.QuanHuyen, b.TinhThanh }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
<div class="bd-facts"><div><small>Mã tòa nhà</small><strong>TN-@b.Id.ToString("D3")</strong></div><div><small>Quy mô</small><strong>@(b.SoTang?.ToString() ?? "—") tầng · @Model.TongPhong phòng</strong></div><div><small>Diện tích phòng</small><strong>@(Model.DienTichMin?.ToString("0.#", vn) ?? "—")–@(Model.DienTichMax?.ToString("0.#", vn) ?? "—") m²</strong></div></div>
@if (!string.IsNullOrWhiteSpace(b.GhiChu)) { <p class="bd-muted">@b.GhiChu</p> }</div>
<div class="bd-management"><small>Người quản lý</small><strong>@(Model.QuanLy ?? "Chưa phân công")</strong><div class="bd-facts"><div><small>Kỳ hóa đơn</small><strong>Hàng tháng</strong></div><div><small>Ngày chốt</small><strong>Ngày @b.NgayChotHangThang.ToString("D2")</strong></div></div></div>
</section>
<section class="bd-stats"><article><small>Phòng đang thuê <span>▣</span></small><strong>@Model.DangThue / @Model.TongPhong <em>phòng</em></strong><p>@occupancy.ToString("0.#", vn)% công suất thuê</p><progress value="@Model.DangThue" max="@Math.Max(1, Model.TongPhong)"></progress></article>
<article><small>Phòng trống <span>▤</span></small><strong>@Model.Trong.ToString("D2") <em>phòng</em></strong><p>Sẵn sàng cho thuê</p><progress value="@Model.Trong" max="@Math.Max(1, Model.TongPhong)"></progress></article>
@if (finance) { <article><small>Đã thu tháng này <span>▧</span></small><strong>— <em>đ</em></strong><p>Chưa có dữ liệu thu tiền</p></article><article><small>Còn phải thu <span>▧</span></small><strong>— <em>đ</em></strong><p>Chưa có dữ liệu thanh toán</p></article> }
else { <article><small>Đã đặt cọc <span>▧</span></small><strong>@Model.DatCoc <em>phòng</em></strong><p>Phòng đang được giữ chỗ</p></article> }
</section>
<div class="bd-attention"><span>ⓘ Cần chú ý</span><strong>@Model.Trong phòng trống · @Model.DatCoc phòng đã đặt cọc</strong><a asp-controller="YeuCau" asp-action="Index">Xem yêu cầu thuê <svg class="bd-link-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a></div>
<section class="bd-room-panel"><div class="bd-panel-heading"><h2>Danh sách phòng <small>@Model.TongPhong phòng</small></h2><div class="bd-actions">
@if (write && b.DangHoatDong) { <a asp-action="CreateBulk" asp-route-toaNhaId="@b.Id" class="bd-import-link"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg>Nhập danh sách</a> }
<div class="bd-view-switch" aria-label="Kiểu hiển thị phòng"><button type="button" data-room-view="list" aria-label="Danh sách" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg></button><button type="button" data-room-view="grid" aria-label="Lưới" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/></svg></button></div></div></div>
<div class="bd-tabs nav"><a class="@(string.IsNullOrEmpty(Model.TrangThai) ? "active" : "")" asp-route-id="@b.Id" asp-route-sapXep="@Model.SapXep" asp-route-thanhToan="@Model.ThanhToan" asp-route-tuKhoa="@Model.TuKhoa" asp-route-tang="@Model.Tang" asp-route-loaiPhong="@Model.LoaiPhong">Tất cả phòng <small>@Model.TongPhong</small></a><a class="@(Model.TrangThai == "DANG_THUE" ? "active" : "")" asp-route-id="@b.Id" asp-route-trangThai="DANG_THUE" asp-route-sapXep="@Model.SapXep" asp-route-thanhToan="@Model.ThanhToan" asp-route-tuKhoa="@Model.TuKhoa" asp-route-tang="@Model.Tang" asp-route-loaiPhong="@Model.LoaiPhong">Đang thuê <small>@Model.DangThue</small></a><a class="@(Model.TrangThai == "TRONG" ? "active" : "")" asp-route-id="@b.Id" asp-route-trangThai="TRONG" asp-route-sapXep="@Model.SapXep" asp-route-thanhToan="@Model.ThanhToan" asp-route-tuKhoa="@Model.TuKhoa" asp-route-tang="@Model.Tang" asp-route-loaiPhong="@Model.LoaiPhong">Còn trống <small>@Model.Trong</small></a></div>
<form method="get" class="bd-filters" asp-action="ChiTietToaNha" asp-route-id="@b.Id">
<input type="hidden" name="trangThai" value="@Model.TrangThai" />
<label class="bd-room-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><input class="form-control" name="tuKhoa" value="@Model.TuKhoa" placeholder="Tìm mã phòng, tên khách thuê..." aria-label="Tìm mã phòng, tên khách thuê" /></label>
<select class="form-select" name="tang" aria-label="Tầng" onchange="this.form.requestSubmit()"><option value="">Tất cả tầng</option>@foreach (var floor in Model.Tangs) { <option value="@floor" selected="@(Model.Tang == floor)">Tầng @floor</option> }</select>
<select class="form-select" name="loaiPhong" aria-label="Loại phòng" onchange="this.form.requestSubmit()"><option value="">Loại phòng</option>@foreach (var type in Model.LoaiPhongs) { <option value="@type" selected="@(Model.LoaiPhong == type)">@type</option> }</select>
@if (finance) { <select class="form-select" name="thanhToan" aria-label="Thanh toán" onchange="this.form.requestSubmit()"><option value="">Thanh toán</option>@foreach (var option in new[] { ("CHUA_CO", "Chưa có hóa đơn"), ("CHUA_TRA", "Chưa thanh toán"), ("MOT_PHAN", "Thanh toán một phần"), ("DA_TRA", "Đã thanh toán"), ("QUA_HAN", "Quá hạn"), ("CHO_XAC_NHAN", "Chờ xác nhận") }) { <option value="@option.Item1" selected="@(Model.ThanhToan == option.Item1)">@option.Item2</option> }</select> }
<button type="submit" class="visually-hidden">Tìm phòng</button><select class="form-select" name="sapXep" aria-label="Sắp xếp phòng" onchange="this.form.requestSubmit()">@foreach (var option in new[] { ("ma_asc", "Mã phòng tăng dần"), ("ma_desc", "Mã phòng giảm dần"), ("gia_asc", "Giá thuê tăng dần"), ("gia_desc", "Giá thuê giảm dần"), ("tang_asc", "Tầng tăng dần") }) { <option value="@option.Item1" selected="@(Model.SapXep == option.Item1)">@option.Item2</option> }</select></form>
<div class="bd-table-scroll"><table class="bd-table table align-middle mb-0"><thead><tr><th>Phòng</th><th>Khách thuê</th><th>Trạng thái</th><th>Giá thuê</th>@if (finance) { <th>Thanh toán @Model.KyThanhToan</th> }<th>Hợp đồng</th><th></th></tr></thead><tbody>
@foreach (var row in Model.Phongs) { var p = row.Phong; <tr><td><strong>@p.MaPhong</strong><small>Tầng @p.Tang · @(p.LoaiPhong ?? "Phòng trọ") · @p.DienTich.ToString("0.#", vn) m²</small></td><td>@(row.Khach ?? (p.TrangThai == "TRONG" ? "Chưa có khách thuê" : "Chưa ghi nhận"))</td><td><span class="bd-room-status @(p.TrangThai == "DANG_THUE" ? "rented" : p.TrangThai == "TRONG" ? "vacant" : "reserved")">@QL_PhongTro.Controllers.PhongTroController.StatusLabel(Enum.TryParse<QL_PhongTro.ViewModels.TrangThaiPhong>(p.TrangThai, out var roomState) ? roomState : QL_PhongTro.ViewModels.TrangThaiPhong.NGUNG_CHO_THUE)</span></td><td><strong>@p.GiaThue.ToString("N0", vn) đ</strong><small>/ tháng</small></td>@if (finance) { <td class="bd-payment">@if (Model.ThanhToanPhongs.TryGetValue(p.Id, out var payment)) { <span class="bd-room-status @(payment.Ma == "DA_TRA" ? "rented" : "reserved")">@payment.Nhan</span><small>Còn @payment.ConNo.ToString("N0", vn) đ / @payment.TongTien.ToString("N0", vn) đ</small> } else { <span class="bd-muted">Chưa có hóa đơn</span> }</td> }
<td>@if (row.HanHopDong.HasValue) { <span>@row.HanHopDong.Value.ToString("dd/MM/yyyy")</span><small>Ngày hết hạn</small> } else { <span class="bd-muted">—</span> }</td>
<td>@if (write) { <a asp-action="Edit" asp-route-id="@p.Id" class="bd-room-edit" aria-label="Chỉnh sửa phòng @p.MaPhong">⋯</a> }</td></tr> }
@if (Model.Phongs.Count == 0) { <tr><td colspan="@(finance ? 7 : 6)" class="bd-empty">Không có phòng phù hợp với bộ lọc.</td></tr> }
</tbody></table></div>
<footer class="bd-pagination"><span>Hiển thị @Model.Phongs.Count trong @Model.TongKetQua phòng phù hợp</span><nav aria-label="Phân trang phòng">@for (var i = Math.Max(1, Model.Trang - 2); i <= Math.Min(Model.TongTrang, Model.Trang + 2); i++) { <a class="@(i == Model.Trang ? "active" : "")" asp-route-id="@b.Id" asp-route-thanhToan="@Model.ThanhToan" asp-route-sapXep="@Model.SapXep" asp-route-loaiPhong="@Model.LoaiPhong" asp-route-trang="@i" asp-route-tuKhoa="@Model.TuKhoa" asp-route-tang="@Model.Tang" asp-route-trangThai="@Model.TrangThai">@i</a> }</nav></footer>
</section></div>
@section Styles { <link rel="stylesheet" href="~/css/building-detail.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/building-detail-bootstrap.css" asp-append-version="true" /> }

@section Scripts { <script src="~/js/building-detail-filters.js" asp-append-version="true"></script><script>
document.querySelectorAll('[data-room-view]').forEach(button => button.addEventListener('click', () => {
    document.querySelector('.bd-room-panel').classList.toggle('bd-grid-view', button.dataset.roomView === 'grid');
    document.querySelectorAll('[data-room-view]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
}));
</script> }
