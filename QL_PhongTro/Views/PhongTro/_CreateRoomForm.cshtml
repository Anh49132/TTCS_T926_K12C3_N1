@model QL_PhongTro.ViewModels.TaoPhongViewModel
@{ var locations = ViewData["RoomBuildingLocations"] as Dictionary<string, string>; var floors = ViewData["RoomBuildingFloors"] as Dictionary<string, int?>; }
<div class="room-create-page room-create-bootstrap"><header class="rc-heading"><div><h1>Thêm phòng mới</h1><p>Thiết lập thông tin, giá thuê và tiện nghi để bắt đầu quản lý phòng.</p></div><span>* Trường thông tin bắt buộc</span></header>
<form asp-action="Create" enctype="multipart/form-data" method="post" novalidate><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="rc-layout"><div class="rc-main">
<section class="rc-card rc-basic-card"><div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8v18H8zM11 3v18m2-9h1" /></svg></span><div><h2>Thông tin cơ bản</h2><p>Xác định phòng và cơ sở quản lý.</p></div></div><div class="rc-fields">
<div><label asp-for="ToaNhaId">Cơ sở <em>*</em></label><select class="form-select" asp-for="ToaNhaId" data-room-building><option value="">Chọn cơ sở</option>@foreach (var building in Model.ToaNhaOptions) { <option value="@building.Value" data-location="@(locations?.GetValueOrDefault(building.Value!))" data-floors="@(floors?.GetValueOrDefault(building.Value!))">@building.Text</option> }</select><small data-room-location>@(locations?.GetValueOrDefault(Model.ToaNhaId?.ToString() ?? ""))</small><span asp-validation-for="ToaNhaId" class="text-danger"></span></div>
<div><label asp-for="MaPhong">Số / tên phòng <em>*</em></label><input class="form-control" asp-for="MaPhong" autocomplete="off" /><small>Tên phòng phải là duy nhất trong cùng cơ sở.</small><span asp-validation-for="MaPhong" class="text-danger"></span></div>
<div class="rc-wide rc-three"><div><label asp-for="Tang">Tầng</label><input class="form-control" asp-for="Tang" type="number" list="rc-floor-options" /><datalist id="rc-floor-options"></datalist><span asp-validation-for="Tang" class="text-danger"></span></div><div><label asp-for="DienTich">Diện tích <em>*</em></label><div class="rc-unit"><input class="form-control" asp-for="DienTich" type="number" min="0.01" step="0.01" /><span>m²</span></div><span asp-validation-for="DienTich" class="text-danger"></span></div><div><label asp-for="SoNguoiToiDa">Sức chứa tối đa <em>*</em></label><div class="rc-unit"><input class="form-control" asp-for="SoNguoiToiDa" type="number" min="1" /><span>người</span></div><span asp-validation-for="SoNguoiToiDa" class="text-danger"></span></div></div>
<fieldset class="rc-wide rc-status"><legend>Trạng thái ban đầu</legend><div class="rc-status-options"><label class="rc-status-option"><input asp-for="TrangThai" type="radio" id="TrangThaiTrong" value="TRONG" checked="@(Model.TrangThai is null || Model.TrangThai == QL_PhongTro.ViewModels.TrangThaiPhong.TRONG)" /><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8v18H8zM11 3v18m2-9h1" /></svg><span>Còn trống</span></label><label class="rc-status-option rc-status-unavailable" title="Chưa hỗ trợ chức năng bảo trì"><input type="radio" id="TrangThaiBaoTri" disabled aria-label="Bảo trì — chưa hỗ trợ" /><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6a5 5 0 0 0-6 6l-5 5a2 2 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3z" /></svg><span>Bảo trì</span></label></div><span asp-validation-for="TrangThai" class="text-danger"></span><small>Trạng thái “Đang thuê” được cập nhật khi bạn tạo hợp đồng cho phòng.</small><small class="rc-unavailable-note">Bảo trì: chưa có chức năng, tạm thời không hoạt động.</small></fieldset></div></section>
<section class="rc-card rc-pricing-card">
    <div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h14v14H4zM4 8h16v8h-7V8m3 4h1" /></svg></span><div><h2>Giá thuê &amp; tiền cọc</h2><p>Các khoản tiền được tính bằng Việt Nam đồng (đ).</p></div></div>
    <div class="rc-fields">
        <div><label asp-for="GiaThueDisplay">Giá thuê hàng tháng <em>*</em></label><div class="rc-unit"><input class="form-control" asp-for="GiaThueDisplay" inputmode="numeric" autocomplete="off" data-vnd-input placeholder="0" /><span>đ / tháng</span></div><span asp-validation-for="GiaThue" class="text-danger"></span></div>
        <div><label for="rc-deposit-preview">Tiền cọc <em>*</em></label><div class="rc-unit"><input class="form-control" id="rc-deposit-preview" value="0" placeholder="0" disabled aria-describedby="rc-pricing-unavailable" /><span>đ</span></div></div>
    </div>
    <p class="rc-hint">ⓘ Tiền cọc tương đương 1 tháng thuê. Có thể điều chỉnh theo hợp đồng.</p>
    <div class="rc-services" data-room-services>
        <div class="rc-services-heading"><h2>Phí dịch vụ</h2></div>
        <p>Chọn các dịch vụ áp dụng cho phòng và điều chỉnh đơn giá.</p>
        <input type="hidden" name="DichVuDaChon" value="@(Model.DichVuDaChon ? "true" : "false")" data-services-ready />
        <script type="application/json" data-service-state>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DichVuMoi))</script>
        <div class="rc-service-table" role="group" aria-label="Phí dịch vụ của phòng"><div class="rc-service-table-head"><span>Dịch vụ áp dụng</span><span>Đơn giá</span><span>Cách tính</span></div><div data-service-rows></div></div>
        <p data-service-message class="rc-service-help">Chọn cơ sở để tải danh sách dịch vụ.</p>
        <span asp-validation-for="DichVuMoi" class="text-danger"></span>
    </div>
    <p id="rc-pricing-unavailable" class="visually-hidden">Tiền cọc được thỏa thuận khi lập hợp đồng.</p>
</section>

</div><aside class="rc-aside"><section class="rc-card rc-amenities"><div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10V5h14v5M4 10h16v9H4ZM7 19v2M17 19v2M4 14h16M8 10v4M16 10v4"/></svg></span><div><h2>Tiện nghi</h2><p>Chọn tiện nghi có sẵn trong phòng.</p></div></div><div class="rc-amenity-options">@foreach (var amenity in QL_PhongTro.ViewModels.TienNghiPhong.Options) { <label><input type="checkbox" name="TienNghi" value="@amenity.Key" checked="@Model.TienNghi.Contains(amenity.Key)" /><span>@amenity.Value</span></label> }</div><span asp-validation-for="TienNghi" class="text-danger"></span><p class="rc-amenity-count" aria-live="polite">Đã chọn <span>@Model.TienNghi.Count</span> tiện nghi</p></section><section class="rc-card rc-photo-card"><div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m5 18 5-5 3 3 4-6 3 4"/></svg></span><div><h2>Ảnh phòng</h2><p>Thêm ảnh để dễ nhận diện và giới thiệu phòng.</p></div></div><label class="rc-photo-drop" for="rc-photo-input"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 17H5a4 4 0 0 1-1-8 6 6 0 0 1 12-1 4 4 0 0 1 3 8h-3M12 20V11m-3 3 3-3 3 3"/></svg><strong>Kéo thả ảnh hoặc <span>chọn ảnh</span></strong><small>JPG, PNG · Tối đa 5 MB / ảnh, 8 ảnh</small></label><input id="rc-photo-input" name="AnhPhongMoi" type="file" accept="image/jpeg,image/png" multiple class="visually-hidden" /><span asp-validation-for="AnhPhongMoi" class="text-danger"></span><p class="rc-photo-error" role="alert" hidden></p><div class="rc-photo-meta"><span>Đã thêm <b>0</b> / 8 ảnh</span><span>Ảnh đầu tiên là ảnh đại diện</span></div><div class="rc-photo-previews"></div></section><section class="rc-card rc-room-notes"><div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 5H5v15h15v-8M10 14l1-4 7-7 3 3-7 7-4 1zM17 4l3 3" /></svg></span><div><h2>Ghi chú</h2><p>Thông tin bổ sung dành cho việc quản lý.</p></div></div><textarea class="form-control" asp-for="GhiChuNoiBo" id="rc-room-notes-preview" maxlength="500" rows="4" aria-label="Ghi chú nội bộ" placeholder="Phòng có cửa sổ, đón ánh sáng tự nhiên..."></textarea><span asp-validation-for="GhiChuNoiBo" class="text-danger"></span><div class="rc-room-notes-footer"><span>Chỉ hiển thị cho chủ nhà</span><span><b id="rc-notes-count">@(Model.GhiChuNoiBo?.Length ?? 0)</b> / 500 ký tự</span></div></section></aside></div>
<footer class="rc-footer"><span>Phòng sẽ được thêm vào cơ sở bạn chọn.</span><div><a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" class="btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-dark">✓ Lưu phòng</button></div></footer></form></div>
