@model QL_PhongTro.ViewModels.TaoToaNhaViewModel
@{ ViewData["Title"] = "Chỉnh sửa tòa nhà"; var id = Context.Request.RouteValues["id"]; }
<div class="building-edit-page building-edit-bootstrap">

<header class="be-heading"><div><h1>Chỉnh sửa tòa nhà</h1><p>Cập nhật thông tin và thiết lập quản lý cho @Model.TenToaNha.</p></div><span class="be-code">▣ TN-@(int.TryParse(id?.ToString(), out var number) ? number.ToString("D3") : id)</span></header>
<nav class="be-tabs nav" aria-label="Các nhóm thông tin"><a href="#be-general">Thông tin chung</a><a href="#be-address">Địa chỉ &amp; vị trí</a><a href="#be-size">Quy mô</a><a href="#be-manager">Người phụ trách</a></nav>
<form asp-action="SuaToaNha" asp-route-id="@id" method="post" novalidate>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="be-layout"><div class="be-sections">
<section id="be-general" class="be-card"><div class="be-section-heading"><span class="be-section-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V4h11v17M15 9h5v12H2m5-14h1m3 0h1m-5 4h1m3 0h1m-5 4h1m3 0h1M8 21v-3h3v3m6-8h1m-1 4h1"/></svg></span><div><h2>Thông tin chung</h2><p>Thông tin nhận diện và trạng thái hoạt động của tòa nhà.</p></div></div><div class="be-fields">
<div><label asp-for="TenToaNha">Tên tòa nhà <em>*</em></label><input class="form-control" asp-for="TenToaNha" /><span asp-validation-for="TenToaNha" class="text-danger"></span></div>
<div><label>Mã tòa nhà</label><input class="form-control" value="TN-@(number.ToString("D3"))" readonly aria-label="Mã tòa nhà" /></div>
<div><label>Trạng thái hiện tại</label><input class="form-control" value="@(Model.DangHoatDongHienTai ? "Đang hoạt động" : "Ngừng hoạt động")" readonly /></div><div class="be-wide"><label asp-for="GhiChu">Mô tả tòa nhà</label><textarea class="form-control" asp-for="GhiChu" rows="3"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div>
</div></section>
<section id="be-address" class="be-card"><div class="be-section-heading"><span class="be-section-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg></span><div><h2>Địa chỉ &amp; vị trí</h2><p>Địa chỉ được hiển thị trên hợp đồng và hồ sơ tòa nhà.</p></div></div><div class="be-fields be-address-fields">
<div><label asp-for="TinhThanh">Tỉnh/thành phố <em>*</em></label><input class="form-control" asp-for="TinhThanh" required aria-required="true" /><span asp-validation-for="TinhThanh" class="text-danger"></span></div>
<div><label asp-for="QuanHuyen">Quận/huyện <em>*</em></label><input class="form-control" asp-for="QuanHuyen" required aria-required="true" /><span asp-validation-for="QuanHuyen" class="text-danger"></span></div>
<div><label asp-for="PhuongXa">Phường/xã <em>*</em></label><input class="form-control" asp-for="PhuongXa" required aria-required="true" /><span asp-validation-for="PhuongXa" class="text-danger"></span></div>
<div class="be-wide"><label asp-for="DiaChi">Số nhà, tên đường <em>*</em></label><input class="form-control" asp-for="DiaChi" /><span asp-validation-for="DiaChi" class="text-danger"></span></div>
</div><div class="be-address-preview"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span id="be-full-address">@string.Join(", ", new[] { Model.DiaChi, Model.PhuongXa, Model.QuanHuyen, Model.TinhThanh }.Where(x => !string.IsNullOrWhiteSpace(x)))</span></div></section>
<section id="be-size" class="be-card"><div class="be-section-heading"><span class="be-section-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 7 9-4 9 4-9 4-9-4Zm0 5 9 4 9-4M3 17l9 4 9-4"/></svg></span><div><h2>Quy mô &amp; tiện ích</h2><p>Thiết lập quy mô thực tế và các tiện ích dùng chung.</p></div></div><div class="be-fields"><div><label asp-for="SoTang">Số tầng <em>*</em></label><div class="be-unit"><input class="form-control" asp-for="SoTang" required aria-required="true" type="number" min="1" max="99" /><span>tầng</span></div><span asp-validation-for="SoTang" class="text-danger"></span></div><div><label>Tổng số phòng</label><div class="be-unit"><input class="form-control" value="@Model.TongPhongHienTai" readonly /><span>phòng ▣</span></div></div><div><label asp-for="DienTichDat">Diện tích đất</label><div class="be-unit"><input class="form-control" asp-for="DienTichDat" type="number" min="0.01" step="0.01" /><span>m²</span></div><span asp-validation-for="DienTichDat" class="text-danger"></span></div></div><fieldset class="be-amenities"><legend>Tiện ích chung</legend><label><input asp-for="ThangMay" /> Thang máy</label><label><input asp-for="BaiDoXe" /> Bãi đỗ xe</label><label><input asp-for="CameraAnNinh" /> Camera an ninh</label><label><input asp-for="BaoVe24h" /> Bảo vệ 24/7</label><label><input asp-for="KhuGiatSay" /> Khu giặt sấy</label><label><input asp-for="SanThuong" /> Sân thượng</label></fieldset></section>
<section id="be-manager" class="be-card"><div class="be-section-heading"><span class="be-section-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 21v-3a8 8 0 0 1 16 0v3"/></svg></span><div><h2>Người phụ trách</h2><p>Thông tin liên hệ dùng cho vận hành và hỗ trợ khách thuê.</p></div></div><div class="be-fields"><div><label asp-for="QuanLyId">Người quản lý <em>*</em></label><select class="form-select" asp-for="QuanLyId" asp-items="Model.QuanLyOptions"><option value="">Chưa phân công</option></select><span asp-validation-for="QuanLyId" class="text-danger"></span></div><div><label>Số điện thoại liên hệ <em>*</em></label><input class="form-control" value="@(Model.DienThoaiQuanLyHienTai ?? "Chưa phân công")" readonly /></div></div></section>
</div><aside class="be-aside"><section class="be-card"><div class="be-image-heading"><h2>Ảnh tòa nhà</h2><span>Ảnh đại diện</span></div><img src="@(Model.AnhHienTai ?? Url.Content("~/room-placeholder.svg"))" alt="Ảnh phòng đại diện của tòa nhà" class="be-image" />@if (Model.PhongAnhHienTaiId.HasValue) { <a asp-action="Edit" asp-route-id="@Model.PhongAnhHienTaiId" class="be-change-image"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4H4v16h16V10M16 3v6m-3-3h6M5 17l5-6 4 4 3-3 3 4"/></svg>Thay đổi ảnh</a> }
<p class="be-image-note">JPG hoặc PNG. Tối đa 5 MB. Nên dùng ảnh ngang, rõ mặt tiền tòa nhà.</p></section><section class="be-card be-current"><h2>Tòa nhà hiện tại</h2><strong>@Model.TenToaNha</strong><span class="be-state">● @(Model.DangHoatDongHienTai ? "Đang hoạt động" : "Ngừng hoạt động")</span><div class="be-current-stats"><div><b>@Model.TongPhongHienTai</b><small>Tổng số phòng</small></div><div><b>@Model.DangThueHienTai</b><small>Đang cho thuê</small></div></div><div class="be-occupancy"><span>Tỷ lệ lấp đầy</span><strong>@(Model.TongPhongHienTai == 0 ? "0" : (100m * Model.DangThueHienTai / Model.TongPhongHienTai).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")))%</strong></div><progress value="@Model.DangThueHienTai" max="@Math.Max(1, Model.TongPhongHienTai)" aria-label="Tỷ lệ lấp đầy"></progress><div class="be-updated"><span>Cập nhật gần nhất</span><p>Chưa có thông tin cập nhật</p></div></section><section class="be-card be-notice"><h2><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></svg>Lưu ý khi cập nhật</h2><p>Thông tin mới sẽ áp dụng cho các hợp đồng tạo sau khi lưu. Hợp đồng hiện có không bị thay đổi.</p><p>Tổng số phòng được tính từ danh sách phòng của tòa nhà.</p><a asp-action="Index" asp-route-toaNhaId="@id" class="be-manage-rooms">Quản lý danh sách phòng <span aria-hidden="true">↗</span></a></section></aside></div>
<footer class="be-footer"><span>ⓘ Các trường có dấu * là bắt buộc.</span><div><a asp-action="ChiTietToaNha" asp-route-id="@id" class="be-cancel btn btn-outline-secondary">Hủy thay đổi</a><button type="submit" class="btn btn-dark">✓ Lưu thay đổi</button></div></footer>
</form></div>
@section Styles { <link rel="stylesheet" href="~/css/building-edit.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/building-edit-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>
const addressInputs = ['DiaChi','PhuongXa','QuanHuyen','TinhThanh'].map(id => document.getElementById(id));
addressInputs.forEach(input => input.addEventListener('input', () => { document.getElementById('be-full-address').textContent = addressInputs.map(item => item.value.trim()).filter(Boolean).join(', '); }));
</script> }
