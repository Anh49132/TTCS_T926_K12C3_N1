@model QL_PhongTro.ViewModels.TaoToaNhaViewModel
@{ ViewData["Title"] = "Thêm tòa nhà"; }
<div class="building-edit-page building-create-page building-create-bootstrap">
<header class="be-heading"><div><h1>Thêm tòa nhà</h1><p>Khai báo thông tin cơ bản để bắt đầu quản lý nhà cho thuê của bạn.</p></div><span class="bc-required">* Trường có dấu * là bắt buộc</span></header>
<form asp-action="TaoToaNha" method="post" novalidate id="building-create-form">
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="be-layout"><div class="be-sections">
<section class="be-card bc-basic"><div class="be-section-heading"><span class="be-section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 21V9h6m0 12V3h8v18m0-10h3v10H2m11-15h2m-2 4h2m-2 4h2M6 12v2m0 3v1m7 3v-3h2v3"/></svg></span><div><h2>Thông tin cơ bản</h2><p>Tên và mã giúp bạn nhận diện, tra cứu tòa nhà trong hệ thống.</p></div></div><div class="be-fields">
<div><label asp-for="TenToaNha">Tên tòa nhà <em>*</em></label><input class="form-control" asp-for="TenToaNha" placeholder="Ví dụ: AnHome Riverside" /><span asp-validation-for="TenToaNha" class="text-danger"></span></div>
<div><label for="bc-code">Mã tòa nhà</label><input id="bc-code" value="Tự động sau khi lưu" readonly /><small>Mã nhận diện được tạo từ ID tòa nhà.</small></div>
<div class="be-wide"><label>Loại hình</label><div class="bc-types"><label class="bc-type"><input type="radio" name="LoaiHinhXemTruoc" value="PHONG_TRO" /><div><strong>Phòng trọ</strong><small>Cho thuê theo từng phòng riêng lẻ.</small></div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V5l9-2v18m0-13h5v13H3m7-13v2m0 3v2m7-3v2"/></svg></label><label class="bc-type"><input type="radio" name="LoaiHinhXemTruoc" value="CAN_HO" checked /><div><strong>Căn hộ</strong><small>Căn hộ khép kín, đầy đủ tiện nghi.</small></div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V10h7m0 11V3h8v18H2m12-14h2m-2 4h2m-2 4h2M6 13h2m-2 4h2"/></svg></label></div><small>Lựa chọn loại hình chỉ để xem trước, hiện chưa được lưu vào hồ sơ tòa nhà.</small></div>
</div></section>
<section class="be-card bc-address"><div class="be-section-heading"><span class="be-section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 10c0 5-6 11-6 11S6 15 6 10a6 6 0 1 1 12 0Z"/><circle cx="12" cy="10" r="2"/></svg></span><div><h2>Địa chỉ tòa nhà</h2><p>Nhập địa chỉ chính xác để dễ tìm kiếm và quản lý theo khu vực.</p></div></div><div class="be-fields">
<div><label asp-for="TinhThanh">Tỉnh / Thành phố <em>*</em></label><input class="form-control" asp-for="TinhThanh" placeholder="TP. Hồ Chí Minh" /><span asp-validation-for="TinhThanh" class="text-danger"></span></div>
<div><label asp-for="PhuongXa">Phường / Xã <em>*</em></label><input class="form-control" asp-for="PhuongXa" placeholder="Phường 1" /><span asp-validation-for="PhuongXa" class="text-danger"></span></div>
<div class="be-wide bc-district"><label asp-for="QuanHuyen">Quận / Huyện <em>*</em></label><input class="form-control" asp-for="QuanHuyen" placeholder="Quận 3" /><span asp-validation-for="QuanHuyen" class="text-danger"></span></div>
<div class="be-wide"><label asp-for="DiaChi">Số nhà, tên đường <em>*</em></label><input class="form-control" asp-for="DiaChi" placeholder="Ví dụ: 24 Nguyễn Văn Hưởng" /><span asp-validation-for="DiaChi" class="text-danger"></span></div>
<div class="be-wide"><label for="bc-address-note">Địa chỉ bổ sung (không bắt buộc)</label><input id="bc-address-note" placeholder="Ví dụ: hẻm, khu dân cư hoặc chỉ dẫn đến tòa nhà" disabled /><small>Có thể thêm chỉ dẫn trong phần ghi chú bên dưới.</small></div>
</div></section>
<section class="be-card bc-size"><div class="be-section-heading"><span class="be-section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m4 8 8-4 8 4-8 4-8-4Zm0 4 8 4 8-4M4 16l8 4 8-4"/></svg></span><div><h2>Quy mô tòa nhà</h2><p>Khai báo quy mô thực tế để theo dõi và lên kế hoạch quản lý.</p></div></div><div class="be-fields"><div><label asp-for="SoTang">Số tầng <em>*</em></label><div class="be-unit"><input class="form-control" asp-for="SoTang" type="number" min="1" max="99" placeholder="5" /><span>tầng</span></div><small>Tính cả tầng trệt, không tính tầng hầm.</small><span asp-validation-for="SoTang" class="text-danger"></span></div><div><label for="bc-room-count">Tổng số phòng dự kiến</label><div class="be-unit"><input id="bc-room-count" value="0" readonly /><span>phòng</span></div><small>Tổng số phòng / căn hộ đã thêm vào tòa nhà.</small></div></div><p class="bc-tip"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 11v6M12 7h.01"/></svg><span>Thông tin quy mô không tự tạo phòng. Sau khi lưu tòa nhà, bạn có thể thêm từng phòng tại mục Phòng.</span></p></section>
<section class="be-card bc-contact"><div class="be-section-heading"><span class="be-section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20v-2a6.5 6.5 0 0 1 13 0v2"/></svg></span><div><h2>Người phụ trách &amp; liên hệ</h2><p>Thông tin liên hệ để phối hợp quản lý và xử lý công việc của tòa nhà.</p></div></div><div class="be-fields"><div><label asp-for="QuanLyId">Người phụ trách</label><select class="form-select" asp-for="QuanLyId" asp-items="Model.QuanLyOptions"><option value="">Chưa phân công</option></select><span asp-validation-for="QuanLyId" class="text-danger"></span></div><div><label for="bc-role">Vai trò</label><input id="bc-role" value="Quản lý tòa nhà" readonly /></div><div><label for="bc-phone">Số điện thoại</label><input id="bc-phone" placeholder="Theo hồ sơ tài khoản quản lý" disabled /></div><div><label for="bc-email">Email (không bắt buộc)</label><input id="bc-email" placeholder="Theo hồ sơ tài khoản quản lý" disabled /></div></div></section>
<section class="be-card bc-operation"><div class="be-section-heading"><span class="be-section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 7h9M5 17h9"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/></svg></span><div><h2>Trạng thái vận hành &amp; ghi chú</h2><p>Thiết lập trạng thái hiện tại và lưu các lưu ý nội bộ.</p></div></div><div class="be-fields"><div class="be-wide"><label for="bc-status">Trạng thái vận hành</label><select id="bc-status" aria-label="Trạng thái vận hành"><option value="active">Đang hoạt động</option></select><small>Tòa nhà sẵn sàng để thiết lập phòng và quản lý vận hành.</small></div><div class="be-wide"><label asp-for="GhiChu">Ghi chú (không bắt buộc)</label><textarea class="form-control" asp-for="GhiChu" rows="3" placeholder="Ví dụ: Tòa nhà có thang máy, khu để xe tại tầng trệt. Liên hệ người phụ trách trước khi đến khảo sát."></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div></div></section>
</div><aside class="be-aside">
<section class="be-card bc-summary"><h2 class="bc-summary-title"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2M9 9h6m-6 4h6m-6 4h4"/></svg>Tóm tắt tòa nhà</h2><div class="bc-summary-name"><span class="be-section-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 21V9h6m0 12V3h8v18m0-10h3v10H2m11-15h2m-2 4h2m-2 4h2M6 12v2m0 3v1"/></svg></span><div><strong data-bc="name">Tên tòa nhà</strong><small data-bc="type">Mã tạo sau khi lưu · Căn hộ</small></div></div><div class="bc-scale"><p class="bc-overline">QUY MÔ KHAI BÁO</p><div class="bc-stats"><div><b data-bc="floors">—</b><small>Số tầng</small></div><div><b>0</b><small>phòng đã tạo</small></div></div></div><dl><div><dt>Địa chỉ</dt><dd data-bc="address">Chưa nhập địa chỉ</dd></div><div><dt>Phụ trách</dt><dd data-bc="manager">Chưa phân công</dd></div><div><dt>Điện thoại</dt><dd>Theo hồ sơ quản lý</dd></div><div><dt>Vận hành</dt><dd><span class="bc-state">● Đang hoạt động</span></dd></div></dl><p class="bc-summary-foot"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 3H5v18h14v-8M13 3v6h6m-6-6 6 6m-9 5h5m-5 3h3"/></svg>Thông tin chưa được lưu.</p></section>
<section class="be-card bc-photo"><h2>Ảnh tòa nhà</h2><p>Thêm ảnh đại diện để dễ nhận diện tòa nhà trong danh sách. Không bắt buộc.</p><div class="bc-upload"><span class="bc-photo-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13 4H4v16h16v-8M17 2v6m-3-3h6M5 17l5-6 4 4 3-3 3 4"/><circle cx="8" cy="8" r="1"/></svg></span><strong>Kéo thả ảnh vào đây hoặc</strong><button type="button" disabled title="Chưa hỗ trợ lưu ảnh riêng cho tòa nhà"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v6h16v-6"/></svg>Chọn ảnh</button><small>JPG, PNG · Tối đa 5 MB</small></div><p class="bc-photo-guidance">Nên dùng ảnh mặt tiền rõ nét, tỷ lệ 4:3.</p><p class="bc-photo-unavailable">Chưa hỗ trợ lưu ảnh riêng; ảnh đại diện hiện lấy từ phòng trong tòa nhà.</p></section>
<section class="bc-note"><strong>♧ Tiếp theo: thêm phòng</strong><p>Sau khi lưu, thêm phòng để quản lý giá thuê, diện tích và sức chứa. Bạn có thể dùng chức năng tạo nhanh để thêm nhiều phòng cùng lúc.</p></section>
</aside></div>
<footer class="be-footer"><span>ⓘ Chỉ những tòa nhà thuộc quyền quản lý của bạn được hiển thị.</span><div><a asp-action="ToaNha" class="be-cancel btn btn-outline-secondary">Hủy</a><button class="btn btn-dark" type="submit">✓ Lưu tòa nhà</button></div></footer>
</form></div>
@section Styles { <link rel="stylesheet" href="~/css/building-edit.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/building-create.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/building-create-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/building-create.js" asp-append-version="true"></script> }
