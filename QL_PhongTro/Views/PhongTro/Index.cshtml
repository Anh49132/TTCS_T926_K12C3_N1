@model QL_PhongTro.ViewModels.DanhSachPhongViewModel
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{ ViewData["Title"] = "Quản lý phòng"; var write = await Permissions.AllowsAsync("PHONG_TRO", true); var vn = CultureInfo.GetCultureInfo("vi-VN"); var total = Model.SoLuongTheoTrangThai.Values.Sum(); var rented = Model.SoLuongTheoTrangThai.GetValueOrDefault("DANG_THUE"); var vacant = Model.SoLuongTheoTrangThai.GetValueOrDefault("TRONG"); var stopped = Model.SoLuongTheoTrangThai.GetValueOrDefault("NGUNG_CHO_THUE"); }
<div class="room-management room-management-bootstrap">
<header class="rm-heading"><div><h1>Quản lý phòng</h1><p>Theo dõi tình trạng, khách thuê và giá thuê tại tất cả cơ sở của bạn.</p></div><div class="rm-header-actions"><button type="button" id="rm-export" class="rm-button rm-export btn btn-outline-secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 16v5h16v-5"/></svg><span>Xuất danh sách</span></button>@if (write && Model.ToaNhaOptions.Count > 0) { <button type="button" id="rm-add-room" class="rm-button rm-primary btn btn-dark" aria-haspopup="dialog" aria-controls="rm-create-choice">＋ Thêm phòng</button> }</div></header>
@if (TempData["RoomWarning"] is string warning) { <div class="alert alert-warning">@warning</div> }
<section class="rm-stats"><article><span>Tổng số phòng <i class="rm-stat-icon rm-stat-building"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V5h10v16M15 9h4v12M3 21h18M8 8h1m2 0h1M8 11h1m2 0h1M8 14h1m2 0h1M9 21v-4h3v4"/></svg></i></span><strong>@total <small>phòng</small></strong><p>@Model.ToaNhaOptions.Count cơ sở đang quản lý</p></article><article><span>Đang thuê <i class="rm-stat-icon rm-stat-key"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 14a6 6 0 1 0-5-5L3 16v5h5v-3h3l4-4Z"/></svg></i></span><strong>@rented <small>/ @total phòng</small></strong><p>Tỷ lệ lấp đầy @(total == 0 ? "0" : (100m * rented / total).ToString("0.#", vn))%</p></article><article><span>Còn trống <i class="rm-stat-icon rm-stat-door"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21h16M7 21V5l9-2v18M16 5h3v16M12 12h.01"/></svg></i></span><strong>@vacant.ToString("D2") <small>phòng</small></strong><p>Sẵn sàng đón khách mới</p></article><article><span>Ngừng cho thuê <i class="rm-stat-icon rm-stat-wrench"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4a5 5 0 0 0-6 6L3 16v5h5l7-7a5 5 0 0 0 6-6l-4 4-4-4Z"/></svg></i></span><strong>@stopped.ToString("D2") <small>phòng</small></strong><p>Tạm ngừng cho thuê</p></article></section>
<div class="rm-attention"><span class="rm-vacancy-message"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V5l10-2v18M15 7h4v14H3m8-9h.01"/></svg><span>@rented phòng đang thuê · Doanh thu tiền phòng dự kiến @Model.DoanhThuPhongDangThue.ToString("N0", vn) đ / tháng</span></span><a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-trangThaiFilter="DANG_THUE">Xem phòng đang thuê <svg class="rm-vacancy-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a></div>
<section class="rm-panel"><div class="rm-panel-heading"><h2>Danh sách phòng <small>@total phòng</small></h2><div class="rm-view"><button type="button" data-view="list" aria-label="Danh sách" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg></button><button type="button" data-view="grid" aria-label="Lưới" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></svg></button></div></div>
<nav class="rm-tabs nav"><a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" class="@(Model.TrangThaiFilter == null ? "active" : "")">Tất cả <small>@total</small></a>@foreach (var state in Model.TrangThaiOptions) { <a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-trangThaiFilter="@state.Value" class="@(Model.TrangThaiFilter?.ToString() == state.Value ? "active" : "")">@state.Text <small>@Model.SoLuongTheoTrangThai[state.Value!]</small></a> }</nav>
<form method="get" asp-action="Index" class="rm-filters"><label class="rm-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><input class="form-control" name="tuKhoa" value="@Model.TuKhoa" placeholder="Tìm mã phòng hoặc tên khách thuê..." aria-label="Tìm phòng hoặc khách thuê" /></label><label class="rm-filter-select"><span>Cơ sở:</span><select class="form-select" asp-for="ToaNhaId" asp-items="Model.ToaNhaOptions" aria-label="Cơ sở" onchange="this.form.requestSubmit()"><option value="">Tất cả cơ sở</option></select></label><label class="rm-filter-select"><span>Trạng thái:</span><select class="form-select" asp-for="TrangThaiFilter" asp-items="Model.TrangThaiOptions" aria-label="Trạng thái" onchange="this.form.requestSubmit()"><option value="">Tất cả</option></select></label><input type="hidden" name="quanLyId" value="@Model.QuanLyId" /><button type="submit" class="visually-hidden">Tìm kiếm</button><button type="button" id="rm-sort" class="rm-button btn btn-outline-secondary"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v16m-3-3 3 3 3-3M12 5h9M12 9h6M12 13h3"/></svg>Số phòng tăng dần</button></form>
<div class="rm-table-scroll"><table class="rm-table table align-middle mb-0"><thead><tr><th>Phòng</th><th>Cơ sở</th><th>Khách thuê</th><th>Giá thuê / tháng</th><th>Tình trạng</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var room in Model.PhongTros) { var building = Model.ToaNhaOptions.FirstOrDefault(x => x.Value == room.ToaNhaId.ToString())?.Text ?? "—"; var tenant = Model.KhachTheoPhong.GetValueOrDefault(room.Id); <tr data-code="@room.MaPhong"><td><strong>@room.MaPhong</strong><small>Tầng @room.Tang · @room.DienTich.ToString("0.#", vn) m²</small></td><td><a asp-action="ChiTietToaNha" asp-route-id="@room.ToaNhaId">@building</a></td><td><div class="rm-tenant"><span class="rm-avatar">@(tenant == null ? "♙" : tenant[..1])</span><div>@(tenant ?? "Chưa có khách thuê")<small>@(tenant == null ? "Chưa ghi nhận người thuê" : "Người đứng tên hợp đồng")</small></div></div></td><td><strong>@room.GiaThue.ToString("N0", vn) đ</strong><small>/ tháng</small></td><td><span class="rm-status @(room.TrangThai == "TRONG" ? "vacant" : "")">● @QL_PhongTro.Controllers.PhongTroController.StatusLabel(Enum.Parse<QL_PhongTro.ViewModels.TrangThaiPhong>(room.TrangThai))</span></td><td class="rm-actions"><a asp-action="Details" asp-route-id="@room.Id" class="rm-detail">Chi tiết</a>@if (write) { <a asp-action="Edit" asp-route-id="@room.Id" class="rm-edit" aria-label="Sửa phòng @room.MaPhong">✎</a><details><summary aria-label="Thao tác phòng @room.MaPhong">⋯</summary><div>@if ((User.IsInRole("CHU_NHA") || User.IsInRole("ADMIN")) && room.TrangThai == "TRONG") { <a asp-controller="TinDang" asp-action="Tao" asp-route-phongId="@room.Id">Đăng tin</a> }@if (User.IsInRole("CHU_NHA") || User.IsInRole("ADMIN")) { <a asp-action="NhatKyPhong" asp-route-phongId="@room.Id">Nhật ký</a> }<form asp-action="Delete" asp-route-id="@room.Id" method="post" data-confirm="Bạn có chắc muốn xóa phòng @room.MaPhong? Phòng có dữ liệu liên quan sẽ không được xóa."><button type="submit">Xóa phòng</button></form></div></details> }</td></tr> }
</tbody></table></div><p id="rm-empty" hidden>Không có phòng phù hợp với bộ lọc.</p><footer class="rm-pagination"><span id="rm-count"></span><select class="form-select" id="rm-page-size" aria-label="Số phòng mỗi trang"><option value="10">10 / trang</option><option value="20">20 / trang</option><option value="50">50 / trang</option></select><nav id="rm-pages" aria-label="Phân trang phòng"></nav></footer>
</section>@if (Model.ToaNhaOptions.Count == 0 && write) { <a asp-action="TaoToaNha" class="rm-button">Khai báo tòa nhà</a> }</div>
@if (write && Model.ToaNhaOptions.Count > 0) {
<dialog id="rm-create-choice" class="rm-create-choice" aria-labelledby="rm-choice-title" aria-describedby="rm-choice-description">
    <button type="button" class="rm-choice-close" aria-label="Đóng lựa chọn">×</button>
    <h2 id="rm-choice-title">Bạn muốn tạo phòng theo cách nào?</h2>
    <p id="rm-choice-description">Chọn cách thêm phòng phù hợp với nhu cầu của bạn.</p>
    <div class="rm-choice-options">
        <a asp-action="Create" asp-route-toaNhaId="@Model.ToaNhaId"><span class="rm-choice-symbol" aria-hidden="true">＋</span><span><strong>Tạo một phòng</strong><small>Nhập thông tin chi tiết cho từng phòng.</small></span><span aria-hidden="true">›</span></a>
        <a asp-action="CreateBulk" asp-route-toaNhaId="@Model.ToaNhaId"><span class="rm-choice-symbol" aria-hidden="true">▦</span><span><strong>Tạo nhanh nhiều phòng</strong><small>Tạo một loạt phòng với thông tin chung.</small></span><span aria-hidden="true">›</span></a>
    </div>
    <button type="button" class="rm-choice-cancel">Hủy</button>
</dialog>
}
@section Styles { <link rel="stylesheet" href="~/css/room-management.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/room-management-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/room-management.js" asp-append-version="true"></script> }
