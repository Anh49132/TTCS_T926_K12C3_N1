@model QL_PhongTro.ViewModels.ChiTietPhongViewModel
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    var room = Model.Phong;
    var building = Model.ToaNha;
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    var write = await Permissions.AllowsAsync("PHONG_TRO", true);
    var finance = await Permissions.AllowsAsync("TAI_CHINH");
    var contract = await Permissions.AllowsAsync("HOP_DONG");
    ViewData["Title"] = "Chi tiết phòng " + room.MaPhong;
    var location = string.Join(", ", new[] { building.QuanHuyen, building.TinhThanh }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<div class="room-overview">

<header class="rd-heading"><div class="rd-room-title"><span class="rd-room-icon">▯</span><div><h1>Chi tiết phòng @room.MaPhong <span class="rd-state">● @QL_PhongTro.Controllers.PhongTroController.StatusLabel(Enum.Parse<QL_PhongTro.ViewModels.TrangThaiPhong>(room.TrangThai))</span></h1><p>@building.TenToaNha · @location</p></div></div><div class="rd-actions">@if (finance) { <button type="button" disabled title="Chưa hỗ trợ tạo hóa đơn trực tiếp tại trang này">▤ Tạo hóa đơn</button> }@if (write) { <a class="rd-primary" asp-action="Edit" asp-route-id="@room.Id">✎ Chỉnh sửa phòng</a> }<button type="button" disabled aria-label="Thao tác khác chưa hỗ trợ">⋯</button></div></header>
<nav class="rd-tabs"><span class="active">Chi tiết phòng</span>@if (contract) { <button disabled>Hợp đồng &amp; khách thuê</button> }@if (finance) { <button disabled>Hóa đơn &amp; thanh toán</button> }<button disabled>Lịch sử hoạt động</button></nav>
<div class="rd-layout"><div class="rd-main">
<section class="rd-card" aria-labelledby="room-photos-title">
    <div class="rd-card-title"><h2 id="room-photos-title"><span class="rd-icon">▣</span>Ảnh phòng</h2><span class="rd-muted">@Model.Anh.Count ảnh</span></div>
    @if (Model.Anh.Count == 0)
    {
        <p class="rd-empty">Phòng chưa có ảnh.</p>
    }
    else
    {
        <div class="rd-photo-grid">
            @foreach (var image in Model.Anh)
            {
                <a class="rd-photo" href="@image.DuongDan" target="_blank" rel="noopener" aria-label="Xem ảnh phòng @room.MaPhong thứ @image.ThuTu">
                    <img src="@(image.DuongDanAnhNho ?? image.DuongDan)" alt="Ảnh phòng @room.MaPhong thứ @image.ThuTu" loading="lazy" />
                    @if (image.ThuTu == 1)
                    {
                        <span class="rd-photo-primary">Ảnh đại diện</span>
                    }
                    <span class="rd-photo-caption">Ảnh @image.ThuTu · Xem ảnh lớn ↗</span>
                </a>
            }
        </div>
    }
</section>
<section class="rd-card"><h2><span class="rd-icon">▥</span>Thông tin cơ bản</h2><dl class="rd-info"><div><dt>Số / tên phòng</dt><dd>@room.MaPhong</dd></div><div><dt>Cơ sở</dt><dd>@building.TenToaNha</dd></div><div><dt>Khu vực</dt><dd>@(string.IsNullOrEmpty(location) ? "Chưa khai báo" : location)</dd></div><div><dt>Tầng</dt><dd>Tầng @room.Tang</dd></div><div><dt>Diện tích</dt><dd>@room.DienTich.ToString("0.#", vn) m²</dd></div><div><dt>Số người đang ở / tối đa</dt><dd>— / @room.SoNguoiToiDa người</dd></div></dl><div class="rd-divider"><h3>Tiện nghi có sẵn</h3><div class="rd-amenities"><span>♧ Điều hòa</span><span>▤ Bình nóng lạnh</span><span>▯ Giường</span><span>▥ Tủ quần áo</span><span>⌂ Khu bếp riêng</span></div><p class="rd-unavailable">Khung minh họa; chưa có dữ liệu tiện nghi và số người đang ở tại trang này.</p></div></section>
@if (finance) {
<section class="rd-card"><div class="rd-card-title"><h2><span class="rd-icon">▤</span>Thanh toán &amp; hóa đơn</h2><a asp-controller="HoaDonDichVu" asp-action="Index" asp-route-toaNhaId="@room.ToaNhaId">Xem tất cả ↗</a></div><div class="rd-payment"><div><small>Cần thu · kỳ hiện tại</small><strong>— đ</strong></div><div><small>Hạn thanh toán: —</small><small>Đã thu: — · Chưa thu: —</small><small>Chưa có dữ liệu tổng hợp tại đây</small></div></div><div class="rd-invoice-head"><span>Hóa đơn / kỳ thu</span><span>Hạn thanh toán</span><span>Tổng tiền</span><span>Trạng thái</span></div><p class="rd-empty">Chưa kết nối danh sách hóa đơn của phòng vào trang chi tiết phòng.</p><p class="rd-muted">Khung hiển thị 3 hóa đơn gần nhất · Không bao gồm nợ kỳ trước.</p></section>
}
<section class="rd-card"><div class="rd-card-title"><h2><span class="rd-icon">✎</span>Ghi chú &amp; bảo trì</h2><button disabled>Thêm ghi chú</button></div><small class="rd-muted">GHI CHÚ NỘI BỘ · CHỈ CHỦ NHÀ XEM</small><p class="rd-empty">Chưa hỗ trợ ghi chú nội bộ cho phòng tại đây.</p><div class="rd-maintenance"><span>⚒</span><div><h3>Lịch sử bảo trì</h3><p>Chưa kết nối dữ liệu bảo trì.</p></div><button disabled>Chưa hỗ trợ</button></div></section>
</div><aside class="rd-aside">
@if (contract) {
<section class="rd-card"><h2><span class="rd-icon">♙</span>Khách thuê &amp; hợp đồng</h2><div class="rd-tenant"><span class="rd-avatar">—</span><div><h3>Chưa kết nối thông tin khách thuê</h3><p>Không hiển thị dữ liệu cá nhân mẫu.</p></div></div><p class="rd-muted">Điện thoại: —</p><p class="rd-muted">Email: —</p><button class="rd-text-button" disabled>Xem hồ sơ khách thuê →</button><div class="rd-divider"><div class="rd-contract-heading"><strong>Hợp đồng: —</strong><span class="rd-state">Chưa kết nối</span></div><dl class="rd-info rd-two"><div><dt>Ngày bắt đầu</dt><dd>—</dd></div><div><dt>Ngày kết thúc</dt><dd>—</dd></div><div><dt>Chu kỳ thanh toán</dt><dd>—</dd></div><div><dt>Ngày thu tiền</dt><dd>—</dd></div></dl><button class="rd-full" disabled>Xem hợp đồng</button>@if (User.IsInRole("CHU_NHA")) { <a class="rd-history" asp-controller="HopDong" asp-action="LichSuNguoiO" asp-route-phongId="@room.Id">Xem lịch sử người ở ↗</a> }</div></section>
}
<section class="rd-card"><h2><span class="rd-icon">▣</span>Giá thuê &amp; phí dịch vụ</h2><p class="rd-muted">Giá thuê hàng tháng</p><div class="rd-price">@room.GiaThue.ToString("N0", vn) đ <small>/ tháng</small></div><div class="rd-deposit"><div><span>Tiền cọc đang giữ</span><small>Chưa kết nối sổ cọc</small></div><strong>— đ</strong></div><h3 class="rd-divider">Phí dịch vụ áp dụng</h3><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 3-8 11h6l-1 7 9-12h-6l1-6Z" /></svg>Điện</span><span>— đ<small>/ kWh</small></span></div><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5c-1 3-5 6-5 9a5 5 0 0 0 10 0c0-3-4-6-5-9ZM16 3c0 2 3 4 3 6a3 3 0 0 1-3 3M8 15c0 1 1 2 2 2" /></svg>Nước</span><span>— đ<small>/ m³</small></span></div><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8a14 14 0 0 1 18 0M6 11a9 9 0 0 1 12 0M9 14a5 5 0 0 1 6 0" /><circle cx="12" cy="18" r=".8" /></svg>Internet</span><span>— đ<small>/ phòng / tháng</small></span></div><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M9 6V3h6v3M7 6l1 15h8l1-15M10 10v7m4-7v7" /></svg>Vệ sinh</span><span>— đ<small>/ người / tháng</small></span></div><p class="rd-unavailable">Các dòng phí chỉ là khung giao diện, chưa kết nối dịch vụ áp dụng của phòng.</p></section>
</aside></div><footer class="rd-footer"><span>Thông tin phòng lấy từ dữ liệu hiện có.</span><span>Nội dung chưa kết nối hiển thị dấu “—”.</span></footer>
<p class="rd-unavailable">Tạm chưa hoạt động: tạo hóa đơn tại trang này, các tab phụ, xem hồ sơ/hợp đồng, thêm ghi chú và bảo trì. Các khối hóa đơn, khách thuê, hợp đồng, cọc, phí dịch vụ và tiện nghi chưa kết nối dữ liệu vào trang chi tiết phòng.</p>
</div>
@section Styles { <link rel="stylesheet" href="~/css/room-overview.css" asp-append-version="true" /> }
