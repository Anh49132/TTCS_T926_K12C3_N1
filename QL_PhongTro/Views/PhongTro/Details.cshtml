@model QL_PhongTro.ViewModels.ChiTietPhongViewModel
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    var room = Model.Phong;
    var building = Model.ToaNha;
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    var write = await Permissions.AllowsAsync("PHONG_TRO", true);
    var finance = await Permissions.AllowsAsync("TAI_CHINH");
    var contract = await Permissions.AllowsAsync("HOP_DONG");
    ViewData["Title"] = "Chi tiết phòng " + room.MaPhong;
    var location = string.Join(", ", new[] { building.QuanHuyen, building.TinhThanh }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
<div class="room-overview room-detail-bootstrap">

<header class="rd-heading"><div class="rd-room-title"><span class="rd-room-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 4h9v16H8M8 4l5-1v18l-5-1V4ZM4 21h16M11 12h.01" /></svg></span><div><h1>Phòng @room.MaPhong <span class="rd-state">● @QL_PhongTro.Controllers.PhongTroController.StatusLabel(Enum.Parse<QL_PhongTro.ViewModels.TrangThaiPhong>(room.TrangThai))</span></h1><p>@building.TenToaNha · @location</p></div></div><div class="rd-actions">@if (finance) { <button type="button" disabled title="Chưa hỗ trợ tạo hóa đơn trực tiếp tại trang này">▤ Tạo hóa đơn</button> }@if (write) { <a class="rd-primary btn btn-dark" asp-action="Edit" asp-route-id="@room.Id">✎ Chỉnh sửa phòng</a> }</div></header>
<nav class="rd-tabs nav"><span class="active">Tổng quan phòng</span>@if (contract) { <button disabled>Hợp đồng &amp; khách thuê</button> }@if (finance) { <button disabled>Hóa đơn &amp; thanh toán</button> }<button disabled>Lịch sử hoạt động</button></nav>
<div class="rd-layout"><div class="rd-main">

<section class="rd-card"><h2><span class="rd-icon">▥</span>Thông tin cơ bản</h2><dl class="rd-info"><div><dt>Số / tên phòng</dt><dd>@room.MaPhong</dd></div><div><dt>Cơ sở</dt><dd>@building.TenToaNha</dd></div><div><dt>Khu vực</dt><dd>@(string.IsNullOrEmpty(location) ? "Chưa khai báo" : location)</dd></div><div><dt>Tầng</dt><dd>Tầng @room.Tang</dd></div><div><dt>Diện tích</dt><dd>@room.DienTich.ToString("0.#", vn) m²</dd></div><div><dt>Số người đang ở / tối đa</dt><dd>— / @room.SoNguoiToiDa người</dd></div></dl><div class="rd-divider"><h3>Tiện nghi có sẵn</h3><div class="rd-amenities"><span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="8" rx="2"/><path d="M6 9h12M8 15v3l-2 2M12 15v6M16 15v3l2 2"/></svg>Điều hòa</span><span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="6" width="14" height="15" rx="2"/><path d="M8 3v6M12 2v7M16 3v6M8 13h8M9 17h.01M15 17h.01"/></svg>Bình nóng lạnh</span><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12V5h16v7M4 9h16M12 5v4M3 12h18v7H3ZM4 19v2M20 19v2"/></svg>Giường</span><span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6m0-6-6 6"/></svg>Tủ quần áo</span><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 10h14v10H5ZM3 10h18M6 6h12M12 6l4-3M9 2v2M15 2v2"/></svg>Khu bếp riêng</span></div><p class="rd-unavailable">Khung minh họa; chưa có dữ liệu tiện nghi và số người đang ở tại trang này.</p></div><div class="rd-divider rd-room-photos" aria-labelledby="room-photos-title">
    <div class="rd-card-title"><h2 id="room-photos-title"><span class="rd-icon rd-photo-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m5 18 5-5 3 3 4-6 3 4"/></svg></span>Ảnh phòng</h2><span class="rd-muted">@Model.Anh.Count ảnh</span></div>
    @if (Model.Anh.Count == 0)
    {
        <p class="rd-empty">Phòng chưa có ảnh.</p>
    }
    else
    {
        <div class="rd-photo-grid">
            @foreach (var image in Model.Anh)
            {
                <a class="rd-photo" href="@image.DuongDan" target="_blank" rel="noopener" aria-label="Xem ảnh phòng @room.MaPhong thứ @image.ThuTu">
                    <img src="@(image.DuongDanAnhNho ?? image.DuongDan)" alt="Ảnh phòng @room.MaPhong thứ @image.ThuTu" loading="lazy" />
                    @if (image.ThuTu == 1)
                    {
                        <span class="rd-photo-primary">Ảnh đại diện</span>
                    }
                    <span class="rd-photo-caption">Ảnh @image.ThuTu · Xem ảnh lớn ↗</span>
                </a>
            }
        </div>
    }
</div></section>
@if (finance) {
<section class="rd-card"><div class="rd-card-title"><h2><span class="rd-icon rd-payment-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 2v3M15 2v3M15 8h-5a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H9M12 6v12"/></svg></span>Thanh toán &amp; hóa đơn</h2><a asp-controller="HoaDonDichVu" asp-action="Index" asp-route-toaNhaId="@room.ToaNhaId">Xem tất cả ↗</a></div><div class="rd-payment"><div><small>Cần thu · kỳ hiện tại</small><strong>— đ</strong></div><div><small>Hạn thanh toán: —</small><small>Đã thu: — · Chưa thu: —</small><a class="rd-payment-link" href="@Url.Action("Index", "HoaDonDichVu", new { toaNhaId = room.ToaNhaId })">Xem hóa đơn →</a></div></div><div class="rd-invoice-head"><span>Hóa đơn / kỳ thu</span><span>Hạn thanh toán</span><span>Tổng tiền</span><span>Trạng thái</span></div><div class="rd-invoice-empty"><span>Chưa có dữ liệu hóa đơn tại đây.</span><small>Xem danh sách hóa đơn để tra cứu các khoản thu.</small></div><p class="rd-muted">Khung hiển thị 3 hóa đơn gần nhất · Không bao gồm nợ kỳ trước.</p></section>
}
<section class="rd-card rd-notes-card"><div class="rd-card-title"><h2><span class="rd-icon rd-notes-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13 4H6a2 2 0 0 0-2 2v14h14a2 2 0 0 0 2-2v-7M2 8h5M2 12h5M2 16h5m5-3 1-4 7-7 3 3-7 7-4 1Z"/></svg></span>Ghi chú &amp; bảo trì</h2><button disabled>Thêm ghi chú</button></div>@if (User.IsInRole("CHU_NHA")) { <small class="rd-muted">GHI CHÚ NỘI BỘ · CHỈ CHỦ NHÀ XEM</small><p class="rd-note-content">@(string.IsNullOrWhiteSpace(room.GhiChuNoiBo) ? "Chưa có ghi chú nội bộ." : room.GhiChuNoiBo)</p> }<div class="rd-maintenance"><span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 4a5 5 0 0 0-6 6l-5 5a2 2 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3 3-3Z"/></svg></span><div><h3>Lịch sử bảo trì</h3><p>Chưa kết nối dữ liệu bảo trì.</p></div><button disabled>Chưa hỗ trợ</button></div></section>
</div><aside class="rd-aside">
@if (contract) {
<section class="rd-card"><h2><span class="rd-icon rd-people-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="7" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4v2"/></svg></span>Khách thuê &amp; hợp đồng</h2><div class="rd-tenant"><span class="rd-avatar">—</span><div><h3>Chưa kết nối thông tin khách thuê</h3><p>Không hiển thị dữ liệu cá nhân mẫu.</p></div></div><p class="rd-muted">Điện thoại: —</p><p class="rd-muted">Email: —</p><button class="rd-text-button" disabled>Xem hồ sơ khách thuê →</button><div class="rd-divider"><div class="rd-contract-heading"><strong>Hợp đồng: —</strong><span class="rd-state">Chưa kết nối</span></div><dl class="rd-info rd-two"><div><dt>Ngày bắt đầu</dt><dd>—</dd></div><div><dt>Ngày kết thúc</dt><dd>—</dd></div><div><dt>Chu kỳ thanh toán</dt><dd>—</dd></div><div><dt>Ngày thu tiền</dt><dd>—</dd></div></dl><button class="rd-full" disabled>Xem hợp đồng</button>@if (User.IsInRole("CHU_NHA")) { <a class="rd-history" asp-controller="HopDong" asp-action="LichSuNguoiO" asp-route-phongId="@room.Id">Xem lịch sử người ở ↗</a> }</div></section>
}
<section class="rd-card"><h2><span class="rd-icon rd-wallet-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 7V5a2 2 0 0 0-2-2H6a3 3 0 0 0 0 6h13v11H6a3 3 0 0 1-3-3V6M19 12h-5v5h7v-5h-2ZM17 14.5h.01"/></svg></span>Giá thuê &amp; phí dịch vụ</h2><p class="rd-muted">Giá thuê hàng tháng</p><div class="rd-price">@room.GiaThue.ToString("N0", vn) đ <small>/ tháng</small></div><div class="rd-deposit"><div><span>Tiền cọc đang giữ</span><small>Chưa kết nối sổ cọc</small></div><strong>— đ</strong></div><h3 class="rd-divider">Phí dịch vụ áp dụng</h3><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 3-8 11h6l-1 7 9-12h-6l1-6Z" /></svg>Điện</span><span>— đ<small>/ kWh</small></span></div><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5c-1 3-5 6-5 9a5 5 0 0 0 10 0c0-3-4-6-5-9ZM16 3c0 2 3 4 3 6a3 3 0 0 1-3 3M8 15c0 1 1 2 2 2" /></svg>Nước</span><span>— đ<small>/ m³</small></span></div><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8a14 14 0 0 1 18 0M6 11a9 9 0 0 1 12 0M9 14a5 5 0 0 1 6 0" /><circle cx="12" cy="18" r=".8" /></svg>Internet</span><span>— đ<small>/ phòng / tháng</small></span></div><div class="rd-fee"><span class="rd-fee-name"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M9 6V3h6v3M7 6l1 15h8l1-15M10 10v7m4-7v7" /></svg>Vệ sinh</span><span>— đ<small>/ người / tháng</small></span></div><p class="rd-unavailable">Các dòng phí chỉ là khung giao diện, chưa kết nối dịch vụ áp dụng của phòng.</p></section>
</aside></div><footer class="rd-footer"><span>Thông tin phòng lấy từ dữ liệu hiện có.</span><span>Nội dung chưa kết nối hiển thị dấu “—”.</span></footer>
<p class="rd-unavailable">Tạm chưa hoạt động: tạo hóa đơn tại trang này, các tab phụ, xem hồ sơ/hợp đồng, thêm ghi chú và bảo trì. Các khối hóa đơn, khách thuê, hợp đồng, cọc, phí dịch vụ và tiện nghi chưa kết nối dữ liệu vào trang chi tiết phòng.</p>
</div>
@section Styles { <link rel="stylesheet" href="~/css/room-overview.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/room-detail-bootstrap.css" asp-append-version="true" /> }
