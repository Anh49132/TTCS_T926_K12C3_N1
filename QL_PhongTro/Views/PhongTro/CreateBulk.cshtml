@model QL_PhongTro.ViewModels.TaoPhongHangLoatViewModel
@{ ViewData["Title"] = "Tạo nhanh phòng"; }
<div class="room-bulk-page room-bulk-bootstrap">
<header class="rb-heading"><div><h1>Tạo nhanh phòng</h1><p>Thiết lập một loạt phòng cùng tòa nhà, cùng diện tích và cùng giá thuê. Xem trước tất cả phòng trước khi tạo đồng loạt.</p></div><span class="rb-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 3-9 11h7l-1 7 10-12h-7l1-6Z" /></svg>Tạo đồng loạt</span></header>
<form asp-action="CreateBulk" method="post" novalidate id="room-bulk-form">
<div asp-validation-summary="ModelOnly" class="text-danger rb-errors"></div>
<div class="rb-layout"><div class="rb-main">
<section class="rb-card"><div class="rb-card-heading"><span class="rb-icon rb-door-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3h7v18H9Z"/><path d="m9 3 4 2v14l-4 2M11 12h.1"/></svg></span><div><h2>Cài đặt chung cho loạt phòng</h2><p>Thiết lập thông tin chung cho tất cả phòng trong loạt. Các trường có dấu * là bắt buộc.</p></div><small><em>*</em> Bắt buộc</small></div>
<div class="rb-fields">
<div><label asp-for="ToaNhaId">Tòa nhà <em>*</em></label><select class="form-select" asp-for="ToaNhaId" asp-items="Model.ToaNhaOptions"><option value="">Chọn tòa nhà</option></select><span asp-validation-for="ToaNhaId" class="text-danger"></span></div>
<div><label asp-for="SoTang">Số tầng <em>*</em></label><input class="form-control" asp-for="SoTang" type="number" min="1" max="99" step="1" placeholder="3" /><small>Tạo lần lượt từ tầng 1 đến tầng đã nhập.</small><span asp-validation-for="SoTang" class="text-danger"></span></div>
<div><label asp-for="DienTich">Diện tích mỗi phòng <em>*</em></label><div class="rb-unit"><input class="form-control" asp-for="DienTich" type="number" min="0.01" step="0.01" placeholder="25" /><span>m²</span></div><small>Áp dụng cho tất cả phòng trong loạt.</small><span asp-validation-for="DienTich" class="text-danger"></span></div>
<div><label asp-for="GiaThueDisplay">Giá thuê hàng tháng <em>*</em></label><div class="rb-unit"><input class="form-control" asp-for="GiaThueDisplay" inputmode="numeric" autocomplete="off" placeholder="4.500.000" data-vnd-input /><span>đ / tháng</span></div><small>Giá mặc định cho tất cả phòng trong loạt.</small><span asp-validation-for="GiaThue" class="text-danger"></span></div>
<div><label asp-for="SoPhongMoiTang">Số phòng mỗi tầng <em>*</em></label><input class="form-control" asp-for="SoPhongMoiTang" type="number" min="1" max="99" step="1" placeholder="5" /><small>Tạo cùng số lượng phòng trên mỗi tầng.</small><span asp-validation-for="SoPhongMoiTang" class="text-danger"></span></div>
<div><label for="rb-code-rule">Quy tắc mã phòng</label><input class="form-control" id="rb-code-rule" value="Tầng + 2 chữ số thứ tự" readonly /><small>Ví dụ: tầng 3 tạo 301, 302, 303, …</small></div>

</div>
<div class="rb-status"><div><label asp-for="TrangThai">Trạng thái ban đầu <em>*</em></label><small>Tất cả phòng trong loạt sẽ được tạo với trạng thái này.</small></div><select class="form-select" asp-for="TrangThai" asp-items="Html.GetEnumSelectList<QL_PhongTro.ViewModels.TrangThaiPhong>()"><option value="">Chọn trạng thái</option></select></div><span asp-validation-for="TrangThai" class="text-danger"></span>
</section>
<details class="rb-card rb-additional"><summary><span class="rb-icon rb-sliders-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 7h5m4 0h5M5 12h9m4 0h1M5 17h2m4 0h8M10 5v4m4 1v4m-7 1v4"/></svg></span><div><div class="rb-additional-title"><strong>Thông tin bổ sung</strong><span>Thiết lập cho cả tòa</span></div><p>Tiền cọc, số người ở, tiện ích, nội thất và ghi chú có thể được thêm sau khi tạo.</p></div><span class="rb-expand"><span>Thêm thông tin</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></span></summary><div class="rb-additional-body"><div class="rb-fields">
<div><label asp-for="TienCocDisplay">Tiền cọc dự kiến</label><div class="rb-unit"><input class="form-control" asp-for="TienCocDisplay" inputmode="numeric" data-vnd-input placeholder="0" /><span>đ</span></div><small>Để trống = 0 đ. Cọc thực nhận được ghi theo hợp đồng.</small><span asp-validation-for="TienCocDisplay" class="text-danger"></span></div>
<div><label asp-for="SoNguoiToiDa">Số người ở tối đa</label><div class="rb-unit"><input class="form-control" asp-for="SoNguoiToiDa" type="number" min="1" step="1" placeholder="3" /><span>người / phòng</span></div><small>Không bắt buộc. Để trống mặc định 1 người / phòng.</small><span asp-validation-for="SoNguoiToiDa" class="text-danger"></span></div>
<div><label asp-for="TienIch">Tiện ích</label><textarea class="form-control" asp-for="TienIch" rows="3" maxlength="500" placeholder="Ví dụ: thang máy, bãi xe, khu giặt…"></textarea><span asp-validation-for="TienIch" class="text-danger"></span></div>
<div><label asp-for="NoiThat">Nội thất</label><textarea class="form-control" asp-for="NoiThat" rows="3" maxlength="500" placeholder="Ví dụ: giường, tủ, điều hòa…"></textarea><span asp-validation-for="NoiThat" class="text-danger"></span></div>
<div class="rb-full"><label asp-for="GhiChuPhong">Ghi chú phòng</label><textarea class="form-control" asp-for="GhiChuPhong" rows="3" maxlength="1000" placeholder="Thông tin bổ sung áp dụng cho tất cả phòng trong loạt"></textarea><span asp-validation-for="GhiChuPhong" class="text-danger"></span><small>Tiện ích, nội thất và ghi chú được lưu trong mô tả phòng, có thể hiển thị trên tin đăng. Không nhập thông tin riêng tư.</small></div>
</div></div></details>
<p class="rb-hint">ⓘ Bạn có thể thêm ảnh, nội thất và phí dịch vụ cho từng phòng sau khi tạo loạt.</p>
</div><aside class="rb-preview" aria-label="Xem trước loạt phòng">
<section class="rb-card"><div class="rb-preview-heading"><h2>Loạt phòng sắp tạo</h2><span>Xem trước</span></div>
<div class="rb-building-art" aria-hidden="true"><svg viewBox="0 0 360 180"><rect width="360" height="180" fill="#e9ece8"/><circle cx="295" cy="38" r="22" fill="#e2d6be"/><path d="M0 145Q80 110 170 143T360 130V180H0" fill="#ccd4c7"/><path d="M76 150V45l105-23 103 38v90" fill="#fff"/><path d="M181 22v128h103V60" fill="#ded8cd"/><path d="M91 57l73-16v15L91 71zm0 31 73-12v15L91 102zm0 30 73-8v15l-73 6" fill="#8f9a95"/><path d="M197 52h67v13h-67zm0 31h67v13h-67zm0 31h67v13h-67z" fill="#a9b3a5"/><path d="M167 150v-23h25v23" fill="#30343b"/><path d="M50 157h260" stroke="#bfa77a" stroke-width="4"/></svg></div>
<h3 id="rb-building-name">Chưa chọn tòa nhà</h3><p class="rb-preview-description">Thông tin chung áp dụng cho tất cả phòng trong loạt.</p>
<dl class="rb-facts"><div><dt>Tòa nhà</dt><dd data-preview="building">—</dd></div><div><dt>Tầng</dt><dd data-preview="floors">—</dd></div><div><dt>Diện tích</dt><dd data-preview="area">—</dd></div><div><dt>Giá thuê</dt><dd data-preview="rent">—</dd></div><div><dt>Sức chứa</dt><dd data-preview="people">—</dd></div><div><dt>Tổng số phòng</dt><dd data-preview="total">—</dd></div></dl>
<h4>DANH SÁCH PHÒNG TRONG LOẠT</h4><p id="rb-preview-empty">Nhập số tầng và số phòng để xem trước.</p><ol id="rb-room-list"></ol><p id="rb-preview-limit" hidden></p>
</section><div class="rb-note"><strong>ⓘ Tạo loạt, chỉnh sửa sau</strong><p>Tất cả phòng trong loạt sẽ được tạo cùng lúc với thông tin chung đã thiết lập. Bạn có thể chỉnh sửa từng phòng sau khi tạo.</p></div>
</aside></div>
<footer class="rb-footer"><div class="rb-continue"><label asp-for="TaoTiep"><input asp-for="TaoTiep" /> <span>Tạo tiếp loạt phòng khác sau khi hoàn tất</span></label><small>Giữ lại tòa nhà và tầng để tạo loạt tiếp theo nhanh hơn.</small></div><div class="rb-actions"><small>Ctrl + Enter để tạo loạt</small><a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId" class="rb-cancel btn btn-outline-secondary">Hủy</a><button type="submit" class="btn btn-dark">＋ Tạo loạt phòng</button></div></footer>
</form></div>
@section Styles { <link rel="stylesheet" href="~/css/room-bulk.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/room-bulk-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/room-form.js" asp-append-version="true"></script><script src="~/js/room-bulk.js" asp-append-version="true"></script> }
