@model QL_PhongTro.ViewModels.TatToanViewModel
@{ViewData["Title"]="Lập bảng tất toán";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
@section Styles { <link rel="stylesheet" href="~/css/tat-toan.css" asp-append-version="true" /> }
<div class="settlement-page"><nav class="st-breadcrumb"><a asp-controller="HopDong" asp-action="Details" asp-route-id="@Model.Input.HopDongId">Hợp đồng &amp; người ở ghép</a> / @Model.MaHopDong / <strong>Tất toán</strong></nav><h1>Lập bảng tất toán</h1><p class="st-muted">Đối chiếu tiền cọc, công nợ và các khoản khấu trừ trước khi kết thúc hợp đồng.</p>
<partial name="_ThongTin" model="Model"/><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<form asp-action="Luu" method="post" id="settlement-form" data-estimate="@Url.Action("UocTinh")"><input asp-for="Input.HopDongId" type="hidden"/><input asp-for="Input.PhienBan" type="hidden"/><input asp-for="Input.DauVanTayNguon" type="hidden"/>
<div class="st-grid"><section class="st-card"><partial name="_ChamDutEditor" model="@(new QL_PhongTro.ViewModels.ChamDutEditor(Model.Input,Model.ChamDut!))"/><h2 class="st-space">Các khoản tất toán</h2><div class="st-deposit"><strong>◉ Tiền cọc còn giữ</strong><strong>@Model.Bang.CocConGiu.ToString("N0",vi) đ</strong></div>
@if(Model.Bang.CocConGiu==0){<p class="st-muted">Không có số dư cọc thực giữ. Cọc thỏa thuận trên hợp đồng không được coi là tiền đã thu.</p>}
<dl class="st-facts"><div><dt>Hóa đơn kỳ cuối còn nợ</dt><dd>@Model.Bang.NoHoaDonCuoi.ToString("N0",vi) đ</dd></div><div><dt>Công nợ các kỳ trước</dt><dd>@Model.Bang.CongNoCu.ToString("N0",vi) đ</dd></div></dl><partial name="_CongNo" model="Model"/>
<h2 class="st-space">Khấu trừ hư hỏng</h2><div class="st-table-wrap"><table class="st-damage-table"><thead><tr><th>Tên khoản *</th><th>Số tiền (đ) *</th><th>Ghi chú</th><th>Thao tác</th></tr></thead><tbody id="st-damage-rows">
@for(var i=0;i<Model.Input.KhauTru.Count;i++){<tr><td><input asp-for="Input.KhauTru[i].TenKhoan" class="form-control" maxlength="200" required aria-label="Tên khoản hư hỏng"/></td><td><input asp-for="Input.KhauTru[i].SoTien" type="number" class="form-control" min="0" step="0.01" required aria-label="Số tiền khấu trừ"/></td><td><input asp-for="Input.KhauTru[i].GhiChu" class="form-control" maxlength="500" aria-label="Ghi chú khoản hư hỏng"/></td><td><button class="st-remove" type="button" aria-label="Xóa khoản hư hỏng">✕</button></td></tr>}
</tbody></table></div><button type="button" id="st-add" class="st-add">＋ Thêm khoản khấu trừ</button><p class="st-muted">ⓘ Tên khoản không được để trống; số tiền không âm. Làm tròn từng khoản đến đồng trước khi cộng. Không có hư hỏng thì để danh sách trống.</p></section>
<aside class="st-card"><partial name="_KetQua" model="Model"/><p id="st-estimate-error" class="text-danger" role="status"></p><label asp-for="Input.GhiChu">Ghi chú tất toán <span class="st-muted">(khách thuê cũng xem được)</span></label><textarea asp-for="Input.GhiChu" rows="3" class="form-control" maxlength="1000" placeholder="Nhập ghi chú (nếu có)…"></textarea><div class="st-notice">Bảng nháp chưa ghi hoàn/cấn cọc và chưa kết thúc hợp đồng.</div><div class="st-actions"><a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a><button class="btn btn-outline-secondary" type="submit" asp-action="DuTinh">Xem dự tính</button><button class="btn st-primary" type="submit">Lưu bản nháp</button></div>@if(Model.Bang.Id>0){<a class="btn btn-outline-secondary st-space" asp-action="XacNhan" asp-route-id="@Model.Input.HopDongId">Kiểm tra bản đã lưu &amp; xác nhận →</a><p class="st-muted">Lưu lại các thay đổi trên form trước khi xác nhận.</p>}</aside></div></form>
<template id="st-row-template"><tr><td><input class="form-control" data-field="TenKhoan" maxlength="200" required aria-label="Tên khoản hư hỏng"/></td><td><input type="number" class="form-control" data-field="SoTien" min="0" step="0.01" required aria-label="Số tiền khấu trừ"/></td><td><input class="form-control" data-field="GhiChu" maxlength="500" aria-label="Ghi chú khoản hư hỏng"/></td><td><button class="st-remove" type="button" aria-label="Xóa khoản hư hỏng">✕</button></td></tr></template></div>
@section Scripts { <script src="~/js/cham-dut.js" asp-append-version="true"></script><script src="~/js/tat-toan.js" asp-append-version="true"></script> }
