@model QL_PhongTro.ViewModels.TatToanViewModel
@{var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");var b=Model.Bang;}
<h2>Kết quả tất toán</h2><dl class="st-facts"><div><dt>Cọc thực giữ</dt><dd>@b.CocConGiu.ToString("N0",vi) đ</dd></div><div><dt>− Hóa đơn kỳ cuối còn nợ</dt><dd>@b.NoHoaDonCuoi.ToString("N0",vi) đ</dd></div><div><dt>− Công nợ kỳ trước</dt><dd>@b.CongNoCu.ToString("N0",vi) đ</dd></div><div><dt>− Phạt cọc</dt><dd id="st-penalty-total">@b.TienPhat.ToString("N0",vi) đ</dd></div><div><dt>− Hư hỏng</dt><dd id="st-damage-total">@b.TienHuHong.ToString("N0",vi) đ</dd></div><div><dt>Tổng khấu trừ (hư hỏng + phạt)</dt><dd id="st-deduction-total">@b.TongKhauTru.ToString("N0",vi) đ</dd></div></dl>
<div id="st-result" class="st-result @(b.TienKhachTraThem>0?"is-debit":"is-credit")" aria-live="polite"><strong id="st-result-label">@(b.TienKhachTraThem>0?"Khách còn phải trả thêm":b.TienPhaiHoan>0?"Số tiền hoàn cho khách":"Hai bên vừa đủ, không thu/hoàn thêm")</strong><strong id="st-result-value">@(b.TienKhachTraThem>0?b.TienKhachTraThem.ToString("N0",vi):b.TienPhaiHoan.ToString("N0",vi)) đ</strong></div>
<p class="st-muted">Kết quả = cọc thực giữ − nợ kỳ cuối − công nợ cũ − hư hỏng − phạt cọc. Dương: hoàn khách; âm: khách trả thêm.</p>
