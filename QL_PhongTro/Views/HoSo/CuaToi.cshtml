@model QL_PhongTro.ViewModels.HoSoCaNhanViewModel
@{ ViewData["Title"] = "Hồ sơ của tôi"; }
<div class="owner-profiles op-personal personal-bootstrap @(User.IsInRole("ADMIN") ? "admin-personal-bootstrap" : "")">
    <header class="op-heading mb-4"><span class="personal-kicker">TÀI KHOẢN CÁ NHÂN</span><h1 class="fw-bold mt-2">Hồ sơ của tôi</h1><p>Quản lý thông tin tài khoản và bảo mật của bạn.</p></header>
    <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-4">
            <section class="op-card op-profile-banner card border-0 shadow-sm text-center" aria-label="Thông tin cá nhân">
                <span class="op-avatar large mx-auto" aria-hidden="true">@string.Concat(Model.HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(p => System.Globalization.StringInfo.GetNextTextElement(p))).ToUpperInvariant()</span>
                <div><h2>@Model.HoTen</h2><span class="op-badge rounded-pill">@Model.VaiTro</span></div>
            </section>
            <section class="op-card card border-0 shadow-sm personal-security" aria-labelledby="personal-security-title">
                <h2 id="personal-security-title">Bảo mật tài khoản</h2><p class="text-muted">Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
                <a class="btn btn-outline-dark w-100" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu <span aria-hidden="true">↗</span></a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-2"><button class="btn personal-logout w-100" type="submit">Đăng xuất</button></form>
            </section>
        </div>
        <div class="col-12 col-xl-8">
            <section class="op-card card border-0 shadow-sm" aria-labelledby="personal-info-title">
                <div class="personal-card-heading"><h2 id="personal-info-title">Thông tin tài khoản</h2><span class="personal-account-id">ID #@Model.Id</span></div>
                <dl class="op-facts mb-0">
                    <div><dt>Họ và tên</dt><dd>@Model.HoTen</dd></div>
                    <div><dt>Vai trò</dt><dd>@Model.VaiTro</dd></div>
                    <div><dt>Số điện thoại</dt><dd>@Model.DienThoai</dd></div>
                    <div><dt>Email</dt><dd><span>@Model.Email</span> <span class="op-badge @(Model.EmailDaXacThuc ? "green" : "gold")">@(Model.EmailDaXacThuc ? "Đã xác thực" : "Chưa xác thực")</span></dd></div>
                    <div><dt>Ngày tạo tài khoản</dt><dd>@Model.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</dd></div>
                    <div><dt>Đăng nhập gần nhất</dt><dd>@(Model.DangNhapGanNhat?.AddHours(7).ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận")</dd></div>
                </dl>
            </section>
        </div>
    </div>
</div>
@if (User.IsInRole("CHU_NHA")) { <div class="owner-profiles op-personal"><partial name="_BankSettings" /></div> }
@section Scripts { @if (User.IsInRole("CHU_NHA")) { <script src="~/js/owner-bank.js" asp-append-version="true"></script> } }
@section Styles { <link rel="stylesheet" href="~/css/owner-profiles.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/owner-bank.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/personal-profile-bootstrap.css" asp-append-version="true" /> }
