@model QL_PhongTro.ViewModels.HoSoCaNhanViewModel
@{ ViewData["Title"] = "Hồ sơ của tôi"; }
<div class="owner-profiles op-personal"><div class="op-heading"><h1>Hồ sơ của tôi</h1><p>Thông tin tài khoản cá nhân của bạn.</p></div><section class="op-card op-profile-banner"><span class="op-avatar large">@string.Concat(Model.HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(p => System.Globalization.StringInfo.GetNextTextElement(p)))</span><div><h2>@Model.HoTen</h2><span class="op-badge">@Model.VaiTro</span></div></section><section class="op-card"><h2>Thông tin tài khoản</h2><dl class="op-facts"><div><dt>ID tài khoản</dt><dd>@Model.Id</dd></div><div><dt>Họ và tên</dt><dd>@Model.HoTen</dd></div><div><dt>Vai trò</dt><dd>@Model.VaiTro</dd></div><div><dt>Số điện thoại</dt><dd>@Model.DienThoai</dd></div><div><dt>Email</dt><dd>@Model.Email <span class="op-badge @(Model.EmailDaXacThuc ? "green" : "gold")">@(Model.EmailDaXacThuc ? "Đã xác thực" : "Chưa xác thực")</span></dd></div><div><dt>Ngày tạo tài khoản</dt><dd>@Model.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Đăng nhập gần nhất</dt><dd>@(Model.DangNhapGanNhat?.AddHours(7).ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận")</dd></div></dl></section><section class="op-card"><h2>Bảo mật tài khoản</h2><a class="btn btn-outline-secondary" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a><hr /><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary" type="submit">Đăng xuất</button></form></section></div>
@if (User.IsInRole("CHU_NHA")) { <div class="owner-profiles op-personal"><partial name="_BankSettings" /></div> }
@section Scripts { @if (User.IsInRole("CHU_NHA")) { <script src="~/js/owner-bank.js" asp-append-version="true"></script> } }
@section Styles { <link rel="stylesheet" href="~/css/owner-profiles.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/owner-bank.css" asp-append-version="true" /> }
