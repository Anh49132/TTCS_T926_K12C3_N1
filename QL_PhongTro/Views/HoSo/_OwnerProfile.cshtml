@model QL_PhongTro.ViewModels.XemHoSoViewModel
@{ var current = Model.HopDongsLienQuan.FirstOrDefault(h => h.DangO); }
<div class="owner-profiles"><a class="op-back" asp-action="DanhSach">← &nbsp; Quay lại danh sách</a>
<div class="op-detail-grid"><div class="op-main"><section class="op-card op-profile-banner"><span class="op-avatar large">@string.Concat(Model.HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(p => System.Globalization.StringInfo.GetNextTextElement(p)))</span><div><h1>@Model.HoTen <span class="op-badge @(Model.HoSoDayDu ? "green" : "gold")">@(Model.HoSoDayDu ? "Hồ sơ đầy đủ" : "Thiếu thông tin")</span><span class="op-badge">▣ Chỉ xem</span></h1><p>Mã hồ sơ: @Model.Id</p></div></section>
<section class="op-card"><h2>Thông tin cá nhân</h2><dl class="op-facts"><div><dt>Họ và tên</dt><dd>@Model.HoTen</dd></div><div><dt>Số điện thoại</dt><dd>@(Model.SoDienThoai ?? "Chưa cập nhật")</dd></div><div><dt>Ngày sinh</dt><dd>@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd></div><div><dt>Quê quán</dt><dd>@(string.IsNullOrWhiteSpace(Model.QueQuan) ? "Chưa cập nhật" : Model.QueQuan)</dd></div><div><dt>Nghề nghiệp</dt><dd>@(string.IsNullOrWhiteSpace(Model.NgheNghiep) ? "Chưa cập nhật" : Model.NgheNghiep)</dd></div></dl></section>
<section class="op-card"><h2>Giấy tờ định danh</h2><div class="op-documents"><dl class="op-facts"><div><dt>Số CCCD</dt><dd id="can-cuoc-hien-thi">@(string.IsNullOrEmpty(Model.CanCuocHienThi) ? "Chưa cập nhật" : Model.CanCuocHienThi)</dd></div></dl><div class="op-document-image"><small>Mặt trước</small>@if (Model.CoAnhMatTruoc) { <img src="@Url.Action("Anh", new { id = Model.Id, mat = "truoc" })" alt="Ảnh giấy tờ mặt trước" loading="lazy" /> } else { <p>Chưa cập nhật ảnh</p> }</div><div class="op-document-image"><small>Mặt sau</small>@if (Model.CoAnhMatSau) { <img src="@Url.Action("Anh", new { id = Model.Id, mat = "sau" })" alt="Ảnh giấy tờ mặt sau" loading="lazy" /> } else { <p>Chưa cập nhật ảnh</p> }</div></div><p class="op-note">Thông tin giấy tờ được hiển thị theo quyền xem hồ sơ. Chỉ sử dụng cho việc quản lý và vận hành cho thuê.</p></section>
</div><aside class="op-side"><section class="op-card"><h2>Thông tin thuê hiện tại</h2>@if (current is not null) { <dl class="op-facts"><div><dt>Phòng</dt><dd>@current.Phong</dd></div><div><dt>Tòa nhà</dt><dd>@current.ToaNha</dd></div><div><dt>Ngày bắt đầu thuê</dt><dd>@current.BatDau?.ToString("dd/MM/yyyy")</dd></div><div><dt>Vai trò cư trú</dt><dd>@current.VaiTro</dd></div><div><dt>Số người ở hiện tại</dt><dd>@current.SoNguoi / @current.SucChua</dd></div></dl> } else { <p class="op-note">Chưa có lượt cư trú đang hiệu lực tại các tòa nhà trong phạm vi của bạn. Xem hợp đồng liên quan bên dưới.</p> }</section><section class="op-card"><h2>Quyền truy cập</h2><p class="op-access-note">▣ &nbsp; @(User.IsInRole("ADMIN") ? "Bạn có quyền xem hồ sơ theo vai trò quản trị hệ thống." : "Bạn chỉ được xem hồ sơ của khách đã hoặc đang có hợp đồng tại tòa nhà của mình.")</p><p class="op-note">Hồ sơ chỉ xem. Khách thuê tự cập nhật thông tin của mình.</p></section></aside></div>
<section class="op-card op-list"><h2>Hợp đồng liên quan</h2><div class="op-table-frame"><table><thead><tr><th>Mã hợp đồng</th><th>Phòng</th><th>Tòa nhà</th><th>Vai trò</th><th>Thời gian thuê</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var h in Model.HopDongsLienQuan) { <tr><td>@h.Ma</td><td>@h.Phong</td><td>@h.ToaNha</td><td>@h.VaiTro</td><td>@(h.BatDau?.ToString("dd/MM/yyyy") ?? "—") – @(h.KetThuc?.ToString("dd/MM/yyyy") ?? "—")</td><td><span class="op-badge @(h.DangO ? "green" : "")">@(h.TrangThai switch { "DANG_HIEU_LUC" => "Đang hiệu lực", "CHO_HIEU_LUC" => "Chờ hiệu lực", _ => "Đã kết thúc" })</span></td><td>@if (User.IsInRole("CHU_NHA")) { <a class="btn btn-outline-secondary" asp-controller="HopDong" asp-action="Details" asp-route-id="@h.Id">Xem hợp đồng</a> }</td></tr> }@if (Model.HopDongsLienQuan.Count == 0) { <tr><td colspan="7">Chưa có hợp đồng liên quan.</td></tr> }</tbody></table></div></section>
</div>
