@model QL_PhongTro.ViewModels.HoSoViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}
<div class="profile-edit-bootstrap row justify-content-center">
    <div class="col-12 col-xl-10">
        <header class="pe-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1>Hồ sơ cá nhân</h1><p class="text-muted mb-0">Cập nhật thông tin cá nhân và giấy tờ của bạn.</p></div>
        <a asp-action="Xem" class="btn btn-outline-secondary">Xem hồ sơ đã lưu</a></header>
<form asp-controller="HoSo" asp-action="Index" method="post" enctype="multipart/form-data" class="card shadow-sm pe-form"><div class="card-body p-4"><h2 class="h6 fw-bold mb-3">Thông tin cá nhân</h2><div class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="col-12 col-md-6">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" autocomplete="name" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="NgaySinh" class="form-label"></label>
                <input asp-for="NgaySinh" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="NgaySinh" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="SoCanCuoc" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.CanCuocDaLuu))
                {
                    <p>Căn cước đã lưu: <strong>@Model.CanCuocDaLuu</strong></p>
                }
                <input asp-for="SoCanCuoc" class="form-control" type="text" inputmode="numeric"
                       autocomplete="off"
                       data-val-regex-pattern="^(?:[0-9]{9}|[0-9]{12})$" aria-describedby="can-cuoc-help can-cuoc-error" />
                <div id="can-cuoc-help" class="form-text">Nhập đúng 9 hoặc 12 chữ số. Nếu đã lưu căn cước, để trống để giữ nguyên; chỉ nhập khi muốn thay đổi.</div>
                <span asp-validation-for="SoCanCuoc" id="can-cuoc-error" class="text-danger" aria-live="polite"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="QueQuan" class="form-label"></label>
                <input asp-for="QueQuan" class="form-control" />
                <span asp-validation-for="QueQuan" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="NgheNghiep" class="form-label"></label>
                <input asp-for="NgheNghiep" class="form-control" />
                <span asp-validation-for="NgheNghiep" class="text-danger"></span>
            </div>
            </div><section class="pe-documents mt-4 pt-4"><h2 class="h6 fw-bold mb-2">Ảnh giấy tờ định danh</h2><p class="form-text">Ảnh JPG/PNG, mỗi ảnh tối đa 5MB. Ảnh rộng hơn 1600px sẽ được thu nhỏ. Không chọn ảnh mới nếu muốn giữ ảnh đã lưu.</p>
            @if (!ViewData.ModelState.IsValid)
            {
                <p class="text-muted">Nếu đã chọn ảnh mới, vui lòng chọn lại ảnh trước khi lưu.</p>
            }
            <div class="row g-3"><div class="col-12 col-md-6">
                <label asp-for="AnhMatTruoc" class="form-label"></label>
                <input asp-for="AnhMatTruoc" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control" aria-describedby="anh-truoc-error" />
                <span asp-validation-for="AnhMatTruoc" id="anh-truoc-error" class="text-danger" aria-live="polite"></span>
                <img id="preview-truoc" src="@(Model.CoAnhMatTruoc ? Url.Action("Anh", new { mat = "truoc" }) : null)"
                     hidden="@(!Model.CoAnhMatTruoc)" alt="Ảnh giấy tờ mặt trước" class="img-fluid mt-2" style="max-height:280px" />
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="AnhMatSau" class="form-label"></label>
                <input asp-for="AnhMatSau" type="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control" aria-describedby="anh-sau-error" />
                <span asp-validation-for="AnhMatSau" id="anh-sau-error" class="text-danger" aria-live="polite"></span>
                <img id="preview-sau" src="@(Model.CoAnhMatSau ? Url.Action("Anh", new { mat = "sau" }) : null)"
                     hidden="@(!Model.CoAnhMatSau)" alt="Ảnh giấy tờ mặt sau" class="img-fluid mt-2" style="max-height:280px" />
            </div>
            </div></section><footer class="pe-actions d-flex flex-wrap gap-2 mt-4 pt-3"><button type="submit" class="btn btn-primary">Lưu hồ sơ</button><a asp-action="Xem" class="btn btn-outline-secondary">Hủy thay đổi</a></footer></div>
        </form>
        @if (Model.CoHoSo)
        {
            <form asp-controller="HoSo" asp-action="Xoa" method="post" id="delete-profile-form" class="mt-3">
                <p class="form-text">Xóa hồ sơ sẽ xóa thông tin và ảnh giấy tờ đã khai báo. Tài khoản đăng nhập vẫn được giữ lại.</p>
                <button type="submit" class="btn btn-outline-danger">Xóa hồ sơ</button>
            </form>
        }
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ho-so.js" asp-append-version="true"></script>
}

@section Styles { <link rel="stylesheet" href="~/css/profile-edit-bootstrap.css" asp-append-version="true" /> }
