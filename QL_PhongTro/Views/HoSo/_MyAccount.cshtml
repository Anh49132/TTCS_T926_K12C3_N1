@model QL_PhongTro.ViewModels.XemHoSoViewModel
<div class="tenant-account">
    <nav class="ta-breadcrumb" aria-label="Đường dẫn"><a asp-controller="Home" asp-action="Index">Trang chủ</a> / Hồ sơ của tôi</nav>
    <div class="ta-heading"><div><h1>Hồ sơ của tôi</h1><p>Quản lý thông tin cá nhân, tài khoản và bảo mật.</p></div><a class="ta-button" asp-action="Index">✎ &nbsp; Chỉnh sửa hồ sơ</a></div>
    <section class="ta-card ta-identity"><div class="ta-identity-person"><span class="ta-avatar">@Model.HoTen.FirstOrDefault()</span><div><h2>@Model.HoTen</h2><span class="ta-badge neutral">Khách thuê</span> <span class="ta-badge success">● &nbsp; Tài khoản đang hoạt động</span></div></div><div class="ta-account-id"><small>ID tài khoản</small><div><strong>@Model.TaiKhoanId</strong><button type="button" class="ta-copy" data-copy-account="@Model.TaiKhoanId">▣ &nbsp; Sao chép</button></div><small>Dùng ID này khi chủ nhà thêm bạn vào hợp đồng.</small><span class="ta-copy-status" role="status" aria-live="polite"></span></div><div class="ta-verification"><p class="@(Model.EmailDaXacThuc ? "ta-success" : "ta-warning")">@(Model.EmailDaXacThuc ? "✓ Email đã xác thực" : "! Email chưa xác thực")</p><p class="ta-muted">CCCD: @(string.IsNullOrEmpty(Model.CanCuocHienThi) ? "Chưa cập nhật" : "Đã lưu thông tin")</p></div></section>
    <nav class="ta-tabs" aria-label="Các mục hồ sơ"><a class="is-active" href="#personal-info">Thông tin cá nhân</a><a href="#account-security">Bảo mật &amp; đăng nhập</a><a href="#account-privacy">Quyền riêng tư</a></nav>
    <div class="ta-workspace"><div class="ta-main">
        <section class="ta-card" id="personal-info"><div class="ta-card-heading"><span class="ta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/></svg></span><h2>Thông tin cá nhân</h2><a asp-action="Index">✎ &nbsp; Chỉnh sửa</a></div><dl class="ta-facts"><div><dt>Họ và tên</dt><dd>@Model.HoTen</dd></div><div><dt>Số điện thoại</dt><dd>@Model.SoDienThoai</dd></div><div><dt>Email</dt><dd>@Model.Email @if (Model.EmailDaXacThuc) { <span class="ta-badge success">✓ Đã xác thực</span> }</dd></div><div><dt>Ngày sinh</dt><dd class="@(Model.NgaySinh is null ? "ta-muted" : "")">@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd></div><div><dt>Quê quán</dt><dd class="@(string.IsNullOrWhiteSpace(Model.QueQuan) ? "ta-muted" : "")">@(string.IsNullOrWhiteSpace(Model.QueQuan) ? "Chưa cập nhật" : Model.QueQuan)</dd></div><div><dt>Nghề nghiệp</dt><dd class="@(string.IsNullOrWhiteSpace(Model.NgheNghiep) ? "ta-muted" : "")">@(string.IsNullOrWhiteSpace(Model.NgheNghiep) ? "Chưa cập nhật" : Model.NgheNghiep)</dd></div></dl></section>
        <section class="ta-card" id="account-privacy"><div class="ta-card-heading"><span class="ta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8" cy="10" r="2"/><path d="M5 16a3 3 0 0 1 6 0M14 9h4M14 13h4"/></svg></span><h2>Giấy tờ định danh</h2></div><dl class="ta-facts"><div><dt>Loại giấy tờ</dt><dd>Căn cước công dân</dd></div><div><dt>Số CCCD</dt><dd id="can-cuoc-hien-thi">@(string.IsNullOrEmpty(Model.CanCuocHienThi) ? "Chưa cập nhật" : Model.CanCuocHienThi)</dd></div><div><dt>Trạng thái</dt><dd><span class="ta-badge neutral">@(string.IsNullOrEmpty(Model.CanCuocHienThi) ? "Chưa có thông tin" : "Đã lưu · Chưa có xác minh giấy tờ")</span></dd></div></dl><div class="ta-identity-note"><p>▣ &nbsp; Số căn cước chỉ hiển thị 4 chữ số cuối để bảo vệ thông tin cá nhân.</p><a class="ta-button" asp-action="Index">Cập nhật CCCD</a></div>
            @if (Model.CoAnhMatTruoc || Model.CoAnhMatSau) { <details class="ta-document-images"><summary>Xem ảnh giấy tờ đã lưu</summary>@if (Model.CoAnhMatTruoc) { <img src="@Url.Action("Anh", new { id = Model.Id, mat = "truoc" })" alt="Ảnh giấy tờ mặt trước" loading="lazy" /> }@if (Model.CoAnhMatSau) { <img src="@Url.Action("Anh", new { id = Model.Id, mat = "sau" })" alt="Ảnh giấy tờ mặt sau" loading="lazy" /> }</details> }
            <p class="ta-notice">ⓘ &nbsp; Thông tin họ tên, số điện thoại và CCCD được dùng khi bạn tham gia hợp đồng thuê. Chủ nhà tra cứu bằng ID sẽ chỉ thấy số điện thoại và CCCD đã che bớt.</p>
        </section>
    </div><aside class="ta-side">
        <section class="ta-card"><div class="ta-card-heading"><span class="ta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/></svg></span><h2>Thông tin tài khoản</h2></div><dl class="ta-facts"><div><dt>ID tài khoản</dt><dd>@Model.TaiKhoanId <button class="ta-copy ta-copy-small" type="button" data-copy-account="@Model.TaiKhoanId" aria-label="Sao chép ID tài khoản">▣</button></dd></div><div><dt>Vai trò</dt><dd>Khách thuê</dd></div><div><dt>Ngày tạo</dt><dd>@Model.NgayTaoTaiKhoan?.AddHours(7).ToString("dd/MM/yyyy")</dd></div><div><dt>Trạng thái</dt><dd><span class="ta-badge success">● Đang hoạt động</span></dd></div></dl></section>
        <section class="ta-card" id="account-security"><div class="ta-card-heading"><span class="ta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg></span><h2>Bảo mật</h2></div><dl class="ta-facts"><div><dt>Mật khẩu</dt><dd><a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></dd></div><div><dt>Xác thực hai bước</dt><dd class="ta-muted">Chưa được hỗ trợ</dd></div><div><dt>Đăng nhập gần nhất</dt><dd>@(Model.DangNhapGanNhat?.AddHours(7).ToString("dd/MM/yyyy HH:mm") ?? "Chưa ghi nhận")</dd></div></dl><p class="ta-security-note">Sau khi đổi mật khẩu, các phiên đăng nhập cũ được thu hồi.</p></section>
        <section class="ta-card"><div class="ta-card-heading"><span class="ta-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10H3Z"/><path d="M9 20v-7h6v7"/></svg></span><h2>Liên kết thuê phòng</h2></div><dl class="ta-facts"><div><dt>Hợp đồng đang tham gia</dt><dd>@Model.SoHopDong</dd></div><div><dt>Vai trò thuê</dt><dd>@Model.VaiTroThue</dd></div></dl><a asp-controller="HopDongCuaToi" asp-action="Index">Xem hợp đồng của tôi</a><p class="ta-notice">ⓘ &nbsp; Chia sẻ ID tài khoản với chủ nhà để được thêm đúng vào hợp đồng.</p><form asp-controller="Account" asp-action="Logout" method="post" class="ta-logout"><button type="submit">↪ &nbsp; Đăng xuất</button></form></section>
    </aside></div>
</div>
