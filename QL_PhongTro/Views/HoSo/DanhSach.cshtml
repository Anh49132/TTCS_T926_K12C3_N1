@model QL_PhongTro.ViewModels.HoSoChuNhaDanhSachViewModel
@{ ViewData["Title"] = "Hồ sơ khách thuê"; }
<div class="owner-profiles tenant-profiles-bootstrap">
    <div class="op-heading"><h1>Hồ sơ khách thuê</h1><p>@(User.IsInRole("ADMIN") ? "Danh sách hồ sơ khách thuê trong hệ thống." : "Chỉ hiển thị khách đã hoặc đang có hợp đồng tại các tòa nhà của bạn.")</p></div>
    <div class="op-stats"><div><span class="op-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22v-3a8 8 0 0 1 16 0v3"/></svg></span><div><small>Tổng khách</small><strong>@Model.TongKhach</strong></div></div><div><span class="op-stat-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="7" r="4"/><path d="M2 22v-3a7 7 0 0 1 11-6M15 17l3 3 5-7"/></svg></span><div><small>Đang thuê</small><strong>@Model.DangThue</strong></div></div><div><span class="op-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><small>Đã kết thúc</small><strong>@Model.DaKetThuc</strong></div></div><div><span class="op-stat-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v5h4M9 12h6M9 16h6"/></svg></span><div><small>Thiếu hồ sơ</small><strong>@Model.ThieuHoSo</strong></div></div></div>
    <form method="post" asp-action="LocDanhSach" class="op-card op-filters"><div><label class="visually-hidden" for="profile-search">Tìm khách thuê</label><input class="form-control" id="profile-search" name="timKiem" maxlength="100" value="@Model.TimKiem" placeholder="Tìm theo tên, số điện thoại hoặc CCCD…" /></div><div><label class="visually-hidden" for="profile-building">Tòa nhà</label><select class="form-select" id="profile-building" name="toaNhaId"><option value="">Tất cả tòa nhà</option>@foreach (var b in Model.ToaNhas) { <option value="@b.Id" selected="@(b.Id == Model.ToaNhaId)">@b.Ten</option> }</select></div><div><label class="visually-hidden" for="profile-state">Tình trạng thuê</label><select class="form-select" id="profile-state" name="trangThai"><option value="">Tất cả tình trạng thuê</option><option value="DANG_THUE" selected="@(Model.TrangThai == "DANG_THUE")">Đang thuê</option><option value="CHO_HIEU_LUC" selected="@(Model.TrangThai == "CHO_HIEU_LUC")">Chờ hiệu lực</option><option value="DA_KET_THUC" selected="@(Model.TrangThai == "DA_KET_THUC")">Đã kết thúc</option></select></div><button type="submit" class="btn btn-dark">Lọc danh sách</button></form>
    <section class="op-card op-list"><div class="op-table-frame"><table class="table align-middle mb-0"><thead><tr><th>Khách thuê</th><th>Liên hệ</th><th>Phòng / Tòa nhà</th><th>Vai trò</th><th>Tình trạng thuê</th><th>Hồ sơ</th><th>Thao tác</th></tr></thead><tbody>@foreach (var k in Model.Khachs) { <tr class="@(!k.DayDu ? "op-missing" : "")"><td><div class="op-person"><span class="op-avatar">@string.Concat(k.HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(p => System.Globalization.StringInfo.GetNextTextElement(p)))</span><div><strong>@k.HoTen</strong><small>Sinh nhật: @(k.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</small></div></div></td><td><strong>@(string.IsNullOrEmpty(k.DienThoai) ? "Chưa cập nhật" : k.DienThoai)</strong><small>CCCD: @(string.IsNullOrEmpty(k.CanCuoc) ? "Chưa cập nhật" : k.CanCuoc)</small></td><td><strong>@k.Phong</strong><small>@k.ToaNha</small></td><td>@k.VaiTro</td><td><span class="op-badge @(k.TinhTrang == "DANG_THUE" ? "green" : "")">@(k.TinhTrang switch { "DANG_THUE" => "Đang thuê", "CHO_HIEU_LUC" => "Chờ hiệu lực", "CHUA_CO_HOP_DONG" => "Chưa có hợp đồng", _ => "Đã kết thúc" })</span></td><td><span class="op-badge @(k.DayDu ? "green" : "gold")">@(k.DayDu ? "Đầy đủ" : "Thiếu thông tin")</span></td><td><a class="btn btn-outline-secondary" asp-action="Xem" asp-route-id="@k.Id">Xem hồ sơ</a></td></tr> }@if (Model.Khachs.Count == 0) { <tr><td colspan="7" class="op-empty">Không có hồ sơ phù hợp. Thử đổi bộ lọc.</td></tr> }</tbody></table></div>
        <footer class="op-pagination"><span>Hiển thị @(Model.TongKetQua == 0 ? 0 : (Model.Trang - 1) * 10 + 1) - @Math.Min(Model.Trang * 10, Model.TongKetQua) của @Model.TongKetQua khách thuê</span><nav aria-label="Phân trang hồ sơ">@if (Model.Trang > 1) { <a asp-action="DanhSach" asp-route-trang="@(Model.Trang - 1)" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-trangThai="@Model.TrangThai">‹</a> }@for (var pageNumber = Math.Max(1, Model.Trang - 2); pageNumber <= Math.Min(Model.TongTrang, Model.Trang + 2); pageNumber++) { <a class="@(pageNumber == Model.Trang ? "is-active" : "")" aria-current="@(pageNumber == Model.Trang ? "page" : null)" asp-action="DanhSach" asp-route-trang="@pageNumber" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-trangThai="@Model.TrangThai">@pageNumber</a> }@if (Model.Trang < Model.TongTrang) { <a asp-action="DanhSach" asp-route-trang="@(Model.Trang + 1)" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-trangThai="@Model.TrangThai">›</a> }</nav></footer>
    </section>
</div>
@section Styles { <link rel="stylesheet" href="~/css/owner-profiles.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/tenant-profiles-bootstrap.css" asp-append-version="true" /> }

@section Scripts { <script src="~/js/tenant-profile-filters.js" asp-append-version="true"></script> }
