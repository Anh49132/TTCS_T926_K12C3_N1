@model QL_PhongTro.ViewModels.PersonalAccountViewModel
@{ViewData["Title"]="Chỉnh sửa tài khoản";}
<section class="personal-edit"><header><h1>Chỉnh sửa tài khoản</h1><p>Cập nhật ảnh đại diện và thông tin cá nhân của bạn.</p></header>
@if(TempData["PersonalSuccess"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(TempData["PersonalError"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
<div class="row g-4"><aside class="col-12 col-lg-4"><section class="card p-4"><h2 class="h5">Ảnh đại diện</h2><img class="personal-avatar-preview" src="/PersonalAccount/Avatar" alt="Ảnh đại diện của tôi" width="128" height="128" /><form asp-action="Avatar" method="post" enctype="multipart/form-data"><label for="personal-image" class="form-label">Chọn ảnh mới</label><input id="personal-image" name="image" type="file" accept="image/jpeg,image/png" class="form-control mb-2" required/><p class="text-secondary small">JPG, PNG · Tối đa 5MB. Ảnh được cắt vuông.</p><button class="btn btn-dark w-100">Lưu ảnh đại diện</button></form><form asp-action="RemoveAvatar" method="post" class="mt-2"><button class="btn btn-outline-secondary w-100">Xóa ảnh đại diện</button></form></section></aside>
<div class="col-12 col-lg-8"><section class="card p-4"><h2 class="h5">Thông tin tài khoản</h2><form asp-action="Edit" method="post"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div><input name="OriginalUpdated" type="hidden" value="@Model.OriginalUpdated?.ToString("O")"/><div class="mb-3"><label asp-for="HoTen" class="form-label">Họ và tên</label><input asp-for="HoTen" class="form-control" autocomplete="name" maxlength="100" required/><span asp-validation-for="HoTen" class="text-danger"></span></div><div class="mb-3"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" type="tel" autocomplete="tel" pattern="0[0-9]{9}" maxlength="10" required/><span asp-validation-for="SoDienThoai" class="text-danger"></span></div><div class="mb-3"><label for="personal-email" class="form-label">Email đăng nhập</label><input id="personal-email" value="@Model.Email" class="form-control" readonly/><p class="text-secondary small mt-1">Email đã xác thực được giữ nguyên để bảo vệ tài khoản.</p></div><div class="mb-4"><label for="personal-role" class="form-label">Vai trò</label><input id="personal-role" value="@Model.Role" class="form-control" readonly/></div><div class="d-flex gap-2 flex-wrap"><button class="btn btn-dark">Lưu thông tin</button><a class="btn btn-outline-secondary" asp-controller="HoSo" asp-action="@(User.IsInRole("KHACH_THUE")?"Xem":"CuaToi")">Quay lại hồ sơ</a><a class="btn btn-outline-secondary" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></div></form></section></div></div></section>
@section Styles{<link rel="stylesheet" href="~/css/personal-edit.css" asp-append-version="true"/>}
