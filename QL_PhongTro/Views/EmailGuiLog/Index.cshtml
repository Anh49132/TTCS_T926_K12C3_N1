@model QL_PhongTro.ViewModels.EmailGuiLogViewModel
@using QL_PhongTro.ViewModels
@{
    ViewData["Title"] = "Tra cứu gửi thông báo lỗi";
}
<p class="eyebrow">HỆ THỐNG</p>
<h1>Tra cứu gửi thông báo lỗi</h1>
<nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Loại email"><a class="btn btn-outline-secondary" asp-action="Index" asp-route-nhom="HOA_DON">Hóa đơn</a><a class="btn btn-outline-secondary" asp-action="Index" asp-route-nhom="THANH_TOAN">Báo và xác nhận thanh toán</a><a class="btn btn-outline-secondary" asp-action="BaoHong">Báo hỏng và cập nhật</a></nav>
<p>Xem lịch sử email hóa đơn/thanh toán, số lần thử lại và trạng thái gửi. Chế độ pickup chỉ lưu thư local.</p>
<form method="get" class="row g-3 mb-4">
    <input type="hidden" name="Nhom" value="@Model.Nhom" />
    <div class="col-md-3"><label asp-for="TrangThai" class="form-label">Trạng thái</label><select asp-for="TrangThai" class="form-select"><option value="">Tất cả</option>
    @foreach (var t in EmailGuiLogViewModel.TrangThais) { <option value="@t.Key">@t.Value</option> }
    </select></div>
    <div class="col-md-3"><label asp-for="TuNgay" class="form-label">Từ ngày</label><input asp-for="TuNgay" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="DenNgay" class="form-label">Đến ngày</label><input asp-for="DenNgay" type="date" class="form-control" /></div>
    <div><button class="btn btn-primary" type="submit">Lọc nhật ký</button> <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a></div>
</form>
<p>@Model.Total bản ghi · Trang @Model.Page/@Model.Pages</p>
<div class="table-responsive"><table class="table align-top"><thead><tr><th>STT</th><th>Ngày gửi</th><th>Hóa đơn</th><th>Người nhận</th><th>Email</th><th>Loại thông báo</th><th>Trạng thái</th><th>Số lần thử</th><th>Lần gửi tiếp</th><th>Lỗi gần nhất</th></tr></thead><tbody>
@{ var stt = (Model.Page - 1) * 50; }
@foreach (var row in Model.Rows) {
stt++;
<tr>
<td>@stt</td>
<td>@row.NgayGui.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
<td>#@row.HoaDonId</td>
<td>#@row.NguoiNhanId</td>
<td>@row.EmailNguoiNhan</td>
<td>@EmailGuiLogViewModel.KindName(row.LoaiThongBao)</td>
<td>
@switch (row.TrangThai)
{
    case "DA_GUI": <span class="badge bg-success">@EmailGuiLogViewModel.TrangThais[row.TrangThai]</span>; break;
    case "THAT_BAI": <span class="badge bg-danger">@EmailGuiLogViewModel.TrangThais[row.TrangThai]</span>; break;
    case "CHO_GUI": <span class="badge bg-warning text-dark">@EmailGuiLogViewModel.TrangThais[row.TrangThai]</span>; break;
    case "DANG_GUI": <span class="badge bg-info text-dark">@EmailGuiLogViewModel.TrangThais[row.TrangThai]</span>; break;
    default: @row.TrangThai; break;
}
</td>
<td>@row.SoLanThu</td>
<td>@(row.NgayThuTiep is { } t ? t.AddHours(7).ToString("dd/MM/yyyy HH:mm") : "-")</td>
<td style="overflow-wrap:anywhere">@(row.LoiGanNhat ?? "-")</td>
</tr>
}
@if (Model.Rows.Count == 0) { <tr><td colspan="10">Không có bản ghi phù hợp.</td></tr> }
</tbody></table></div>
<nav aria-label="Phân trang nhật ký gửi email">
@foreach (var pageNumber in new[] { Model.Page - 1, Model.Page + 1 }.Where(p => p >= 1 && p <= Model.Pages)) {
<a class="btn btn-outline-primary" asp-action="Index" asp-route-page="@pageNumber" asp-route-nhom="@Model.Nhom" asp-route-trangThai="@Model.TrangThai" asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">@(pageNumber < Model.Page ? "Trang trước" : "Trang sau")</a>
}
</nav>
