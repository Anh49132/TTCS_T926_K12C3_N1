@model List<QL_PhongTro.Services.RepairEmailRow>
@{ViewData["Title"]="Email báo hỏng và cập nhật";var page=(int)(ViewData["Page"]??1);var pages=(int)(ViewData["Pages"]??1);var status=ViewData["Status"] as string;}
<h1>Email báo hỏng và cập nhật</h1><nav class="d-flex gap-2 mb-3" aria-label="Loại email"><a class="btn btn-outline-secondary" asp-action="Index">Hóa đơn</a><a class="btn btn-dark" asp-action="BaoHong">Báo hỏng và cập nhật</a></nav>
<p>Gửi khi có báo hỏng mới, phản hồi hoặc đổi trạng thái. Chế độ lưu thư local chưa đồng nghĩa thư đã đến hộp thư thật.</p>
<form method="get" class="d-flex gap-2 mb-3"><select name="trangThai" class="form-select" aria-label="Trạng thái"><option value="">Tất cả</option>@foreach(var s in QL_PhongTro.ViewModels.EmailGuiLogViewModel.TrangThais){<option value="@s.Key" selected="@(s.Key==status)">@s.Value</option>}</select><button class="btn btn-dark">Lọc</button></form>
<p>@(ViewData["Total"]??0) bản ghi · Trang @(page) / @pages</p><div class="table-responsive"><table class="table"><thead><tr><th>Thời điểm</th><th>Báo hỏng</th><th>Người nhận</th><th>Nội dung</th><th>Trạng thái</th><th>Số lần gửi</th><th>Thử tiếp</th><th>Lỗi</th></tr></thead><tbody>@foreach(var row in Model){<tr><td>@DateTime.Parse(row.Created,null,System.Globalization.DateTimeStyles.RoundtripKind).AddHours(7).ToString("dd/MM/yyyy HH:mm")</td><td><a asp-controller="ChuNhaBaoHong" asp-action="Details" asp-route-id="@row.ReportId">#@row.ReportId</a></td><td>@row.Email</td><td>@row.Subject</td><td>@QL_PhongTro.ViewModels.EmailGuiLogViewModel.TrangThais.GetValueOrDefault(row.Status,row.Status)</td><td>@row.Attempts / 4</td><td>@(row.Next is null?"—":DateTime.Parse(row.Next,null,System.Globalization.DateTimeStyles.RoundtripKind).AddHours(7).ToString("dd/MM/yyyy HH:mm"))</td><td>@row.Error</td></tr>}@if(Model.Count==0){<tr><td colspan="8">Không có bản ghi phù hợp.</td></tr>}</tbody></table></div><nav aria-label="Phân trang">@if(page>1){<a class="btn btn-outline-secondary" asp-route-page="@(page-1)" asp-route-trangThai="@status">Trước</a>} @if(page<pages){<a class="btn btn-outline-secondary" asp-route-page="@(page+1)" asp-route-trangThai="@status">Sau</a>}</nav>
