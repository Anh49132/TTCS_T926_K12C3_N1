@model QL_PhongTro.ViewModels.TaoTinDangViewModel
@using System.Globalization
@{ var chooseBuilding = ViewData["ChooseListingBuilding"] is true; var edit=Model.TinDangId.HasValue;var published=Model.TrangThaiTin=="DANG_HIEN_THI";ViewData["Title"]=edit?"Chỉnh sửa tin đăng":"Tạo tin đăng";var vi=CultureInfo.GetCultureInfo("vi-VN"); }
<div class="listing-create-page listing-form-bootstrap @(edit ? "listing-edit-mode" : "listing-create-mode")"><header class="lc-heading"><div><h1>@(edit?"Chỉnh sửa tin đăng":"Tạo tin đăng")</h1><p>Giới thiệu phòng trống của bạn và kết nối với khách tìm phòng phù hợp.</p></div><small>* Trường thông tin bắt buộc</small></header>
<form method="post" asp-action="Tao" id="listing-create-form"><input asp-for="PhongId" type="hidden"/><input asp-for="TinDangId" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="lc-layout"><div class="lc-main">
<section class="lc-card lc-info"><div class="lc-title"><span class="lc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M10 14l1-4 8-8 3 3-8 8-4 1Zm7-10 3 3"/></svg></span><div><h2>Thông tin tin đăng</h2><p>Chọn phòng và viết nội dung giới thiệu với khách thuê.</p></div></div><div class="lc-fields"><div><label for="lc-building">Cơ sở <em>*</em></label><select class="form-select" id="lc-building" aria-label="Chọn cơ sở"><option value="" selected="@chooseBuilding" disabled>Chọn tòa nhà</option>@foreach(var building in Model.PhongOptions.GroupBy(room=>room.ToaNhaId)){<option value="@building.Key" selected="@(!chooseBuilding && building.Key==Model.ToaNhaId)">@building.First().TenToaNha</option>}</select></div><div><label for="lc-room">Phòng cho thuê <em>*</em></label><select class="form-select" id="lc-room" aria-label="Chọn phòng đăng tin"><option value="" selected="@chooseBuilding" disabled>Chọn phòng cho thuê</option>@foreach(var room in Model.PhongOptions){<option value="@room.Id" data-building="@room.ToaNhaId" selected="@(!chooseBuilding && room.Id==Model.PhongId)">@room.MaPhong · Tầng @room.Tang · @room.DienTich.ToString("0.#",vi) m²</option>}</select></div></div><p class="lc-notice">● @(Model.TrangThaiPhong=="TRONG"?"Còn trống · Phòng chưa có hợp đồng đang thuê.":"Phòng chưa trống · Không thể đăng tin mới.")</p><div class="lc-field"><label asp-for="TieuDe">Tiêu đề tin đăng <em>*</em></label><input class="form-control" asp-for="TieuDe" maxlength="200" placeholder="Phòng sáng tự nhiên, có bếp riêng…"/><small>Nêu điểm nổi bật của phòng · tối đa 200 ký tự.</small><span asp-validation-for="TieuDe" class="text-danger"></span></div><div class="lc-field"><label asp-for="NoiDung">Mô tả</label><textarea class="form-control" asp-for="NoiDung" rows="5" maxlength="4000" placeholder="Giới thiệu không gian, tiện ích và những điểm nổi bật của phòng…"></textarea><small id="lc-description-count">Tối đa 4.000 ký tự.</small><span asp-validation-for="NoiDung" class="text-danger"></span></div></section>
<section class="lc-card lc-room-pricing"><div class="lc-title"><span class="lc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14V5ZM3 8h16m0 3h-6v6h6m-3-3h.1"/></svg></span><div><h2>Giá thuê &amp; thông số phòng</h2><p>Thông tin lấy từ phòng @Model.MaPhong; kiểm tra trước khi đăng.</p></div></div><div class="lc-fields lc-three"><div><label for="lc-rent">Giá thuê hàng tháng</label><div class="lc-unit"><input class="form-control" id="lc-rent" value="@Model.GiaThue.ToString("N0",vi)" readonly/><span>đ / tháng</span></div></div><div><label for="lc-deposit">Tiền cọc dự kiến</label><div class="lc-unit"><input class="form-control" id="lc-deposit" value="@Model.TienCoc.ToString("N0",vi)" readonly/><span>đ</span></div></div><div><label for="lc-area">Diện tích</label><div class="lc-unit"><input class="form-control" id="lc-area" value="@Model.DienTich.ToString("0.#",vi)" readonly/><span>m²</span></div></div></div><p class="lc-hint">Giá thuê chưa bao gồm phí dịch vụ. Tiền cọc dự kiến lấy từ hồ sơ phòng.</p><a asp-controller="PhongTro" asp-action="Edit" asp-route-id="@Model.PhongId" class="lc-text-link">Chỉnh sửa thông tin phòng ↗</a><div class="lc-amenities"><div class="lc-amenities-heading"><h3>Tiện nghi có sẵn</h3><small>Thông tin trong mô tả phòng</small></div><div class="lc-amenity-grid">@foreach(var amenity in new[] { "Điều hòa", "Bình nóng lạnh", "Giường", "Tủ quần áo", "Khu bếp riêng", "Ban công", "Máy giặt", "Tủ lạnh" }) { <label><input type="checkbox" disabled checked="@(Model.NoiDung?.Contains(amenity, StringComparison.OrdinalIgnoreCase) == true)" /><span>@amenity</span></label> }</div><p class="lc-hint">Tiện nghi được nhận diện từ mô tả hiện tại, chỉ để tham khảo. Chưa hỗ trợ lưu lựa chọn tiện nghi riêng.</p></div>
<h3 class="lc-subtitle">Dịch vụ của phòng</h3>@if(Model.DichVu.Count==0){<p class="lc-hint">Phòng chưa có dịch vụ áp dụng.</p>}else{<div class="lc-service-list">@foreach(var service in Model.DichVu){<div><span>@service.TenDichVu<small>@QL_PhongTro.Models.CachTinhDichVu.Ten(service.CachTinh)</small></span><strong>@service.DonGia.ToString("N0",vi) đ / @service.DonViTinh</strong></div>}</div>}</section>
<section class="lc-card lc-address-card"><div class="lc-title"><span class="lc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 10c0 5-6 11-6 11S6 15 6 10a6 6 0 1 1 12 0Z"/><circle cx="12" cy="10" r="2"/></svg></span><div><h2>Địa chỉ</h2><p>Địa chỉ của cơ sở giúp khách tìm đúng vị trí phòng.</p></div></div><label for="lc-address">Địa chỉ hiển thị <em>*</em></label><input class="form-control" id="lc-address" value="@Model.DiaChi" readonly/><small>Đồng bộ từ @Model.TenToaNha. Chỉnh sửa địa chỉ trong thông tin cơ sở.</small></section>
<section class="lc-card lc-images-card"><div class="lc-title"><span class="lc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8" cy="8" r="2"/><path d="m4 18 6-7 4 4 3-3 4 5"/></svg></span><div><h2>Ảnh phòng</h2><p>Ảnh rõ nét, đúng thực tế giúp tin đăng thu hút hơn.</p></div></div><a class="lc-upload" asp-controller="PhongTro" asp-action="Edit" asp-route-id="@Model.PhongId"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17H5a4 4 0 0 1-1-8 7 7 0 0 1 14-1 4.5 4.5 0 0 1 1 9h-2M12 21V10m-4 4 4-4 4 4"/></svg><strong>Thêm ảnh hoặc quản lý ảnh phòng</strong><small>JPG, PNG · Tối đa 5 MB / ảnh · Tối đa 8 ảnh</small></a><div class="lc-images-meta"><span>Đã thêm @Model.Anh.Count / 8 ảnh từ phòng @Model.MaPhong</span><span>Ảnh đầu tiên là ảnh đại diện</span></div><div class="lc-gallery">@foreach(var photo in Model.Anh){<div class="lc-photo"><img src="@(photo.DuongDanAnhNho??photo.DuongDan)" alt="@(photo.MoTa??"Phòng "+Model.MaPhong)" loading="lazy"/>@if(photo==Model.Anh.First()){<span class="lc-photo-cover">Ảnh đại diện</span>}<a asp-controller="PhongTro" asp-action="Edit" asp-route-id="@Model.PhongId" class="lc-photo-edit" aria-label="Quản lý ảnh phòng @Model.MaPhong">✎</a></div>}@if(Model.Anh.Count<8){<a asp-controller="PhongTro" asp-action="Edit" asp-route-id="@Model.PhongId" class="lc-add-photo"><span>＋</span><small>Thêm ảnh</small></a>}</div></section>
</div><aside class="lc-aside"><section class="lc-card lc-preview"><div class="lc-preview-heading"><div><h2>Xem trước tin đăng</h2><p>Nội dung khách tìm phòng sẽ nhìn thấy.</p></div><span>@(published?"Đang đăng":"Chưa đăng")</span></div><div class="lc-cover"><img src="@(Model.Anh.FirstOrDefault()?.DuongDan??Url.Content("~/room-placeholder.svg"))" alt="Ảnh đại diện phòng @Model.MaPhong"/><small><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="m5 17 5-6 4 4 3-3 3 4"/></svg>@(Model.Anh.Count>0?"1 / "+Model.Anh.Count:"0 / 0")</small></div><div class="lc-preview-body"><h3 id="lc-preview-title">@Model.TieuDe</h3><strong class="lc-price">@Model.GiaThue.ToString("N0",vi) đ <small>/ tháng</small></strong><p class="lc-facts"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 5-5 13 13-5 5L3 8Zm4-1 2 2m1 1 2 2m1 1 2 2"/></svg>@Model.DienTich.ToString("0.#",vi) m² · 1–@Model.SoNguoiToiDa người · Tầng @Model.Tang</p><p class="lc-facts"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 10c0 5-6 11-6 11S6 15 6 10a6 6 0 1 1 12 0Z"/><circle cx="12" cy="10" r="2"/></svg>@Model.DiaChi</p><p id="lc-preview-description">@Model.NoiDung</p><button type="button" id="lc-preview-more" aria-expanded="false">Xem thêm</button><div class="lc-preview-tags">@foreach(var service in Model.DichVu){<span>@service.TenDichVu</span>}</div><p class="lc-preview-deposit">Tiền cọc: @Model.TienCoc.ToString("N0",vi) đ · Chưa gồm phí dịch vụ</p><div class="lc-preview-contact"><span class="lc-contact-avatar">@(string.IsNullOrWhiteSpace(Model.TenChuNha)?"CN":Model.TenChuNha.Trim()[..1])</span><div><strong>@(Model.TenChuNha??"Chủ nhà")</strong><small>Chủ nhà · @Model.TenToaNha</small></div></div>@if(!string.IsNullOrWhiteSpace(Model.DienThoaiChuNha)){<a class="lc-contact-call" href="tel:@Model.DienThoaiChuNha"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-3 2a15 15 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2Z"/></svg>Liên hệ @Model.DienThoaiChuNha</a>}</div></section>
<section class="lc-card lc-contact-card"><div class="lc-title"><span class="lc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2"/><circle cx="12" cy="10" r="2"/><path d="M8 17a4 4 0 0 1 8 0"/></svg></span><div><h2>Thông tin liên hệ</h2><p>Khách thuê sẽ liên hệ qua thông tin này.</p></div></div><label for="lc-contact-name">Tên người liên hệ</label><input class="form-control" id="lc-contact-name" value="@(Model.TenChuNha??"Chủ nhà")" readonly/><div class="lc-field"><label for="lc-contact-phone">Số điện thoại</label><input class="form-control" id="lc-contact-phone" value="@Model.DienThoaiChuNha" readonly/></div><label class="lc-zalo"><input type="checkbox" disabled/><span>Cho phép liên hệ qua Zalo</span></label><small>Thông tin đồng bộ từ chủ nhà. Chưa hỗ trợ tùy chọn Zalo.</small></section>
<section class="lc-card lc-visibility-card"><div class="lc-title"><span class="lc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></span><div><h2>Thiết lập hiển thị</h2><p>Chọn thời điểm tin xuất hiện với khách.</p></div></div><label>Thời điểm đăng</label><div class="lc-post-options"><label class="lc-post-option"><input type="radio" name="PostTimePreview" checked/><span><strong>Đăng ngay</strong><small>Hiển thị sau khi chọn Đăng tin</small></span></label><label class="lc-post-option lc-disabled" title="Chưa hỗ trợ hẹn lịch đăng"><input type="radio" name="PostTimePreview" disabled/><span>Hẹn lịch đăng</span></label></div><div class="lc-field"><label for="lc-duration">Thời hạn hiển thị</label><select class="form-select" id="lc-duration"><option>30 ngày</option></select><small>Dự kiến hết hạn: @Model.NgayHetHan.AddHours(7).ToString("dd/MM/yyyy").</small></div><p class="lc-visibility-note"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 11v6M12 7h.01"/></svg><span>Tin chỉ hiển thị khi phòng còn trống và tòa nhà đang hoạt động. Chọn Lưu nháp để lưu mà chưa đăng.</span></p></section></aside></div><footer class="lc-footer"><div><strong>Tin sẽ được đăng cho phòng @Model.MaPhong · @Model.TenToaNha.</strong><small>Kiểm tra nội dung và ảnh trước khi hoàn tất.</small></div><div><a asp-action="QuanLy">Hủy</a>@if(!published){<button type="submit" name="intent" value="NHAP" class="lc-draft btn btn-outline-secondary" disabled="@chooseBuilding"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12l4 4v14H3V3h2Zm2 0v7h10V3M7 21v-7h10v7m-3-15v2"/></svg>Lưu nháp</button>}<button type="submit" name="intent" value="DANG_HIEN_THI" class="lc-submit btn btn-dark" disabled="@chooseBuilding"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>@(published?"Lưu thay đổi":"Đăng tin")</button></div></footer></form></div>
@section Styles {<link rel="stylesheet" href="~/css/listing-create.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/listing-form-bootstrap.css" asp-append-version="true"/>}
@section Scripts {<partial name="_ValidationScriptsPartial"/><script src="~/js/listing-create.js" asp-append-version="true"></script>}
