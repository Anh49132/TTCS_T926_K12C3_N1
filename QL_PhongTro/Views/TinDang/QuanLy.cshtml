@model QL_PhongTro.ViewModels.TinDangQuanLyViewModel
@using System.Globalization
@{ ViewData["Title"] = "Tin đăng cho thuê"; var ok = TempData["TinDangOk"] as string; var vi = CultureInfo.GetCultureInfo("vi-VN"); var statuses = new[] { (Code:"DANG_HIEN_THI",Name:"Công khai",Icon:"⚑",Note:"Tin đang hiển thị công khai"), (Code:"NHAP",Name:"Bản nháp",Icon:"▧",Note:"Chưa hiển thị với khách tìm phòng"), (Code:"TAM_AN",Name:"Tạm ẩn",Icon:"◉",Note:"Có thể đăng lại khi sẵn sàng"), (Code:"DA_CHO_THUE",Name:"Đã kết thúc",Icon:"⊙",Note:"Đã cho thuê · Không còn hiển thị") }; }
<div class="listing-manage-page listing-manage-bootstrap">
@if(TempData["TinDangError"] is string stateError){<p class="alert alert-warning" role="alert">@stateError</p>}
<header class="lm-heading"><div><h1>Tin đăng cho thuê</h1><p>Quản lý nội dung tin đăng và theo dõi các phòng tại các cơ sở của bạn.</p></div><a asp-action="Tao" class="lm-primary btn btn-dark">＋ Tạo tin đăng</a></header>
@if(ok is not null){<div class="alert alert-success" role="status">@ok</div>}
@if(Model.DanhSach.Any(x=>x.DaHetHan)){<div class="lm-warning">Có tin đã hết hạn và tự chuyển sang Tạm ẩn. Bạn có thể kiểm tra rồi đăng lại tin.</div>}
<div class="lm-stats">@foreach(var state in statuses){<button type="button" data-lm-tab="@state.Code"><span>@state.Name <i aria-hidden="true">@if(state.Code == "DANG_HIEN_THI"){<svg viewBox="0 0 24 24"><path d="M4 9v6h5l9 4V5L9 9H4Zm5 6 2 6H7l-2-6M21 9v6"/></svg>}else if(state.Code == "NHAP"){<svg viewBox="0 0 24 24"><path d="M13 3H5v18h14v-7M13 3v6h6m-6-6 6 6m-8 9 1-4 7-7 3 3-7 7-4 1Z"/></svg>}else if(state.Code == "TAM_AN"){<svg viewBox="0 0 24 24"><path d="m3 3 18 18M9 5a12 12 0 0 1 12 7 15 15 0 0 1-4 5M6 6a16 16 0 0 0-3 6 12 12 0 0 0 12 7m-6-10a4 4 0 0 0 6 6"/></svg>}else{<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="m8 12 3 3 5-6"/></svg>}</i></span><strong>@Model.DanhSach.Count(x=>x.TrangThaiTin==state.Code).ToString("D2") <small>tin</small></strong><p>@state.Note</p></button>}</div>
<div class="lm-warning">▯ @Model.DanhSach.Count(x=>x.TrangThaiPhong=="TRONG") phòng còn trống; @Model.DanhSach.Count(x=>x.TrangThaiPhong=="TRONG" && x.TinDangId is null) phòng chưa có tin đăng. <a asp-controller="PhongTro" asp-action="Index">Xem phòng trống <svg class="lm-vacant-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M9 5l3 3-3 3"/></svg></a></div>
<section class="lm-panel" id="lm-table"><div class="lm-panel-heading"><h2>Danh sách tin đăng <span>@Model.DanhSach.Count(x=>x.TinDangId.HasValue) tin</span></h2><small>Quản lý tin và phòng chưa đăng</small></div>
<nav class="lm-tabs nav" aria-label="Lọc trạng thái"><button type="button" data-lm-tab="" aria-pressed="true">Tất cả @Model.DanhSach.Count</button>@foreach(var state in statuses){<button type="button" data-lm-tab="@state.Code">@state.Name @Model.DanhSach.Count(x=>x.TrangThaiTin==state.Code)</button>}<button type="button" data-lm-tab="NONE">Chưa có tin</button></nav>
<div class="lm-filters"><div class="lm-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><input class="form-control" id="lm-search" aria-label="Tìm tin đăng" placeholder="Tìm tiêu đề, mã tin hoặc số phòng…" /></div><select class="form-select" id="lm-building" aria-label="Cơ sở"><option value="">Cơ sở: Tất cả cơ sở</option>@foreach(var building in Model.DanhSach.GroupBy(x=>x.ToaNhaId)){<option value="@building.Key">@building.First().TenToaNha</option>}</select><select class="form-select" id="lm-status" aria-label="Trạng thái"><option value="">Trạng thái: Tất cả</option>@foreach(var state in statuses){<option value="@state.Code">@state.Name</option>}<option value="NONE">Chưa có tin</option></select><select class="form-select" id="lm-sort" aria-label="Sắp xếp"><option value="new">Ngày đăng mới nhất</option><option value="price">Giá thuê tăng dần</option></select></div>
<div class="lm-table-scroll"><table class="table align-middle mb-0"><thead><tr><th>Tin đăng / Phòng</th><th>Cơ sở</th><th>Giá thuê / tháng</th><th>Ngày đăng</th><th>Trạng thái</th><th>Mức độ quan tâm</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var item in Model.DanhSach){ var visible=item.TrangThaiTin=="DANG_HIEN_THI"; var status=item.TrangThaiTin??"NONE";
<tr data-lm-row data-building="@item.ToaNhaId" data-status="@status" data-price="@item.GiaThue" data-date="@(item.NgayDang?.Ticks ?? 0)" data-search="@((item.TieuDe+" "+item.MaPhong+" "+item.TinDangId+" "+item.TenToaNha).ToLowerInvariant())">
<td><div class="lm-room"><img src="@(item.AnhDaiDien ?? Url.Content("~/room-placeholder.svg"))" alt="Phòng @item.MaPhong" loading="lazy" /><div><strong>@(item.TieuDe??"Phòng "+item.MaPhong+" · Chưa có tin")</strong><small>@item.MaPhong · @item.DienTich.ToString("0.#",vi) m²</small><small>@(item.TinDangId.HasValue?"TD-"+item.TinDangId.Value.ToString("D3"):"Chưa đăng tin")</small>@if(item.TuDongSauTraPhong && status=="NHAP"){<small class="lm-checkout-draft">Nháp tự tạo sau trả phòng</small>}@if(status=="NHAP" && (User.IsInRole("CHU_NHA") || User.IsInRole("QUAN_LY"))){<form method="post" asp-action="Dang" class="lm-publish-form"><input type="hidden" name="id" value="@item.TinDangId"/><button type="submit" class="lm-publish-button">Đăng tin</button></form>}</div></div></td><td>@item.TenToaNha</td><td class="lm-rent"><strong>@item.GiaThue.ToString("N0",vi) đ</strong><small>/ tháng</small></td><td>@(item.NgayDang?.AddHours(7).ToString("dd/MM/yyyy")??"—")</td><td><span class="lm-badge lm-@status">● @(status switch{"DANG_HIEN_THI"=>"Công khai","NHAP"=>"Bản nháp","TAM_AN"=>"Tạm ẩn","DA_CHO_THUE"=>"Đã kết thúc",_=>"Chưa có tin"})</span><small>@(item.TrangThaiPhong switch{"TRONG"=>"Phòng còn trống","DANG_THUE"=>"Đã có khách thuê","DA_DAT_COC"=>"Đã đặt cọc",_=>"Ngừng cho thuê"})</small>@if(item.DaHetHan){<small class="lm-expired">Đã hết hạn</small>}</td><td><small>Chưa có thống kê</small></td><td><div class="lm-actions">
@if(item.TinDangId.HasValue) {<a asp-action="Sua" asp-route-id="@item.TinDangId" class="lm-edit-button" aria-label="Chỉnh sửa tin phòng @item.MaPhong" title="Chỉnh sửa tin"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-5L16 4a2.1 2.1 0 0 1 3 3L8 18l-4 2ZM14 6l3 3"/></svg></a>}
else {<button type="button" class="lm-edit-button" disabled title="Phòng chưa có tin đăng để chỉnh sửa" aria-label="Phòng chưa có tin đăng để chỉnh sửa"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-5L16 4a2.1 2.1 0 0 1 3 3L8 18l-4 2ZM14 6l3 3"/></svg></button>}
<details class="lm-action-menu"><summary class="lm-more-button" aria-label="Đổi trạng thái tin phòng @item.MaPhong" title="Thao tác tin đăng"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="19" cy="12" r="1.4"/></svg></summary><div class="lm-action-popup">
@foreach(var choice in new[]{("DANG_HIEN_THI","Đăng tin"),("NHAP","Bản nháp"),("TAM_AN","Tạm ẩn"),("DA_CHO_THUE","Đã kết thúc")}) {
if(item.TinDangId.HasValue){<form method="post" asp-action="DoiTrangThai"><input type="hidden" name="id" value="@item.TinDangId"/><input type="hidden" name="trangThai" value="@choice.Item1"/><input type="hidden" name="trangThaiDaXem" value="@status"/><button type="submit" disabled="@(status==choice.Item1)">@(status==choice.Item1?"✓ ":"")@choice.Item2</button></form>}
else if(choice.Item1 is "NHAP" or "DANG_HIEN_THI") {<a asp-action="Tao" asp-route-phongId="@item.PhongId">@choice.Item2</a>} else {<button type="button" disabled>@choice.Item2</button>}
}
</div></details>
</div></td></tr>}
</tbody></table></div><p id="lm-empty" hidden>Không có phòng hoặc tin đăng phù hợp.</p><footer class="lm-pagination"><span id="lm-count"></span><select class="form-select" id="lm-size" aria-label="Số dòng mỗi trang"><option value="10">10 / trang</option><option value="20">20 / trang</option><option value="50">50 / trang</option></select><div><button type="button" id="lm-prev" aria-label="Trang trước">‹</button><span id="lm-page"></span><button type="button" id="lm-next" aria-label="Trang sau">›</button></div></footer><p class="lm-panel-note">ⓘ Tin đã kết thúc không hiển thị với khách tìm phòng. Phòng đang cho thuê chưa thể đăng tin mới.</p></section></div>
@section Styles {<link rel="stylesheet" href="~/css/listing-management.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/listing-manage-bootstrap.css" asp-append-version="true" />}
@section Scripts {<script src="~/js/listing-management.js" asp-append-version="true"></script>}
