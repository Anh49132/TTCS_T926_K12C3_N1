@model QL_PhongTro.ViewModels.DanhSachTinDangQuanLyViewModel
@{
    ViewData["Title"] = "Quản lý tin đăng";
    var statusLabels = new Dictionary<string, string>
    {
        ["NHAP"] = "Nháp",
        ["DANG_HIEN_THI"] = "Đang hiển thị",
        ["TAM_AN"] = "Tạm ẩn",
        ["DA_CHO_THUE"] = "Đã cho thuê"
    };
}

<section class="mb-4">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Tin đăng</p>
    <h1 class="h2 mb-1">Quản lý tin đăng</h1>
    <p class="text-secondary mb-0">Chọn trạng thái phù hợp cho từng tin. Mỗi phòng chỉ được có một tin đang hiển thị.</p>
</section>

@if (Model.TinDangs.Count == 0)
{
    <div class="border-top border-bottom py-4">
        <h2 class="h5">Chưa có tin đăng</h2>
        <p class="text-secondary mb-0">Tạo tin từ trang quản lý phòng để bắt đầu.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Tin đăng</th>
                    <th scope="col">Mã phòng</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col">Chuyển trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tin in Model.TinDangs)
                {
                    var label = statusLabels.GetValueOrDefault(tin.TrangThai, tin.TrangThai);
                    <tr>
                        <th scope="row">
                            @tin.TieuDe
                            @if (tin.DaTuDongAnDoQuaHan)
                            {
                                <span class="d-block text-danger small fw-semibold" role="status">⚠ Tin đã quá hạn hiển thị</span>
                            }
                        </th>
                        <td>@tin.MaPhong</td>
                        <td>@label</td>
                        <td>
                            <form asp-action="CapNhatTrangThai" asp-route-id="@tin.Id" method="post" class="d-flex flex-wrap gap-2">
                                <button type="submit" name="trangThai" value="NHAP" class="btn btn-sm btn-outline-secondary">Nháp</button>
                                <button type="submit" name="trangThai" value="DANG_HIEN_THI" class="btn btn-sm btn-outline-primary">Hiển thị</button>
                                <button type="submit" name="trangThai" value="TAM_AN" class="btn btn-sm btn-outline-warning">Tạm ẩn</button>
                                <button type="submit" name="trangThai" value="DA_CHO_THUE" class="btn btn-sm btn-outline-success">Đã cho thuê</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
