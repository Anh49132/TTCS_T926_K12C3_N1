@model QL_PhongTro.ViewModels.TinDangChiTietViewModel
@{ViewData["Title"]="Chi tiết tin đăng";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<a asp-action="QuanLy" class="btn btn-outline-secondary mb-3">← Danh sách tin đăng</a>
<article class="card p-4"><h1 class="h3">@Model.TieuDe</h1><p>Phòng @Model.MaPhong · @Model.TenToaNha</p><p>@Model.DiaChi · @Model.PhuongXa · @Model.QuanHuyen · @Model.TinhThanh</p><strong>@Model.GiaThue.ToString("N0",vi) đ / tháng</strong><p>@Model.DienTich.ToString("0.#",vi) m² · Tối đa @Model.SoNguoiToiDa người</p><div class="row g-3 my-2">@foreach(var photo in Model.Anh){<div class="col-sm-6 col-lg-4"><img src="@photo.DuongDan" alt="@(photo.MoTa ?? Model.TieuDe)" class="img-fluid rounded" loading="lazy" /></div>}</div><h2 class="h5 mt-3">Mô tả</h2><p style="white-space:pre-wrap;overflow-wrap:anywhere">@Model.MoTa</p><h2 class="h5">Dịch vụ và đơn giá</h2><div class="table-responsive"><table class="table"><thead><tr><th>Dịch vụ</th><th>Đơn giá</th><th>Đơn vị</th></tr></thead><tbody>@foreach(var fee in Model.DichVuTheoSuDung.Concat(Model.KhoanCoDinh)){<tr><td>@fee.TenDichVu</td><td>@fee.DonGia.ToString("N0",vi) đ</td><td>@fee.DonViTinh</td></tr>}</tbody></table></div></article>
