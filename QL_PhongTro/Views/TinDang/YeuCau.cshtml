@model QL_PhongTro.ViewModels.ChiTietYeuCauKhachViewModel
@using QL_PhongTro.Models
@using QL_PhongTro.Services
@{ViewData["Title"]="Thông tin yêu cầu"; var r=Model.YeuCau; var room=Model.TinDang; var status=TrangThaiYeuCau.Labels.GetValueOrDefault(r.TrangThai,r.TrangThai); var cancel=r.TrangThai is "MOI" or "DA_HEN_LICH";}
<article class="tr-page tr-detail">
<nav class="tr-breadcrumb"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span>/</span><a asp-controller="YeuCau" asp-action="Index">Yêu cầu của tôi</a><span>/</span><span>@r.MaYeuCau</span></nav>

<header class="tr-detail-heading"><div><h1>Yêu cầu <span id="ma-yeu-cau">@r.MaYeuCau</span> <span class="tr-status @r.TrangThai">@status</span></h1><p class="tr-muted">Đã gửi lúc @LichHenService.HienThoiGio(r.NgayTao)</p></div><div class="tr-actions">@if(cancel){<form method="post" asp-controller="YeuCau" asp-action="Huy" asp-route-id="@r.Id" data-cancel-request><button type="button" class="tr-button danger-outline" data-open-cancel-confirmation aria-haspopup="dialog">Huỷ yêu cầu</button></form>}<a class="tr-button" asp-controller="YeuCau" asp-action="MoTinDang" asp-route-id="@r.Id">↗ Mở tin đăng</a></div></header>
<div class="tr-detail-columns"><div class="tr-detail-main">
<section class="tr-card"><h2><span class="tr-icon"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("list")' /></span>Thông tin yêu cầu</h2><dl class="tr-facts"><div><dt>Loại yêu cầu</dt><dd>@TrangThaiYeuCau.LoaiLabel(r.LoaiYeuCau)</dd></div><div><dt>Ngày mong muốn</dt><dd>@r.NgayMongMuon.ToString("dd/MM/yyyy")</dd></div><div><dt>Số người dự kiến</dt><dd>@r.SoNguoiDuKien người</dd></div><div><dt>Trạng thái</dt><dd><span class="tr-status @r.TrangThai">@status</span></dd></div><div><dt>Lời nhắn</dt><dd class="tr-message">@(string.IsNullOrWhiteSpace(r.LoiNhan)?"Không có lời nhắn":r.LoiNhan)</dd></div>@if(r.TrangThai=="TU_CHOI"){<div><dt>Lý do từ chối</dt><dd>@LichHenService.LyDoLabel(r.LyDoTuChoi ?? "Không có lý do")</dd></div>}</dl><p class="tr-info">ⓘ @(r.TrangThai switch {"MOI"=>"Yêu cầu đang chờ chủ nhà tiếp nhận.","DA_HEN_LICH"=>"Chủ nhà đã xác nhận lịch hẹn xem phòng.","DA_DUYET"=>"Yêu cầu đã được chủ nhà duyệt.","DA_HUY"=>"Yêu cầu đã hủy và không thể khôi phục.","TU_CHOI"=>"Chủ nhà đã từ chối yêu cầu này.",_=>status})</p></section>
<section class="tr-card" id="lich-hen"><h2><span class="tr-icon"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("calendar")' /></span>Lịch hẹn xem phòng</h2>@if(r.LichHen is {} appointment){<div class="tr-appointment"><span class="tr-icon blue"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("calendar")' /></span><div><strong>@LichHenService.HienThoiGio(appointment)</strong><p>Phòng @room?.MaPhong</p><small>@(r.TrangThai is "DA_HUY" or "TU_CHOI" ? "Lịch hẹn trước khi yêu cầu kết thúc, không còn hiệu lực." : "Thời gian theo giờ Việt Nam. Hãy trao đổi với chủ nhà nếu cần đổi lịch.")</small></div></div>}else{<div class="tr-empty-appointment"><span class="tr-icon"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("calendar")' /></span><strong>@(r.LoaiYeuCau=="THUE_NGAY" ? "Yêu cầu thuê ngay" : "Chưa có lịch hẹn")</strong><p>@(r.LoaiYeuCau=="THUE_NGAY" ? "Yêu cầu này chưa ghi nhận lịch xem phòng." : "Chủ nhà chưa xác nhận thời gian xem phòng.")</p></div>}</section>
<section class="tr-card"><h2><span class="tr-icon"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("list")' /></span>Lịch sử yêu cầu</h2><ol class="tr-timeline">@foreach(var entry in Model.LichSu.OrderBy(x=>x.ThoiDiem)){<li><strong>@(entry.TrangThaiCu is null ? $"Bạn đã gửi yêu cầu {TrangThaiYeuCau.LoaiLabel(r.LoaiYeuCau).ToLower()}" : entry.TrangThaiMoi==entry.TrangThaiCu ? "Lịch hẹn đã được cập nhật" : TrangThaiYeuCau.Labels.GetValueOrDefault(entry.TrangThaiMoi,entry.TrangThaiMoi))</strong><small>@LichHenService.HienThoiGio(entry.ThoiDiem)</small>@if(entry.LichHenMoi is {} time){<p>Lịch hẹn: @LichHenService.HienThoiGio(time)</p>}@if(entry.LyDoTuChoi is not null){<p>Lý do từ chối: @LichHenService.LyDoLabel(entry.LyDoTuChoi)</p>}</li>}</ol></section>
</div><aside class="tr-detail-side"><section class="tr-card tr-room"><h2><span class="tr-icon"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("home")' /></span>Phòng đã yêu cầu</h2>@if(room is not null){<img src="@(room.Anh.FirstOrDefault()?.DuongDanAnhNho ?? room.Anh.FirstOrDefault()?.DuongDan ?? Url.Content("~/room-placeholder.svg"))" alt="Phòng @room.MaPhong" /><h3>@room.TieuDe</h3><p class="tr-muted">@room.MaPhong · @room.TenToaNha</p><p class="tr-muted">@string.Join(", ",new[]{room.DiaChi,room.PhuongXa,room.QuanHuyen,room.TinhThanh}.Where(x=>!string.IsNullOrWhiteSpace(x)))</p><p class="tr-room-price"><strong>@room.GiaThue.ToString("N0",System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</strong> / tháng</p><div class="tr-room-facts"><span>@room.DienTich.ToString("0.##") m²</span><span>Tối đa @room.SoNguoiToiDa người</span></div>}else{<p>Thông tin phòng không còn khả dụng.</p>}<a class="tr-button primary" asp-controller="YeuCau" asp-action="MoTinDang" asp-route-id="@r.Id">↗ Xem tin đăng</a></section>
<section class="tr-card"><h2><span class="tr-icon"><partial name="~/Views/YeuCau/_RequestIcon.cshtml" model='@("clock")' /></span>Trạng thái xử lý</h2><dl class="tr-processing"><div><dt>Đã gửi yêu cầu</dt><dd>@LichHenService.HienThoiGio(r.NgayTao)</dd></div><div><dt>Phản hồi của chủ nhà</dt><dd>@(r.TrangThai=="MOI" ? "Đang chờ" : status)</dd></div>@if(r.NgayXuLy is {} processed){<div><dt>Cập nhật xử lý</dt><dd>@LichHenService.HienThoiGio(processed)</dd></div>}</dl>@if(cancel){<p class="tr-info">ⓘ Bạn có thể hủy khi yêu cầu mới hoặc đã hẹn lịch.</p>}</section>
<section class="tr-card tr-help"><strong>Cần hỗ trợ?</strong><p class="tr-muted">Xem thông tin liên hệ của NhàTốt nếu thông tin yêu cầu chưa chính xác.</p><a class="tr-button" asp-controller="Home" asp-action="GioiThieu">Thông tin hỗ trợ</a></section></aside></div>
<partial name="~/Views/YeuCau/_CancelRequestDialog.cshtml" />
</article>
@section Styles {<link rel="stylesheet" href="~/css/tenant-requests.css" asp-append-version="true" />}
@section Scripts {<script src="~/js/tenant-request-cancel-confirmation.js" asp-append-version="true"></script>}
