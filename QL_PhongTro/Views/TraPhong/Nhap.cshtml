@model QL_PhongTro.ViewModels.TraPhongViewModel
@{ViewData["Title"]="Ghi nhận trả phòng";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
@section Styles { <link rel="stylesheet" href="~/css/tat-toan.css" asp-append-version="true"/> }
<div class="settlement-page"><nav class="st-breadcrumb"><a asp-controller="HopDong" asp-action="Details" asp-route-id="@Model.Input.HopDongId">Hợp đồng &amp; người ở ghép</a> / @Model.MaHopDong / Trả phòng</nav><h1>Ghi nhận trả phòng</h1><p class="st-muted">Nhập thông tin bàn giao để hệ thống tính hóa đơn kỳ cuối.</p><div class="st-card st-contract"><div><small>Mã hợp đồng</small><strong>@Model.MaHopDong</strong></div><div><small>Phòng</small><strong>@Model.Phong · @Model.ToaNha</strong></div><div><small>Khách thuê</small><strong>@Model.Khach</strong></div><div><small>Ngày kết thúc HĐ</small><strong>@Model.NgayKetThuc.ToString("dd/MM/yyyy")</strong></div></div><div asp-validation-summary="All" class="alert alert-danger"></div>
@if(Model.HoaDonDaCo.HasValue){<div class="alert alert-info">Hợp đồng đã có hóa đơn kỳ cuối. <a asp-action="ChiTiet" asp-route-id="@Model.HoaDonDaCo">Xem hóa đơn</a></div>}
<form asp-action="Tinh" method="post" id="checkout-input" data-preview="@Url.Action("UocTinh")"><input asp-for="Input.HopDongId" type="hidden"/><div class="st-grid"><div><section class="st-card"><h2>Thông tin trả phòng</h2><label asp-for="Input.NgayTra">Ngày trả thực tế *</label><input asp-for="Input.NgayTra" type="date" required class="form-control"/><p class="st-muted">Tính cả ngày trả phòng. Tiền phòng tính từ đầu tháng hoặc ngày vào nếu muộn hơn, chia số ngày thực tế của tháng.</p></section><section class="st-card"><h2>Chỉ số điện nước cuối cùng</h2><div class="st-meter-grid">
@foreach(var m in Model.CongTo){<div><h3>@m.Ten</h3><p class="st-muted">Chỉ số gần nhất: <strong>@m.ChiSo.ToString("#,##0.###",vi) @m.DonVi</strong><br/>Chốt ngày @m.NgayChot.ToString("dd/MM/yyyy")</p><p>Đơn giá đã tải: @m.DonGia.ToString("N0",vi) đ/@m.DonVi</p>@if(m.Ma=="DIEN"){<label asp-for="Input.ChiSoDien">Chỉ số điện cuối *</label><input asp-for="Input.ChiSoDien" type="number" min="0" max="99999999999.999" step="0.001" required class="form-control"/>}else{<label asp-for="Input.ChiSoNuoc">Chỉ số nước cuối *</label><input asp-for="Input.ChiSoNuoc" type="number" min="0" max="99999999999.999" step="0.001" required class="form-control"/>}</div>}
</div><p class="st-muted">ⓘ Chỉ số cuối không được nhỏ hơn lần chốt gần nhất. Đơn giá được tính lại theo ngày trả thực tế khi xem dự tính.</p></section></div><aside class="st-card"><h2>Dự tính kỳ cuối</h2><div id="checkout-estimate" aria-live="polite">Nhập ngày trả và hai chỉ số cuối để xem dự tính.</div><div class="st-notice">Bước này chưa tất toán cọc hoặc kết thúc hợp đồng.</div></aside></div><div class="st-actions"><a class="btn btn-outline-secondary" asp-controller="HopDong" asp-action="Details" asp-route-id="@Model.Input.HopDongId">Hủy</a><button class="btn st-primary" type="submit" disabled="@(Model.CongTo.Count!=2 || Model.HoaDonDaCo.HasValue)">Tính hóa đơn kỳ cuối →</button></div></form></div>
@section Scripts { <script src="~/js/tra-phong.js" asp-append-version="true"></script> }
