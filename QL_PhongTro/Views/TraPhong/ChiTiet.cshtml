@model QL_PhongTro.ViewModels.TraPhongViewModel
@{ViewData["Title"]="Hóa đơn kỳ cuối";var bill=Model.HoaDon!;var saved=bill.Id>0;var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
@section Styles { <link rel="stylesheet" href="~/css/tat-toan.css" asp-append-version="true"/> }
<div class="settlement-page"><nav class="st-breadcrumb"><a asp-controller="HopDong" asp-action="Details" asp-route-id="@bill.HopDongId">Hợp đồng &amp; người ở ghép</a> / @Model.MaHopDong / Hóa đơn kỳ cuối</nav><h1>@(saved?"Chi tiết hóa đơn kỳ cuối":"Kiểm tra hóa đơn kỳ cuối")</h1><p class="st-muted">Phòng @Model.Phong · @Model.Khach · Ngày trả @bill.DenNgay.ToString("dd/MM/yyyy")</p><div class="alert alert-info">Hóa đơn được lưu nháp để kiểm tra; chưa phát hành và chưa kết thúc hợp đồng.</div><div class="st-grid"><section class="st-card"><h2>Chi tiết khoản thu</h2><div class="st-table-wrap"><table><thead><tr><th>Khoản thu</th><th>Cách tính</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>
@foreach(var line in bill.ChiTiet.OrderBy(x=>x.SoThuTu)){<tr><th>@line.TenKhoan</th><td>@(line.LoaiKhoan=="TIEN_PHONG"?"Theo ngày thực tế":$"{line.ChiSoCuoi?.ToString("#,##0.###",vi)} − {line.ChiSoDau?.ToString("#,##0.###",vi)}")</td><td>@(line.LoaiKhoan=="TIEN_PHONG"?$"{line.SoNgayTinhTien??DateTime.DaysInMonth(bill.Nam,bill.Thang)}/{line.SoNgayTrongThang??DateTime.DaysInMonth(bill.Nam,bill.Thang)} ngày":$"{line.SoLuong.ToString("#,##0.###",vi)} {line.DonViTinh}")</td><td>@line.DonGia.ToString("N0",vi) đ</td><td><strong>@line.ThanhTien.ToString("N0",vi) đ</strong></td></tr>}
</tbody></table></div><div class="st-result"><strong>Tổng hóa đơn kỳ cuối</strong><strong>@bill.TongTien.ToString("N0",vi) đ</strong></div></section><aside class="st-card"><partial name="_ChamDutChiTiet" model="Model.ChamDut"/><h2 class="st-space">Thông tin tính toán</h2><p>Kỳ tính: @bill.TuNgay.ToString("dd/MM/yyyy") – @bill.DenNgay.ToString("dd/MM/yyyy")</p><p>Đơn giá áp dụng: tại ngày trả phòng.</p><p>Trạng thái: @(bill.TrangThai=="NHAP"?"Chưa phát hành":bill.TrangThai=="DA_HUY"?"Đã hủy":"Đã phát hành")</p>@foreach(var line in bill.ChiTiet.Where(x=>x.DichVuId.HasValue)){<p class="st-muted">@line.GhiChu</p>}</aside></div><div class="st-actions">
@if(!saved){<form asp-action="Sua" method="post"><input asp-for="Input.HopDongId" type="hidden"/><input asp-for="Input.NgayTra" type="hidden"/><input asp-for="Input.ChiSoDien" type="hidden"/><input asp-for="Input.ChiSoNuoc" type="hidden"/><input asp-for="Input.LyDo" type="hidden"/><input asp-for="Input.LyDoKhac" type="hidden"/><input name="Input.ApDungPhat" value="@Model.Input.ApDungPhat.ToString().ToLowerInvariant()" type="hidden"/><input asp-for="Input.TienPhat" type="hidden"/><button class="btn btn-outline-secondary">← Sửa dữ liệu bàn giao</button></form><form asp-action="Luu" method="post"><input asp-for="Input.HopDongId" type="hidden"/><input asp-for="Input.NgayTra" type="hidden"/><input asp-for="Input.ChiSoDien" type="hidden"/><input asp-for="Input.ChiSoNuoc" type="hidden"/><input asp-for="Input.LyDo" type="hidden"/><input asp-for="Input.LyDoKhac" type="hidden"/><input name="Input.ApDungPhat" value="@Model.Input.ApDungPhat.ToString().ToLowerInvariant()" type="hidden"/><input asp-for="Input.TienPhat" type="hidden"/><input asp-for="Input.DauVanTay" type="hidden"/><button class="btn st-primary">Lưu hóa đơn kỳ cuối</button></form>}
else{<a class="btn btn-outline-secondary" asp-controller="HopDong" asp-action="Details" asp-route-id="@bill.HopDongId">Về chi tiết hợp đồng</a>@if(bill.TrangThai!="DA_HUY"){<a class="btn st-primary" asp-controller="TatToan" asp-action="Nhap" asp-route-id="@bill.HopDongId">Tiếp tục lập bảng tất toán →</a>}}
</div></div>
