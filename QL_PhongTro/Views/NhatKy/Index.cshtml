@model QL_PhongTro.ViewModels.NhatKyViewModel
@using QL_PhongTro.ViewModels
@{
    ViewData["Title"] = "Nhật ký hoạt động";
}
<div class="audit-bootstrap">
<header class="audit-heading"><p class="eyebrow">HỆ THỐNG</p>
<h1>Nhật ký hoạt động</h1>
<p>Xem ai đã thêm, sửa hoặc xóa thông tin. Thời gian hiển thị theo giờ Việt Nam; tên và vai trò là thông tin tại lúc thực hiện.</p>
</header>
<form method="get" class="row g-3 audit-filters">
    <div class="col-md-3"><label asp-for="TuNgay" class="form-label">Từ ngày</label><input asp-for="TuNgay" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="DenNgay" class="form-label">Đến ngày</label><input asp-for="DenNgay" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="NguoiThucHienId" class="form-label">Người thực hiện</label><select asp-for="NguoiThucHienId" class="form-select"><option value="">Tất cả</option>
    @foreach (var actor in Model.Actors) { <option value="@actor.Id">@(actor.Name ?? "Chưa có tên lịch sử") (#@actor.Id)</option> }
    </select></div>
    <div class="col-md-3"><label asp-for="LoaiDoiTuong" class="form-label">Nhóm thông tin</label><select asp-for="LoaiDoiTuong" class="form-select"><option value="">Tất cả</option>
    @foreach (var type in NhatKyViewModel.Types) { <option value="@type.Key">@type.Value</option> }
    </select></div>
    <div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Lọc nhật ký</button> <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a></div>
</form>
<p class="audit-count">@Model.Total hoạt động · Trang @Model.Page/@Model.Pages</p>
<div class="table-responsive audit-table-wrap"><table class="table table-hover align-top audit-table mb-0"><thead><tr><th>STT</th><th>Thời điểm</th><th>Người thực hiện</th><th>Vai trò</th><th>Thao tác</th><th>Thông tin liên quan</th><th>Nội dung thay đổi</th></tr></thead><tbody>
@{ var auditStt = (Model.Page - 1) * 50; }
@foreach (var row in Model.Rows) {
auditStt++;
var display = AuditDisplay.Describe(row);
<tr data-audit-id="@row.Id">
<td>@auditStt</td>
<td>@row.ThoiDiem.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
<td>@(row.TenNguoiThucHien ?? "Chưa ghi nhận tên") @if (row.NguoiThucHienId is not null) { <small class="d-block text-muted">Mã tài khoản: @row.NguoiThucHienId</small> }</td>
<td>@AuditDisplay.Role(row.VaiTroLucThucHien)</td><td>@NhatKyViewModel.ActionName(row.HanhDong)</td>
<td>@display.Subject</td>
<td><p class="mb-2">@AuditDisplay.Sentence(row)</p><p class="text-secondary mb-2">@display.Summary</p><details><summary class="text-primary">Xem chi tiết</summary>
@if (display.Unreadable) { <p class="text-secondary mt-2">Một phần thông tin cũ không đọc được. Các thông tin còn lại được hiển thị bên dưới.</p> }
@if (display.Changes.Count > 0) {
<table class="table table-sm table-bordered mt-2 mb-0" aria-label="Chi tiết thay đổi">
<thead><tr><th scope="col">Thông tin</th>
@if (row.HanhDong != "TAO") { <th scope="col">@(row.HanhDong == "XOA" ? "Thông tin đã xóa" : "Trước khi sửa")</th> }
@if (row.HanhDong != "XOA") { <th scope="col">@(row.HanhDong == "TAO" ? "Thông tin đã thêm" : "Sau khi sửa")</th> }
</tr></thead><tbody>
@foreach (var change in display.Changes) {
<tr><th scope="row">@change.Label</th>
@if (row.HanhDong != "TAO") { <td style="overflow-wrap:anywhere">@change.Before</td> }
@if (row.HanhDong != "XOA") { <td style="overflow-wrap:anywhere">@change.After</td> }
</tr>
}
</tbody></table>
} else if (!display.Unreadable) { <p class="text-secondary mt-2">Không có thông tin chi tiết được lưu cho thao tác này.</p> }
@if (row.HanhDong == "GUI_LAI_MAT_KHAU_TAM") { <p>Đã cấp mật khẩu tạm mới và đăng xuất các phiên đăng nhập cũ. Mật khẩu không hiển thị trong lịch sử.</p> }
</details></td></tr>
}
@if (Model.Rows.Count == 0) { <tr><td colspan="7">Không có nhật ký phù hợp.</td></tr> }
</tbody></table></div>
<nav aria-label="Phân trang nhật ký">
@foreach (var pageNumber in new[] { Model.Page - 1, Model.Page + 1 }.Where(p => p >= 1 && p <= Model.Pages)) {
<a class="btn btn-outline-primary" asp-action="Index" asp-route-page="@pageNumber" asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")" asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-nguoiThucHienId="@Model.NguoiThucHienId" asp-route-loaiDoiTuong="@Model.LoaiDoiTuong">@(pageNumber < Model.Page ? "Trang trước" : "Trang sau")</a>
}
</nav>
</div>
@section Styles { <link rel="stylesheet" href="~/css/audit-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/audit-dropdowns.js" asp-append-version="true"></script> }
