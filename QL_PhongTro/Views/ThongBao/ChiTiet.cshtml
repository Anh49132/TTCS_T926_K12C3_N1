@model QL_PhongTro.ViewModels.ChiTietHoaDonKhachPageViewModel
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}
<section class="container py-4 tenant-invoice-detail" data-invoice-url="@Url.Action("ChiTietDuLieu", "ThongBao", new { maHoaDon = Model.MaHoaDon })">
    <a asp-action="DanhSach"
       asp-route-ky="@Model.Ky"
       asp-route-trangThai="@(Model.TrangThai == QL_PhongTro.ViewModels.TrangThaiThanhToanHoaDon.TatCa ? null : Model.TrangThai)"
       asp-route-page="@(Model.Page > 1 ? Model.Page : null)"
       class="btn btn-outline-secondary mb-3">← Danh sách hóa đơn</a>
    <h1 class="h3">Chi tiết hóa đơn</h1>
    <div id="tenant-invoice-loading" class="alert alert-info" role="status" aria-live="polite">
        Đang tải chi tiết hóa đơn…
    </div>
    <div id="tenant-invoice-error" class="alert alert-danger" role="alert" hidden></div>
    <section id="tenant-invoice-content" class="card" hidden>
        <div class="card-body">
            <h2 class="h5 mb-1">Hóa đơn tháng <span id="tenant-invoice-period"></span></h2>
            <p class="text-muted" id="tenant-invoice-room"></p>
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0" id="tenant-invoice-lines">
                    <caption class="visually-hidden">Các khoản mục của hóa đơn</caption>
                    <thead>
                        <tr>
                            <th scope="col">Khoản mục</th>
                            <th scope="col">Chỉ số đầu kỳ</th>
                            <th scope="col">Chỉ số cuối kỳ</th>
                            <th scope="col">Số đơn vị tiêu thụ</th>
                            <th scope="col">Đơn giá</th>
                            <th scope="col">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <section class="tenant-invoice-summary mt-4" aria-labelledby="tenant-invoice-summary-title">
                <h3 class="h6" id="tenant-invoice-summary-title">Tổng kết hóa đơn</h3>
                <dl class="mb-0">
                    <div><dt>Tổng cộng</dt><dd id="tenant-invoice-total"></dd></div>
                    <div><dt>Đã thanh toán</dt><dd id="tenant-invoice-paid"></dd></div>
                    <div><dt>Còn phải trả</dt><dd id="tenant-invoice-remaining"></dd></div>
                    <div class="tenant-invoice-due-row">
                        <dt>Hạn thanh toán</dt>
                        <dd><span id="tenant-invoice-due"></span><span id="tenant-invoice-overdue" class="tenant-invoice-overdue" role="status" hidden></span></dd>
                    </div>
                </dl>
                <div id="tenant-payment-report-pending" class="alert alert-info mt-3 mb-0" role="status" hidden></div>
                <form asp-controller="ThongBao" asp-action="BaoCaoThanhToan" method="post" id="tenant-payment-report-form" class="mt-4" hidden>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="hoaDonId" id="tenant-payment-report-invoice-id" />
                    <h4 class="h6">Báo cáo thanh toán</h4>
                    <div class="mb-3">
                        <label for="tenant-payment-report-amount" class="form-label">Số tiền đã thanh toán (đồng)</label>
                        <input id="tenant-payment-report-amount" name="soTien" type="number" class="form-control" min="1" step="1" required />
                        <div class="form-text" id="tenant-payment-report-limit"></div>
                    </div>
                    <div class="mb-3">
                        <label for="tenant-payment-report-date" class="form-label">Ngày thanh toán</label>
                        <input id="tenant-payment-report-date" name="ngayThanhToan" type="date" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="tenant-payment-report-method" class="form-label">Hình thức thanh toán</label>
                        <select id="tenant-payment-report-method" name="hinhThucThanhToan" class="form-select" required>
                            <option value="">Chọn hình thức</option>
                            <option value="TIEN_MAT">Tiền mặt</option>
                            <option value="CHUYEN_KHOAN">Chuyển khoản</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-dark">Gửi báo cáo thanh toán</button>
                </form>
            </section>
        </div>
    </section>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/invoice-detail.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/tenant-invoice-detail.js" asp-append-version="true"></script>
}
