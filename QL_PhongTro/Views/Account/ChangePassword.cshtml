@model QL_PhongTro.ViewModels.Auth.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<main class="login-page login-bootstrap change-bootstrap container-fluid p-0">
    <aside class="login-photo" aria-label="Không gian sống ấm cúng">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-story">
            <span class="login-proof"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3 7 3v6c0 5-7 9-7 9s-7-4-7-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>Tin đăng được xác thực mỗi ngày</span>
            <h2>Tìm một nơi vừa vặn để gọi là nhà.</h2>
            <p>Hàng nghìn phòng trọ và căn hộ minh bạch, dễ so sánh, sẵn sàng cho hành trình an cư của bạn.</p>
            <div class="login-stats"><div><strong>12.000+</strong><span>người thuê tin dùng</span></div><div><strong>4.800+</strong><span>chỗ ở đã xác thực</span></div></div>
        </div>
    </aside>
    <section class="login-panel" aria-labelledby="change-password-title">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-card change-password-card card border-0 shadow-sm" id="auth-content">

<span class="login-welcome-tag badge rounded-pill mb-3">BẢO MẬT TÀI KHOẢN</span><h1 id="change-password-title" class="fw-bold">Đổi mật khẩu</h1>
@if (User.FindFirst("must_change_password")?.Value == "true") { <div class="alert alert-warning">Bạn phải thay mật khẩu tạm trước khi sử dụng bất kỳ chức năng nào khác.</div> }
@if (TempData["PasswordSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<p class="login-description">Mật khẩu mới tối thiểu 8 ký tự, có ít nhất một chữ cái và một chữ số.</p>
<form asp-action="ChangePassword" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label><div class="login-field password-field"><svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg><input name="CurrentPassword" id="CurrentPassword" type="password" autocomplete="current-password" class="form-control" placeholder="••••••••" required /><partial name="_PasswordToggle" model='@("CurrentPassword")' /></div><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
<div class="mb-3"><label for="NewPassword" class="form-label">Mật khẩu mới</label><div class="login-field password-field"><svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg><input name="NewPassword" id="NewPassword" type="password" autocomplete="new-password" class="form-control" placeholder="••••••••" required /><partial name="_PasswordToggle" model='@("NewPassword")' /></div><span asp-validation-for="NewPassword" class="text-danger"></span></div>
<div class="mb-3"><label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label><div class="login-field password-field"><svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg><input name="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" placeholder="••••••••" required /><partial name="_PasswordToggle" model='@("ConfirmPassword")' /></div><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
<button type="submit" class="btn btn-dark login-submit">Đổi mật khẩu</button>
</form>
<p class="login-bottom"><a href="/">Về trang chủ</a></p>
</div>
</section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/login-bootstrap.css" asp-append-version="true" />
}