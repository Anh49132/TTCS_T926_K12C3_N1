@model QL_PhongTro.ViewModels.Auth.LoginRequest
@{ ViewData["Title"] = "Đăng nhập"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('loginForm');
            var errorEl = document.getElementById('loginError');
            var lockoutAlert = document.getElementById('lockoutAlert');
            var lockoutMessage = document.getElementById('lockoutMessage');
            var countdownTimer = document.getElementById('countdownTimer');
            var countdownInterval = null;

            function showLockout(seconds) {
                errorEl.textContent = '';
                lockoutAlert.classList.remove('d-none');
                var endTime = Date.now() + seconds * 1000;
                function tick() {
                    var remaining = Math.max(0, Math.ceil((endTime - Date.now()) / 1000));
                    var mins = Math.floor(remaining / 60);
                    var secs = remaining % 60;
                    countdownTimer.textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
                    if (remaining <= 0) {
                        clearInterval(countdownInterval);
                        countdownInterval = null;
                        lockoutAlert.classList.add('d-none');
                    }
                }
                tick();
                countdownInterval = setInterval(tick, 1000);
            }

            function hideLockout() {
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                }
                lockoutAlert.classList.add('d-none');
            }

            if (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    errorEl.textContent = '';
                    hideLockout();

                    var taiKhoan = document.getElementById('TaiKhoanDangNhap').value.trim();
                    var pwd = document.getElementById('MatKhau').value;

                    if (!taiKhoan) {
                        errorEl.textContent = 'Phải nhập số điện thoại hoặc email';
                        return;
                    }
                    if (!pwd) {
                        errorEl.textContent = 'Nhập mật khẩu.';
                        return;
                    }

                    // S1-02: gui qua /Account/Login de lay cookie phien trinh duyet,
                    // dong thoi nhan access token + refresh token luu xuong thiet bi.
                    var payload = new FormData();
                    payload.append('TaiKhoanDangNhap', taiKhoan);
                    payload.append('MatKhau', pwd);
                    payload.append('RememberMe', document.getElementById('RememberMe').checked ? 'true' : 'false');
                    payload.append('ReturnUrl', document.getElementById('ReturnUrl').value || '');
                    var antiforgery = form.querySelector('input[name="__RequestVerificationToken"]');
                    if (antiforgery) payload.append('__RequestVerificationToken', antiforgery.value);

                    try {
                        var res = await fetch('/Account/Login', {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            body: payload
                        });
                        var data = await res.json();
                        if (!res.ok || !data.success) {
                            errorEl.textContent = data.message || 'Đăng nhập thất bại';
                            if (data.locked && data.remainingMinutes > 0) {
                                showLockout(data.remainingMinutes * 60);
                            }
                            return;
                        }
                        if (data.accessToken) {
                            authSetTokens(data.accessToken, data.refreshToken);
                        }
                        window.location.href = data.returnUrl || '/';
                    } catch (err) {
                        errorEl.textContent = 'Lỗi kết nối server';
                    }
                });
            }
        })();
    </script>
}
<main class="login-page login-bootstrap container-fluid p-0">
    <aside class="login-photo" aria-label="Không gian sống ấm cúng">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-story">
            <span class="login-proof"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3 7 3v6c0 5-7 9-7 9s-7-4-7-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>Tin đăng được xác thực mỗi ngày</span>
            <h2>Tìm một nơi vừa vặn để gọi là nhà.</h2>
            <p>Hàng nghìn phòng trọ và căn hộ minh bạch, dễ so sánh, sẵn sàng cho hành trình an cư của bạn.</p>
            <div class="login-stats"><div><strong>12.000+</strong><span>người thuê tin dùng</span></div><div><strong>4.800+</strong><span>chỗ ở đã xác thực</span></div></div>
        </div>
    </aside>
    <section class="login-panel" aria-labelledby="login-title">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-card card border-0 shadow-sm" id="auth-content">
            <span class="login-welcome-tag badge rounded-pill mb-3">CHÀO MỪNG ĐẾN VỚI NHÀTỐT</span><h1 id="login-title" class="fw-bold">Chào mừng bạn trở lại</h1>
            <p class="login-description">Đăng nhập để lưu căn yêu thích, theo dõi lịch hẹn và kết nối với chủ nhà uy tín.</p>
            @if (TempData["PasswordSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
            @if (ViewData["TimeoutMessage"] is string timeout) { <div class="alert alert-warning" role="alert">@timeout</div> }
            <form id="loginForm" asp-controller="Account" asp-action="Login" method="post" data-use-api="false" novalidate>
                <div class="text-danger" role="alert" id="loginError">@if (!ViewData.ModelState.IsValid) { @Html.ValidationSummary(false) }</div>
                <input asp-for="ReturnUrl" type="hidden" />
                <div class="mb-3">
                    <label asp-for="TaiKhoanDangNhap" class="form-label">Email hoặc số điện thoại</label>
                    <div class="login-field">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/></svg>
                        <input asp-for="TaiKhoanDangNhap" class="form-control" autocomplete="username" placeholder="ban@example.com" />
                    </div>
                    <span asp-validation-for="TaiKhoanDangNhap" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
                    <div class="login-field password-field">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/><circle cx="12" cy="15" r="1"/></svg>
                        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" placeholder="••••••••••" />
                        <partial name="_PasswordToggle" model='@("MatKhau")' />
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>
                <div class="login-options">
                    <label class="login-remember form-check-label"><input asp-for="RememberMe" class="form-check-input" /> Ghi nhớ đăng nhập</label>
                    <a asp-action="ForgotPassword">Quên mật khẩu?</a>
                </div>
                <div class="mb-3 text-warning d-none" id="lockoutAlert"><div class="alert alert-warning mb-0" role="alert"><strong id="lockoutMessage">Tài khoản đã bị khoá.</strong><div class="mt-2"><span class="badge bg-warning text-dark" id="countdownTimer"></span></div></div></div>
                <button type="submit" class="btn btn-dark login-submit" id="loginSubmitBtn">Đăng nhập</button>
            </form>
            <p class="login-bottom">Chưa có tài khoản?<a asp-action="Register">Đăng ký miễn phí</a></p>
        </div>
    </section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/login-bootstrap.css" asp-append-version="true" />
}