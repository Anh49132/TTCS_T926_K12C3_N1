@model QL_PhongTro.Controllers.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<main class="login-page register-page login-bootstrap container-fluid p-0">
    <aside class="login-photo" aria-label="Không gian sống ấm cúng">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-story">
            <span class="login-proof"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3 7 3v6c0 5-7 9-7 9s-7-4-7-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>Tin đăng được xác thực mỗi ngày</span>
            <h2>Tìm một nơi vừa vặn để gọi là nhà.</h2>
            <p>Hàng nghìn phòng trọ và căn hộ minh bạch, dễ so sánh, sẵn sàng cho hành trình an cư của bạn.</p>
            <div class="login-stats"><div><strong>12.000+</strong><span>người thuê tin dùng</span></div><div><strong>4.800+</strong><span>chỗ ở đã xác thực</span></div></div>
        </div>
    </aside>
    <section class="login-panel" aria-labelledby="register-title">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-card register-card card border-0 shadow-sm" id="auth-content">
            <span class="login-welcome-tag badge rounded-pill mb-3">BẮT ĐẦU CÙNG NHÀTỐT</span><h1 id="register-title" class="fw-bold">Tạo tài khoản của bạn</h1>
            <p class="login-description">Cùng NhàTốt tìm nơi ở phù hợp, theo dõi lịch hẹn và kết nối với chủ nhà uy tín.</p>
<form asp-action="Register" method="post" id="registerForm">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="HoTen" class="form-label">Họ và tên</label><input asp-for="HoTen" class="form-control" autocomplete="name" placeholder="Nguyễn Văn An" required /><span asp-validation-for="HoTen" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" placeholder="ban@example.com" required /><span asp-validation-for="Email" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" type="tel" class="form-control" autocomplete="tel" placeholder="Nhập 10 chữ số, bắt đầu bằng 0" pattern="0[0-9]{9}" required /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MatKhau" class="form-label">Mật khẩu</label><div class="login-field password-field"><input asp-for="MatKhau" type="password" class="form-control" autocomplete="new-password" minlength="8" aria-describedby="password-help" required /><partial name="_PasswordToggle" model='@("MatKhau")' /></div><div id="password-help" class="form-text">Tối thiểu 8 ký tự, gồm chữ cái và chữ số.</div><span asp-validation-for="MatKhau" class="text-danger"></span></div>
<button class="btn btn-dark login-submit" type="submit">Tạo tài khoản</button>
</form>
            <p class="login-bottom">Đã có tài khoản?<a asp-action="Login">Đăng nhập</a></p>
        </div>
    </section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/login-bootstrap.css" asp-append-version="true" />
}