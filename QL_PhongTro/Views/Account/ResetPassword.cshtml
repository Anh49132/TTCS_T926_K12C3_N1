@model QL_PhongTro.ViewModels.Auth.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt mật khẩu mới"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<main class="login-page auth-recovery-page">
<section class="login-panel" aria-labelledby="reset-title">
<a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
<div class="login-card" id="auth-content" tabindex="-1"><h1 id="reset-title">Đặt mật khẩu mới</h1>
<p class="login-description" id="reset-password-help">Mật khẩu tối thiểu 8 ký tự, có ít nhất một chữ cái và một chữ số.</p>
<form asp-action="ResetPassword" method="post">
<input asp-for="Token" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label for="NewPassword" class="form-label">Mật khẩu mới</label><div class="login-field password-field"><input name="NewPassword" id="NewPassword" type="password" autocomplete="new-password" class="form-control" minlength="8" aria-describedby="reset-password-help reset-password-error" required /><partial name="_PasswordToggle" model='@("NewPassword")' /></div><span asp-validation-for="NewPassword" id="reset-password-error" class="text-danger"></span></div>
<div class="mb-3"><label for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label><div class="login-field password-field"><input name="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" minlength="8" aria-describedby="reset-confirm-error" required /><partial name="_PasswordToggle" model='@("ConfirmPassword")' /></div><span asp-validation-for="ConfirmPassword" id="reset-confirm-error" class="text-danger"></span></div>
<button type="submit" class="btn login-submit">Đặt mật khẩu mới</button>
</form><p class="login-bottom"><a asp-action="Login">← Quay lại đăng nhập</a></p>
</div></section></main>
