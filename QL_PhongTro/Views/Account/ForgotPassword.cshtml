@model QL_PhongTro.ViewModels.Auth.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<main class="login-page login-bootstrap forgot-bootstrap container-fluid p-0">
    <aside class="login-photo" aria-label="Không gian sống ấm cúng">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-story">
            <span class="login-proof"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3 7 3v6c0 5-7 9-7 9s-7-4-7-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>Tin đăng được xác thực mỗi ngày</span>
            <h2>Tìm một nơi vừa vặn để gọi là nhà.</h2>
            <p>Hàng nghìn phòng trọ và căn hộ minh bạch, dễ so sánh, sẵn sàng cho hành trình an cư của bạn.</p>
            <div class="login-stats"><div><strong>12.000+</strong><span>người thuê tin dùng</span></div><div><strong>4.800+</strong><span>chỗ ở đã xác thực</span></div></div>
        </div>
    </aside>
    <section class="login-panel" aria-labelledby="forgot-title">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-card card border-0 shadow-sm" id="auth-content">
<div class="forgot-icon mb-3" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V6a4 4 0 0 1 8 0v4M12 14v3"/></svg></div><span class="login-welcome-tag badge rounded-pill mb-3">KHÔI PHỤC TÀI KHOẢN</span><h1 id="forgot-title" class="fw-bold">Quên mật khẩu?</h1>
@if (TempData["ResetRequestMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<p class="login-description">Nhập email tài khoản Khách thuê để nhận liên kết đặt lại mật khẩu.</p>
<form asp-action="ForgotPassword" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Email" class="form-label">Email</label><div class="login-field"><svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/></svg><input asp-for="Email" type="email" autocomplete="email" class="form-control" placeholder="ban@example.com" required /></div><span asp-validation-for="Email" class="text-danger"></span></div>
<button type="submit" class="btn btn-dark login-submit">Gửi liên kết đặt lại</button>
</form><p class="login-bottom"><a asp-action="Login">← Quay lại đăng nhập</a></p>
        </div>
    </section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/login-bootstrap.css" asp-append-version="true" />
}