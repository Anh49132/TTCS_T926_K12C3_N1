@model QL_PhongTro.ViewModels.EmailConfirmationViewModel
@{ ViewData["Title"] = "Xác nhận email"; Layout = "~/Views/Shared/_LoginLayout.cshtml"; }
<main class="login-page login-bootstrap confirm-bootstrap container-fluid p-0">
    <aside class="login-photo" aria-label="Không gian sống ấm cúng">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-story">
            <span class="login-proof"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="m12 3 7 3v6c0 5-7 9-7 9s-7-4-7-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>Tin đăng được xác thực mỗi ngày</span>
            <h2>Tìm một nơi vừa vặn để gọi là nhà.</h2>
            <p>Hàng nghìn phòng trọ và căn hộ minh bạch, dễ so sánh, sẵn sàng cho hành trình an cư của bạn.</p>
            <div class="login-stats"><div><strong>12.000+</strong><span>người thuê tin dùng</span></div><div><strong>4.800+</strong><span>chỗ ở đã xác thực</span></div></div>
        </div>
    </aside>
    <section class="login-panel" aria-labelledby="confirmation-title">
        <a class="login-brand" href="/" aria-label="NhàTốt, về trang chủ"><img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" /></a>
        <div class="login-card card border-0 shadow-sm" id="auth-content">
<div class="confirmation-icon mb-3" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/></svg></div><span class="login-welcome-tag badge rounded-pill mb-3">HOÀN TẤT ĐĂNG KÝ</span><h1 id="confirmation-title" class="fw-bold">Xác nhận email của bạn</h1>
<p class="login-description" id="confirmation-help">Nhập mã 6 số được gửi đến email của bạn. Mã có hiệu lực trong 15 phút.</p>
@if (TempData["RegisterMessage"] is string message) { <div class="alert alert-info" role="status">@message</div> }
@if (TempData.ContainsKey("RegisterPickupDirectory") || TempData.ContainsKey("RegisterPickupFile"))
{
    <details class="confirmation-local mb-3"><summary>Chi tiết email thử nghiệm</summary>
        @if (TempData["RegisterPickupDirectory"] is string directory) { <div><strong>Thư mục email local:</strong> <code>@directory</code></div> }
        @if (TempData["RegisterPickupFile"] is string file) { <div><strong>File mới nhất:</strong> <code>@file</code></div> }
    </details>
}
@if (TempData["RegisterError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<form asp-action="ConfirmEmail" method="post"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" class="form-control" autocomplete="email" placeholder="ban@example.com" required />
<label asp-for="Code" class="form-label mt-3">Mã xác nhận</label><input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="000000" required aria-describedby="confirmation-help" />
<div class="confirmation-actions mt-3"><button class="btn btn-dark login-submit" type="submit">Xác nhận</button><button class="btn btn-outline-secondary confirmation-resend" type="submit" formaction="@Url.Action("ResendConfirmation", "Account")" formnovalidate>Gửi lại mã</button></div></form>

<p class="login-bottom"><a asp-action="Login">← Quay lại đăng nhập</a></p>
        </div>
    </section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/login-bootstrap.css" asp-append-version="true" />
}