@model QL_PhongTro.ViewModels.TaoDichVuViewModel
@using QL_PhongTro.Models
@using QL_PhongTro.Services
@{ ViewData["Title"] = "Thêm dịch vụ"; }
<div class="service-create-page service-create-bootstrap">

<header class="sc-heading"><div><h1>Thêm dịch vụ</h1><p>Thiết lập dịch vụ, đơn giá và phạm vi áp dụng cho nhà cho thuê của bạn.</p></div><span>* Thông tin bắt buộc</span></header>
@if (Model.ToaNhas.Count == 0) { <p class="alert alert-info">Bạn cần khai báo tòa nhà trước khi thêm dịch vụ.</p><a class="sc-button btn btn-outline-secondary" asp-controller="PhongTro" asp-action="TaoToaNha">Khai báo tòa nhà</a> }
else {
<form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="sc-layout"><div class="sc-main">
<section class="sc-card sc-service-info"><div class="sc-card-heading"><span class="sc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg></span><div><h2>Thông tin dịch vụ</h2><p>Tên dịch vụ sẽ hiển thị trong hợp đồng và hóa đơn.</p></div></div><div class="sc-fields sc-name-fields"><div><label asp-for="TenDichVu">Tên dịch vụ <em>*</em></label><input class="form-control" asp-for="TenDichVu" maxlength="100" placeholder="Ví dụ: Dọn phòng" /><span asp-validation-for="TenDichVu" class="text-danger"></span></div><div><label for="sc-code">Mã dịch vụ</label><input class="form-control" id="sc-code" disabled placeholder="Tự sinh khi lưu" /><small>Mã được hệ thống tạo khi lưu dịch vụ.</small></div></div></section>
<section class="sc-card sc-pricing-card"><div class="sc-card-heading"><span class="sc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18H6zM14.5 8h-4a1.5 1.5 0 0 0 0 3h3a1.5 1.5 0 0 1 0 3h-4M12 6v10"/></svg></span><div><h2>Cách tính phí &amp; đơn giá</h2><p>Chọn một cách tính phí phù hợp với dịch vụ.</p></div></div><div class="sc-methods">
<label><input asp-for="CachTinh" type="radio" value="THEO_CHI_SO" id="sc-meter" /><span><strong>Theo tiêu thụ</strong><small>Theo chỉ số điện, nước ghi nhận mỗi kỳ.</small></span><svg class="sc-method-icon sc-meter-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17a9 9 0 1 1 16 0M12 13l5-5" /><circle cx="12" cy="13" r="1" /></svg></label>
<label><input asp-for="CachTinh" type="radio" value="CO_DINH" id="sc-fixed" /><span><strong>Cố định</strong><small>Theo số phòng đăng ký mỗi tháng.</small></span><svg class="sc-method-icon sc-billing-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M7 10h2m6 4h2" /><circle cx="12" cy="12" r="2" /></svg></label>
<label><input asp-for="CachTinh" type="radio" value="THEO_NGUOI" id="sc-person" /><span><strong>Theo đầu người</strong><small>Theo số người sử dụng dịch vụ.</small></span><svg class="sc-method-icon sc-billing-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3" /><path d="M6 21v-3a6 6 0 0 1 12 0v3M18 4a3 3 0 0 1 0 6M21 20v-3a5 5 0 0 0-3-4" /></svg></label>
</div><span asp-validation-for="CachTinh" class="text-danger"></span><div class="sc-fields"><div><label asp-for="DonGia">Đơn giá <em>*</em></label><div class="sc-unit"><input class="form-control" asp-for="DonGia" type="number" min="0" step="1" inputmode="numeric" placeholder="0" /><span>đ</span></div><span asp-validation-for="DonGia" class="text-danger"></span></div><div><label asp-for="DonViTinh">Đơn vị tính <em>*</em></label><input class="form-control" asp-for="DonViTinh" maxlength="30" list="sc-units" placeholder="phòng / tháng" /><datalist id="sc-units"><option value="kWh"></option><option value="m³"></option><option value="phòng / tháng"></option><option value="người / tháng"></option><option value="xe / tháng"></option></datalist><span asp-validation-for="DonViTinh" class="text-danger"></span></div></div><p class="sc-formula" data-sc-formula>▤ Chọn cách tính để xem công thức.</p><small class="sc-muted">Nhập đơn giá nguyên đồng không âm, không dùng dấu phân cách.</small></section>
<section class="sc-card sc-scope-card"><div class="sc-card-heading"><span class="sc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 21V4h9v17M8 9H4v12h16M11 7h3M11 10h3M11 13h3M11 21v-5h3v5"/></svg></span><div><h2>Phạm vi áp dụng</h2><p>Chọn tòa nhà và các phòng sử dụng dịch vụ này.</p></div></div><label asp-for="ToaNhaIds">Tòa nhà áp dụng <em>*</em></label><select class="form-select" asp-for="ToaNhaIds" asp-items="Model.ToaNhas" multiple data-building-multiple></select><span asp-validation-for="ToaNhaIds" class="text-danger"></span><small>Có thể chọn một hoặc nhiều tòa nhà.</small><label class="sc-scope-heading">Phạm vi áp dụng</label><div class="sc-scope"><label><input asp-for="ApDungMacDinh" /> Áp dụng mặc định cho phòng mới</label><label><input asp-for="ChonPhongCuThe" data-specific-rooms /> Chọn phòng cụ thể</label></div><small>Chọn phòng cụ thể để gán dịch vụ cho các phòng hiện có trong tòa đã chọn.</small></section>
<div class="sc-card sc-room-selection" data-room-selection hidden><h2>Chọn phòng áp dụng</h2><p data-room-empty>Chọn tòa nhà để xem danh sách phòng.</p><div class="sc-room-grid">
@foreach (var room in Model.Phongs) { var buildingName = Model.ToaNhas.FirstOrDefault(x => x.Value == room.ToaNhaId.ToString())?.Text; <label data-room-building="@room.ToaNhaId"><input type="checkbox" name="PhongIds" value="@room.Id" checked="@Model.PhongIds.Contains(room.Id)"/> @room.MaPhong <small>@buildingName</small></label> }
</div><span asp-validation-for="PhongIds" class="text-danger"></span></div>
<section class="sc-card sc-effective-card"><div class="sc-card-heading"><span class="sc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="16" rx="2"/><path d="M8 3v4m8-4v4M5 10h14M8 14h8m-8 3h5"/></svg></span><div><h2>Hiệu lực &amp; ghi chú</h2><p>Thiết lập thời điểm bắt đầu và trạng thái của dịch vụ.</p></div></div><div class="sc-fields"><div><label for="sc-effective">Hiệu lực từ <em>*</em></label><input class="form-control" id="sc-effective" type="date" value="@DichVuService.HomNay().ToString("yyyy-MM-dd")" disabled /></div><div><label for="sc-status">Trạng thái <em>*</em></label><select class="form-select" id="sc-status" asp-for="TrangThai"><option value="DANG_AP_DUNG">Đang áp dụng</option><option value="TAM_NGUNG">Tạm ngừng</option></select><span asp-validation-for="TrangThai" class="text-danger"></span></div></div><small class="sc-notice">ⓘ Dịch vụ mới áp dụng từ ngày khai báo. Chưa hỗ trợ hẹn ngày hiệu lực khi tạo.</small><label for="sc-note">Ghi chú (không bắt buộc)</label><textarea class="form-control" id="sc-note" asp-for="GhiChu" maxlength="500" rows="3" placeholder="Thông tin bổ sung về dịch vụ..."></textarea><span asp-validation-for="GhiChu" class="text-danger"></span><small>Ghi chú tối đa 500 ký tự.</small></section>
</div><aside class="sc-aside"><section class="sc-card sc-summary"><h2 class="sc-summary-heading"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="12" height="16" rx="2"/><path d="M9 5V3h6v2M9 10h6M9 14h6M9 18h4"/></svg>Tóm tắt dịch vụ</h2><div class="sc-summary-name"><span class="sc-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 12h7v9H6zM8 12V9h3v3M11 9h4M16 3v6M13 6h6M19 12v4M17 14h4"/></svg></span><div><strong data-sc-name>Chưa nhập tên dịch vụ</strong><small data-sc-type>Chưa chọn cách tính</small></div></div><div class="sc-summary-price"><small>ĐƠN GIÁ</small><strong data-sc-price>— đ</strong><small data-sc-unit>—</small></div><dl><div><dt>Tòa nhà</dt><dd data-sc-building>—</dd></div><div><dt>Phòng</dt><dd data-sc-scope>Chưa gán mặc định</dd></div><div><dt>Hiệu lực từ</dt><dd>@DichVuService.HomNay().ToString("dd/MM/yyyy")</dd></div><div><dt>Trạng thái</dt><dd><span class="sc-status" data-sc-status>Đang áp dụng</span></dd></div></dl><p class="sc-summary-footer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5H5v14h14v-7M10 14l1-4 8-8 3 3-8 8-4 1Z"/></svg>Thông tin chưa được lưu</p></section><section class="sc-explanation"><h3>♧ Phí dịch vụ được tính thế nào?</h3><p data-sc-explanation>Chọn cách tính phí để xem giải thích tương ứng.</p><p>ⓘ Giá ghi nhận khi tạo dịch vụ. Các thay đổi đơn giá sau đó được quản lý trong lịch sử đơn giá.</p></section></aside></div><footer class="sc-footer"><span>ⓘ Kiểm tra đơn giá và phạm vi áp dụng trước khi lưu.</span><div><a class="sc-button btn btn-outline-secondary" asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId">Hủy</a><button class="sc-button sc-primary btn btn-dark" type="submit">✓ Lưu dịch vụ</button></div></footer></form>
}
</div>
@section Styles { <link rel="stylesheet" href="~/css/service-create.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/service-create-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/service-create.js" asp-append-version="true"></script> }
