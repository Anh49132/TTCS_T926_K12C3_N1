@model QL_PhongTro.ViewModels.QuanLyDichVuViewModel
@using QL_PhongTro.Services
@using QL_PhongTro.Models
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    ViewData["Title"] = "Sửa đơn giá";
    var latest = Model.LichSu.Last();
    var priceRows = ViewData["BuildingPriceRows"] as List<CauHinhDichVu> ?? [];
    var roomCounts = ViewData["PriceServiceRoomCounts"] as Dictionary<int,int> ?? [];
    string PriceIcon(string code) => code.ToUpperInvariant() switch {
        "DIEN" => "m13 2-9 12h7l-1 8 10-13h-7l0-7",
        "NUOC" => "M12 3s-7 8-7 12a7 7 0 0 0 14 0c0-4-7-12-7-12Z",
        "INTERNET" => "M3 8a14 14 0 0 1 18 0M6 12a9 9 0 0 1 12 0m-9 4a4 4 0 0 1 6 0m-3 4h.01",
        _ => "M12 3v4m0 10v4M3 12h4m10 0h4M8 8l-3-3m11 11 3 3M8 16l-3 3m11-11 3-3M9 9h6v6H9Z"
    };
    var write = await Permissions.AllowsAsync("PHONG_TRO", true);
    var today = DichVuService.HomNay();
    var current = Model.LichSu.LastOrDefault(x => x.TuNgay <= today && (x.DenNgay == null || x.DenNgay >= today));
    var vn = CultureInfo.GetCultureInfo("vi-VN");
    var statusDate = DichVuService.KySau();
    if (statusDate <= latest.TuNgay) { statusDate = new DateOnly(latest.TuNgay.Year, latest.TuNgay.Month, 1).AddMonths(1); }
}
<div class="service-price-page">
<header class="sp-heading"><div><h1>@latest.DichVu.TenDichVu</h1><p>Quản lý mức giá và thiết lập thời điểm áp dụng cho từng phòng.</p></div><a class="sp-back" asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6-6 6 6 6M4 12h16"/></svg><span>Quay lại đơn giá</span></a></header>
<div class="sp-layout sp-edit-layout"><aside class="sp-price-list"><section class="sp-card sp-building"><span class="sp-building-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V7h7v14M11 21V3h9v18M2 21h20M7 10h1m-1 4h1m6-7h3m-3 4h3m-3 4h3M7 21v-4m7 4v-3h3v3"/></svg></span><div><small>KHU NHÀ ĐANG QUẢN LÝ</small><strong>@Model.TenToaNha</strong><p>@ViewData["PriceBuildingAddress"] · @ViewData["PriceBuildingRooms"] phòng / căn hộ</p></div><details class="sp-building-picker"><summary class="sp-building-link" aria-label="Đổi tòa nhà" title="Đổi tòa nhà"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></summary><div class="sp-building-menu">@foreach(var building in (ViewData["PriceBuildingOptions"] as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [])){<a asp-action="ChuyenToaSuaGia" asp-route-toaNhaId="@building.Value" asp-route-dichVuId="@Model.DichVuId" class="@(building.Value==Model.ToaNhaId.ToString()?"selected":"")">@building.Text @if(building.Value==Model.ToaNhaId.ToString()){<span>✓</span>}</a>}</div></details></section><div class="sp-list-heading"><div><h2>Bảng mức giá hiện tại</h2><p>Chọn một loại giá để chỉnh sửa mức áp dụng.</p></div><span class="sp-badge">@priceRows.Count loại giá</span></div><section class="sp-card sp-price-table"><table><thead><tr><th>Loại giá</th><th>Đơn vị tính</th><th>Mức giá (VND)</th><th>Phạm vi</th><th></th></tr></thead><tbody>
@foreach(var price in priceRows){
<tr class="@(price.DichVuId==Model.DichVuId?"selected":"")"><td><div class="sp-price-name"><span class="sp-price-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@PriceIcon(price.DichVu.MaDichVu)"/></svg></span><div><a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@price.DichVuId">@price.DichVu.TenDichVu</a>@if(price.DichVuId==Model.DichVuId){<small>Đang chỉnh sửa</small>}</div></div></td><td>@price.DonViTinh</td><td><strong>@(price.DaChotGia?price.DonGia.ToString("N0",vn):"Chưa thiết lập")</strong></td><td><span>@roomCounts.GetValueOrDefault(price.DichVuId) phòng</span><small class="sp-scope-note">Đã chọn dịch vụ</small></td><td><a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@price.DichVuId" aria-label="Sửa giá @price.DichVu.TenDichVu">›</a></td></tr>}
</tbody></table><footer class="sp-table-footer"><span>Hiển thị @priceRows.Count loại giá · Đơn vị tiền tệ: VND</span><span>Từ @latest.TuNgay.ToString("dd/MM/yyyy")</span></footer></section><section class="sp-card sp-principles"><h2><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6m0-10h.01"/></svg>Nguyên tắc áp dụng đơn giá</h2><p>Mức giá mới áp dụng cho các phòng dùng giá chung, từ ngày có hiệu lực. Các phòng dùng giá riêng tiếp tục sử dụng mức giá hiện tại. Hóa đơn đã phát hành giữ nguyên.</p><footer><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Phiên bản gần nhất: hiệu lực từ @latest.TuNgay.ToString("dd/MM/yyyy")</span></footer></section></aside><section class="sp-card sp-editor"><div class="sp-editor-heading"><span class="sp-editor-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@PriceIcon(latest.DichVu.MaDichVu)"/></svg></span><div><h2>Chỉnh sửa @latest.DichVu.TenDichVu.ToLower()</h2><small>@latest.DichVu.MaDichVu · @Model.TenToaNha</small></div><span class="sp-badge">Chưa lưu</span></div>
<div class="sp-service-fields"><div><label>Loại giá</label><div class="sp-old-price">@latest.DichVu.TenDichVu</div></div><div><label>Đơn vị tính</label><div class="sp-old-price">@latest.DonViTinh</div></div></div>
@if (write)
{
    <form asp-action="SavePrice" method="post" class="row g-3 mb-4">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="ToaNhaId" type="hidden" /><input asp-for="DichVuId" type="hidden" />
        <input asp-for="PhienBan" type="hidden" /><input asp-for="GiaCu" type="hidden" />
        <div class="col-sm-6"><label class="form-label">Mức giá hiện tại</label><div class="sp-old-price">@(current is { DaChotGia: true } ? current.DonGia.ToString("N0", vn) + " đ" : "Chưa thiết lập")</div></div>
        <div class="col-sm-6"><label asp-for="DonGia" class="form-label">Mức giá mới <em>*</em></label><input asp-for="DonGia" type="number" min="0" step="1" inputmode="numeric" class="form-control" /><span asp-validation-for="DonGia" class="text-danger"></span></div>
        <div class="col-12 sp-scope"><label>Phạm vi áp dụng <em>*</em></label><div class="sp-scope-options"><div class="sp-scope-option sp-option-disabled"><span>○</span><div><strong>Một phòng</strong><small>Chỉnh giá riêng trong hồ sơ phòng</small></div></div><div class="sp-scope-option selected"><span>◉</span><div><strong>Nhiều phòng</strong><small>Áp dụng cùng một mức giá chung</small></div></div></div><label class="sp-building-label">Khu nhà</label><div class="sp-old-price">@Model.TenToaNha</div><div class="sp-scope-count"><strong>@Math.Max(0,Model.SoPhongApDung-Model.SoPhongGiaRieng) phòng dùng giá chung</strong><a asp-controller="PhongTro" asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId">Xem phòng</a></div><p>@Model.SoPhongGiaRieng phòng dùng giá riêng giữ nguyên đơn giá.</p></div>
        <div class="col-sm-6"><label asp-for="TuNgay" class="form-label">Ngày bắt đầu áp dụng <em>*</em></label><input asp-for="TuNgay" type="date" class="form-control" /></div>
        <div class="col-sm-6 sp-first-period"><small>KỲ ÁP DỤNG ĐẦU TIÊN</small><strong id="sp-period">@(Model.TuNgay.HasValue ? "Tháng " + Model.TuNgay.Value.Month + ", " + Model.TuNgay.Value.Year : "Chọn ngày áp dụng")</strong></div><div class="col-12"><section class="sp-summary"><h3>Tóm tắt trước khi lưu</h3><p><span>@latest.DonGia.ToString("N0",vn)</span> → <strong id="sp-new-summary">@(Model.DonGia?.ToString("N0",vn)??"—")</strong> đ / @latest.DonViTinh</p><small>@Math.Max(0,Model.SoPhongApDung-Model.SoPhongGiaRieng) phòng dùng giá chung · @Model.TenToaNha</small></section><p class="sp-notice">Giá mới áp dụng cho kỳ có ngày chốt từ ngày hiệu lực đã chọn; trùng ngày sẽ bị từ chối. Hóa đơn đã phát hành giữ nguyên đơn giá cũ.</p></div>
        <div class="col-12 d-flex flex-wrap gap-2 sp-save-actions">

            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId">Hủy</a><button class="btn btn-primary" name="initial" value="false">✓ Lưu thay đổi</button>
        </div>

    </form>
}
</section></div><details class="sp-extra"><summary>Thông tin và trạng thái dịch vụ</summary><aside><section class="sp-card"><h2>Thông tin dịch vụ</h2><dl class="sp-info"><div><dt>Mã dịch vụ</dt><dd>@latest.DichVu.MaDichVu</dd></div><div><dt>Cách tính phí</dt><dd>@CachTinhDichVu.Ten(latest.CachTinh)</dd></div><div><dt>Đơn vị tính</dt><dd>@latest.DonViTinh</dd></div><div><dt>Tòa nhà</dt><dd>@Model.TenToaNha</dd></div></dl><a asp-controller="PhongTro" asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId">Xem danh sách phòng của tòa →</a></section>
@if (write)
{
<section class="sp-card"><h2>Trạng thái áp dụng</h2>
    <form asp-action="SetDefault" method="post" class="sp-default"><input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" /><input name="dichVuId" value="@Model.DichVuId" type="hidden" /><input name="returnToManage" value="true" type="hidden" /><span>Áp dụng cho phòng tạo mới</span><button type="submit" class="sp-switch @(Model.ApDungMacDinh ? "on" : "")" name="enabled" value="@((!Model.ApDungMacDinh).ToString())" role="switch" aria-checked="@Model.ApDungMacDinh.ToString().ToLowerInvariant()" aria-label="Đổi mặc định cho phòng tạo mới"><span></span></button></form>
    <form asp-action="SetStatus" method="post" class="d-flex flex-wrap align-items-end gap-2 mb-4">
        <input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" /><input name="dichVuId" value="@Model.DichVuId" type="hidden" />
        <input name="phienBan" value="@latest.Id" type="hidden" /><input name="active" value="@((!latest.DangApDung).ToString())" type="hidden" />
        <div><label for="status-date" class="form-label">Áp dụng trạng thái từ kỳ</label><input id="status-date" name="tuNgay" type="date" value="@statusDate.ToString("yyyy-MM-dd")" class="form-control" required /></div>
        <button class="btn btn-outline-secondary">@(latest.DangApDung ? "Ngừng áp dụng" : "Kích hoạt lại")</button>
    </form>
    <p class="small text-secondary">Chọn ngày đầu tháng từ kỳ sau, sau phiên bản mới nhất. Thông tin hợp đồng và hóa đơn cũ được giữ nguyên.</p>
</section>
}
</aside></details><section class="sp-card sp-history">
<h2>Lịch sử đơn giá và trạng thái</h2><p class="text-secondary">Mỗi lần thay đổi được lưu thành một phiên bản.</p>
<div class="table-responsive"><table class="table">
<thead><tr><th>Từ ngày</th><th>Đến ngày</th><th class="text-end">Đơn giá (VND)</th><th>Trạng thái</th></tr></thead>
<tbody>@foreach (var row in Model.LichSu.OrderByDescending(x => x.TuNgay))
{
    <tr><td>@row.TuNgay.ToString("dd/MM/yyyy")</td><td>@(row.DenNgay?.ToString("dd/MM/yyyy") ?? "Chưa kết thúc")</td><td class="text-end">@(row.DaChotGia ? row.DonGia.ToString("N0", vn) + " đ" : "Chưa thiết lập")</td><td><span class="sp-badge">@(row.TuNgay > today ? (row.DangApDung ? "Sắp áp dụng" : "Sắp ngừng") : row.DenNgay < today ? "Đã kết thúc" : row.DangApDung ? "Đang áp dụng" : "Ngừng áp dụng")</span></td></tr>
}</tbody></table></div>
@if (write)
{
    <details class="mt-4"><summary>Xóa dịch vụ khỏi tòa nhà</summary>
    <p class="mt-2">Chỉ xóa khi chưa được hợp đồng hoặc hóa đơn tham chiếu. Dịch vụ mặc định đã xóa sẽ không tự xuất hiện lại.</p>
    <form asp-action="Delete" method="post"><input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" /><input name="dichVuId" value="@Model.DichVuId" type="hidden" /><button class="btn btn-outline-danger">Xác nhận xóa dịch vụ</button></form></details>
}
</section></div>
@section Styles { <link rel="stylesheet" href="~/css/service-price.css" asp-append-version="true" /> }

@section Scripts {<partial name="_ValidationScriptsPartial"/><script>document.getElementById('DonGia')?.addEventListener('input',function(){document.getElementById('sp-new-summary').textContent=Number(this.value||0).toLocaleString('vi-VN');});document.getElementById('TuNgay')?.addEventListener('change',function(){const [year,month]=this.value.split('-');document.getElementById('sp-period').textContent=this.value?'Tháng '+Number(month)+', '+year:'Chọn ngày áp dụng';});</script>}
