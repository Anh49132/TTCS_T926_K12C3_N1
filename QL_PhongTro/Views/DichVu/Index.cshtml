@model QL_PhongTro.ViewModels.DanhSachDichVuViewModel
@using QL_PhongTro.Models
@using QL_PhongTro.Services
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    ViewData["Title"] = "Dịch vụ & đơn giá";
    var write = await Permissions.AllowsAsync("PHONG_TRO", true);
    var today = DichVuService.HomNay();
    var groups = Model.DichVus.GroupBy(x => x.DichVuId).ToList();
    var rows = groups.Select(g => g.Where(x => x.TuNgay <= today).OrderBy(x => x.TuNgay).LastOrDefault() ?? g.OrderBy(x => x.TuNgay).First()).ToList();
    var active = rows.Count(x => x.TuNgay <= today && x.DaChotGia && x.DangApDung && x.DichVu.DangHoatDong);
    var upcoming = groups.Count(g => g.Any(x => x.TuNgay > today));
    var paused = rows.Count(x => !x.DangApDung || !x.DichVu.DangHoatDong);
    var building = Model.ToaNhas.FirstOrDefault(x => x.Value == Model.ToaNhaId?.ToString())?.Text ?? "Chưa chọn tòa nhà";
    var scheduled = Model.DichVus.Where(x => x.TuNgay > today).OrderBy(x => x.TuNgay).FirstOrDefault();
    var error = TempData.Peek("Error") as string;
    var vn = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="service-management service-bootstrap @(User.IsInRole("ADMIN") ? "admin-services container-fluid px-0" : "")">
<header class="sm-heading"><div><h1>Dịch vụ &amp; đơn giá</h1><p>Quản lý dịch vụ, thiết lập đơn giá và phạm vi áp dụng cho các tòa nhà.</p></div><div class="sm-actions"><button class="sm-button btn btn-outline-secondary" type="button" disabled title="Chưa hỗ trợ xuất danh sách dịch vụ"><svg class="sm-export-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 15v5h14v-5" /></svg><span>Xuất danh sách</span></button>@if (Model.SanSang && write) { <a class="sm-button sm-primary sm-add-service btn btn-dark" asp-action="Create" asp-route-toaNhaId="@Model.ToaNhaId"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>Thêm dịch vụ</span></a> }</div></header>
<section class="sm-stats">
<article><span>Tổng số dịch vụ <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4"/></svg></i></span><strong>@rows.Count.ToString("D2") <small>dịch vụ</small></strong><p>@active đang áp dụng · @upcoming có lịch thay đổi · @paused ngừng áp dụng</p></article>
<article><span>Theo tiêu thụ <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19a9 9 0 1 1 14 0M12 12l4-4"/><circle cx="12" cy="12" r="1"/></svg></i></span><strong>@rows.Count(x => x.CachTinh == CachTinhDichVu.TheoChiSo).ToString("D2") <small>dịch vụ</small></strong><p>Điện, nước · ghi chỉ số mỗi kỳ</p></article>
<article><span>Phí cố định <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18H6zM14.5 8h-4a1.5 1.5 0 0 0 0 3h3a1.5 1.5 0 0 1 0 3h-4M12 6v10"/></svg></i></span><strong>@rows.Count(x => x.CachTinh != CachTinhDichVu.TheoChiSo).ToString("D2") <small>dịch vụ</small></strong><p>Theo phòng hoặc theo người / tháng</p></article>
<article><span>Phạm vi quản lý <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 21V4h9v17M8 9H4v12h16M11 7h3M11 10h3M11 13h3M11 21v-5h3v5M4 21h16"/></svg></i></span><strong>@Model.ToaNhas.Count.ToString("D2") <small>tòa nhà</small></strong><p>Số liệu dịch vụ theo tòa đang chọn</p></article>
</section>
@if (!Model.SanSang) { <p class="alert alert-info">Chức năng dịch vụ chưa sẵn sàng. Vui lòng liên hệ người quản trị để hoàn tất thiết lập.</p> }
else if (Model.ToaNhas.Count == 0) { <p>Bạn chưa có tòa nhà đang hoạt động.</p><a asp-controller="PhongTro" asp-action="TaoToaNha" class="sm-button btn btn-outline-secondary">Khai báo tòa nhà</a> }
else {
@if (scheduled is not null) { <div class="sm-scheduled"><span>▣ <strong>Sắp áp dụng</strong> <span>@scheduled.DichVu.TenDichVu tại @building · @(scheduled.DaChotGia ? scheduled.DonGia.ToString("N0", vn) + " đ / " + scheduled.DonViTinh : "Chưa thiết lập giá") · từ @scheduled.TuNgay.ToString("dd/MM/yyyy")</span></span><a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@scheduled.DichVuId">Xem đơn giá <svg class="sm-price-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></div> }
<section class="sm-panel card shadow-sm">
<div class="sm-panel-heading"><h2>Danh sách dịch vụ <small>@rows.Count dịch vụ</small></h2><span>☑ Chỉnh sửa đơn giá theo tòa nhà</span></div>
<nav class="sm-tabs nav" aria-label="Trạng thái dịch vụ"><span class="active">Tất cả dịch vụ <small>@rows.Count</small></span><button disabled>Đang áp dụng <small>@active</small></button><button disabled>Sắp áp dụng <small>@upcoming</small></button><button disabled>Tạm ngừng <small>@paused</small></button></nav>
<form method="get" class="sm-filters"><div class="sm-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input disabled placeholder="Tìm theo tên hoặc mã dịch vụ..." aria-label="Tìm dịch vụ — chưa hỗ trợ" /></div><select class="form-select" name="toaNhaId" asp-for="ToaNhaId" asp-items="Model.ToaNhas" aria-label="Tòa nhà" onchange="this.form.requestSubmit()"><option value="">Chọn tòa nhà</option></select><select class="form-select" data-service-method aria-label="Lọc cách tính phí"><option value="all">Tất cả cách tính phí</option><option value="TheoChiSo">Theo tiêu thụ</option><option value="TheoNguoi">Theo người</option><option value="CoDinh">Cố định</option></select><button type="button" class="sm-sort" data-service-sort aria-label="Đổi thứ tự mã dịch vụ">⇵ Mã dịch vụ tăng dần</button></form>
@if (Model.CanKhoiTao && write) {
<form id="initialize-services" asp-action="Initialize" method="post" class="sm-initialize"><input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" /><span>Chuẩn bị điện, nước, rác, gửi xe và internet cho tòa nhà.</span><button class="sm-button sm-primary">Khởi tạo năm dịch vụ</button></form>
@if (error is null) { <script>document.getElementById('initialize-services').requestSubmit();</script> }
}
<div class="sm-table-scroll table-responsive"><table class="sm-table table table-hover align-middle mb-0"><thead><tr><th>Dịch vụ</th><th>Cách tính phí</th><th>Đơn giá</th><th>Đơn vị tính</th><th>Phạm vi áp dụng</th><th>Trạng thái</th><th>Hiệu lực từ</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in rows) {
var status = item.TuNgay > today ? "Sắp áp dụng" : !item.DaChotGia ? "Chờ đơn giá" : item.DangApDung && item.DichVu.DangHoatDong ? "Đang áp dụng" : "Tạm ngừng";
var iconName = (item.DichVu.TenDichVu + " " + item.DichVu.MaDichVu).ToLowerInvariant();
var iconPath = iconName.Contains("điện") || iconName.Contains("dien") ? "M13 2 4 14h7l-1 8 10-12h-7l1-8Z"
: iconName.Contains("nước") || iconName.Contains("nuoc") ? "M12 3c0 4-6 6-6 10a6 6 0 0 0 12 0c0-4-6-6-6-10ZM9 13a3 3 0 0 0 3 3"
: iconName.Contains("internet") || iconName.Contains("wifi") ? "M3 8a15 15 0 0 1 18 0M6 12a10 10 0 0 1 12 0M9 16a5 5 0 0 1 6 0M12 20h.01"
: iconName.Contains("vệ sinh") || iconName.Contains("ve_sinh") ? "M6 12h7v9H6zM8 12V9h3v3M11 9h4M16 3v6M13 6h6M19 12v4M17 14h4"
: iconName.Contains("đạp") || iconName.Contains("dap") ? "M5 17a3 3 0 1 0 0 .01M19 17a3 3 0 1 0 0 .01M5 17l5-8 5 8H5M10 9h6l3 8M14 5h3l-1 4M8 9H6"
: iconName.Contains("xe") ? "M5 17a3 3 0 1 0 0 .01M19 17a3 3 0 1 0 0 .01M8 17h5l3-8h3M10 10H6l2 4M14 5h3l2 4M13 17l-4-7"
: iconName.Contains("quản lý") || iconName.Contains("quan_ly") ? "M8 21V4h9v17M8 9H4v12h16M11 7h3M11 10h3M11 13h3M11 21v-5h3v5"
: iconName.Contains("giặt") || iconName.Contains("giat") ? "M4 3h16v18H4zM7 6h.01M10 6h.01M8 13a4 4 0 1 0 8 0 4 4 0 1 0-8 0M8 13c2-2 4 2 8 0"
: iconName.Contains("rác") || iconName.Contains("rac") ? "M4 6h16M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7M14 10v7"
: "M5 4h14v16H5zM8 8h8M8 12h8M8 16h5";
<tr data-service-code="@item.DichVu.MaDichVu" data-service-method-value="@item.CachTinh"><td><div class="sm-service"><span class="sm-icon @(item.CachTinh == CachTinhDichVu.TheoChiSo ? "meter" : "")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@iconPath"/></svg></span><div><a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@item.DichVuId">@item.DichVu.TenDichVu</a><small>@item.DichVu.MaDichVu</small></div></div></td><td><span class="sm-type @(item.CachTinh == CachTinhDichVu.TheoChiSo ? "meter" : "")">@(item.CachTinh == CachTinhDichVu.TheoChiSo ? "Theo tiêu thụ" : item.CachTinh == CachTinhDichVu.TheoNguoi ? "Theo người" : "Cố định")</span></td><td><strong>@(item.DaChotGia ? item.DonGia.ToString("N0", vn) + " đ" : "Chưa thiết lập")</strong></td><td>@item.DonViTinh</td><td>@building<small>Giá mặc định của tòa nhà</small></td><td><span class="sm-status @(status == "Đang áp dụng" ? "active" : status == "Sắp áp dụng" ? "scheduled" : "")">@status</span></td><td>@item.TuNgay.ToString("dd/MM/yyyy")</td><td>
@if (write) {
<details class="sm-row-actions"><summary aria-label="Thao tác @item.DichVu.TenDichVu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1-5L16 4a2.1 2.1 0 0 1 3 3L8 18l-4 2ZM14 6l3 3"/></svg></summary><div><a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@item.DichVuId">Sửa đơn giá</a><form asp-action="SetDefault" method="post"><input type="hidden" name="toaNhaId" value="@Model.ToaNhaId" /><input type="hidden" name="dichVuId" value="@item.DichVuId" /><input type="hidden" name="enabled" value="@((!Model.MacDinhIds.Contains(item.DichVuId)).ToString().ToLowerInvariant())" /><button>@(Model.MacDinhIds.Contains(item.DichVuId) ? "Bỏ áp dụng mặc định" : "Đặt áp dụng mặc định")</button></form><form asp-action="Delete" method="post" data-service-name="@item.DichVu.TenDichVu" onsubmit="return confirm('Xóa dịch vụ ' + this.dataset.serviceName + ' khỏi tòa nhà? Dịch vụ đã được sử dụng sẽ không thể xóa.');"><input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" /><input name="dichVuId" value="@item.DichVuId" type="hidden" /><button>Xóa dịch vụ</button></form></div></details>
} else { <a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@item.DichVuId" aria-label="Xem đơn giá @item.DichVu.TenDichVu">↗</a> }
</td></tr>
}
</tbody></table></div>
@if (rows.Count == 0) { <p class="sm-empty">@(Model.ToaNhaId.HasValue ? "Chưa có dịch vụ. Chọn “Thêm dịch vụ” để khai báo đơn giá đầu tiên." : "Chọn tòa nhà để xem dịch vụ và đơn giá.")</p> }
<p class="sm-empty" data-service-filter-empty hidden>Không có dịch vụ phù hợp với cách tính đã chọn.</p><footer class="sm-pagination"><span data-service-count>Hiển thị @rows.Count trong tổng số @rows.Count dịch vụ</span><div><select data-service-page-size aria-label="Số dòng mỗi trang"><option value="10">10 / trang</option><option value="20">20 / trang</option><option value="50">50 / trang</option></select><button type="button" data-service-prev aria-label="Trang trước">‹</button><span class="sm-page" data-service-page aria-live="polite">1</span><button type="button" data-service-next aria-label="Trang sau">›</button></div></footer>
</section>

}
<div class="sm-explanations"><article><span class="sm-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 19a9 9 0 1 1 14 0M12 12l4-4"/><circle cx="12" cy="12" r="1"/></svg></span><div><h3>Theo tiêu thụ</h3><p>Thành tiền = (chỉ số cuối − chỉ số đầu) × đơn giá. Ghi chỉ số điện, nước cho từng phòng mỗi kỳ.</p></div></article><article><span class="sm-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h12v18H6zM14.5 8h-4a1.5 1.5 0 0 0 0 3h3a1.5 1.5 0 0 1 0 3h-4M12 6v10"/></svg></span><div><h3>Phí cố định</h3><p>Thành tiền = số phòng / người / xe × đơn giá tháng. Áp dụng theo số lượng đã đăng ký trong hợp đồng.</p></div></article></div>
<p class="sm-footnote">ⓘ Mặc định chỉ áp dụng khi tạo phòng mới. Các phòng đã tồn tại giữ nguyên lựa chọn; thay đổi giá không làm thay đổi hóa đơn đã phát hành.</p>
</div>
@section Styles { <link rel="stylesheet" href="~/css/service-management.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/service-bootstrap.css" asp-append-version="true" />@if(User.IsInRole("ADMIN")){<link rel="stylesheet" href="~/css/admin-services-bootstrap.css" asp-append-version="true" />} }

@section Scripts { <script src="~/js/service-management.js" asp-append-version="true"></script> }
