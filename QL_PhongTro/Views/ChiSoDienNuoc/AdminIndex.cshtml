@model QL_PhongTro.ViewModels.AdminMeterViewModel
@{ViewData["Title"]="Chỉ số điện nước";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<section class="admin-meter-page container-fluid px-0"><header class="mb-4"><h1 class="h4 fw-bold mb-2">Chỉ số điện nước</h1><p class="text-secondary">Bao gồm chỉ số lịch sử của hợp đồng đã kết thúc. Admin chỉ xem dữ liệu.</p></header><section class="card shadow-sm mb-4"><div class="card-body p-4"><h2 class="h6 fw-bold mb-3">Bộ lọc chỉ số</h2>
<form method="get" class="row g-3 align-items-end"><div class="col-12 col-md-5"><label for="admin-meter-building" class="form-label">Tòa nhà</label><select id="admin-meter-building" name="toaNhaId" asp-for="ToaNhaId" asp-items="Model.Buildings" class="form-select"><option value="">Tất cả tòa nhà</option></select></div><div class="col-12 col-md-4"><label for="admin-meter-period" class="form-label">Kỳ</label><input id="admin-meter-period" type="month" name="ky" value="@Model.Period.ToString("yyyy-MM")" class="form-control" /></div><div class="col-12 col-md-3 align-self-end"><button class="btn btn-dark">Tra cứu</button></div></form></div></section><section class="card shadow-sm admin-meter-results"><header class="card-header bg-white p-4 d-flex flex-wrap justify-content-between align-items-center gap-2"><h2 class="h6 fw-bold mb-0">Danh sách chỉ số <span class="badge am-count ms-2">@Model.Total bản ghi</span></h2><small class="text-muted">Kỳ @Model.Period.ToString("MM/yyyy")</small></header>
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Tòa / phòng</th><th>Hợp đồng</th><th>Dịch vụ</th><th>Từ ngày</th><th>Đến ngày</th><th>Chỉ số đầu</th><th>Chỉ số cuối</th><th>Tiêu thụ</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Building · @row.Room</td><td>@row.Contract</td><td>@row.Service</td><td>@row.From.ToString("dd/MM/yyyy")</td><td>@row.To.ToString("dd/MM/yyyy")</td><td>@row.First.ToString("0.###",vi)</td><td>@row.Last.ToString("0.###",vi)</td><td>@((row.Last-row.First).ToString("0.###",vi))</td><td><span class="badge am-state @(row.Locked ? "am-locked" : "am-open")">@(row.Locked?"Đã khóa":"Chưa khóa")</span></td></tr>}@if(Model.Total==0){<tr><td colspan="9" class="am-empty"><strong class="d-block mb-2">Không có dữ liệu phù hợp</strong><span class="text-muted">Chọn tòa nhà hoặc kỳ khác để tra cứu chỉ số.</span></td></tr>}</tbody></table></div><footer class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2"><small class="text-muted">@Model.Total bản ghi · Trang @Model.Page / @Model.Pages</small><nav class="d-flex gap-2" aria-label="Phân trang chỉ số">@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-ky="@Model.Period.ToString("yyyy-MM")" asp-route-page="@(Model.Page-1)">Trước</a>} @if(Model.Page<Model.Pages){<a class="btn btn-outline-secondary" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-ky="@Model.Period.ToString("yyyy-MM")" asp-route-page="@(Model.Page+1)">Sau</a>}</nav></footer></section></section>

@section Styles { <link rel="stylesheet" href="~/css/admin-meter-lookup-bootstrap.css" asp-append-version="true" /> }

@section Scripts { <script src="~/js/admin-meter-dropdown.js" asp-append-version="true"></script> }
