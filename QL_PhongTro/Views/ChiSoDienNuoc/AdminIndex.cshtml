@model QL_PhongTro.ViewModels.AdminMeterViewModel
@{ViewData["Title"]="Tra cứu chỉ số điện nước";var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<section class="card p-4"><h1 class="h3">Tra cứu chỉ số điện nước</h1><p class="text-secondary">Bao gồm chỉ số lịch sử của hợp đồng đã kết thúc. Admin chỉ xem dữ liệu.</p>
<form method="get" class="row g-3 mb-4"><div class="col-md-5"><label for="admin-meter-building" class="form-label">Tòa nhà</label><select id="admin-meter-building" name="toaNhaId" asp-for="ToaNhaId" asp-items="Model.Buildings" class="form-select"><option value="">Tất cả tòa nhà</option></select></div><div class="col-md-4"><label for="admin-meter-period" class="form-label">Kỳ</label><input id="admin-meter-period" type="month" name="ky" value="@Model.Period.ToString("yyyy-MM")" class="form-control" /></div><div class="col-md-3 align-self-end"><button class="btn btn-dark">Tra cứu</button></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Tòa / phòng</th><th>Hợp đồng</th><th>Dịch vụ</th><th>Từ ngày</th><th>Đến ngày</th><th>Chỉ số đầu</th><th>Chỉ số cuối</th><th>Tiêu thụ</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Building · @row.Room</td><td>@row.Contract</td><td>@row.Service</td><td>@row.From.ToString("dd/MM/yyyy")</td><td>@row.To.ToString("dd/MM/yyyy")</td><td>@row.First.ToString("0.###",vi)</td><td>@row.Last.ToString("0.###",vi)</td><td>@((row.Last-row.First).ToString("0.###",vi))</td><td>@(row.Locked?"Đã khóa":"Chưa khóa")</td></tr>}@if(Model.Total==0){<tr><td colspan="9">Không có dữ liệu phù hợp.</td></tr>}</tbody></table></div><p>@Model.Total bản ghi · Trang @Model.Page / @Model.Pages</p><nav aria-label="Phân trang chỉ số">@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-ky="@Model.Period.ToString("yyyy-MM")" asp-route-page="@(Model.Page-1)">Trước</a>} @if(Model.Page<Model.Pages){<a class="btn btn-outline-secondary" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-ky="@Model.Period.ToString("yyyy-MM")" asp-route-page="@(Model.Page+1)">Sau</a>}</nav></section>
