<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NhàTốt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public-listing.css" asp-append-version="true" />
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "TinDang") {
        <link rel="stylesheet" href="~/css/listing-theme.css" asp-append-version="true" />
    }
<link rel="stylesheet" href="~/css/champagne-theme.css" asp-append-version="true" />
@if (User.IsInRole("KHACH_THUE")) { <link rel="stylesheet" href="~/css/tenant-header.css" asp-append-version="true" /> }
@await RenderSectionAsync("Styles", required: false)
<link rel="stylesheet" href="~/css/public-header.css" asp-append-version="true" />
</head>
<body class="public-site @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "public-home" : "")">
    @{
        var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
        var isHome = path == "" || path == "/" || path == "/home" || path == "/home/index";
        var isTimTin = path.StartsWith("/timtin");
        var isGioiThieu = path.StartsWith("/home/gioithieu") || path.StartsWith("/gioithieu");
    }
    @if (User.IsInRole("KHACH_THUE"))
    {
        <partial name="_TenantHeader" />
    }
    else
    {
    <header class="public-header nhatot-header navbar">
        <div class="nhatot-header-inner container align-items-center">
            <a class="public-brand nhatot-brand" href="/" aria-label="NhàTốt, về trang chủ">
                <img src="~/images/nhatot-logo.svg" alt="NhàTốt - SỐNG ĐÚNG NƠI" height="38" />
            </a>
            <nav class="public-nav nhatot-nav nav align-items-center" aria-label="Điều hướng chính">
                <a href="/" class="header-home-link @(isHome ? "active" : "")"><svg class="header-home-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 10.5 12 3l9 7.5M5.5 9v12h13V9M9.5 21v-7h5v7" /></svg>Trang Chủ</a>
                <a href="/TimTin" class="@(isTimTin ? "active" : "")">Tìm Phòng</a>
                <a href="/Home/GioiThieu" class="@(isGioiThieu ? "active" : "")">Giới Thiệu</a>
            </nav>
            <div class="public-auth nhatot-auth d-flex align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="public-user-greeting">Chào, <strong>@User.Identity.Name</strong></span>
                    <a href="/PhongTro" class="btn-dashboard-link">Vào quản lý ↗</a>
                    <a href="/Account/Logout" class="public-auth-login">Đăng xuất</a>
                }
                else
                {
                    <a href="/Account/Login" class="public-auth-login btn btn-outline-dark rounded-pill">Đăng nhập</a>
                    <a class="public-register public-auth-register btn btn-dark rounded-pill" href="/Account/Register">Đăng ký</a>
                }
            </div>
        </div>
    </header>
    }
    <main class="public-main @(isHome ? "public-main-home" : "") @(isTimTin ? "public-main-timtin" : "")">
        @RenderBody()
    </main>
    @if (!(ViewContext.RouteData.Values["controller"]?.ToString() == "TinDang" && ViewContext.RouteData.Values["action"]?.ToString() == "ChiTiet"))
    {
        <footer class="public-footer nhatot-footer">
            <div class="nhatot-footer-inner">
                <div class="footer-top">
                    <section class="footer-brand" aria-label="Thông tin NhàTốt">
                        <a class="footer-logo" href="/" aria-label="NhàTốt, về trang chủ">
                            <span class="footer-badge" aria-hidden="true">⌂</span>
                            <span class="footer-logo-copy">
                                <strong>NhàTốt</strong>
                                <small>SỐNG ĐÚNG NƠI</small>
                            </span>
                        </a>
                        <p>Nền tảng kết nối người thuê và chủ nhà bằng trải nghiệm tìm kiếm minh bạch, thuận tiện và đáng tin cậy.</p>
                        <address class="footer-contact">
                            <a href="tel:19006888"><span aria-hidden="true">☎</span> 1900 6888 · 08:00–22:00</a>
                            <a href="mailto:hotro@nhatot.vn"><span aria-hidden="true">✉</span> hotro@nhatot.vn</a>
                            <span><span aria-hidden="true">⌖</span> 28 Nguyễn Cơ Thạch, An Lợi Đông, TP. Thủ Đức</span>
                        </address>
                    </section>
                    <nav class="footer-links" aria-label="Liên kết cuối trang">
                        <div class="footer-col">
                            <h4>Khám phá</h4>
                            <a href="/TimTin">Tìm phòng</a>
                            <a href="/TimTin">Căn hộ cho thuê</a>
                            <a href="/TimTin">Nhà nguyên căn</a>
                            <a href="/TimTin">Ở ghép</a>
                            <a href="/TimTin">Khu vực phổ biến</a>
                        </div>
                        <div class="footer-col">
                            <h4>Dành cho chủ nhà</h4>
                            <a href="/Account/Login">Đăng tin miễn phí</a>
                            <a href="/Account/Login">Quản lý tin đăng</a>
                            <a href="/TimTin">Bảng giá dịch vụ</a>
                            <a href="/Home/GioiThieu">Kinh nghiệm cho thuê</a>
                            <a href="/Home/GioiThieu">Trung tâm trợ giúp</a>
                        </div>
                        <div class="footer-col">
                            <h4>Về NhàTốt</h4>
                            <a href="/Home/GioiThieu">Giới thiệu</a>
                            <a href="/Home/GioiThieu">Cam kết an toàn</a>
                            <a href="/Home/GioiThieu">Quy chế hoạt động</a>
                            <a href="/Home/GioiThieu">Điều khoản sử dụng</a>
                            <a href="/Home/GioiThieu">Chính sách bảo mật</a>
                        </div>
                    </nav>
                </div>

            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year NhàTốt. Bảo lưu mọi quyền.</p>
                <div class="footer-social" aria-label="Mạng xã hội">
                    <span aria-label="Facebook">f</span>
                    <span aria-label="Instagram">◎</span>
                    <span aria-label="YouTube">▶</span>
                    <span aria-label="LinkedIn">in</span>
                </div>
                <span class="footer-legal">Minh bạch · An toàn · Tin cậy</span>
            </div>
        </footer>
    }
    @if (User.IsInRole("KHACH_THUE")) { <script src="~/js/tenant-sidebar.js" asp-append-version="true"></script> }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
