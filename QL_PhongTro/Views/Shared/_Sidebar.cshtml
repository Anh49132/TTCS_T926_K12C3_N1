@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    var menu = await Permissions.MenuAsync();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var buildingPage = controller == "PhongTro" && action is "ToaNha" or "TaoToaNha" or "SuaToaNha";
    string Active(bool selected) => selected ? "is-active" : "";
}

<div class="sidebar-scroll">
<a class="sidebar-brand" asp-controller="Home" asp-action="Index"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 10 9-7 9 7v11H3Z M9 21v-8h6v8" /></svg><span><strong>Nhà Trọ</strong><small>Quản lý không gian sống</small></span></a>
<p class="sidebar-greeting">Xin chào, @(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "bạn")!</p>
<nav aria-label="Menu chức năng">
<a class="sidebar-link @Active(controller == "Home" && action == "Index")" asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" && action == "Index" ? "page" : null)"><span class="menu-icon" aria-hidden="true">⌂</span>Trang chủ</a>
@if (!menu.Any(m => m.Code == "TIN_DANG")) {
<a class="sidebar-link @Active(controller == "TinDang")" asp-controller="TinDang" asp-action="Index" aria-current="@(controller == "TinDang" ? "page" : null)"><span class="menu-icon" aria-hidden="true">⌕</span>Tin đăng cho thuê</a>
}
<a class="sidebar-link @Active(controller == "TimTin")" asp-controller="TimTin" asp-action="Index"><span class="menu-icon" aria-hidden="true">⌕</span>Tìm phòng trọ</a>
@foreach (var group in menu.GroupBy(m => m.GroupName).OrderBy(g => g.Key == "Hệ thống" ? 1 : 0)) {
<section data-menu-group="@group.Key"><h2>@group.Key</h2>
@foreach (var module in group) {
var selected = module.Code switch {
    "PHONG_TRO" => controller == "PhongTro" && !buildingPage,
    "TAI_KHOAN" => controller == "Permissions",
    "TIN_DANG" => controller == "TinDang",
    _ => controller == "Modules" && ViewContext.RouteData.Values["code"]?.ToString() == module.Code
};
var icon = module.Code switch { "PHONG_TRO" => "▦", "TAI_KHOAN" => "⚙", "TAI_CHINH" => "◇", "HOP_DONG" => "▤", "DIEN_NUOC" => "◉", "BAO_CAO" => "▥", _ => "▣" };
var moduleUrl = module.Code == "TIN_DANG" && User.IsInRole("CHU_NHA")
    ? Url.Action("QuanLy", "TinDang")
    : QL_PhongTro.Authorization.PermissionService.Url(module.Code);
<a class="sidebar-link @Active(selected)" data-menu-module="@module.Code" href="@moduleUrl" aria-current="@(selected ? "page" : null)"><span class="menu-icon" aria-hidden="true">@icon</span>@module.Name</a>
@if (module.Code == "PHONG_TRO" && (User.IsInRole("CHU_NHA") || User.IsInRole("QUAN_LY") || User.IsInRole("ADMIN"))) {
<a class="sidebar-link @Active(buildingPage)" asp-controller="PhongTro" asp-action="ToaNha" aria-current="@(buildingPage ? "page" : null)"><span class="menu-icon" aria-hidden="true">▥</span>Quản lý tòa nhà</a>
@if (User.IsInRole("CHU_NHA")) {
<a class="sidebar-link @Active(controller == "DichVu")" asp-controller="DichVu" asp-action="Index" aria-current="@(controller == "DichVu" ? "page" : null)"><span class="menu-icon" aria-hidden="true">≡</span>Dịch vụ và đơn giá</a>
}
}
}
</section>
}
@if (User.IsInRole("KHACH_THUE")) {
<a class="sidebar-link @Active(controller == "HoSo" && action == "Index")" asp-controller="HoSo" asp-action="Index"><span class="menu-icon" aria-hidden="true">○</span>Hồ sơ cá nhân</a>
}
</nav>
</div>
