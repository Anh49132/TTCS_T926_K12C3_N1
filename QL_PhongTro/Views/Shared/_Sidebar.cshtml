@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    var allowed = (await Permissions.MenuAsync()).Select(x => x.Code).ToHashSet();
    var admin = User.IsInRole("ADMIN");
    var owner = User.IsInRole("CHU_NHA");
    var name = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Tài khoản" : User.Identity.Name;
    var path = Context.Request.Path.Value ?? "/";
    var section = Context.Request.Query["section"].ToString();
    var roleFilter = Context.Request.Query["role"].ToString();
    var items = new List<(string Group, string Title, string Url, string Module, string Icon)>();
    if (admin) {
        items.AddRange(new[] {
            ("", "Tài khoản & phân quyền", "/ManagedAccounts", "TAI_KHOAN", "users"),
            ("", "Chủ nhà", "/ManagedAccounts?role=CHU_NHA", "TAI_KHOAN", "users"),
            ("", "Quản lý tòa nhà", "/PhongTro/ToaNha", "PHONG_TRO", "building"),
            ("", "Tòa nhà & phòng", "/PhongTro", "PHONG_TRO", "home"),
            ("", "Tin đăng cho thuê", "/TinDang/QuanLy", "TIN_DANG", "file"),
            ("", "Yêu cầu thuê", "/YeuCau", "YEU_CAU_THUE", "file"),
            ("", "Hợp đồng", "/Modules/HOP_DONG", "HOP_DONG", "file"),
            ("", "Chỉ số điện nước", "/Modules/DIEN_NUOC", "DIEN_NUOC", "meter"),
            ("", "Hóa đơn & thanh toán", "/Modules/TAI_CHINH", "TAI_CHINH", "wallet"),
            ("", "Công nợ", "/Modules/TAI_CHINH?section=cong-no", "TAI_CHINH", "money"),
            ("", "Báo hỏng & bảo trì", "/Modules/BAO_HONG", "BAO_HONG", "tool"),
            ("", "Báo cáo", "/Modules/BAO_CAO", "BAO_CAO", "chart"),
            ("", "Nhật ký hoạt động", "/NhatKy", "TAI_KHOAN", "clock"),
            ("", "Cấu hình hệ thống", "/Permissions?section=cau-hinh", "TAI_KHOAN", "settings")
        });
    } else {
        items.Add(("Vận hành", "Quản lý tòa nhà", "/PhongTro/ToaNha", "PHONG_TRO", "building"));
        items.Add(("Vận hành", "Quản lý phòng", "/PhongTro", "PHONG_TRO", "home"));
        if (owner) items.Add(("Vận hành", "Hồ sơ khách thuê", "/HoSo/DanhSach", "HOP_DONG", "users"));
        if (owner) items.Add(("Vận hành", "Dịch vụ & đơn giá", "/DichVu", "PHONG_TRO", "tag"));
        items.AddRange(new[] {
            ("Vận hành", "Tin đăng cho thuê", "/TinDang/QuanLy", "TIN_DANG", "speaker"),
            ("Vận hành", "Yêu cầu thuê & lịch xem", "/YeuCau", "YEU_CAU_THUE", "calendar"),
            ("Vận hành", "Hợp đồng & người ở ghép", "/Modules/HOP_DONG", "HOP_DONG", "file"),
            ("Tài chính", "Chỉ số điện nước", (User.IsInRole("QUAN_LY") || owner) ? "/ChiSoDienNuoc" : "/Modules/DIEN_NUOC", "DIEN_NUOC", "meter"),
            ("Tài chính", "Hóa đơn, thanh toán", "/Modules/TAI_CHINH", "TAI_CHINH", "wallet"),
            ("Tài chính", "Công nợ", "/Modules/TAI_CHINH?section=cong-no", "TAI_CHINH", "money"),
            ("Tài chính", "Báo cáo doanh thu", "/Modules/BAO_CAO", "BAO_CAO", "chart"),
            ("Chăm sóc", "Báo hỏng & bảo trì", "/Modules/BAO_HONG", "BAO_HONG", "tool")
        });
        if (owner) items.Add(("Tài chính", "Tiến độ chốt chỉ số", "/TienDoChiSo", "DIEN_NUOC", "meter"));
    }
    string Icon(string key) => key switch {
        "home" => "m3 10 9-7 9 7v11H3Z M9 21v-8h6v8",
        "building" => "M5 21V3h14v18M9 7h1m4 0h1M9 11h1m4 0h1M9 15h1m4 0h1M10 21v-3h4v3",
        "users" => "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M20 21v-2a4 4 0 0 0-3-4M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8",
        "calendar" => "M4 5h16v16H4ZM8 3v4m8-4v4M4 10h16",
        "chart" => "M3 3v18h18M7 17v-5m5 5V7m5 10V4",
        "bell" => "M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4",
        "clock" => "M12 8v5l3 2M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20",
        "wallet" => "M3 5h18v15H3ZM3 9h18M16 13h3",
        "tag" => "M3 3h8l10 10-8 8L3 11ZM7 7h.01",
        "speaker" => "M3 8h5l12-5v18L8 16H3ZM8 16l2 5",
        "tool" => "m14 5 5-3a7 7 0 0 1-8 9L4 20l-3-3 9-8a7 7 0 0 1 3-7l1 3Z",
        "meter" => "M4 19a10 10 0 1 1 16 0ZM12 14l5-5M7 17h10",
        "money" => "M15 7h-5a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6H9M12 3v18",
        "settings" => "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M9 3h6l1 3 3 1 2 5-2 5-3 1-1 3H9l-1-3-3-1-2-5 2-5 3-1Z",
        _ => "M5 3h10l4 4v14H5ZM14 3v5h5M8 12h8m-8 4h8"
    };
}
<div class="sidebar-scroll compact-sidebar">
<a class="sidebar-brand" href="/"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="@Icon("home")" /></svg><span><strong>NhàTốt</strong><small>Sống đúng nơi</small></span></a>
@if (!admin) { <div class="compact-sidebar-profile"><span class="tenant-avatar">@System.Globalization.StringInfo.GetNextTextElement(name).ToUpperInvariant()</span><div><strong>Xin chào, @name</strong><small>@(owner ? "Chủ nhà" : "Quản lý tòa nhà")</small></div></div> }
<nav aria-label="Menu chức năng">
<a class="sidebar-link @(path is "/" or "/Home" or "/Home/Index" ? "is-active" : "")" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon("home")" /></svg><span>Tổng quan</span></a>
@foreach (var group in items.Where(x => allowed.Contains(x.Module)).GroupBy(x => x.Group)) {
<section data-menu-group="@group.Key">
@if (!string.IsNullOrEmpty(group.Key)) { <h2>@group.Key</h2> }
@foreach (var item in group) {
    var target = item.Url.Split('?')[0];
    var selected = (path.Equals(target, StringComparison.OrdinalIgnoreCase) || (target == "/HoSo/DanhSach" && path.Equals("/HoSo/Xem", StringComparison.OrdinalIgnoreCase))) &&
        (item.Url.Contains("section=") ? item.Url.EndsWith("section=" + section) : string.IsNullOrEmpty(section)) &&
        (target != "/ManagedAccounts" || (item.Url.Contains("role=CHU_NHA") ? roleFilter == "CHU_NHA" : roleFilter != "CHU_NHA"));
<a class="sidebar-link @(selected ? "is-active" : "")" href="@item.Url" data-menu-module="@item.Module" aria-current="@(selected ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="@Icon(item.Icon)" /></svg><span>@item.Title</span></a>
}
</section>
}
</nav>
</div>
