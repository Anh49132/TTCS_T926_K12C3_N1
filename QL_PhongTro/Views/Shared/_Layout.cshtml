    <a class="header-notification-bell" id="notification-bell" href="javascript:void(0);" aria-label="Thông báo hóa đơn" title="Thông báo hóa đơn"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1-.9 2-2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5 .67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm2 10H8v-6c0-2 4-3.1 6-3.1s4 1.1 6 3.1v6z"></path></svg><span class="notification-badge" id="notification-badge">0</span></a>
    <div class="notification-dropdown" id="notification-dropdown">
        <div class="dropdown-header">Thông báo hóa đơn</div>
        <div id="notification-list" class="notification-list"></div>
        <button id="mark-all-read-btn" class="btn btn-sm btn-block mark-all-read-btn">Đánh dấu tất cả đã đọc</button>
    </div>
}
<div class="latte-header-user"><partial name="_AccountMenu" /></div>
</header>
<main id="main-content" class="app-content @(isPropertyPage ? "property-management" : "")" tabindex="-1">
@if (isPropertyPage) { <partial name="_PropertyNotifications" /> }
@RenderBody()
</main>
</div>
}
<partial name="_Toast" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tenant-notification-bell.js" asp-append-version="true"></script>
<script src="~/js/logout-confirm.js" asp-append-version="true"></script>
<script src="~/js/auth-interceptor.js" asp-append-version="true"></script>
<script src="~/js/password-toggle.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
@if (isPropertyPage) {
<partial name="_PropertyConfirm" />
<script src="~/js/property-management.js" asp-append-version="true"></script>
}
@if (User.Identity?.IsAuthenticated == true) {
<script src="~/js/session-status.js" asp-append-version="true"></script>
}
</body>
</html>


