<dialog id="property-confirm" aria-labelledby="property-confirm-title" aria-describedby="property-confirm-message">
    <form method="dialog">
        <h2 id="property-confirm-title">Xác nhận thao tác</h2>
        <p id="property-confirm-message"></p>
        <div class="d-flex flex-wrap justify-content-end gap-2">
            <button value="cancel" class="btn btn-outline-secondary" autofocus>Hủy</button>
            <button value="confirm" class="btn btn-danger">Xác nhận</button>
        </div>
    </form>
</dialog>
