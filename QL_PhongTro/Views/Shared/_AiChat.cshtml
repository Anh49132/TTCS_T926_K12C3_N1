@{
    var guestChat = User.Identity?.IsAuthenticated != true;
}
@if(guestChat || User.IsInRole("KHACH_THUE") || User.IsInRole("CHU_NHA") || User.IsInRole("QUAN_LY") || User.IsInRole("ADMIN")){
<link rel="stylesheet" href="~/css/ai-chat.css" asp-append-version="true" />
<div class="ai-chat" data-ai-chat>
<button type="button" class="ai-chat-launcher" aria-label="Mở Trợ lý AI NhàTốt" aria-expanded="false" aria-controls="ai-chat-panel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11a9 9 0 0 1-9 9H5l-4 3 2-7a9 9 0 1 1 18-5Z"/><path d="M7 10h10M7 14h6"/></svg><span>Trợ lý AI</span></button>
<section class="ai-chat-panel" id="ai-chat-panel" role="dialog" aria-modal="false" aria-labelledby="ai-chat-title" hidden>
<header><div class="ai-chat-avatar" aria-hidden="true">✦</div><div><strong id="ai-chat-title">Trợ lý NhàTốt</strong><small>@(guestChat ? "AI giúp bạn tìm phòng phù hợp" : "AI hỗ trợ tra cứu và hướng dẫn")</small></div><button type="button" data-ai-new title="Bắt đầu lại" aria-label="Bắt đầu cuộc trò chuyện mới">↻</button><button type="button" data-ai-close aria-label="Thu nhỏ hộp chat">×</button></header>
<div class="ai-chat-messages" data-ai-messages role="log" aria-live="polite" aria-relevant="additions text"><div class="ai-chat-message assistant">@(guestChat ? "Chào bạn! Bạn muốn tìm phòng ở khu vực nào, ngân sách mỗi tháng khoảng bao nhiêu và ở mấy người? Tôi sẽ giúp tìm trong các tin đang cho thuê." : "Xin chào! Bạn muốn tìm hiểu điều gì về NhàTốt? Tôi có thể tra cứu dữ liệu trong phạm vi tài khoản của bạn.")</div></div>
<div class="ai-chat-suggestions" data-ai-suggestions>@if(guestChat){<button type="button">Tìm phòng dưới 3 triệu cho 2 người</button><button type="button">Tôi muốn đăng ký xem phòng</button>}else if(User.IsInRole("KHACH_THUE")){<button type="button">Tôi còn phải thanh toán bao nhiêu?</button><button type="button">Tìm phòng dưới 3 triệu cho 2 người</button><button type="button">Báo hỏng của tôi được xử lý chưa?</button>}else if(User.IsInRole("QUAN_LY")){<button type="button">Có báo hỏng nào cần tiếp nhận?</button><button type="button">Tình hình phòng tại các tòa tôi quản lý?</button>}else{<button type="button">Tháng này còn phải thu bao nhiêu?</button><button type="button">Tòa nào còn nhiều phòng trống?</button>}</div>
<p class="ai-chat-error" data-ai-error role="alert" hidden></p>
<form data-ai-form>@Html.AntiForgeryToken()<label class="visually-hidden" for="ai-chat-input">Câu hỏi cho trợ lý</label><textarea id="ai-chat-input" name="message" rows="2" maxlength="2000" placeholder="Nhập câu hỏi của bạn..." required></textarea><button type="submit" aria-label="Gửi câu hỏi">➤</button></form>
<footer>Câu hỏi và dữ liệu tra cứu được gửi tới Google Gemini. Không nhập mật khẩu, giấy tờ hoặc thông tin nhạy cảm. AI có thể nhầm; hãy kiểm tra trên trang nghiệp vụ.</footer>
</section></div>
<script src="~/js/ai-chat.js" asp-append-version="true" defer></script>
}
