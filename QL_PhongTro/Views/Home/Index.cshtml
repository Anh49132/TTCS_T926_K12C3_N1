@model QL_PhongTro.ViewModels.HomeViewModel
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    if (!signedIn)
    {
        Layout = "~/Views/Shared/_PublicLayout.cshtml";
    }
    ViewData["Title"] = "Trang chủ";
}

@if (signedIn)
{
    <partial name="_RoleHome" model="Model" />
}
else
{
    @* Giao diện NhàTốt khi chưa đăng nhập: đúng theo ảnh mẫu *@
    <div class="nhatot-landing">
        <!-- 1. HERO SECTION CHUẨN THEO ẢNH MẪU -->
        <section class="nhatot-hero" aria-label="Tìm kiếm phòng trọ NhàTốt">
            <div class="nhatot-hero-overlay"></div>
            <div class="nhatot-hero-content">
                <h1 class="nhatot-hero-title">
                    Tìm chốn ở phù hợp, bắt<br />đầu cuộc sống mới.
                </h1>
                <p class="nhatot-hero-desc">
                    Khám phá nhà trọ, căn hộ và phòng ở minh bạch tại khu vực bạn yêu thích. Giá thật, ảnh thật, liên hệ trực tiếp.
                </p>
            </div>
        </section>
        <section class="home-room-search-section" aria-label="Tìm phòng">
            <form asp-controller="TimTin" asp-action="Index" method="get" class="home-room-search-form">
                <div class="listing-search-grid timtin-search-grid home-room-search-grid">
                    <input type="hidden" name="GiaToiDa" value="" />
                    <div class="timtin-location-field">
                        <svg class="timtin-location-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <label for="home-room-district">Khu vực</label>
                        <select id="home-room-district" name="QuanHuyen" class="form-select" aria-label="Chọn khu vực">
                            <option value="">Chọn khu vực</option>
                            @foreach (var district in Model.QuanHuyens)
                            {
                                <option value="@district">@district</option>
                            }
                        </select>
                    </div>
                    <div class="timtin-keyword-field">
                        <label for="home-room-keyword" class="visually-hidden">Từ khóa tìm kiếm</label>
                        <input id="home-room-keyword" name="TuKhoa" class="form-control" maxlength="200"
                               placeholder="Nhập tên đường, phường, dự án hoặc từ khóa..." />
                    </div>
                    <button type="submit" class="listing-search-submit btn-nhatot-search">
                        <svg class="timtin-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="10.8" cy="10.8" r="6.3" />
                            <path d="m15.5 15.5 4.2 4.2" />
                        </svg>
                        <span>Tìm phòng</span>
                    </button>
                </div>
            </form>
        </section>
        <section class="container py-4" aria-labelledby="featured-listings-title">
            <h2 id="featured-listings-title">Tin đăng mới nhất</h2>
            <div class="row g-3">
            @foreach (var item in Model.TinMoiNhat) {
                <div class="col-12 col-md-6 col-lg-4"><a class="card h-100 text-decoration-none" asp-controller="TinDang" asp-action="ChiTiet" asp-route-id="@item.Id">
                    <img class="card-img-top" src="@(item.AnhDaiDien ?? Url.Content("~/room-placeholder.svg"))" alt="Phòng @item.TieuDe" loading="lazy" style="height:180px;object-fit:cover" />
                    <div class="card-body"><h3 class="h5">@item.TieuDe</h3><strong>@item.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ/tháng</strong><p>@(item.QuanHuyen ?? item.DiaChi ?? item.TenToaNha)</p><span>@item.DienTich.ToString("0.#") m² · @item.SoNguoiToiDa người</span></div>
                </a></div>
            }
            @if(Model.TinMoiNhat.Count == 0){<p>Chưa có tin đăng đang hiển thị.</p>}
            </div>
        </section>
        <section class="container py-4" aria-labelledby="home-values-title">
            <h2 id="home-values-title">Tại sao nên chọn NhàTốt?</h2>
            <div class="row g-3"><div class="col-12 col-md-4"><h3 class="h5">Giá thật minh bạch</h3><p>Xem giá thuê và các khoản dịch vụ trước khi gửi yêu cầu.</p></div><div class="col-12 col-md-4"><h3 class="h5">Ảnh thật xác thực</h3><p>Xem ảnh phòng do bên cho thuê cung cấp.</p></div><div class="col-12 col-md-4"><h3 class="h5">Liên hệ trực tiếp</h3><p>Gửi yêu cầu thuê hoặc hẹn xem phòng với bên quản lý.</p></div></div>
        </section>
    </div>
}
