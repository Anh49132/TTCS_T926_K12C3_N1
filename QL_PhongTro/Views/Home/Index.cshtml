@model QL_PhongTro.ViewModels.HomeViewModel
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    if (!signedIn)
    {
        Layout = "~/Views/Shared/_PublicLayout.cshtml";
    }
    ViewData["Title"] = "Trang chủ";
}

@if (signedIn)
{
    <partial name="_RoleHome" model="Model" />
}
else
{
    @* Giao diện NhàTốt khi chưa đăng nhập: đúng theo ảnh mẫu *@
    <div class="nhatot-landing">
        <div class="home-hero-stage">
        <!-- 1. HERO SECTION CHUẨN THEO ẢNH MẪU -->
        <section class="nhatot-hero" aria-label="Tìm kiếm phòng trọ NhàTốt">
            <div class="nhatot-hero-overlay"></div>
            <div class="nhatot-hero-content">
                <h1 class="nhatot-hero-title">
                    Tìm chốn ở phù hợp, bắt<br />đầu cuộc sống mới.
                </h1>
                <p class="nhatot-hero-desc">
                    Khám phá nhà trọ, căn hộ và phòng ở minh bạch tại khu vực bạn yêu thích. Giá thật, ảnh thật, liên hệ trực tiếp.
                </p>
            </div>
        </section>
        <section class="home-room-search-section" aria-label="Tìm phòng">
            <form asp-controller="TimTin" asp-action="Index" method="get" class="home-room-search-form">
                <div class="listing-search-grid timtin-search-grid home-room-search-grid">
                    <input type="hidden" name="GiaToiDa" value="" />
                    <div class="timtin-location-field">
                        <svg class="timtin-location-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <label for="home-room-district">Khu vực</label>
                        <select id="home-room-district" name="QuanHuyen" class="form-select" aria-label="Chọn khu vực">
                            <option value="">Chọn khu vực</option>
                            @foreach (var district in Model.QuanHuyens)
                            {
                                <option value="@district">@district</option>
                            }
                        </select>
                    </div>
                    <div class="timtin-keyword-field">
                        <label for="home-room-keyword" class="visually-hidden">Từ khóa tìm kiếm</label>
                        <input id="home-room-keyword" name="TuKhoa" class="form-control" maxlength="200"
                               placeholder="Nhập tên đường, phường, dự án hoặc từ khóa..." />
                    </div>
                    <button type="submit" class="listing-search-submit btn-nhatot-search">
                        <svg class="timtin-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="10.8" cy="10.8" r="6.3" />
                            <path d="m15.5 15.5 4.2 4.2" />
                        </svg>
                        <span>Tìm phòng</span>
                    </button>
                </div>
            </form>
        </section>
        </div>
        <section class="home-discovery" aria-labelledby="home-listings-title">
            <header class="home-section-heading"><div><h2 id="home-listings-title">Phòng mới đăng</h2><p>Khám phá những phòng đang được đăng cho thuê.</p></div><a asp-controller="TinDang" asp-action="Index" class="btn btn-outline-primary">Xem tất cả tin</a></header>
            @if (Model.TinMoiNhat.Count == 0)
            {
                <p class="alert alert-light">Hiện chưa có tin phòng đang hiển thị. Bạn có thể quay lại sau để xem tin mới.</p>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var listing in Model.TinMoiNhat)
                {
                    <div class="col"><article class="card h-100 home-listing-card">
                        <a asp-controller="TinDang" asp-action="ChiTiet" asp-route-id="@listing.Id"><img class="card-img-top" src="@(listing.AnhDaiDien ?? Url.Content("~/room-placeholder.svg"))" alt="Ảnh phòng: @listing.TieuDe" loading="lazy" /></a>
                        <div class="card-body"><h3><a asp-controller="TinDang" asp-action="ChiTiet" asp-route-id="@listing.Id">@listing.TieuDe</a></h3><p class="home-listing-price">@listing.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ/tháng</p><p class="text-secondary">@listing.DienTich.ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) m² · Tối đa @listing.SoNguoiToiDa người</p><p class="mb-0 text-secondary">@string.Join(", ", new[] { listing.PhuongXa, listing.QuanHuyen }.Where(x => !string.IsNullOrWhiteSpace(x)))</p></div>
                    </article></div>
                }
                </div>
            }
        </section>
        <section class="home-discovery home-values" aria-labelledby="home-values-title">
            <header class="home-section-heading"><h2 id="home-values-title">Tại sao nên chọn NhàTốt?</h2></header>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                <div class="col"><article class="card h-100"><div class="card-body"><h3>Giá thật minh bạch</h3><p class="mb-0 text-secondary">Xem giá thuê và dịch vụ của phòng trước khi gửi yêu cầu.</p></div></article></div>
                <div class="col"><article class="card h-100"><div class="card-body"><h3>Ảnh thật xác thực</h3><p class="mb-0 text-secondary">Tham khảo ảnh do người đăng cung cấp và đặt lịch xem để kiểm tra phòng thực tế.</p></div></article></div>
                <div class="col"><article class="card h-100"><div class="card-body"><h3>Liên hệ trực tiếp</h3><p class="mb-0 text-secondary">Gửi yêu cầu thuê hoặc lịch xem phòng ngay từ tin đăng.</p></div></article></div>
            </div>
        </section>
    </div>
}
