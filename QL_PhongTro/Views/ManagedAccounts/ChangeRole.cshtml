@model QL_PhongTro.ViewModels.ChangeAccountRoleViewModel
@using QL_PhongTro.ViewModels
@{ ViewData["Title"] = "Đổi vai trò tài khoản"; }
<section class="auth-card management-form">
<h1>Đổi vai trò tài khoản</h1>
<p>Tài khoản: <strong>@Model.HoTen</strong></p>
<p>Sau khi đổi vai trò, mọi phiên đăng nhập cũ sẽ mất hiệu lực. Người dùng cần đăng nhập lại.</p>
<form asp-action="ChangeRole" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Id" type="hidden" />
<input asp-for="OriginalRole" type="hidden" />
<div class="mb-3">
<label asp-for="VaiTro">Vai trò</label>
<select asp-for="VaiTro" class="form-select">
@foreach (var role in new[] { "KHACH_THUE", "CHU_NHA", "QUAN_LY", "ADMIN" }) {
<option value="@role">@ManagedAccountsViewModel.RoleName(role)</option>
}
</select>
</div>
<div class="management-actions"><button class="btn btn-primary" type="submit">Lưu vai trò</button>
<a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>
</form>
</section>
