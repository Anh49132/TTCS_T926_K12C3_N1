@model QL_PhongTro.ViewModels.ManagedAccountsViewModel
@using QL_PhongTro.ViewModels
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="accounts-bootstrap">
<header class="accounts-heading d-flex flex-wrap justify-content-between align-items-center gap-3"><div><h1>Quản lý tài khoản</h1><p>Theo dõi tài khoản, vai trò và trạng thái truy cập hệ thống.</p></div><a asp-action="Create" class="btn btn-primary">＋ Tạo tài khoản</a></header>
@if (TempData["AccountMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["AccountError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

<form method="get" class="row g-3 accounts-filters">
<div class="col-sm-4"><label for="role">Vai trò</label><select id="role" name="role" class="form-select">
<option value="">Tất cả vai trò</option>
@foreach (var role in new[] { "ADMIN", "CHU_NHA", "QUAN_LY", "KHACH_THUE" }) { <option value="@role" selected="@(Model.Role == role)">@ManagedAccountsViewModel.RoleName(role)</option> }
</select></div>
<div class="col-sm-4"><label for="status">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả trạng thái</option><option value="active" selected="@(Model.Status == "active")">Đang hoạt động</option><option value="locked" selected="@(Model.Status == "locked")">Đã khoá</option></select></div>
<div class="col-sm-4 align-self-end"><button type="submit" class="btn btn-primary">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary">Bỏ lọc</a></div>
</form>
<p id="account-count">Tổng số tài khoản: @Model.Total · Tổng số trang: @Model.Pages · Trang @Model.Page</p>
<div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead><tr><th>STT</th><th>Họ tên</th><th>Email</th><th>Số điện thoại</th><th>Vai trò</th><th>Trạng thái</th><th>Mật khẩu</th><th>Thao tác</th></tr></thead>
<tbody>
@{ var accountStt = (Model.Page - 1) * 20; }
@foreach (var account in Model.Accounts) {
accountStt++;
<tr data-account-id="@account.Id"><td>@accountStt</td><td>@account.HoTen</td><td>@account.Email</td><td>@account.SoDienThoai</td><td>@ManagedAccountsViewModel.RoleName(account.VaiTro)</td><td><span class="badge @(account.DangHoatDong ? "text-bg-success" : "text-bg-danger")">@(account.DangHoatDong ? "Đang hoạt động" : "Đã khoá")</span></td><td>@(account.MustChangePassword ? "Chờ đổi mật khẩu" : "Đã thiết lập")</td><td>
@if (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value != account.Id.ToString()) {
<a asp-action="ChangeRole" asp-route-id="@account.Id" class="btn btn-sm btn-outline-secondary mb-2">Đổi vai trò</a>
}
@if (account.VaiTro is "CHU_NHA" or "QUAN_LY") {
<form asp-action="SetActive" method="post" class="mb-2" onsubmit="return confirm('@(account.DangHoatDong ? "Khoá tài khoản và chấm dứt mọi phiên đăng nhập?" : "Mở khoá tài khoản này?")');">
<input type="hidden" name="id" value="@account.Id" /><input type="hidden" name="active" value="@(!account.DangHoatDong ? "true" : "false")" /><input type="hidden" name="confirmed" value="true" />
<button class="btn btn-sm @(account.DangHoatDong ? "btn-outline-danger" : "btn-outline-success")">@(account.DangHoatDong ? "Khoá" : "Mở khoá")</button>
</form>
}
@if (account.VaiTro is "CHU_NHA" or "QUAN_LY" or "ADMIN" && account.MustChangePassword && account.DangHoatDong) {
<form asp-action="Resend" method="post" onsubmit="return confirm('Tạo mật khẩu tạm mới và gửi lại email? Mật khẩu tạm cũ sẽ mất hiệu lực.');"><input type="hidden" name="id" value="@account.Id" /><button class="btn btn-sm btn-outline-secondary">Gửi lại mật khẩu tạm</button></form>
}
@if (account.VaiTro is not "ADMIN" && !account.IsDeleted) {
<form asp-action="Delete" method="post" onsubmit="return confirm('Xóa tài khoản này? Email và số điện thoại sẽ dùng đăng ký lại được. Dữ liệu lịch sử được giữ lại.');"><input type="hidden" name="id" value="@account.Id" /><input type="hidden" name="confirmed" value="true" /><button class="btn btn-sm btn-outline-danger">Xóa</button></form>
}
</td></tr>
}
@if (Model.Total == 0) { <tr><td colspan="8">Không có tài khoản phù hợp.</td></tr> }
</tbody></table></div>
<nav aria-label="Phân trang tài khoản" class="d-flex gap-3 align-items-center">
@if (Model.Page > 1) { <a asp-action="Index" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="1">Đầu</a><a asp-action="Index" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Trước</a> }
<span aria-current="page">@Model.Page / @Model.Pages</span>
@if (Model.Page < Model.Pages) { <a asp-action="Index" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Sau</a><a asp-action="Index" asp-route-role="@Model.Role" asp-route-status="@Model.Status" asp-route-page="@Model.Pages">Cuối</a> }
</nav>

</div>
@section Styles { <link rel="stylesheet" href="~/css/managed-accounts-bootstrap.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/account-filter-dropdowns.js" asp-append-version="true"></script> }
